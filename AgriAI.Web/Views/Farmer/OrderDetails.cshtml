@model AgriAI.Domain.Entities.Order
@using AgriAI.Infrastructure.Identity

@{
    ViewData["Title"] = $"Order #{Model.Id:D5} Management - AgriAI Farmer Portal";
    var buyer = ViewBag.CustomerUser as ApplicationUser;
    var buyerName = buyer != null 
        ? (!string.IsNullOrEmpty(buyer.FirstName) || !string.IsNullOrEmpty(buyer.LastName) 
            ? $"{buyer.FirstName} {buyer.LastName}".Trim() 
            : buyer.UserName) 
        : (!string.IsNullOrEmpty(Model.CustomerId) && Model.CustomerId.Length < 20 ? Model.CustomerId : "Retail Customer");
    var buyerPhone = buyer?.PhoneNumber ?? "+91 97245 60047";
    var buyerEmail = buyer?.Email ?? "customer@agriai.com";
    var buyerInitial = !string.IsNullOrEmpty(buyerName) ? buyerName.Substring(0, 1).ToUpper() : "C";

    var baseAmount = Model.TotalAmount - Model.LogisticsFee - Model.PlatformFee;
    var orderNoStr = "AG-" + Model.Id.ToString("D5");
    var dateFormatted = Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
    var firstItem = Model.OrderItems.FirstOrDefault();
    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
    var itemQty = firstItem?.Quantity ?? 1;
    var unitPrice = firstItem?.UnitPrice ?? Model.TotalAmount;
    var remainingSeconds = Model.CancellationDeadline.HasValue ? (int)Math.Max(0, (Model.CancellationDeadline.Value - DateTime.UtcNow).TotalSeconds) : 0;
    var isParcel = Model.TransportType != null && (Model.TransportType.Contains("Cargo") || Model.TransportType.Contains("GSRTC") || Model.TransportType.Contains("Parcel"));
    var isSettled = Model.Status.Contains("Delivered") || Model.Status.Contains("Settled") || Model.Status == "Completed" || Model.Status == "Cash Received & Delivered";
}

@section Styles {
    <style>
        .order-details-container {
            max-width: 1680px;
            margin: 0 auto;
        }

        /* 1. Hero Header Banner */
        .order-hero-header {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border-radius: 1.25rem;
            padding: 2.25rem 2rem;
            color: #ffffff;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            animation: orderFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .order-hero-header::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 220px;
            height: 220px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            pointer-events: none;
        }

        .order-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 30px;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            margin-bottom: 10px;
            backdrop-filter: blur(8px);
        }

        .order-hero-title {
            font-size: 2.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .order-hero-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.88);
            max-width: 760px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        /* 2. Unified Master Card */
        .order-unified-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            padding: 2.25rem 2.5rem;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            animation: orderFadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .order-unified-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #006653 0%, #10b981 50%, #cb9d46 100%);
        }

        .order-card-header {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 1.25rem;
            margin-bottom: 2rem;
        }

        /* Status Context Banners */
        .order-status-banner {
            border-radius: 18px;
            padding: 1.5rem 1.75rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
            border: 1.5px solid transparent;
            transition: all 0.25s ease;
        }

        .order-status-banner.status-requested {
            background: #fffbeb;
            border-color: #fde68a;
            color: #92400e;
        }

        .order-status-banner.status-accepted {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
            border-color: #059669;
            color: #ffffff;
        }

        .order-status-banner.status-ready {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .order-status-banner.status-transit {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1e40af;
        }

        .order-status-banner.status-settled {
            background: #f0fdf4;
            border-color: #86efac;
            color: #15803d;
        }

        /* Produce Item Card Inside Master Box */
        .produce-item-row {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1rem 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.25s ease;
        }

        .produce-item-row:hover {
            border-color: #86efac;
            background: #ffffff;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.06);
            transform: translateY(-2px);
        }

        /* Pricing Breakdown Box */
        .pricing-breakdown-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 1.5rem 1.75rem;
            margin-top: 1.5rem;
        }

        .payout-highlight-box {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 1.5px solid #86efac;
            border-radius: 14px;
            padding: 1rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }

        /* Sidebar Panels */
        .order-side-panel {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 1.4rem 1.5rem;
            margin-bottom: 1.35rem;
            transition: all 0.25s ease;
        }

        .order-side-panel:hover {
            border-color: #cbd5e1;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }

        .buyer-avatar-badge {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, #006653 0%, #16a34a 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            font-weight: 800;
            box-shadow: 0 4px 12px rgba(0, 102, 83, 0.2);
        }

        /* Action Buttons */
        .btn-whatsapp-custom {
            background-color: #25D366;
            border-color: #25D366;
            color: #ffffff;
            font-weight: 700;
            border-radius: 9999px;
            padding: 0.65rem 1.25rem;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
        }

        .btn-whatsapp-custom:hover {
            background-color: #20bd5a;
            border-color: #20bd5a;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
        }

        .btn-call-custom {
            background: #ffffff;
            border: 1.5px solid #006653;
            color: #006653;
            font-weight: 700;
            border-radius: 9999px;
            padding: 0.65rem 1.25rem;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
        }

        .btn-call-custom:hover {
            background: #006653;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 102, 83, 0.2);
        }

        .btn-verify-otp-action {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border: none;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.75rem 2rem;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.25);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-verify-otp-action:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 102, 83, 0.35);
        }

        /* Delivery Verification & Settlement Card */
        .settlement-verification-card {
            background: #ffffff;
            border: 1.5px solid #86efac;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            transition: all 0.25s ease;
            margin-bottom: 2rem;
        }

        .settlement-header {
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
            border-bottom: 1.5px solid #bbf7d0;
            padding: 1.15rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .settlement-body {
            padding: 1.5rem 1.6rem;
        }

        .pickup-handover-box {
            background: #ffffff;
            border-radius: 16px;
        }

        .payout-amount-badge-card {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 1.5px solid #86efac;
            border-radius: 14px;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin: 1.25rem 0;
        }

        .btn-confirm-handover {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border: none;
            color: #ffffff;
            font-weight: 800;
            font-size: 1.02rem;
            border-radius: 9999px;
            padding: 0.85rem 2rem;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.25);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-confirm-handover:hover {
            background: linear-gradient(135deg, #005242 0%, #036348 100%);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(0, 102, 83, 0.35);
        }

        /* Keyframe Entrance Animation */
        @@keyframes orderFadeInUp {
            from {
                opacity: 0;
                transform: translateY(22px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 991px) {
            .order-hero-title {
                font-size: 1.85rem;
            }
            .order-unified-card {
                padding: 1.5rem;
            }
        }

        @@media (max-width: 576px) {
            .order-hero-title {
                font-size: 1.45rem !important;
            }
            .order-unified-card {
                padding: 16px 12px !important;
                border-radius: 18px !important;
            }
            .pricing-breakdown-card {
                padding: 14px 12px !important;
                border-radius: 14px !important;
            }
            .payout-highlight-box {
                flex-direction: column !important;
                align-items: stretch !important;
                padding: 12px 14px !important;
                border-radius: 12px !important;
                overflow: hidden !important;
            }
            .settlement-verification-card {
                border-radius: 16px !important;
                margin-bottom: 1.25rem !important;
            }
            .settlement-header {
                padding: 12px 14px !important;
            }
            .settlement-header h5 {
                font-size: 1rem !important;
            }
            .settlement-body {
                padding: 14px 12px !important;
            }
            .payout-amount-badge-card {
                flex-direction: column !important;
                align-items: flex-start !important;
                padding: 12px 14px !important;
                gap: 8px !important;
            }
            .btn-confirm-handover {
                width: 100% !important;
                font-size: 0.92rem !important;
                padding: 12px 16px !important;
                white-space: normal !important;
                text-align: center !important;
            }
            .order-status-banner.status-ready .d-flex {
                flex-direction: column !important;
                align-items: stretch !important;
            }
            .order-status-banner.status-ready .btn {
                width: 100% !important;
                margin-top: 8px !important;
            }
        }
    </style>
}

<div class="container-fluid py-3 px-2 px-md-3 px-xl-4 order-details-container">
    
    <!-- 1. Hero Header Banner -->
    <div class="order-hero-header shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="order-hero-badge">
                    <i class="bi bi-receipt-cutoff text-warning"></i>
                    <span>Direct Farmer Order &bull; 100% Escrow Protected</span>
                </div>
                <h1 class="order-hero-title d-flex align-items-center flex-wrap gap-2.5">
                    <span>Order #@Model.Id.ToString("D5")</span>
                    @if (Model.Status == "Requested")
                    {
                        <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm fs-6">
                            <i class="bi bi-hourglass-top me-1"></i>New Request ⏳
                        </span>
                    }
                    else if (Model.Status == "Accepted")
                    {
                        @if (remainingSeconds > 0)
                        {
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill fs-6 shadow-sm">
                                <i class="bi bi-clock-history me-1"></i>Active (3h Review)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill fs-6">
                                <i class="bi bi-lock-fill me-1"></i>Locked for Dispatch
                            </span>
                        }
                    }
                    else if (Model.Status == "Ready for Pickup")
                    {
                        <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i>Ready for Pickup 🟢
                        </span>
                    }
                    else if (Model.Status == "In Transit")
                    {
                        <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm fs-6">
                            <i class="bi bi-truck me-1"></i>In Transit
                        </span>
                    }
                    else if (Model.Status == "Declined")
                    {
                        <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill fs-6">
                            <i class="bi bi-x-circle-fill me-1"></i>Declined
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-secondary text-white fw-bold px-3 py-1.5 rounded-pill fs-6">
                            <i class="bi bi-slash-circle me-1"></i>Cancelled by Buyer
                        </span>
                    }
                    else if (isSettled)
                    {
                        <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill fs-6">
                            <i class="bi bi-check-circle-fill me-1"></i>Delivered &amp; Settled 🟢
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill fs-6">
                            <i class="bi bi-box-seam me-1"></i>@Model.Status
                        </span>
                    }
                </h1>
                <p class="order-hero-subtitle">
                    Ordered by <strong>@buyerName</strong> on @dateFormatted &bull; Net Producer Earning: <strong>₹@baseAmount.ToString("N2")</strong> (@(Model.PaymentMethod ?? "Online Escrow Vault"))
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0 d-flex flex-wrap gap-2 justify-content-lg-end">
                <a asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-3.5 py-2 fw-bold small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Orders
                </a>
                <button type="button" class="btn btn-light text-success rounded-pill px-4 py-2 fw-bold small shadow-sm" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@buyerName', '@produceName', @itemQty, @unitPrice, @baseAmount, @Model.LogisticsFee, @Model.PlatformFee, @Model.TotalAmount, '@(Model.PaymentMethod ?? "Online (Escrow)")', '@(Model.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(Model.ShippingAddress) ? "Gujarat Farm Location" : Model.ShippingAddress)')">
                    <i class="bi bi-printer-fill me-1"></i> Print Tax Invoice
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Single Unified Master Card -->
    <div class="order-unified-card shadow-sm">
        
        <!-- Header Bar Inside Box -->
        <div class="order-card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam-fill text-success"></i> Customer Order Fulfillment &amp; Settlement
                </h3>
                <p class="text-muted small mb-0">Manage produce harvest packaging, cargo logistics dispatch, and verify delivery OTP to release payment.</p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25 rounded-pill px-3 py-1.5 small">
                    <i class="bi bi-shield-check me-1"></i> 100% Escrow Protected
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold border border-primary border-opacity-25 rounded-pill px-3 py-1.5 small">
                    <i class="bi bi-truck me-1"></i> @(Model.TransportType ?? "Direct Farm Pickup")
                </span>
            </div>
        </div>

        <!-- Dynamic Contextual Status Alert Banner Inside Master Card -->
        @if (Model.Status == "Requested")
        {
            <div class="order-status-banner status-requested">
                <div class="row align-items-center g-3">
                    <div class="col-md-7 col-xl-8">
                        <div class="d-flex align-items-center gap-2 mb-1.5">
                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-inbox-fill me-1"></i>NEW BUYER PURCHASE REQUEST
                            </span>
                            <span class="fw-semibold small">₹@Model.TotalAmount.ToString("N2") Secured in AgriAI Escrow</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Incoming Crop Order Request from @buyerName</h5>
                        <p class="small mb-0 opacity-75">
                            Please review the requested crop quantities and accept this order to start harvest packing.
                        </p>
                    </div>
                    <div class="col-md-5 col-xl-4 text-md-end d-flex flex-wrap justify-content-md-end gap-2">
                        <form asp-action="AcceptOrder" method="post" class="d-inline m-0">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                <i class="bi bi-check-circle-fill me-1"></i> Accept Order
                            </button>
                        </form>
                        <form asp-action="UpdateOrderStatus" method="post" class="d-inline m-0">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <input type="hidden" name="status" value="Ready for Pickup" />
                            <button type="submit" class="btn btn-warning text-dark rounded-pill px-3 py-2 fw-bold shadow-sm" title="Instant College Demo Bypass">
                                <i class="bi bi-lightning-charge-fill me-1"></i> ⚡ Instant Ready
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-bold" onclick="toggleDeclineDetailsBox()">
                            <i class="bi bi-x-circle me-1"></i> Decline
                        </button>
                    </div>
                </div>

                <div id="declineDetailsBox" class="mt-3 p-3 bg-white text-dark rounded-3 border" style="display: none;">
                    <form asp-action="DeclineOrder" method="post">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <label class="form-label small fw-bold text-danger mb-1">Reason for declining order request:</label>
                        <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. Current crop harvest exhausted / logistics unserviceable..." required></textarea>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleDeclineDetailsBox()">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Confirm Decline &amp; Refund Buyer</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (Model.Status == "Accepted")
        {
            <div class="order-status-banner status-accepted">
                <div class="row align-items-center g-3">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-check2-circle me-1"></i>ORDER CONFIRMED &amp; ACTIVE
                            </span>
                            @if (remainingSeconds > 0)
                            {
                                var fh = remainingSeconds / 3600;
                                var fm = (remainingSeconds % 3600) / 60;
                                var fs = remainingSeconds % 60;
                                <span class="d-inline-flex align-items-center gap-1.5 px-3 py-1 rounded-pill" id="farmerReviewCountdown" data-remaining="@remainingSeconds" style="background: rgba(255, 255, 255, 0.18); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); font-weight: 700; font-size: 0.78rem;">
                                    ⏳ @($"{fh:D2}h {fm:D2}m {fs:D2}s") Review Window
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-75 text-white border px-2.5 py-1 rounded-pill small">
                                    🔒 3-Hour Review Ended &bull; Locked for Dispatch
                                </span>
                            }
                        </div>
                        <h4 class="fw-bold text-white mb-1">
                            @(remainingSeconds > 0 ? "Harvest Review & Packaging in Progress" : "Order Locked for Dispatch")
                        </h4>
                        <p class="text-white-50 small mb-0">
                            @if (remainingSeconds > 0)
                            {
                                @(isParcel ? "Prepare the parcel and hand it over to GSRTC/Cargo logistics. You may decline if stock is unavailable, or click dispatch below." : "Check your stock and package fresh produce for farm pickup. You can decline if out of stock, or mark ready instantly.")
                            }
                            else
                            {
                                @(isParcel ? "The 3-hour review window has concluded. Cancellation is now permanently locked. Dispatch the parcel via GSRTC/Cargo and upload the Bilty slip below." : "The 3-hour review window has concluded. Cancellation is now permanently locked. Pack the produce and mark it ready for customer pickup.")
                            }
                        </p>
                        @if (Model.PaymentMethod != "Cash on Delivery")
                        {
                            <div class="mt-2 p-2 px-3 rounded-3 d-inline-flex align-items-center gap-2" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.25);">
                                <i class="bi bi-shield-fill-check text-warning fs-6"></i>
                                <span class="small text-white">
                                    <strong>₹@baseAmount.ToString("N2") Funded in AgriAI Escrow Vault</strong> (100% Razorpay Guaranteed)
                                    @if (Model.Payment != null && !string.IsNullOrEmpty(Model.Payment.RazorpayPaymentId))
                                    {
                                        <span class="opacity-75 ms-1">&bull; Ref: @Model.Payment.RazorpayPaymentId</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <div class="col-md-5 text-md-end d-flex flex-column align-items-md-end gap-2">
                        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                            @if (isParcel)
                            {
                                <button type="button" class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow" data-bs-toggle="modal" data-bs-target="#farmerBiltyModal">
                                    <i class="bi bi-bus-front-fill me-1"></i> Dispatch &amp; Upload Bilty
                                </button>
                            }
                            else
                            {
                                <form asp-action="UpdateOrderStatus" method="post" class="d-inline m-0">
                                    <input type="hidden" name="orderId" value="@Model.Id" />
                                    <input type="hidden" name="status" value="Ready for Pickup" />
                                    <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow">
                                        <i class="bi bi-box-seam me-1"></i> ⚡ Mark Ready for Pickup
                                    </button>
                                </form>
                            }

                            @if (remainingSeconds > 0)
                            {
                                <button type="button" class="btn btn-outline-light rounded-pill px-3 py-2 fw-bold" onclick="toggleDeclineDetailsBox()">
                                    <i class="bi bi-x-circle me-1"></i> Decline (Out of Stock)
                                </button>
                            }
                        </div>
                        <small class="text-white-50" style="font-size: 0.76rem;">
                            @if (remainingSeconds > 0)
                            {
                                <span><i class="bi bi-lightning-fill text-warning me-0.5"></i> Advancing status locks order immediately.</span>
                            }
                            else
                            {
                                <span><i class="bi bi-lock-fill text-warning me-0.5"></i> Review window concluded &bull; Dispatch only</span>
                            }
                        </small>
                    </div>
                </div>

                @if (remainingSeconds > 0)
                {
                    <div id="declineDetailsBox" class="mt-3 p-3 bg-white text-dark rounded-3 border" style="display: none;">
                        <form asp-action="DeclineOrder" method="post">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <label class="form-label small fw-bold text-danger mb-1">Reason for declining / cancelling order:</label>
                            <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. Current crop harvest exhausted / logistics unserviceable..." required></textarea>
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleDeclineDetailsBox()">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Confirm Decline &amp; 100% Refund Buyer</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        }
        else if (Model.Status == "Ready for Pickup")
        {
            <div class="order-status-banner status-ready">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-check-circle-fill me-1"></i>READY FOR FARM PICKUP
                            </span>
                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-hourglass-split me-1"></i>Awaiting Buyer Handover
                            </span>
                        </div>
                        <h5 class="fw-bold text-success mb-1">Produce is Packed &amp; Waiting for Buyer Collection</h5>
                        <p class="text-muted small mb-0">
                            The buyer will collect harvest directly from your farm. No OTP required. Hand over produce and the buyer will confirm handover on their phone to release your payment.
                        </p>
                    </div>
                    <div>
                        <span class="badge rounded-pill px-4 py-2.5 fw-bold shadow-xs text-white" style="background-color: #006653; font-size: 0.90rem;">
                            <i class="bi bi-phone me-1"></i> Buyer Confirms On Phone
                        </span>
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == "In Transit")
        {
            <div class="order-status-banner status-transit">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary text-white fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-truck me-1"></i>IN TRANSIT VIA CARGO
                            </span>
                            <span class="text-muted small">Bilty / LR: <strong class="text-dark font-monospace">@Model.BiltyNumber</strong></span>
                        </div>
                        <h5 class="fw-bold text-primary mb-1">Dispatched via @(string.IsNullOrEmpty(Model.CargoServiceName) ? "GSRTC ST Bus Parcel" : Model.CargoServiceName)</h5>
                        <p class="text-muted small mb-0">
                            When the buyer receives the parcel at their destination, enter the 4-digit OTP or wait for automatic escrow release.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
                        {
                            <a href="@Model.BiltyImageUrl" target="_blank" class="btn btn-outline-primary rounded-pill px-3.5 py-2 fw-bold small">
                                <i class="bi bi-receipt me-1"></i> View Bilty Slip
                            </a>
                        }
                        <a href="#otpVerificationCard" class="btn btn-primary rounded-pill px-4 py-2 fw-bold small shadow-sm">
                            <i class="bi bi-shield-check me-1"></i> Enter OTP
                        </a>
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == "Declined")
        {
            <div class="order-status-banner" style="background-color: #fee2e2; border-color: #fca5a5; color: #991b1b;">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-x-circle-fill fs-3 text-danger"></i>
                    <div>
                        <h5 class="fw-bold mb-1 text-danger">Order Declined / Cancelled by Producer</h5>
                        <p class="small mb-0 opacity-85">
                            Reason: @(string.IsNullOrEmpty(Model.FarmerDeclineReason) ? "Produce unavailable / harvest constraint" : Model.FarmerDeclineReason). Crop inventory stock has been restored and ₹@Model.TotalAmount.ToString("N2") refunded to buyer.
                        </p>
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == "Cancelled")
        {
            <div class="order-status-banner" style="background-color: #f1f5f9; border-color: #cbd5e1; color: #475569;">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-slash-circle-fill fs-3 text-secondary"></i>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Order Cancelled by Buyer</h5>
                        <p class="small mb-0 opacity-85">
                            Reason: @(string.IsNullOrEmpty(Model.CustomerCancelReason) ? "Cancelled within 3-hour review window" : Model.CustomerCancelReason). Produce stock has been restored to your farm inventory.
                        </p>
                    </div>
                </div>
            </div>
        }

        <!-- Integrated Row: Items & Settlement on Left, Buyer & Logistics on Right -->
        <div class="row g-4 g-xl-5">
            
            <!-- Left Column: Produce Items & Delivery Settlement -->
            <div class="col-lg-7 col-xl-8">
                
                <!-- Produce Items List Box -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-basket3-fill text-success"></i> Ordered Farm Produce Items
                        </h5>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@Model.OrderItems.Count Items</span>
                    </div>

                    @foreach (var item in Model.OrderItems)
                    {
                        var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                        <div class="produce-item-row d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(itemImg))
                                {
                                    <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Crop")" style="width: 72px; height: 72px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-white rounded-3 border d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                                        <i class="bi bi-tree text-success fs-3"></i>
                                    </div>
                                }
                                <div>
                                    <span class="badge bg-white text-success border border-success border-opacity-25 small mb-1 fw-bold">@(item.Product?.Category?.Name ?? "Farm Produce")</span>
                                    <h6 class="fw-bold text-dark mb-0.5 fs-6">@(item.Product?.Name ?? "Harvest Crop")</h6>
                                    <small class="text-muted">Quantity: <strong class="text-dark">@item.Quantity Kg</strong> @@ ₹@item.UnitPrice.ToString("N2") / Kg</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="text-muted small d-block">Subtotal</span>
                                <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                            </div>
                        </div>
                    }

                    <!-- Pricing Micro-Breakdown -->
                    <div class="pricing-breakdown-card">
                        <div class="d-flex justify-content-between align-items-center small text-muted mb-2 gap-2">
                            <span>Farmer Produce Value:</span>
                            <span class="fw-bold text-success fs-6 text-nowrap">₹@baseAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted mb-2 gap-2">
                            <span>Transport / Logistics (Customer paid):</span>
                            <span class="text-dark fw-medium text-nowrap">₹@Model.LogisticsFee.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted mb-2.5 gap-2">
                            <span>Platform Escrow Fee (Customer paid tax):</span>
                            <span class="text-dark fw-medium text-nowrap">₹@Model.PlatformFee.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2.5 small text-muted mb-2 gap-2">
                            <span>Total Paid by Customer:</span>
                            <span class="text-dark fw-bold text-nowrap">₹@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        @if (Model.Payment != null && !string.IsNullOrEmpty(Model.Payment.RazorpayPaymentId))
                        {
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-2 gap-2 flex-wrap">
                                <span>Razorpay Escrow Ref:</span>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 font-monospace text-truncate" style="max-width: 170px;">@Model.Payment.RazorpayPaymentId</span>
                            </div>
                        }
                        
                        <!-- Payout Highlight Box -->
                        <div class="payout-highlight-box">
                            <div class="w-100 mb-1">
                                <span class="d-block small text-success fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">100% Guaranteed Farmer Payout</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center w-100 gap-2 flex-wrap">
                                <strong class="text-dark" style="font-size: 1.05rem;">Net Farmer Earning:</strong>
                                <strong class="text-success fw-extrabold" style="font-size: 1.45rem; white-space: nowrap;">₹@baseAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Verification & Settlement Card -->
                <div id="otpVerificationCard" class="settlement-verification-card shadow-sm">
                    <div class="settlement-header">
                        <h5 class="fw-extrabold text-success mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check fs-5"></i> Delivery Verification &amp; Payment Settlement
                        </h5>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #ffffff; color: #15803d; border: 1.5px solid #86efac; font-size: 0.78rem;">
                                <i class="bi bi-shield-fill-check me-1 text-success"></i> 100% Escrow Funded
                            </span>
                            <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #ffffff; color: #006653; border: 1.5px solid #86efac; font-size: 0.78rem;">
                                <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Instant Release
                            </span>
                        </div>
                    </div>
                    <div class="settlement-body">
                        @if (isSettled)
                        {
                            <div class="p-3.5 rounded-4 d-flex align-items-center gap-3 border" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-color: #86efac !important;">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 50px; height: 50px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                    <i class="bi bi-patch-check-fill fs-3"></i>
                                </div>
                                <div>
                                    <h5 class="fw-extrabold text-success mb-1">Order Completed &amp; Payout Released!</h5>
                                    <p class="text-dark small mb-0" style="line-height: 1.5;">
                                        @(isParcel ? "Delivery OTP was successfully verified." : "Produce was physically handed over to buyer at the farm.") <strong>₹@baseAmount.ToString("N2")</strong> net produce earnings have been credited to your farmer account wallet.
                                    </p>
                                </div>
                            </div>
                        }
                        else if (Model.PaymentMethod == "Cash on Delivery")
                        {
                            <div class="pickup-handover-box p-3.5 rounded-4 border" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-color: #fde68a !important;">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill small">
                                        <i class="bi bi-cash-stack me-1"></i> Cash on Delivery Collection
                                    </span>
                                </div>
                                <h5 class="fw-extrabold text-dark mb-1">Collect Cash Payment at Farm</h5>
                                <p class="text-muted small mb-3">
                                    Collect the cash payment of ₹@baseAmount.ToString("N2") directly from the customer upon handing over the harvested produce.
                                </p>
                                <form asp-action="UpdateOrderStatus" method="post" class="m-0">
                                    <input type="hidden" name="orderId" value="@Model.Id" />
                                    <input type="hidden" name="status" value="Cash Received & Delivered" />
                                    <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                                        <i class="bi bi-cash-coin me-1"></i> Mark Cash Received (₹@baseAmount.ToString("N2"))
                                    </button>
                                </form>
                            </div>
                        }
                        else if (!isParcel)
                        {
                            <!-- Direct Farm Pickup: Physical Handover Settlement (NO OTP NEEDED) -->
                            <div class="pickup-handover-box">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2.5">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #ecfdf5; color: #047857; border: 1.5px solid #86efac; font-size: 0.78rem;">
                                            <i class="bi bi-geo-alt-fill me-1 text-success"></i> DIRECT FARM PICKUP
                                        </span>
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #f8fafc; color: #15803d; border: 1px solid #86efac; font-size: 0.78rem;">
                                            <i class="bi bi-check2-circle me-1 text-success"></i> No OTP Required &bull; Direct Handover
                                        </span>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                        <i class="bi bi-shield-check me-1"></i> 100% Escrow Funded
                                    </span>
                                </div>

                                <h5 class="fw-extrabold text-dark mb-1" style="letter-spacing: -0.3px;">
                                    Customer Collecting Produce at Farm
                                </h5>
                                <p class="text-muted small mb-0" style="line-height: 1.55; font-size: 0.88rem;">
                                    The customer visits your farm in person. Hand over the fresh harvest produce to the customer. When the customer inspects and taps <strong>"Confirm Produce Handover"</strong> on their phone, ₹@baseAmount.ToString("N2") will be credited immediately to your farmer wallet. No OTP is required.
                                </p>

                                <div class="payout-amount-badge-card">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" style="width: 46px; height: 46px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                            <i class="bi bi-wallet2 fs-5"></i>
                                        </div>
                                        <div>
                                            <span class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Net Guaranteed Producer Payout</span>
                                            <span class="fw-bold text-dark" style="font-size: 0.95rem;">Instant Wallet Credit (Upon Customer Confirmation)</span>
                                        </div>
                                    </div>
                                    <div class="text-sm-end mt-2 mt-sm-0">
                                        <div class="fs-3 fw-extrabold text-success font-monospace" style="letter-spacing: -0.5px;">₹@baseAmount.ToString("N2")</div>
                                        <small class="d-block text-success fw-semibold" style="font-size: 0.75rem;">0% Commission Deducted</small>
                                    </div>
                                </div>

                                <div class="alert alert-warning border-0 rounded-4 p-3 d-flex align-items-center gap-3 mb-0 mt-3" style="background-color: #fefce8; color: #854d0e; border-left: 4px solid #eab308 !important;">
                                    <i class="bi bi-phone-vibrate fs-3 flex-shrink-0 text-warning"></i>
                                    <div>
                                        <strong class="d-block small">Awaiting Customer Confirmation:</strong>
                                        <span class="small" style="font-size: 0.82rem;">Please ask the customer to open this order on their phone and tap <strong>"Confirm Produce Handover"</strong> once they receive the harvest. Payout will be released to your wallet instantly without needing any OTP.</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Cargo / GSRTC Remote Transport: 4-Digit OTP Required -->
                            <div class="pickup-handover-box">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2.5">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #eff6ff; color: #1d4ed8; border: 1.5px solid #bfdbfe; font-size: 0.78rem;">
                                            <i class="bi bi-truck me-1 text-primary"></i> CARGO / GSRTC PARCEL
                                        </span>
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: #fef3c7; color: #b45309; border: 1.5px solid #fde68a; font-size: 0.78rem;">
                                            <i class="bi bi-key-fill me-1"></i> 4-Digit OTP Required
                                        </span>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                        <i class="bi bi-shield-check me-1"></i> Escrow Secured
                                    </span>
                                </div>

                                <h5 class="fw-extrabold text-dark mb-1" style="letter-spacing: -0.3px;">
                                    Enter Customer's 4-Digit Delivery OTP
                                </h5>
                                <p class="text-muted small mb-3" style="line-height: 1.55; font-size: 0.88rem;">
                                    For GSRTC / Cargo remote parcel shipments, ask the customer for their confidential 4-digit OTP upon parcel collection at their destination counter to release ₹@baseAmount.ToString("N2").
                                </p>

                                <form asp-action="VerifyDeliveryOtp" method="post" class="row g-2 align-items-center mt-2">
                                    <input type="hidden" name="orderId" value="@Model.Id" />
                                    <div class="col-sm-6 col-md-5">
                                        <input type="text" name="enteredOtp" placeholder="4-Digit OTP" maxlength="4" class="form-control text-center fw-bold fs-4 bg-white shadow-none" style="letter-spacing: 6px; border: 2px solid #86efac; border-radius: 14px; height: 52px;" required />
                                    </div>
                                    <div class="col-sm-6 col-md-7">
                                        <button type="submit" class="btn btn-verify-otp-action w-100" style="height: 52px; font-size: 1rem;">
                                            <i class="bi bi-shield-check me-1"></i> Verify OTP &amp; Release ₹@baseAmount.ToString("N2")
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- Right Column: Buyer Profile, Transport & Logistics -->
            <div class="col-lg-5 col-xl-4">
                <div class="d-flex flex-column gap-3">
                    
                    <!-- Customer / Buyer Profile Card -->
                    <div class="order-side-panel shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-success"></i> Customer / Buyer Profile
                            </h6>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold small">Verified</span>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="buyer-avatar-badge">
                                @buyerInitial
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0.5 fs-6">@buyerName</h6>
                                <span class="text-muted small">Registered Gujarat Buyer</span>
                            </div>
                        </div>

                        <div class="p-3 bg-white rounded-3 border mb-3">
                            <div class="mb-2">
                                <small class="text-muted d-block" style="font-size: 0.78rem;">Phone Number:</small>
                                <strong class="text-dark">@buyerPhone</strong>
                            </div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.78rem;">Email Address:</small>
                                <strong class="text-dark small text-break">@buyerEmail</strong>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a href="tel:@buyerPhone" class="btn-call-custom">
                                <i class="bi bi-telephone-fill"></i> Call Customer
                            </a>
                        </div>
                    </div>

                    <!-- Transport & Logistics Card -->
                    <div class="order-side-panel shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-truck text-success"></i> Logistics &amp; Transport
                            </h6>
                            <span class="badge bg-light text-dark border small fw-bold">Dispatch Info</span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block mb-1" style="font-size: 0.80rem;">Selected Delivery Mode:</small>
                            <span class="badge bg-white text-dark border fw-bold fs-6 py-2 px-3 d-inline-flex align-items-center gap-2">
                                <i class="bi bi-box-seam text-success"></i> @(Model.TransportType ?? "Direct Farm Pickup")
                            </span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block mb-1" style="font-size: 0.80rem;">Delivery / Destination Address:</small>
                            <p class="text-dark small mb-0 fw-semibold p-2.5 bg-white rounded-3 border">
                                @(string.IsNullOrEmpty(Model.ShippingAddress) ? "Gujarat Farm Location / Direct APMC Mandi Collection" : Model.ShippingAddress)
                            </p>
                        </div>

                        @if (isParcel && !string.IsNullOrEmpty(Model.BiltyNumber))
                        {
                            <div class="p-3 bg-white rounded-3 border">
                                <small class="text-muted d-block" style="font-size: 0.78rem;">Cargo Service:</small>
                                <strong class="text-dark d-block mb-1.5">@(string.IsNullOrEmpty(Model.CargoServiceName) ? "GSRTC ST Bus Parcel" : Model.CargoServiceName)</strong>
                                
                                <small class="text-muted d-block" style="font-size: 0.78rem;">Bilty / LR Number:</small>
                                <strong class="text-primary font-monospace fs-6">@Model.BiltyNumber</strong>

                                @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
                                {
                                    <div class="mt-2.5">
                                        <a href="@Model.BiltyImageUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-bold py-1.5">
                                            <i class="bi bi-receipt me-1"></i> View Uploaded Bilty
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Escrow Guarantee Security Card -->
                    <div class="order-side-panel shadow-sm" style="background: rgba(16, 185, 129, 0.08); border-color: rgba(16, 185, 129, 0.24);">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-shield-fill-check text-success fs-5"></i>
                            <h6 class="fw-bold text-success mb-0">100% Escrow Protection</h6>
                        </div>
                        <p class="text-muted small mb-0" style="font-size: 0.82rem; line-height: 1.5;">
                            Buyer's funds remain safely deposited in the escrow account. The moment you enter the 4-digit delivery OTP, payout is released immediately to your wallet.
                        </p>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

<!-- Modal: Upload GSRTC / Cargo Bilty Slip -->
<div class="modal fade" id="farmerBiltyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-success text-white p-3.5 px-4" style="background: linear-gradient(135deg, #006653 0%, #047857 100%);">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-bus-front-fill me-1"></i> GSRTC / Cargo Bilty Dispatch (Order #@Model.Id:D5)
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadBiltyAndDispatch" method="post" enctype="multipart/form-data">
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="alert alert-info p-2.5 rounded-3 mb-3 small">
                        <i class="bi bi-info-circle-fill me-1"></i> <strong>Proof of Dispatch:</strong> Uploading the official Bilty / LR receipt guarantees your escrow payout release within 24h.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Transport / Cargo Service Name *</label>
                        <select name="cargoServiceName" class="form-select rounded-3 small shadow-none" required>
                            <option value="GSRTC ST Bus Parcel">GSRTC ST Bus Parcel (State Transport)</option>
                            <option value="Patel Cargo Logistics">Patel Cargo Logistics</option>
                            <option value="Shrinath Travels Cargo">Shrinath Travels Cargo</option>
                            <option value="Eagle Cargo Express">Eagle Cargo Express</option>
                            <option value="Direct Mini-Truck / Transport Vehicle">Direct Mini-Truck / Transport Vehicle</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Bilty / LR / Parcel Receipt Number *</label>
                        <input type="text" name="biltyNumber" class="form-control rounded-3 small shadow-none" placeholder="e.g. GSRTC-RAJ-94821" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Bilty Receipt Slip Photo *</label>
                        <input type="file" name="biltyFile" class="form-control rounded-3 small shadow-none" accept="image/*,.pdf" required />
                        <small class="text-muted d-block mt-1">Take a clear photo of the stamped parcel receipt given by the transport counter.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 px-4 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold" style="background-color: #006653; border-color: #006653;">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload &amp; Mark Dispatched
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDeclineDetailsBox() {
            const box = document.getElementById('declineDetailsBox');
            if (box) {
                box.style.display = box.style.display === 'none' ? 'block' : 'none';
            }
        }

        function printOrderInvoice(orderNo, orderDate, customerName, produceName, qty, unitPrice, subtotal, logisticsFee, platformFee, grandTotal, paymentMethod, transportType, shippingAddress) {
            const printWindow = window.open('', '_blank', 'width=850,height=900');
            const formattedTotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(grandTotal);
            const formattedSubtotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(subtotal);
            const formattedLogistics = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(logisticsFee);
            const formattedFee = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(platformFee);
            const formattedUnit = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(unitPrice);

            let invoiceHtml = '<!DOCTYPE html>' +
                '<html><head><meta charset="utf-8">' +
                '<title>Tax Invoice - ' + orderNo + ' - AgriAI Farm Portal</title>' +
                '<style>' +
                'body { font-family: "Segoe UI", Arial, sans-serif; margin: 0; padding: 25px; color: #1e293b; line-height: 1.4; }' +
                '.invoice-card { max-width: 780px; margin: auto; border: 1px solid #cbd5e1; border-radius: 12px; padding: 30px; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }' +
                '.header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #006653; padding-bottom: 15px; margin-bottom: 20px; }' +
                '.logo-title { color: #006653; font-size: 24px; font-weight: 800; margin: 0; }' +
                '.logo-sub { color: #64748b; font-size: 12px; margin: 2px 0 0 0; }' +
                '.badge-inv { background: #f0fdf4; color: #15803d; border: 1px solid #86efac; padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; }' +
                '.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }' +
                '.info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px; }' +
                '.info-box h4 { margin: 0 0 6px 0; font-size: 13px; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px; }' +
                '.info-box p { margin: 3px 0; font-size: 12.5px; color: #475569; }' +
                'table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }' +
                'th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-size: 12.5px; color: #334155; border-bottom: 2px solid #cbd5e1; }' +
                'td { padding: 12px; font-size: 13px; border-bottom: 1px solid #e2e8f0; }' +
                '.totals-table { width: 320px; margin-left: auto; margin-bottom: 20px; }' +
                '.totals-table td { padding: 5px 8px; border: none; font-size: 12.5px; }' +
                '.grand-row { border-top: 2px solid #006653 !important; font-size: 16px !important; font-weight: 800; color: #006653; padding-top: 8px !important; }' +
                '.footer { border-top: 1px solid #e2e8f0; padding-top: 15px; display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: #64748b; }' +
                '.stamp { border: 2px dashed #86efac; background: #f0fdf4; padding: 6px 12px; border-radius: 6px; color: #15803d; font-weight: bold; font-size: 12px; }' +
                '@@media print { body { padding: 0; } .invoice-card { border: none; padding: 10px; } }' +
                '</style></head><body>' +
                '<div class="invoice-card">' +
                '<div class="header">' +
                '<div><h1 class="logo-title">🌾 AgriAI Farm Portal</h1>' +
                '<p class="logo-sub">Direct Farm-to-Buyer Agricultural Marketplace &bull; Gujarat, India</p></div>' +
                '<div style="text-align: right;"><span class="badge-inv">PRODUCER TAX INVOICE</span>' +
                '<p style="margin: 5px 0 0 0; font-size: 12px; color: #64748b;"><strong>Order No:</strong> ' + orderNo + '</p>' +
                '<p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;"><strong>Date &amp; Time:</strong> ' + orderDate + '</p></div>' +
                '</div>' +
                '<div class="info-grid">' +
                '<div class="info-box">' +
                '<h4>Buyer / Customer Details</h4>' +
                '<p><strong>Name:</strong> ' + customerName + '</p>' +
                '<p><strong>Account Type:</strong> Verified Buyer</p>' +
                '<p><strong>Location:</strong> ' + shippingAddress + '</p>' +
                '</div>' +
                '<div class="info-box">' +
                '<h4>Fulfillment &amp; Payment</h4>' +
                '<p><strong>Payment Method:</strong> ' + paymentMethod + '</p>' +
                '<p><strong>Transport Mode:</strong> ' + transportType + '</p>' +
                '<p><strong>Settlement:</strong> 100% Escrow Protected</p>' +
                '</div>' +
                '</div>' +
                '<table><thead><tr>' +
                '<th>#</th>' +
                '<th>Produce Item Description</th>' +
                '<th>Quantity</th>' +
                '<th>Unit Rate</th>' +
                '<th style="text-align: right;">Amount (INR)</th>' +
                '</tr></thead><tbody>' +
                '<tr>' +
                '<td>1</td>' +
                '<td><strong>' + produceName + '</strong><br><small style="color: #64748b;">100% Farm Fresh Harvest</small></td>' +
                '<td>' + qty + ' Kg</td>' +
                '<td>' + formattedUnit + ' / Kg</td>' +
                '<td style="text-align: right; font-weight: bold;">' + formattedSubtotal + '</td>' +
                '</tr></tbody></table>' +
                '<table class="totals-table">' +
                '<tr><td style="color: #64748b;">Produce Subtotal:</td><td style="text-align: right; font-weight: 600;">' + formattedSubtotal + '</td></tr>' +
                '<tr><td style="color: #64748b;">Logistics &amp; Transport:</td><td style="text-align: right; font-weight: 600;">' + formattedLogistics + '</td></tr>' +
                '<tr><td style="color: #64748b;">Platform Escrow Fee:</td><td style="text-align: right; font-weight: 600;">' + formattedFee + '</td></tr>' +
                '<tr class="grand-row"><td>Gross Total:</td><td style="text-align: right;">' + formattedTotal + '</td></tr>' +
                '</table>' +
                '<div class="footer">' +
                '<div><p style="margin: 0;"><strong>Direct Agricultural Marketplace Document</strong></p>' +
                '<p style="margin: 3px 0 0 0;">Generated electronically via AgriAI Direct Farm Management Platform.</p></div>' +
                '<div class="stamp">✓ ESCROW VERIFIED</div>' +
                '</div></div>' +
                '<script>' +
                'window.onload = function() { setTimeout(function() { window.print(); }, 300); };' +
                '<\/script></body></html>';

            printWindow.document.open();
            printWindow.document.write(invoiceHtml);
            printWindow.document.close();
        }

        // Live countdown timer for 3-Hour Review Window
        let farmerRemSec = parseInt(document.getElementById('farmerReviewCountdown')?.getAttribute('data-remaining') || '0', 10);
        if (farmerRemSec > 0) {
            const farmerTimerInterval = setInterval(function () {
                const timerEl = document.getElementById('farmerReviewCountdown');
                if (!timerEl) return;
                if (farmerRemSec <= 0) {
                    clearInterval(farmerTimerInterval);
                    timerEl.textContent = "🔒 Locked for Dispatch";
                    setTimeout(() => { location.reload(); }, 2000);
                    return;
                }
                const h = Math.floor(farmerRemSec / 3600);
                const m = Math.floor((farmerRemSec % 3600) / 60);
                const s = farmerRemSec % 60;
                timerEl.textContent = "⏳ " + h.toString().padStart(2, '0') + "h " + m.toString().padStart(2, '0') + "m " + s.toString().padStart(2, '0') + "s Review Window";
                farmerRemSec--;
            }, 1000);
        }
    </script>
}
