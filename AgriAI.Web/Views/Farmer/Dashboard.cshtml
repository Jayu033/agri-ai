                                            var bPhone = bUser?.PhoneNumber ?? "";
                                            var bName = $"{bUser?.FirstName} {bUser?.LastName}".Trim();
                                            if (string.IsNullOrEmpty(bName)) bName = "Customer";
                                            var firstCrop = order.OrderItems.FirstOrDefault()?.Product?.Name ?? "ખેતી પાક";
                                            var firstCropQty = order.OrderItems.FirstOrDefault()?.Quantity ?? 1;
                                        }
                                        @if (order.PaymentMethod != "Cash on Delivery")
                                        {
                                            <div class="mx-3 mb-3 p-3 rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-2.5 shadow-xs" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1.5px solid #86efac !important;">
