                                                        <i class="bi bi-check-circle-fill me-1"></i>Delivered &amp; Settled 🟢
                                                    </span>
                                                }
                                                else if (order.Status == "Declined")
                                                {
                                                    <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Declined
                                                    </span>
                                                }
                                                else if (order.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-slash-circle me-1"></i>Cancelled
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border fw-bold px-3 py-1.5 rounded-pill">
                                                        @order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
