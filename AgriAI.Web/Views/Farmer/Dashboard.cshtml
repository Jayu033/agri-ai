@model IEnumerable<AgriAI.Domain.Entities.Product>

@{
    ViewData["Title"] = "Farmer Dashboard";
    var userName = User.Identity?.Name ?? "Farmer";
    var userInitial = userName.Substring(0, 1).ToUpper();
    var productCount = Model?.Count() ?? 0;
    var incomingOrders = ViewBag.Orders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    decimal totalSales = ViewBag.TotalSales != null ? (decimal)ViewBag.TotalSales : incomingOrders.Sum(o => o.TotalAmount);
    int pendingOrdersCount = ViewBag.PendingOrdersCount != null ? (int)ViewBag.PendingOrdersCount : incomingOrders.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (Farmer Portal) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- Farmer Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge" style="background: #f0fdf4; color: #15803d; border-color: #86efac;">
                            <i class="bi bi-patch-check-fill me-1"></i>Verified Producer / Farmer
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons -->
                    <div class="dash-nav-pills">
                        <button type="button" class="dash-tab-link active" onclick="switchDashTab('farmerOverviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Overview</span>
                        </button>
                        
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerProductsTab', this)">
                            <i class="bi bi-tree"></i>
                            <span>My Listed Produce</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerOrdersTab', this)">
                            <i class="bi bi-receipt"></i>
                            <span>Manage Customer Orders</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('aiPredictorTab', this)">
                            <i class="bi bi-stars"></i>
                            <span>AI Price Predictor</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerProfileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Farm &amp; Profile Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    <!-- TAB 1: Dashboard Overview -->
                    <div id="farmerOverviewTab" class="dash-tab-panel active">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farmer Command Center 🌾</h3>
                                <p class="text-muted small mb-0">Track your farm sales, manage listed crop produce, and monitor APMC market demand.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> + List New Crop Harvest
                            </a>
                        </div>

                        <!-- 4 Summary Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-tree-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@productCount</div>
                                        <div class="dash-metric-label">Active Listed Crops</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@totalSales.ToString("N2")</div>
                                        <div class="dash-metric-label">Total Farm Revenue</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-inbox-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@pendingOrdersCount</div>
                                        <div class="dash-metric-label">Pending Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">APMC Live</div>
                                        <div class="dash-metric-label">Market Intelligence</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Shortcuts & Farm Status -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bag-check text-success me-2"></i>Incoming Produce Orders</h5>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-bold px-2.5 py-1 rounded-pill">0 New Inquiries</span>
                                        </div>
                                        <div class="p-4 bg-white rounded-3 border text-center my-2">
                                            <i class="bi bi-inbox text-muted fs-2 d-block mb-2 opacity-50"></i>
                                            <p class="text-muted small mb-0">No pending buyer orders right now. List fresh produce with high resolution pictures to get direct buyer inquiries.</p>
                                        </div>
                                    </div>
                                    <div class="pt-2">
                                        <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success fw-bold rounded-pill px-4">
                                            <i class="bi bi-plus-lg me-1"></i> Add Produce for Sale
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Smart Farming</span>
                                        <h6 class="fw-bold text-dark mb-1">AI Crop Price Forecasting</h6>
                                        <p class="text-muted small mb-3">Check accurate mandi modal rate forecasts for Gujarat crops (Cotton, Groundnut, Wheat, Jeera, Mustard).</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold w-100" onclick="switchDashTab('aiPredictorTab', document.querySelectorAll('.dash-tab-link')[3])">
                                        <i class="bi bi-stars me-1"></i> Open AI Predictor Tool
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: My Listed Produce -->
                    <div id="farmerProductsTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Listed Farm Crops &amp; Produce</h3>
                                <p class="text-muted small mb-0">Manage your farm stock, update prices per quintal/kg, and publish new harvests.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> + Add New Product
                            </a>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="row g-3 mb-3">
                                @foreach (var item in Model)
                                {
                                    var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
                                    <div class="col-md-6 col-xl-4">
                                        <div class="card h-100 bg-white shadow-sm rounded-4 border overflow-hidden">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(imgUrl))
                                                {
                                                    <img src="@imgUrl" class="card-img-top" alt="@item.Name" style="height: 150px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                                                        <i class="bi bi-tree text-success fs-1"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success fw-bold px-2 py-1 shadow-sm" style="font-size: 0.7rem;">
                                                    Active Listing
                                                </span>
                                            </div>

                                            <div class="card-body d-flex flex-column p-3">
                                                <small class="text-success fw-bold text-uppercase mb-1" style="font-size: 0.70rem;">
                                                    @(item.Category?.Name ?? "Farm Crop")
                                                </small>
                                                <h6 class="card-title fw-bold text-dark mb-1">@item.Name</h6>
                                                <p class="card-text text-muted small mb-3 flex-grow-1" style="font-size: 0.78rem;">
                                                    @(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                                </p>
                                                
                                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                                    <span class="fw-bold text-success fs-6">₹@item.Price.ToString("N2")</span>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-outline-success rounded-pill px-3 fw-bold">
                                                        View Details
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-tree display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">You haven't listed any farm crops yet.</h5>
                                <p class="text-muted small mb-3">Add your first harvest to sell directly to verified retail buyers and wholesalers across Gujarat.</p>
                                <a asp-controller="Product" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                                    <i class="bi bi-plus-circle me-1"></i> Add Your First Crop Produce
                                </a>
                            </div>
                        }
                    </div>

                    <!-- TAB 3: Manage Customer Orders -->
                    <div id="farmerOrdersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Customer Orders &amp; Direct Buyer Contact</h3>
                                <p class="text-muted small mb-0">View incoming purchase requests, customer contact details, and arrange direct farm pickup/dispatch.</p>
                            </div>
                        </div>

                        @if (incomingOrders.Any())
                        {
                            var customerUsers = ViewBag.CustomerUsers as Dictionary<string, AgriAI.Infrastructure.Identity.ApplicationUser> ?? new Dictionary<string, AgriAI.Infrastructure.Identity.ApplicationUser>();

                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in incomingOrders)
                                {
                                    var buyer = customerUsers.ContainsKey(order.CustomerId) ? customerUsers[order.CustomerId] : null;
                                    var buyerName = buyer != null 
                                        ? (!string.IsNullOrEmpty(buyer.FirstName) || !string.IsNullOrEmpty(buyer.LastName) 
                                            ? $"{buyer.FirstName} {buyer.LastName}".Trim() 
                                            : buyer.UserName) 
                                        : (!string.IsNullOrEmpty(order.CustomerId) && order.CustomerId.Length < 20 ? order.CustomerId : "Retail Customer");
                                    var buyerPhone = buyer?.PhoneNumber ?? "+91 97245 60047";
                                    var buyerEmail = buyer?.Email ?? "customer@agriai.com";
                                    var buyerInitial = !string.IsNullOrEmpty(buyerName) ? buyerName.Substring(0, 1).ToUpper() : "C";
                                    var farmerCollapseId = "farmerOrder_" + order.Id;

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        
                                        <!-- Card Header: Order ID, Date, Status -->
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order #@order.Id.ToString("D5")
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                                </span>
                                            </div>
                                            <div>
                                                @if (order.Status == "Pending" || order.Status == "Awaiting Cash on Pickup")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-clock-history me-1"></i>@order.Status
                                                    </span>
                                                }
                                                else if (order.Status.Contains("Delivered") || order.Status.Contains("Settled"))
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Delivered &amp; Settled 🟢
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-box-seam me-1"></i>@order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Card Body: Clean Produce Summary -->
                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 55px; height: 55px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <span class="badge bg-light text-success border small mb-1">@(item.Product?.Category?.Name ?? "Grains")</span>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Ordered: <strong>@item.Quantity unit(s)</strong> @@ ₹@item.UnitPrice.ToString("N2")</small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Collapsible Drawer: Buyer Contact & Structured OTP Form -->
                                        <div class="collapse border-top bg-light bg-opacity-50" id="@farmerCollapseId">
                                            <div class="p-3.5">
                                                <div class="row g-3">
                                                    
                                                    <!-- Left: Customer Details & Contact Actions -->
                                                    <div class="col-lg-6">
                                                        <div class="p-3 bg-white rounded-3 border h-100">
                                                            <h6 class="fw-bold text-dark mb-2.5 small"><i class="bi bi-person-circle text-success me-1"></i> Customer / Buyer Profile</h6>
                                                            
                                                            <div class="d-flex align-items-center gap-2.5 mb-3">
                                                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                                                    @buyerInitial
                                                                </div>
                                                                <div>
                                                                    <strong class="text-dark d-block">@buyerName</strong>
                                                                    <span class="text-muted small d-block">
                                                                        <i class="bi bi-telephone text-success me-1"></i>@buyerPhone &bull; <i class="bi bi-envelope text-primary me-1"></i>@buyerEmail
                                                                    </span>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex gap-2">
                                                                <a href="tel:@buyerPhone" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold" title="Call Customer">
                                                                    <i class="bi bi-telephone-fill me-1"></i> Call Buyer
                                                                </a>
                                                                <a href="https://wa.me/@(buyerPhone.Replace("+","").Replace(" ",""))?text=Hello%20@buyerName,%20regarding%20your%20AgriAI%20order%20#@order.Id:D5%20for%20crop%20produce..." target="_blank" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #25D366; border-color: #25D366;">
                                                                    <i class="bi bi-whatsapp me-1"></i> WhatsApp
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Right: Delivery Verification / OTP Form -->
                                                    <div class="col-lg-6">
                                                        <div class="p-3 bg-white rounded-3 border h-100">
                                                            <h6 class="fw-bold text-dark mb-2.5 small"><i class="bi bi-shield-check text-success me-1"></i> Delivery &amp; Settlement Verification</h6>

                                                            @if (order.PaymentMethod == "Cash on Delivery")
                                                            {
                                                                if (order.Status != "Cash Received & Delivered")
                                                                {
                                                                    <div class="p-2.5 bg-warning bg-opacity-10 rounded-3 border border-warning border-opacity-25 mb-2">
                                                                        <strong class="small text-dark d-block mb-1">Cash on Delivery Pending</strong>
                                                                        <span class="small text-muted d-block mb-2">Collect cash directly from the customer upon handing over the produce.</span>
                                                                        
                                                                        <form asp-controller="Farmer" asp-action="UpdateOrderStatus" method="post" class="m-0">
                                                                            <input type="hidden" name="orderId" value="@order.Id" />
                                                                            <input type="hidden" name="status" value="Cash Received & Delivered" />
                                                                            <button type="submit" class="btn btn-sm btn-warning text-dark rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                                                                <i class="bi bi-cash-stack me-1"></i> Mark Cash Received (₹@order.TotalAmount.ToString("N2"))
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-success p-2.5 rounded-3 mb-0 small">
                                                                        <i class="bi bi-check-circle-fill me-1"></i> <strong>Cash Received &amp; Order Fulfilled</strong>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (!order.Status.Contains("Delivered") && !order.Status.Contains("Settled"))
                                                                {
                                                                    <form asp-controller="Farmer" asp-action="VerifyDeliveryOtp" method="post" class="m-0">
                                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                                        <label class="form-label small fw-bold text-dark mb-1">Enter Customer's 4-Digit Delivery OTP:</label>
                                                                        <div class="input-group mb-1.5" style="max-width: 320px;">
                                                                            <input type="text" name="enteredOtp" placeholder="e.g. 4859" maxlength="4" class="form-control text-center fw-bold fs-5 shadow-none bg-light" style="letter-spacing: 4px;" required />
                                                                            <button type="submit" class="btn btn-success fw-bold px-3">
                                                                                <i class="bi bi-shield-check me-1"></i> Verify OTP
                                                                            </button>
                                                                        </div>
                                                                        <small class="text-muted d-block" style="font-size: 0.76rem;">Ask the customer for their confidential 4-digit OTP shown in their app.</small>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-success p-2.5 rounded-3 mb-0 small">
                                                                        <i class="bi bi-shield-fill-check me-1"></i> <strong>OTP Verified &amp; Payment Credited to Farmer</strong>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card Footer: Payment Badge, Revenue & Action Buttons -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1"></i>@(order.PaymentMethod ?? "Online")</span>
                                                <span class="badge bg-light text-dark border"><i class="bi bi-truck me-1"></i>@(order.TransportType ?? "Direct Farm Pickup")</span>
                                                <span class="text-muted small ms-1">Gross Revenue:</span>
                                                <span class="fw-extrabold text-success fs-5">₹@order.TotalAmount.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                @if (order.Status == "Pending")
                                                {
                                                    <form asp-controller="Farmer" asp-action="UpdateOrderStatus" method="post" class="d-inline m-0">
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Ready for Pickup" />
                                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold">
                                                            <i class="bi bi-box-seam me-1"></i> Mark Ready for Pickup
                                                        </button>
                                                    </form>
                                                }

                                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold" data-bs-toggle="collapse" data-bs-target="#@farmerCollapseId" aria-expanded="false">
                                                    <i class="bi bi-person-lines-fill me-1"></i> Buyer Details &amp; OTP
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-receipt display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Customer Orders Received Yet</h5>
                                <p class="text-muted small mb-4">When retail buyers order your farm produce, the customer contact details, quantity, and payment confirmation will appear here.</p>
                                <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold" onclick="switchDashTab('farmerProductsTab', document.querySelectorAll('.dash-tab-link')[1])">
                                    <i class="bi bi-tree me-1"></i> Manage Listed Produce
                                </button>
                            </div>
                        }
                    </div>

                    <!-- TAB 4: AI Price Predictor Tool -->
                    <div id="aiPredictorTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">AI Price Predictor &amp; Analysis</h3>
                                <p class="text-muted small mb-0">Get AI-driven price intelligence before selling your harvest at APMC markets.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="AI" asp-action="CropPredictor" class="btn btn-sm btn-outline-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm">
                                    <i class="bi bi-cpu me-1"></i> AI Crop Predictor
                                </a>
                                <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-sm btn-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> Dedicated AI Studio
                                </a>
                            </div>
                        </div>

                        <!-- Featured: AgriAI Crop Predictor Banner Card -->
                        <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 text-white" style="background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);">
                            <div class="row align-items-center g-3">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-cpu-fill me-1"></i>MACHINE LEARNING
                                        </span>
                                        <span class="text-white-50 small">Soil &amp; Weather Engine</span>
                                    </div>
                                    <h4 class="fw-bold text-white mb-1">AgriAI Crop Predictor</h4>
                                    <p class="text-white-50 small mb-0">
                                        Input your soil NPK, temperature, humidity, and pH to get high-accuracy crop recommendations for maximum yield.
                                    </p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <a asp-controller="AI" asp-action="CropPredictor" class="btn btn-warning rounded-pill px-4 py-2.5 fw-bold shadow">
                                        <i class="bi bi-stars me-1"></i> Open Crop Predictor
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-3">
                            <div class="col-lg-6">
                                <div class="p-4 bg-light rounded-4 border h-100">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-calculator text-success me-2"></i>Maund ⇄ Quintal Quick Converter</h6>
                                    <p class="text-muted small mb-3">Calculate exact ₹/Maund (20 Kg) rates directly from Quintal (100 Kg) APMC modal rates.</p>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark">Price per Quintal (₹/100 Kg)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white">₹</span>
                                            <input type="number" id="farmerQuickQuintal" class="form-control bg-white shadow-none" value="6500" oninput="calculateFarmerMaund()" />
                                        </div>
                                    </div>

                                    <div class="p-3 bg-white rounded-3 border text-center">
                                        <span class="text-muted small d-block mb-1">Calculated 1 Maund (20 Kg) Price</span>
                                        <span class="fs-4 fw-extrabold text-success" id="farmerQuickMaundResult">₹ 1,300.00 / મણ</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="p-4 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Market Alert</span>
                                        <h6 class="fw-bold text-dark mb-1">Top Gaining Gujarat APMC Crops</h6>
                                        <p class="text-muted small mb-3">Cotton (+6.8% in Rajkot APMC) and Cumin (+8.4% in Unjha APMC) are experiencing high buyer demand today.</p>
                                    </div>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                                        <i class="bi bi-graph-up me-1"></i> Explore All APMC Live Rates →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 5: Farmer Profile Settings -->
                    <div id="farmerProfileTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farm &amp; Producer Settings</h3>
                                <p class="text-muted small mb-0">Update your farming location, producer credentials, and login security.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Farmer Producer Account</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="@userName" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Primary Farm Region</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="Gujarat, India" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Classification</label>
                                    <input type="text" class="form-control bg-white shadow-none text-success fw-bold" value="Verified Agricultural Producer" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Credentials</label>
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-success fw-bold rounded-pill w-100">
                                        <i class="bi bi-shield-lock me-1"></i> Edit Password &amp; Personal Info
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDashTab(tabId, btn) {
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }

        function calculateFarmerMaund() {
            const quintalVal = parseFloat(document.getElementById('farmerQuickQuintal').value) || 0;
            const maundVal = (quintalVal / 5).toFixed(2);
            document.getElementById('farmerQuickMaundResult').textContent = `₹ ${maundVal} / મણ`;
        }
    </script>
}
