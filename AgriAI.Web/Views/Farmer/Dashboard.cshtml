                                                </div>
                                                <div class="bg-white bg-opacity-10 rounded-3 px-3 py-1.5 border border-white border-opacity-25">
                                                    <small class="text-white-50 d-block" style="font-size: 0.70rem;">Per Kilogram (1 Kg)</small>
                                                    <strong class="text-white fs-6" id="dashResultKg">₹ 25.65</strong>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-5 text-md-end">
                                            <div class="bg-dark bg-opacity-25 rounded-4 p-3 border border-white border-opacity-25 text-start">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="text-white-50 small">Govt. MSP Benchmark:</span>
                                                    <strong class="text-white small" id="dashResultMsp">₹ 2,425.00</strong>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-white-50 small">Expected Margin:</span>
                                                    <span class="badge bg-success text-white fw-bold" id="dashResultMargin">+₹ 140.00 / Qtl</span>
                                                </div>
                                                <div class="small fw-semibold text-warning" id="dashResultTrend">Bullish (Above MSP) 📈</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- AI Recommendation Text -->
                                    <div class="bg-white bg-opacity-10 rounded-3 p-2.5 border border-white border-opacity-25 d-flex align-items-start gap-2">
                                        <i class="bi bi-lightbulb-fill text-warning fs-5 mt-0.5"></i>
                                        <div>
                                            <strong class="text-white small d-block">Producer Selling Advisory:</strong>
                                            <span class="text-white-50 small" id="dashResultAdvice">Favorable market rates. Optimal time for direct listing on AgriAI Marketplace.</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons After Prediction -->
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="/Product/Create" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" id="dashBtnListCrop" style="background-color: #006653;">
                                        <i class="bi bi-plus-circle-fill me-1"></i> List This Crop on Marketplace
                                    </a>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-outline-success rounded-pill px-3.5 py-2 fw-bold">
                                        <i class="bi bi-graph-up me-1"></i> View Live Gujarat APMC Mandi Rates
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Additional Tools: Quick Converter & ML Soil Recommendation -->
                        <div class="row g-4 mb-3">
                            <div class="col-lg-6">
                                <div class="p-4 bg-light rounded-4 border h-100">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-calculator text-success me-2"></i>Maund ⇄ Quintal Quick Converter</h6>
                                    <p class="text-muted small mb-3">Calculate exact ₹/Maund (20 Kg) rates directly from Quintal (100 Kg) APMC modal rates.</p>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark">Price per Quintal (₹/100 Kg)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white">₹</span>
                                            <input type="number" id="farmerQuickQuintal" class="form-control bg-white shadow-none" value="6500" oninput="calculateFarmerMaund()" />
                                        </div>
                                    </div>

                                    <div class="p-3 bg-white rounded-3 border text-center">
                                        <span class="text-muted small d-block mb-1">Calculated 1 Maund (20 Kg / ૧ મણ) Price</span>
                                        <span class="fs-4 fw-extrabold text-success" id="farmerQuickMaundResult">₹ 1,300.00 / Maund</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card border-0 rounded-4 shadow-sm p-4 text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);">
                                    <div>
                                        <span class="badge bg-warning text-dark fw-bold mb-2">Soil &amp; Weather Engine</span>
                                        <h5 class="fw-bold text-white mb-1">AgriAI Crop Recommendation</h5>
                                        <p class="text-white-50 small mb-3">Input your soil NPK, temperature, and pH to get high-accuracy crop recommendations for maximum harvest yield.</p>
                                    </div>
                                    <a asp-controller="AI" asp-action="CropPredictor" class="btn btn-warning rounded-pill px-4 py-2.5 fw-bold shadow">
                                        <i class="bi bi-stars me-1"></i> Open AI Crop Predictor →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 6: Completed Orders (Fulfilled Orders)  -->
                    <!-- ========================================== -->
                    <div id="farmerCompletedOrdersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Completed Orders &amp; Past Sales 📋</h3>
                                <p class="text-muted small mb-0">Record of all fulfilled, delivered and completed orders.</p>
                            </div>
                        </div>

                        @if (completedOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in completedOrders)
                                {
                                    var buyer = customerUsers.ContainsKey(order.CustomerId) ? customerUsers[order.CustomerId] : null;
                                    var buyerName = buyer != null 
                                        ? (!string.IsNullOrEmpty(buyer.FirstName) || !string.IsNullOrEmpty(buyer.LastName) 
                                            ? $"{buyer.FirstName} {buyer.LastName}".Trim() 
                                            : buyer.UserName) 
                                        : (!string.IsNullOrEmpty(order.CustomerId) && order.CustomerId.Length < 20 ? order.CustomerId : "Retail Customer");

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-secondary bg-opacity-10 text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order #@order.Id.ToString("D5")
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-check me-1"></i>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                                </span>
                                            </div>
                                            <div>
                                                @if (order.Status.Contains("Delivered") || order.Status.Contains("Settled") || order.Status == "Completed" || order.Status == "Cash Received & Delivered")
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Delivered &amp; Settled 🟢
                                                    </span>
                                                }
                                                else if (order.Status == "Declined")
                                                {
                                                    <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Declined
                                                    </span>
                                                }
                                                else if (order.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-slash-circle me-1"></i>Cancelled
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border fw-bold px-3 py-1.5 rounded-pill">
                                                        @order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 50px; height: 50px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Quantity: <strong>@item.Quantity Kg</strong> @@ ₹@item.UnitPrice.ToString("N2")/Kg &bull; Buyer: <strong class="text-dark">@buyerName</strong></small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <small class="text-muted">Payment: <strong>@(order.PaymentMethod ?? "Online")</strong> &bull; Transport: <strong>@(order.TransportType ?? "Direct Farm Pickup")</strong></small>
                                            <div class="d-flex align-items-center gap-2">
                                                @{
                                                    var compOrdFarmerEarning = order.OrderItems.Where(oi => myProductIds.Contains(oi.ProductId)).Sum(oi => oi.UnitPrice * oi.Quantity);
                                                }
                                                <strong class="text-success fs-6 me-2">Farmer Net Payout: ₹@compOrdFarmerEarning.ToString("N2")</strong>
                                                <a asp-controller="Farmer" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 fw-bold small">
                                                    <i class="bi bi-eye me-1"></i> View Order Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-check2-all display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Completed Orders Yet</h5>
                                <p class="text-muted small mb-4">When orders are fulfilled and delivery OTP is verified, they will be archived here in your permanent sales record.</p>
                            </div>
                        }
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 7: Settings (Profile Settings)         -->
                    <!-- ========================================== -->
                    <div id="farmerProfileTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farm &amp; Producer Settings ⚙️</h3>
                                <p class="text-muted small mb-0">Update your farming location, producer credentials, and login security.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Farmer Producer Account</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="@userName" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Primary Farm Region</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="Gujarat, India" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Classification</label>
                                    <input type="text" class="form-control bg-white shadow-none text-success fw-bold" value="Verified Agricultural Producer" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Credentials</label>
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-success fw-bold rounded-pill w-100">
                                        <i class="bi bi-shield-lock me-1"></i> Edit Password &amp; Personal Info
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDashTab(tabId, btn) {
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }

        function calculateFarmerMaund() {
            const quintalVal = parseFloat(document.getElementById('farmerQuickQuintal').value) || 0;
            const maundVal = (quintalVal / 5).toFixed(2);
            document.getElementById('farmerQuickMaundResult').textContent = `₹ ${maundVal} / Maund`;
        }

        function toggleDeclineBox(orderId) {
            const box = document.getElementById('declineBox_' + orderId);
            if (box) {
                box.style.display = box.style.display === 'none' ? 'block' : 'none';
            }
        }

        // Live Countdown timer for review window on Farmer dashboard
        function updateFarmerCountdowns() {
            const timerElements = document.querySelectorAll('.farmer-order-timer');

            timerElements.forEach(el => {
                let rem = parseInt(el.getAttribute('data-remaining') || '0', 10);
                if (rem <= 0) {
                    el.textContent = "Locking for dispatch...";
                    return;
                }

                const hours = Math.floor(rem / 3600);
                const minutes = Math.floor((rem % 3600) / 60);
                const seconds = rem % 60;
                el.textContent = `⏳ ${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s review window`;
                rem--;
                el.setAttribute('data-remaining', rem);
            });
        }

        setInterval(updateFarmerCountdowns, 1000);

        // ========================================================
        // Farmer Dashboard AI Price Predictor Studio Handlers
        // ========================================================
        let currentDashCrop = 'Wheat';
        let currentDashEmoji = '🌾';

        function filterDashCrops(category, btn) {
            document.querySelectorAll('.dash-cat-filter').forEach(b => {
                b.classList.remove('btn-success', 'active');
                b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success', 'active');

            const items = document.querySelectorAll('.dash-crop-item');
            items.forEach(item => {
                if (category === 'all' || item.getAttribute('data-cat') === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function selectDashCrop(cropName, emoji, el) {
            currentDashCrop = cropName;
            currentDashEmoji = emoji;

            document.querySelectorAll('.dash-crop-card').forEach(c => {
                c.classList.remove('active');
                c.style.borderWidth = '1px';
                c.style.borderColor = '#e2e8f0';
                c.style.backgroundColor = '#ffffff';
            });

            const card = el.querySelector('.dash-crop-card');
            if (card) {
                card.classList.add('active');
                card.style.borderWidth = '2px';
                card.style.borderColor = '#006653';
                card.style.backgroundColor = '#f0fdf4';
            }

            document.getElementById('dashSelectedCropName').textContent = cropName;
            document.getElementById('dashSelectedCropEmoji').textContent = emoji;
        }

        async function runFarmerPricePrediction() {
            const btn = document.getElementById('btnRunFarmerPrediction');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<div class="spinner-border spinner-border-sm text-white me-2" role="status"></div> Calculating ML Forecast...`;

            const season = document.getElementById('dashPredSeason').value || 'Rabi';
            const rainfall = parseFloat(document.getElementById('dashRainfallSlider').value) || 450;
            const area = parseFloat(document.getElementById('dashAreaSlider').value) || 5;

            try {
                const response = await fetch('/AI/ApiPredictPrice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cropName: currentDashCrop,
                        season: season,
                        rainfall: rainfall,
                        area: area
                    })
                });

                const data = await response.json();
                if (data && data.success) {
                    const resultBox = document.getElementById('dashPredictionResultBox');
                    resultBox.classList.remove('d-none');

                    document.getElementById('dashResultConfidence').textContent = `ML Confidence: ${data.confidence || '95%'}`;
                    document.getElementById('dashResultQuintal').textContent = `₹ ${Number(data.predictedPriceQuintal).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    document.getElementById('dashResultMaund').textContent = `₹ ${Number(data.predictedPrice20Kg).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    document.getElementById('dashResultKg').textContent = `₹ ${Number(data.predictedPriceKg).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                    document.getElementById('dashResultMsp').textContent = `₹ ${Number(data.msp).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

                    const marginElem = document.getElementById('dashResultMargin');
                    if (data.isAboveMsp) {
                        marginElem.className = 'badge bg-success text-white fw-bold';
                        marginElem.textContent = `+₹ ${Number(data.diffFromMsp).toLocaleString('en-IN', { minimumFractionDigits: 2 })} / Qtl`;
                    } else {
                        marginElem.className = 'badge bg-warning text-dark fw-bold';
                        marginElem.textContent = `-₹ ${Math.abs(data.diffFromMsp).toLocaleString('en-IN', { minimumFractionDigits: 2 })} / Qtl`;
                    }

                    document.getElementById('dashResultTrend').textContent = data.trend || 'Bullish 📈';
                    document.getElementById('dashResultAdvice').textContent = data.recommendation || 'Favorable market conditions.';

                    const listBtn = document.getElementById('dashBtnListCrop');
                    if (listBtn) {
                        listBtn.href = `/Product/Create?name=${encodeURIComponent(currentDashCrop)}&price=${data.predictedPriceKg}`;
                        listBtn.innerHTML = `<i class="bi bi-plus-circle-fill me-1"></i> List ${currentDashCrop} at ₹${data.predictedPriceKg}/Kg`;
                    }

                    resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    alert(data.message || 'Unable to calculate prediction at this time.');
                }
            } catch (err) {
                console.error('Prediction API Error:', err);
                alert('Network error while connecting to AI Engine.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    </script>
}
