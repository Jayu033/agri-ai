@model IEnumerable<AgriAI.Domain.Entities.Product>

@{
    ViewData["Title"] = "Farmer Dashboard";
    var userName = User.Identity?.Name ?? "Farmer";
    var userInitial = userName.Substring(0, 1).ToUpper();
    var productCount = Model?.Count() ?? 0;
    var incomingOrders = ViewBag.Orders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    var customerUsers = ViewBag.CustomerUsers as Dictionary<string, AgriAI.Infrastructure.Identity.ApplicationUser> ?? new Dictionary<string, AgriAI.Infrastructure.Identity.ApplicationUser>();
    
    var activeOrders = incomingOrders
        .Where(o => o.Status == "Requested" || o.Status == "Accepted" || o.Status == "Ready for Pickup" || o.Status == "In Transit")
        .ToList();

    var completedOrders = incomingOrders
        .Where(o => o.Status.Contains("Delivered") || o.Status.Contains("Settled") || o.Status == "Completed" || o.Status == "Cash Received & Delivered" || o.Status == "Declined" || o.Status == "Cancelled")
        .ToList();

    var myProductIds = Model?.Select(p => p.Id).ToList() ?? new List<int>();

    decimal settledIncome = completedOrders
        .Where(o => !o.Status.Contains("Declined") && !o.Status.Contains("Cancelled"))
        .SelectMany(o => o.OrderItems)
        .Where(oi => myProductIds.Contains(oi.ProductId))
        .Sum(oi => oi.UnitPrice * oi.Quantity);

    decimal pendingEscrowIncome = activeOrders
        .SelectMany(o => o.OrderItems)
        .Where(oi => myProductIds.Contains(oi.ProductId))
        .Sum(oi => oi.UnitPrice * oi.Quantity);

    decimal totalSales = settledIncome + pendingEscrowIncome;
    int totalKgSold = completedOrders
        .Where(o => !o.Status.Contains("Declined") && !o.Status.Contains("Cancelled"))
        .SelectMany(o => o.OrderItems)
        .Where(oi => myProductIds.Contains(oi.ProductId))
        .Sum(oi => oi.Quantity);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (Farmer Portal) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- Farmer Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge" style="background: #f0fdf4; color: #15803d; border-color: #86efac;">
                            <i class="bi bi-patch-check-fill me-1"></i>Verified Producer / Farmer
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons (Exact 7 Requested Tabs) -->
                    <div class="dash-nav-pills">
                        <!-- 1. Dashboard Overview -->
                        <button type="button" class="dash-tab-link active" onclick="switchDashTab('farmerOverviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Overview</span>
                        </button>
                        
                        <!-- 2. My Listed Products -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerProductsTab', this)">
                            <i class="bi bi-tree"></i>
                            <span>My Listed Products</span>
                            <span class="badge bg-light text-success border ms-auto fw-bold">@productCount</span>
                        </button>

                        <!-- 3. Customer Orders -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerOrdersTab', this)">
                            <i class="bi bi-box-seam"></i>
                            <span>Customer Orders</span>
                            @if (activeOrders.Count > 0)
                            {
                                <span class="badge bg-warning text-dark ms-auto fw-bold">@activeOrders.Count</span>
                            }
                        </button>

                        <!-- 4. Income -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerIncomeTab', this)">
                            <i class="bi bi-wallet2"></i>
                            <span>Income</span>
                        </button>

                        <!-- 5. AI Price Predictor -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('aiPredictorTab', this)">
                            <i class="bi bi-stars"></i>
                            <span>AI Price Predictor</span>
                        </button>

                        <!-- 6. Completed Orders -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerCompletedOrdersTab', this)">
                            <i class="bi bi-check2-all"></i>
                            <span>Completed Orders</span>
                            @if (completedOrders.Count > 0)
                            {
                                <span class="badge bg-success text-white ms-auto fw-bold">@completedOrders.Count</span>
                            }
                        </button>

                        <!-- 7. Settings -->
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('farmerProfileTab', this)">
                            <i class="bi bi-gear"></i>
                            <span>Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    <!-- ========================================== -->
                    <!-- TAB 1: Dashboard Overview                  -->
                    <!-- ========================================== -->
                    <div id="farmerOverviewTab" class="dash-tab-panel active">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farmer Command Center 🌾</h3>
                                <p class="text-muted small mb-0">Track your farm sales, manage listed crop produce, and monitor APMC market demand.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> + List New Crop Harvest
                            </a>
                        </div>

                        <!-- 4 Summary Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-tree-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@productCount</div>
                                        <div class="dash-metric-label">Active Listed Crops</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@totalSales.ToString("N2")</div>
                                        <div class="dash-metric-label">Total Farm Revenue</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-inbox-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@activeOrders.Count</div>
                                        <div class="dash-metric-label">Active Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">APMC Live</div>
                                        <div class="dash-metric-label">Market Intelligence</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Shortcuts & Farm Status -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bag-check text-success me-2"></i>Active Customer Orders</h5>
                                            <span class="badge @(activeOrders.Any() ? "bg-warning text-dark" : "bg-secondary bg-opacity-10 text-secondary") fw-bold px-2.5 py-1 rounded-pill">
                                                @activeOrders.Count Ongoing
                                            </span>
                                        </div>
                                        @if (activeOrders.Any())
                                        {
                                            var nextOrder = activeOrders.First();
                                            <div class="p-3 bg-white rounded-3 border my-2">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <strong class="text-dark">Order #@nextOrder.Id.ToString("D5")</strong>
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">@nextOrder.Status</span>
                                                </div>
                                                <small class="text-muted d-block">Ordered @nextOrder.OrderDate.ToString("dd MMM yyyy, hh:mm tt") &bull; ₹@nextOrder.TotalAmount.ToString("N2")</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-4 bg-white rounded-3 border text-center my-2">
                                                <i class="bi bi-inbox text-muted fs-2 d-block mb-2 opacity-50"></i>
                                                <p class="text-muted small mb-0">No pending buyer orders right now. List fresh produce with high resolution pictures to get direct buyer inquiries.</p>
                                            </div>
                                        }
                                    </div>
                                    <div class="pt-2 d-flex gap-2">
                                        <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success fw-bold rounded-pill px-4">
                                            <i class="bi bi-plus-lg me-1"></i> Add Produce for Sale
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill px-3" onclick="switchDashTab('farmerOrdersTab', document.querySelectorAll('.dash-tab-link')[2])">
                                            View Orders →
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Smart Farming</span>
                                        <h6 class="fw-bold text-dark mb-1">AI Crop Price Forecasting</h6>
                                        <p class="text-muted small mb-3">Check accurate mandi modal rate forecasts for Gujarat crops (Cotton, Groundnut, Wheat, Jeera, Mustard).</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold w-100" onclick="switchDashTab('aiPredictorTab', document.querySelectorAll('.dash-tab-link')[4])">
                                        <i class="bi bi-stars me-1"></i> Open AI Predictor Tool
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 2: My Listed Products                  -->
                    <!-- ========================================== -->
                    <div id="farmerProductsTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Listed Farm Crops &amp; Produce</h3>
                                <p class="text-muted small mb-0">Manage your farm stock, update prices per kg, and publish new harvests.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> + Add New Product
                            </a>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="row g-3 mb-3">
                                @foreach (var item in Model)
                                {
                                    var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
                                    <div class="col-md-6 col-xl-4">
                                        <div class="card h-100 bg-white shadow-sm rounded-4 border overflow-hidden">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(imgUrl))
                                                {
                                                    <img src="@imgUrl" class="card-img-top" alt="@item.Name" style="height: 150px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                                                        <i class="bi bi-tree text-success fs-1"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success fw-bold px-2 py-1 shadow-sm" style="font-size: 0.7rem;">
                                                    Active Listing
                                                </span>
                                            </div>

                                            <div class="card-body d-flex flex-column p-3">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <small class="text-success fw-bold text-uppercase" style="font-size: 0.70rem;">
                                                        @(item.Category?.Name ?? "Farm Crop")
                                                    </small>
                                                    <span class="badge bg-light text-dark border small fw-bold" style="font-size: 0.70rem;">
                                                        Stock: @item.StockQuantity Kg
                                                    </span>
                                                </div>
                                                <h6 class="card-title fw-bold text-dark mb-1">@item.Name</h6>
                                                <p class="card-text text-muted small mb-3 flex-grow-1" style="font-size: 0.78rem;">
                                                    @(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                                </p>
                                                
                                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                                    <div>
                                                        <span class="fw-bold text-success fs-6">₹@item.Price.ToString("N2")</span>
                                                        <small class="text-muted">/ Kg</small>
                                                    </div>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-outline-success rounded-pill px-3 fw-bold">
                                                        View Details
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-tree display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">You haven't listed any farm crops yet.</h5>
                                <p class="text-muted small mb-3">Add your first harvest to sell directly to verified retail buyers and wholesalers across Gujarat.</p>
                                <a asp-controller="Product" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                                    <i class="bi bi-plus-circle me-1"></i> Add Your First Crop Produce
                                </a>
                            </div>
                        }
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 3: Customer Orders (Active Orders)     -->
                    <!-- ========================================== -->
                    <div id="farmerOrdersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Active Customer Orders &amp; Dispatch 🚚</h3>
                                <p class="text-muted small mb-0">Manage incoming buyer purchase requests, prepare harvest, upload Bilty, and verify OTP.</p>
                            </div>
                        </div>

                        @if (activeOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in activeOrders)
                                {
                                    var buyer = customerUsers.ContainsKey(order.CustomerId) ? customerUsers[order.CustomerId] : null;
                                    var buyerName = buyer != null 
                                        ? (!string.IsNullOrEmpty(buyer.FirstName) || !string.IsNullOrEmpty(buyer.LastName) 
                                            ? $"{buyer.FirstName} {buyer.LastName}".Trim() 
                                            : buyer.UserName) 
                                        : (!string.IsNullOrEmpty(order.CustomerId) && order.CustomerId.Length < 20 ? order.CustomerId : "Retail Customer");
                                    var buyerPhone = buyer?.PhoneNumber ?? "+91 97245 60047";
                                    var buyerEmail = buyer?.Email ?? "customer@agriai.com";
                                    var buyerInitial = !string.IsNullOrEmpty(buyerName) ? buyerName.Substring(0, 1).ToUpper() : "C";
                                    var farmerCollapseId = "farmerOrder_" + order.Id;

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        
                                        <!-- Card Header: Order ID, Date, Status -->
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order #@order.Id.ToString("D5")
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                                </span>
                                            </div>
                                            <div>
                                                @if (order.Status == "Requested")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-hourglass-top me-1"></i>New Order Request ⏳
                                                    </span>
                                                }
                                                else if (order.Status == "Accepted")
                                                {
                                                    <span class="badge bg-info text-dark fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-clock-history me-1"></i>Accepted
                                                    </span>
                                                }
                                                else if (order.Status == "Ready for Pickup")
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Ready for Pickup 🟢
                                                    </span>
                                                }
                                                else if (order.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-truck me-1"></i>In Transit
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-box-seam me-1"></i>@order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Card Body: Produce Items Summary -->
                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 55px; height: 55px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <span class="badge bg-light text-success border small mb-1">@(item.Product?.Category?.Name ?? "Grains")</span>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Ordered: <strong>@item.Quantity Kg</strong> @@ ₹@item.UnitPrice.ToString("N2")/Kg</small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Footer: Payment Badge, Revenue & Dedicated View More Details Button -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1"></i>@(order.PaymentMethod ?? "Online")</span>
                                                <span class="badge bg-light text-dark border"><i class="bi bi-truck me-1"></i>@(order.TransportType ?? "Direct Farm Pickup")</span>
                                                <span class="text-muted small ms-1">Farmer Earning:</span>
                                                @{
                                                    var activeOrdFarmerEarning = order.OrderItems.Where(oi => myProductIds.Contains(oi.ProductId)).Sum(oi => oi.UnitPrice * oi.Quantity);
                                                }
                                                <span class="fw-extrabold text-success fs-5">₹@activeOrdFarmerEarning.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <a asp-controller="Farmer" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                                    <i class="bi bi-eye-fill me-1"></i> View More Details &amp; Actions
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-receipt display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Active Customer Orders Currently</h5>
                                <p class="text-muted small mb-4">When retail buyers order your farm produce, the customer contact details, quantity, and payment confirmation will appear here.</p>
                                <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold" onclick="switchDashTab('farmerProductsTab', document.querySelectorAll('.dash-tab-link')[1])">
                                    <i class="bi bi-tree me-1"></i> Manage Listed Produce
                                </button>
                            </div>
                        }
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 4: Income (Financial Summary)          -->
                    <!-- ========================================== -->
                    <div id="farmerIncomeTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farm Income &amp; Payout Statement 💰</h3>
                                <p class="text-muted small mb-0">Overview of completed earnings, escrow settlements, and financial ledger.</p>
                            </div>
                        </div>

                        <!-- 3 Income Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold text-uppercase">Settled Earnings</span>
                                        <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill fs-5"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-extrabold text-success mb-1">₹@settledIncome.ToString("N2")</h3>
                                    <small class="text-muted">Transferred &amp; Released via Escrow</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="text-muted small fw-bold text-uppercase">In Escrow (Pending)</span>
                                        <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-hourglass-split fs-5"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-extrabold text-dark mb-1">₹@pendingEscrowIncome.ToString("N2")</h3>
                                    <small class="text-muted">Held safe until OTP verification</small>
                                </div>
                            </div>
                            <div class="col-md-4">
