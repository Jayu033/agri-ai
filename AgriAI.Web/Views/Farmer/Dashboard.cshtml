                                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0 shadow-xs" style="width: 38px; height: 38px; background-color: #dcfce7; border: 1px solid #86efac; color: #16a34a;">
                                                        <i class="bi bi-shield-fill-check fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <strong class="text-success small">₹@activeOrdFarmerEarning.ToString("N2") Funded &amp; Locked in AgriAI Escrow Vault</strong>
