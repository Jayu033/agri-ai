                                                        </button>
                                                        <span class="fw-bold px-2 small">@cItem.Quantity Kg</span>
                                                        <button type="button" class="btn btn-xs btn-link text-dark p-0 px-1 border-0 text-decoration-none" onclick="updateFarmerCartQty(@cItem.ProductId, @(cItem.Quantity + 1))">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                    <strong class="text-success fs-6" style="min-width: 80px; text-align: right;">₹@((cItem.UnitPrice * cItem.Quantity).ToString("N2"))</strong>
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Remove crop" onclick="removeFarmerCartItem(@cItem.ProductId, '@(cItem.ProductName.Replace("'", "\\'"))')">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div class="text-muted small">
                                            Platform Escrow Fee: <strong class="text-dark">₹@cartSummary.PlatformFee.ToString("N2")</strong> &bull; 100% Razorpay Protected
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="fs-5 fw-extrabold text-success">Total: ₹@cartSummary.GrandTotal.ToString("N2")</span>
                                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                                <i class="bi bi-credit-card me-1"></i> Checkout Now
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="bi bi-cart-x display-5 text-muted opacity-50 d-block mb-2"></i>
                                        <h6 class="fw-bold text-dark mb-1">Your Shopping Cart is Empty</h6>
                                        <p class="text-muted small mb-3">Looking to buy quality seeds, bulk grains, or fresh harvests directly from other Gujarat farmers?</p>
                                        <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-4 py-2 fw-bold">
                                            <i class="bi bi-shop me-1"></i> Explore Other Farmers' Produce
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. Purchased Orders List -->
                        <div class="dash-section-header mb-3">
                            <div>
                                <h4 class="dash-section-title fs-5 mb-0">Purchased Crop Orders from Other Farmers</h4>
                                <small class="text-muted">Track your incoming harvest shipments and verify delivery OTP upon receiving.</small>
                            </div>
                        </div>

                        @if (purchasedOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var pOrder in purchasedOrders)
                                {
                                    var firstProd = pOrder.OrderItems.FirstOrDefault()?.Product;
                                    var sellerFarmerId = firstProd?.FarmerId;
                                    var sellerUser = !string.IsNullOrEmpty(sellerFarmerId) && sellerUsers.ContainsKey(sellerFarmerId) ? sellerUsers[sellerFarmerId] : null;
                                    var sellerName = sellerUser != null ? $"{sellerUser.FirstName} {sellerUser.LastName}".Trim() : "Gujarat Farmer";
                                    if (string.IsNullOrEmpty(sellerName)) sellerName = sellerUser?.UserName ?? "Gujarat Farmer";
                                    var sellerPhone = sellerUser?.PhoneNumber ?? "";

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        <!-- Card Header: Order ID, Date, Status -->
                                        <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order #@pOrder.Id.ToString("D5")
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@pOrder.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                                </span>
                                            </div>
                                            <div>
                                                @if (pOrder.Status == "Requested" || pOrder.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-hourglass-top me-1"></i>Order Placed ⏳
                                                    </span>
                                                }
                                                else if (pOrder.Status == "Ready for Pickup")
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Ready for Pickup 🟢
                                                    </span>
                                                }
                                                else if (pOrder.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-truck me-1"></i>In Transit 🚚
                                                    </span>
                                                }
                                                else if (pOrder.Status.Contains("Delivered") || pOrder.Status.Contains("Settled") || pOrder.Status == "Completed")
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-check2-all me-1"></i>Delivered &amp; Settled 🟢
                                                    </span>
                                                }
                                                else if (pOrder.Status == "Declined" || pOrder.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i>@pOrder.Status (Refunded)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        @pOrder.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Card Body: Produce Items Summary -->
                                        <div class="card-body p-3">
                                            @foreach (var item in pOrder.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-xs" alt="@(item.Product?.Name ?? "Produce")" style="width: 55px; height: 55px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <span class="badge bg-light text-success border small mb-1">@(item.Product?.Category?.Name ?? "Produce")</span>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Quantity: <strong>@item.Quantity Kg</strong> @@ ₹@item.UnitPrice.ToString("N2")/Kg &bull; Seller Farmer: <strong class="text-dark">@sellerName</strong></small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Escrow Status Box (Exact Same Standardized Styling) -->
                                        @if (pOrder.PaymentMethod != "Cash on Delivery")
                                        {
                                            <div class="mx-3 mb-3 p-3 rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-2.5 shadow-xs" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1.5px solid #86efac !important;">
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0 shadow-xs" style="width: 38px; height: 38px; background-color: #dcfce7; border: 1px solid #86efac; color: #16a34a;">
                                                        <i class="bi bi-shield-fill-check fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <strong class="text-success small">₹@pOrder.TotalAmount.ToString("N2") Secured in AgriAI Escrow Vault</strong>
                                                            <span class="badge rounded-pill fw-bold" style="background-color: #dcfce7; color: #15803d; font-size: 0.70rem; border: 1px solid #86efac; padding: 2px 7px;">
                                                                100% Escrow Protected
                                                            </span>
                                                        </div>
                                                        <span class="text-muted small d-block" style="font-size: 0.80rem; line-height: 1.35; margin-top: 2px;">
                                                            Your payment is safely locked in the Escrow vault. Funds will only be released to farmer @sellerName after you receive and inspect the harvest.
                                                        </span>
                                                    </div>
                                                </div>
                                                @if (pOrder.Payment != null && !string.IsNullOrEmpty(pOrder.Payment.RazorpayPaymentId))
                                                {
                                                    <div class="d-flex align-items-center ms-auto ms-md-0">
                                                        <span class="badge bg-white text-dark border font-monospace shadow-xs px-2.5 py-1.5 rounded-pill d-inline-flex align-items-center gap-1.5" style="font-size: 0.75rem; border-color: #86efac !important;">
                                                            <i class="bi bi-credit-card-2-front-fill text-success"></i>
                                                            <span>RZP: @pOrder.Payment.RazorpayPaymentId</span>
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Card Footer: Logistics, Total & View Details Action -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-truck me-1"></i>@(pOrder.TransportType ?? "Direct Farm Pickup")</span>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-bold">
                                                    @(pOrder.PaymentMethod ?? "Online Escrow")
                                                </span>
                                                <span class="text-muted small ms-1">Total Paid:</span>
                                                <span class="fw-extrabold text-success fs-5">₹@pOrder.TotalAmount.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <a href="/Customer/OrderDetails/@pOrder.Id?from=farmer" class="btn btn-sm btn-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                                    <i class="bi bi-eye-fill me-1"></i> View Order Details &amp; Handover
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-bag display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Crop Purchases Yet</h5>
                                <p class="text-muted small mb-4">You have not ordered any produce from other farmers yet. You can source seeds, grains, and harvests directly with 100% Escrow security.</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                    <i class="bi bi-shop me-1"></i> Browse Gujarat Farm Produce
                                </a>
                            </div>
                        }
                    </div>


                    <!-- ========================================== -->
                    <!-- TAB 6: Settings (Profile Settings)         -->
                    <!-- ========================================== -->
                    <div id="farmerProfileTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farm &amp; Producer Settings ⚙️</h3>
                                <p class="text-muted small mb-0">Update your farming location, producer credentials, and login security.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Farmer Producer Account</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="@userName" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Primary Farm Region</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="Gujarat, India" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Classification</label>
                                    <input type="text" class="form-control bg-white shadow-none text-success fw-bold" value="Verified Agricultural Producer" readonly />
                                </div>
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Account Credentials</label>
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-success fw-bold rounded-pill w-100">
                                        <i class="bi bi-shield-lock me-1"></i> Edit Password &amp; Personal Info
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Beautiful Custom Farmer Cart Action Confirmation Modal -->
<div class="modal fade" id="farmerCartConfirmModal" tabindex="-1" aria-labelledby="farmerCartConfirmModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;">
            <div class="modal-body p-4 text-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm" style="width: 68px; height: 68px; background: #fee2e2; color: #ef4444;">
                    <i class="bi bi-trash3-fill fs-2"></i>
                </div>
                
                <h5 class="fw-extrabold text-dark mb-2 fs-5">Remove Crop from Cart?</h5>
                <p class="text-muted small mb-4 px-3" id="farmerCartConfirmModalMessage" style="line-height: 1.5;">
                    Are you sure you want to remove this crop from your cart?
                </p>

                <div class="d-flex align-items-center justify-content-center gap-2 pt-1">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold text-secondary border shadow-none flex-grow-1" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" id="farmerCartConfirmActionBtn" onclick="confirmFarmerCartModalAction()" class="btn btn-danger rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 flex-grow-1" style="background-color: #dc2626; border-color: #dc2626;">
                        <i class="bi bi-trash3-fill"></i> <span>Remove</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDashTab(tabId, btn) {
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }

            // Immediately clear any query parameters from address bar so refresh always reloads default dashboard
            try {
                if (window.location.search) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            } catch (e) { }
        }

        function calculateFarmerMaund() {
            const quintalVal = parseFloat(document.getElementById('farmerQuickQuintal').value) || 0;
            const maundVal = (quintalVal / 5).toFixed(2);
            document.getElementById('farmerQuickMaundResult').textContent = `₹ ${maundVal} / Maund`;
        }

        function toggleDeclineBox(orderId) {
            const box = document.getElementById('declineBox_' + orderId);
            if (box) {
                box.style.display = box.style.display === 'none' ? 'block' : 'none';
            }
        }

        // Live Countdown timer for review window on Farmer dashboard
        function updateFarmerCountdowns() {
            const timerElements = document.querySelectorAll('.farmer-order-timer');

            timerElements.forEach(el => {
                let rem = parseInt(el.getAttribute('data-remaining') || '0', 10);
                if (rem <= 0) {
                    el.textContent = "Locking for dispatch...";
                    return;
                }

                const hours = Math.floor(rem / 3600);
                const minutes = Math.floor((rem % 3600) / 60);
                const seconds = rem % 60;
                el.textContent = `⏳ ${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s review window`;
                rem--;
                el.setAttribute('data-remaining', rem);
            });
        }

        setInterval(updateFarmerCountdowns, 1000);

        // Auto-activate tab from URL query once (?tab=farmerPurchasesTab), then clear address bar immediately
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const tab = params.get('tab');
            if (tab && tab !== 'farmerOverviewTab') {
                const btn = document.querySelector(`[onclick*="${tab}"]`);
                if (btn) {
                    switchDashTab(tab, btn);
                }
            }
            // Clear URL search params immediately so subsequent browser refreshes (F5) load the normal Dashboard Overview
            try {
                if (window.location.search) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            } catch (e) { }
        });

        function updateFarmerCartQty(productId, qty) {
            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${productId}&quantity=${qty}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Farmer/Dashboard?tab=farmerPurchasesTab';
                }
            });
        }

        let farmerCartConfirmModalInstance = null;
        let farmerCartPendingProductId = null;

        function removeFarmerCartItem(productId, cropName) {
            farmerCartPendingProductId = productId;
            const msgEl = document.getElementById('farmerCartConfirmModalMessage');
            if (msgEl) {
                const name = cropName ? `"${cropName}"` : 'this crop';
                msgEl.textContent = `Are you sure you want to remove ${name} from your cart?`;
            }

            const modalEl = document.getElementById('farmerCartConfirmModal');
            if (!farmerCartConfirmModalInstance && modalEl) {
                farmerCartConfirmModalInstance = new bootstrap.Modal(modalEl);
            }
            if (farmerCartConfirmModalInstance) {
                farmerCartConfirmModalInstance.show();
            } else {
                confirmFarmerCartModalAction();
            }
        }

        function confirmFarmerCartModalAction() {
            if (farmerCartConfirmModalInstance) {
                farmerCartConfirmModalInstance.hide();
            }
            if (!farmerCartPendingProductId) return;

            fetch('/Cart/RemoveItem', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${farmerCartPendingProductId}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Farmer/Dashboard?tab=farmerPurchasesTab';
                }
            });
        }
    </script>
}
