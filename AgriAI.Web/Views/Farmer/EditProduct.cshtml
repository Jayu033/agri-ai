@model AgriAI.Domain.Entities.Product

@{
    ViewData["Title"] = "Edit Harvest Produce - " + Model.Name;
    var currentImg = Model.Images?.FirstOrDefault()?.ImageUrl;
}

<div class="py-4 my-2">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1240px;">
        
        <!-- Header & Breadcrumbs Navigation -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Farmer" asp-action="Dashboard" class="text-success text-decoration-none">Farmer Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit Produce (@Model.Name)</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="fw-extrabold text-dark mb-0">Edit Harvest Produce Listing</h2>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25 rounded-pill px-3 py-1.5 small">
                        <i class="bi bi-patch-check-fill me-1"></i>Active Producer Listing
                    </span>
                </div>
            </div>
            <div>
                <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <div class="row g-4">
            
            <!-- Left Column: Main Produce Edit Form (8 Columns) -->
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 border p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
                        <h4 class="fw-bold text-dark mb-0">Update Crop &amp; Pricing Information</h4>
                        <span class="text-muted small">* Required fields</span>
                    </div>

                    <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FarmerId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3"></div>
                        
                        <!-- Name & Category -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold text-dark small mb-1.5">Product / Crop Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-tag-fill"></i></span>
                                    <input asp-for="Name" class="form-control border-start-0 px-2.5 py-2 shadow-none" placeholder="e.g. Organic Saurashtra Groundnut" required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold text-dark small mb-1.5">Produce Category *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-grid-fill"></i></span>
                                    <select asp-for="CategoryId" class="form-select border-start-0 px-2.5 py-2 shadow-none" asp-items="ViewBag.CategoryId" required>
                                        <option value="">-- Select Category --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        
                        <!-- Price & Quantity -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold text-dark small mb-1.5">Direct Selling Price (₹ / Kg) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0 fw-bold">₹</span>
                                    <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control border-start-0 border-end-0 px-2.5 py-2 shadow-none" placeholder="e.g. 62.00" required />
                                    <span class="input-group-text bg-light text-dark fw-bold border-start-0">/ Kg</span>
                                </div>
                                <small class="text-muted d-block mt-1">Set your farm selling rate per Kilogram (Kg).</small>
                                <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label fw-bold text-dark small mb-1.5">Available Stock Quantity (in Kg) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-box-seam-fill"></i></span>
                                    <input asp-for="StockQuantity" type="number" min="0" class="form-control border-start-0 border-end-0 px-2.5 py-2 shadow-none" placeholder="e.g. 500" required />
                                    <span class="input-group-text bg-light text-dark fw-bold border-start-0">Kg</span>
                                </div>
                                <small class="text-muted d-block mt-1">Update available stock in Kilograms (Kg).</small>
                                <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-dark small mb-1.5">Harvest Description &amp; Origin Details</label>
                            <textarea asp-for="Description" class="form-control px-3 py-2.5 shadow-none" rows="3" placeholder="Describe harvest quality, moisture, organic certification, farm region (e.g. Gondal, Rajkot)..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Produce Photo Upload Area -->
                        <div class="mb-4 p-4 rounded-4 border bg-light bg-opacity-50">
                            <label class="form-label fw-bold text-success d-flex align-items-center gap-2 mb-1.5 fs-6">
                                <i class="bi bi-camera-fill"></i> Crop Harvest Photo
                            </label>
                            <p class="text-muted small mb-3">Upload a new photo to replace the current crop listing image (leave blank to keep current photo).</p>
                            
                            <div class="p-3 bg-white rounded-3 border">
                                @if (!string.IsNullOrEmpty(currentImg))
                                {
                                    <div class="mb-3 d-flex align-items-center gap-3 p-2.5 bg-light rounded-3 border">
                                        <img src="@currentImg" alt="@Model.Name" class="rounded-3 shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                                        <div>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold small">Current Active Photo</span>
                                            <small class="text-muted d-block mt-1">Upload a new file below only if you wish to change this photo.</small>
                                        </div>
                                    </div>
                                }

                                <input type="file" name="imageFile" id="imageFileInput" class="form-control shadow-none" accept="image/*" />
                                <small class="text-muted d-block mt-1.5">Supported formats: JPG, JPEG, PNG, WEBP (Max 5MB)</small>
                                
                                <div id="imagePreviewContainer" class="mt-3 d-none text-center p-3 bg-light rounded-3 border">
                                    <span class="text-muted small d-block mb-2">New Photo Preview:</span>
                                    <img id="imagePreview" src="#" alt="New Image Preview" class="img-thumbnail rounded-3 shadow-sm" style="max-height: 180px; object-fit: cover;" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Form Submission Actions -->
                        <div class="d-flex flex-wrap gap-3 pt-3 border-top justify-content-end">
                            <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-bold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-5 py-2.5 fw-bold shadow" style="background-color: #006653; border-color: #006653;">
                                <i class="bi bi-check2-circle me-1.5 fs-6"></i> Save Produce Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Right Column: Helper & APMC Pricing Tips (4 Columns) -->
            <div class="col-lg-4">
                
                <!-- Pricing Guidelines Card -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3 text-success">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <h6 class="fw-bold mb-0 text-dark">Pricing Guidelines</h6>
                    </div>
                    <ul class="text-muted small ps-3 mb-0 d-flex flex-column gap-2" style="line-height: 1.5;">
                        <li>Check the <strong>Live Mandi Rates</strong> on AgriAI to set competitive APMC pricing.</li>
                        <li>Keep your stock quantity updated regularly so buyers don't experience stockouts.</li>
                        <li>1 Maund (મણ) = 20 Kilograms (Kg). Your per-Kg rate automatically converts for wholesale buyers.</li>
                    </ul>
                </div>

                <!-- Fast Sell Tips Card -->
                <div class="card border-0 shadow-sm rounded-4 text-white p-4" style="background: linear-gradient(135deg, #006653 0%, #047857 100%);">
                    <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                        <i class="bi bi-shield-check fs-5"></i>
                        <h6 class="fw-bold mb-0 text-white">Escrow Guaranteed</h6>
                    </div>
                    <p class="text-white-50 small mb-3">
                        Every order placed by customers is held safe in AgriAI Escrow. Once you dispatch or the buyer collects the harvest, payment releases instantly upon OTP verification.
                    </p>
                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-warning text-dark btn-sm rounded-pill fw-bold w-100 shadow-sm">
                        <i class="bi bi-graph-up me-1"></i> Check Live Mandi Rates
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imageFileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = document.getElementById('imagePreview');
                    img.src = event.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
