                            </div>
                        </div>
                        
                        <div class="accordion helpdesk-accordion" id="buyerFaqAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="bheadingOne">
                                    <button class="accordion-button collapsed shadow-none fw-bold small" type="button" data-bs-toggle="collapse" data-bs-target="#bcollapseOne">
                                        How does the 100% Escrow Protection work?
                                    </button>
                                </h2>
                                <div id="bcollapseOne" class="accordion-collapse collapse" data-bs-parent="#buyerFaqAccordion">
                                    <div class="accordion-body text-muted small">
                                        When you pay for an order, your money is securely deposited in our licensed Escrow Vault. The farmer is ONLY paid after you receive and inspect your harvest shipment.
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="bheadingTwo">
                                    <button class="accordion-button collapsed shadow-none fw-bold small" type="button" data-bs-toggle="collapse" data-bs-target="#bcollapseTwo">
                                        What if the crop quality is damaged or substandard?
                                    </button>
                                </h2>
                                <div id="bcollapseTwo" class="accordion-collapse collapse" data-bs-parent="#buyerFaqAccordion">
                                    <div class="accordion-body text-muted small">
                                        Upload clear photos of the damaged produce within 24 hours of delivery. Admin will hold the farmer payout and process a partial or full refund.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Care Card -->
                    <div class="helpdesk-helpline-card shadow-xs" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-color: #93c5fd;">
                        <div class="rounded-circle bg-white text-primary p-3 d-inline-flex shadow-xs mb-2">
                            <i class="bi bi-chat-dots-fill fs-3"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Buyer Care &amp; Support Desk</h6>
                        <p class="text-muted small mb-3">Email: support@agriai.gujarat.gov.in &bull; 24h Response</p>
                        <a href="mailto:support@agriai.com" class="btn btn-primary rounded-pill px-4 py-2 fw-bold text-white shadow-xs d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border: none;">
                            <i class="bi bi-envelope-fill"></i> Send Support Email
                        </a>
                    </div>
                </div>

            </div>

        </div>

        <!-- Customer Grievance Modal -->
        <div class="modal fade" id="customerGrievanceModal" tabindex="-1" aria-labelledby="custModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header bg-primary text-white p-4">
                        <div>
                            <h5 class="modal-title fw-bold" id="custModalLabel">🛒 Report Issue / Customer Ticket</h5>
                            <small class="text-white-50">Report damaged goods, shipment delay, or request refund</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form asp-action="CreateTicket" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="senderName" value="@(currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}".Trim() : User.Identity?.Name)" />
                        <input type="hidden" name="senderEmail" value="@(currentUser?.Email ?? User.Identity?.Name)" />
                        <input type="hidden" name="senderPhone" value="@currentUser?.PhoneNumber" />

                        <div class="modal-body p-4">
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark small mb-1">Issue Category <span class="text-danger">*</span></label>
                                    <select name="category" class="form-select rounded-3 py-2.5" required>
                                        <option value="Quality Issue">⚠️ Damaged / Substandard Quality</option>
                                        <option value="Delivery Delay">🚚 Shipment Delay / Tracking</option>
                                        <option value="Refund & Cancellation">💳 Refund / Cancellation Request</option>
                                        <option value="General">❓ General Inquiry</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark small mb-1">Related Order (If applicable)</label>
                                    <select name="orderId" class="form-select rounded-3 py-2.5">
                                        <option value="">-- Select Order --</option>
                                        @foreach (var ord in customerOrders)
                                        {
                                            <option value="@ord.Id">Order #@ord.Id.ToString("D5") (₹@ord.TotalAmount.ToString("N2")) - @ord.Status</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold text-dark small mb-1">Subject / Summary <span class="text-danger">*</span></label>
                                    <input type="text" name="subject" class="form-control rounded-3 py-2.5" placeholder="e.g. Received damaged crop packaging for Order #00015" required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-dark small mb-1">Priority</label>
                                    <select name="priority" class="form-select rounded-3 py-2.5">
                                        <option value="High">⚠️ High</option>
                                        <option value="Medium" selected>Standard</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1">Detailed Description <span class="text-danger">*</span></label>
                                <textarea name="message" class="form-control rounded-3 p-3" rows="4" placeholder="Explain what went wrong. For quality claims, specify damage percentage or weight shortage." required></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1">Attach Photo of Damaged Produce / Unboxing (Optional)</label>
                                <input type="file" name="attachmentFile" class="form-control rounded-3 py-2" accept="image/*,.pdf" />
                                <small class="text-muted">Supports JPG, PNG, PDF. Max 5MB.</small>
                            </div>

                        </div>

                        <div class="modal-footer bg-light border-top p-3 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border: none;">
                                <i class="bi bi-send-fill me-1"></i> Submit Ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- 4. GUEST / PUBLIC VISITOR HELPDESK & INQUIRY CENTER                     -->
