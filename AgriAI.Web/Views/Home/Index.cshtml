                                        if (commodity.toLowerCase().includes(key.toLowerCase())) {
                                            icon = ic;
                                            break;
                                        }
                                    }

                                    marqueeHtml += `
                                        <span class="ticker-chip">
                                            <span class="ticker-crop">${icon} ${commodity}</span>
                                            <span class="ticker-market">[${market} ${district}]</span>
                                            <span class="ticker-price">₹${Number(modalPrice).toLocaleString('en-IN')}/Qtl</span>
