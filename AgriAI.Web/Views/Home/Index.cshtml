        let currentSelectedYear = "2025-26";

        function switchBenchmarkYear(year, btn) {
            currentSelectedYear = year;
            document.querySelectorAll('.gov-year-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            
            const label = document.getElementById('activeBenchmarkYearLabel');
            if (label) label.innerText = year + (year === '2025-26' ? ' Season (Latest)' : ' Season');

            renderBenchmarkTable();
        }

        function renderBenchmarkTable() {
            const tableBody = document.getElementById('benchmarkTableBody');
            if (!tableBody) return;

            const data = historicalBenchmarkData[currentSelectedYear] || [];
            const searchVal = (document.getElementById('benchmarkTableSearch')?.value || '').toLowerCase().trim();
            const seasonVal = document.getElementById('benchmarkSeasonFilter')?.value || '';
            const groupVal = document.getElementById('benchmarkGroupFilter')?.value || '';

            const groupBadgeMap = {
                'Fibre Crops': 'bg-success-subtle text-success',
                'Oil Seeds': 'bg-warning-subtle text-warning-emphasis',
                'Pulses': 'bg-info-subtle text-info-emphasis',
                'Cereals': 'bg-primary-subtle text-primary'
            };

            let html = '';
            data.forEach(item => {
                const matchesSearch = !searchVal || item.crop.toLowerCase().includes(searchVal) || item.group.toLowerCase().includes(searchVal);
                const matchesSeason = !seasonVal || item.season === seasonVal;
                const matchesGroup = !groupVal || item.group === groupVal;

                if (matchesSearch && matchesSeason && matchesGroup) {
                    const badgeClass = groupBadgeMap[item.group] || 'bg-secondary-subtle text-secondary';
                    const diffMsp = ((item.price - item.msp) / item.msp) * 100;
                    
                    let diffBadge = '';
                    if (diffMsp > 0) {
                        diffBadge = `<span class="msp-diff-badge msp-diff-above">+${diffMsp.toFixed(1)}% vs MSP ▲</span>`;
                    } else {
                        diffBadge = `<span class="msp-diff-badge msp-diff-below">MSP Protected 🛡️</span>`;
                    }

                    html += `
                        <tr>
                            <td><span class="badge ${badgeClass}">${item.group}</span></td>
                            <td><strong>${item.crop}</strong></td>
                            <td>₹ ${item.msp.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                            <td><span class="badge bg-light text-dark border">${item.season}</span></td>
                            <td>
                                <span class="gov-price-val">₹ ${item.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                                ${diffBadge}
                            </td>
                            <td><span class="gov-arrival-val">${item.arrival.toLocaleString('en-IN', { minimumFractionDigits: 2 })} MT</span></td>
                            <td>
                                <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 small fw-bold" href="/AI/PricePredictor">
                                    Predict
                                </a>
                            </td>
                        </tr>
                    `;
                }
            });

            if (!html) {
                html = `<tr><td colspan="7" class="text-center py-4 text-muted">No benchmark records found matching the filters.</td></tr>`;
            }

            tableBody.innerHTML = html;
        }

        function filterBenchmarkTable() {
            renderBenchmarkTable();
        }

        // Initialize table on load
        renderBenchmarkTable();
