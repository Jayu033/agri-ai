@model IEnumerable<AgriAI.Domain.Entities.Product>

@{
    ViewData["Title"] = "National Agricultural Market & AI Price Intelligence Portal";
}

<div id="mainContent">
    <!-- 1. Hero Carousel Slider -->
    <div class="gov-hero-banner position-relative">
        <div class="gov-carousel-wrapper">
            <!-- SLIDE 1: Open Full-Height Wheat Image with Diagonal Cross Line Transition -->
            <div class="gov-carousel-slide active" id="heroSlide1">
                <!-- Diagonal Accent Divider Line -->
                <div class="slide-diagonal-accent-line"></div>
                <!-- Open Full-Bleed Angled Wheat Crop Image -->
                <div class="slide-diagonal-image-bg"></div>

                <div class="container slide-diagonal-container">
                    <!-- Left Side: Clean Typography & Action Buttons -->
                    <div class="slide-diagonal-text">
                        <div class="agriai-hero-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>Smart Agriculture &amp; AI Platform</span>
                        </div>

                        <h1 class="agriai-hero-title">
                            Empowering Farmers with AI Price Intelligence
                        </h1>

                        <p class="agriai-hero-desc">
                            Forecast accurate crop market prices across 24+ crops and connect directly with verified buyers at 0% middleman commission.
                        </p>

                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <a asp-controller="AI" asp-action="PricePredictor" class="btn-hero-primary">
                                <i class="bi bi-stars"></i>
                                <span>Run AI Price Predictor</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" class="btn-hero-outline">
                                <i class="bi bi-shop"></i>
                                <span>Shop Fresh Products</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SLIDE 2: Clean Agmarknet Style Grains Banner with Pure Transparent SVG AgriAI Flourish Logo -->
            <div class="gov-carousel-slide slide-grains-bg" id="heroSlide2">
                <div class="container">
                    <div class="slide-banner-brand-container">
                        <img src="~/images/agriai-banner-logo.svg" alt="AgriAI - Agricultural Marketing &amp; AI Information System" class="slide-banner-brand-img" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Slider Controls -->
        <div class="gov-slider-control-prev" id="btnPrevSlide" title="Previous Banner">
            <i class="bi bi-chevron-left"></i>
        </div>
        <div class="gov-slider-control-next" id="btnNextSlide" title="Next Banner">
            <i class="bi bi-chevron-right"></i>
        </div>

        <!-- Slider Indicator Dots -->
        <div class="gov-slider-indicators" id="sliderDotsContainer">
            <span class="gov-indicator-dot active" data-slide="0"></span>
            <span class="gov-indicator-dot" data-slide="1"></span>
        </div>
    </div>

    <!-- 2. Live Market Flash Ticker Bar -->
    <div class="gov-flash-ticker">
        <div class="container d-flex align-items-center">
            <a asp-controller="Home" asp-action="LiveMandi" class="gov-ticker-badge text-decoration-none text-white" title="Click to view full Live Gujarat Market Dashboard">
                <span class="ticker-pulse-dot"></span>
                <span>LIVE APMC MARKET</span>
                <i class="bi bi-chevron-right ms-1" style="font-size: 0.65rem;"></i>
            </a>
            <div class="gov-ticker-marquee">
                <marquee id="liveMandiMarqueeText" behavior="scroll" direction="left" scrollamount="6" onmouseover="this.stop();" onmouseout="this.start();">
                    <span class="ticker-chip"><span class="ticker-crop">🌾 Cotton (કપાસ)</span> <span class="ticker-market">[Rajkot APMC]</span> <span class="ticker-price">₹7,440/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🥜 Groundnut (મગફળી)</span> <span class="ticker-market">[Gondal APMC]</span> <span class="ticker-price">₹6,208/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🌾 Wheat (ઘઉં)</span> <span class="ticker-market">[Ahmedabad APMC]</span> <span class="ticker-price">₹2,565/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🌿 Cumin (જીરું)</span> <span class="ticker-market">[Unjha APMC]</span> <span class="ticker-price">₹28,500/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🌱 Sesamum (તલ)</span> <span class="ticker-market">[Amreli APMC]</span> <span class="ticker-price">₹11,546/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🌾 Mustard (રાઈ)</span> <span class="ticker-market">[Panthawada APMC]</span> <span class="ticker-price">₹5,055/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🍲 Tur (તુવેર)</span> <span class="ticker-market">[Surat APMC]</span> <span class="ticker-price">₹7,073/Qtl</span> <span class="ticker-live-tag">▲ Live</span></span>
                    <span class="ticker-chip"><span class="ticker-crop">🇮🇳 Govt. data.gov.in API</span> <span class="ticker-market">[Real-Time Connected]</span></span>
                </marquee>
            </div>
        </div>
    </div>

    <!-- 3. Smart Kisan Tools & Live Market Watch Hub -->
    <section class="kisan-tools-section">
        <div class="container">
            <div class="gov-section-heading mb-4">
                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1.5 rounded-pill mb-2">
                    <i class="bi bi-tools me-1"></i> Smart Farmer Utilities &amp; Live Markets
                </span>
                <h2 class="gov-section-title">Gujarat Kisan Calculator &amp; Market Watch</h2>
                <p class="gov-section-subtitle">Real-time Maund to Quintal Price Calculator and Live APMC Commodity Momentum</p>
            </div>

            <div class="row g-4 align-items-stretch">
                <!-- Left: 🧮 Maund ⇄ Quintal Calculator -->
                <div class="col-lg-6">
                    <div class="kisan-tool-card">
                        <div class="kisan-tool-header">
                            <div class="kisan-tool-title-box">
                                <div class="kisan-tool-icon bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-calculator-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">Maund ⇄ Quintal Calculator</h5>
                                    <small class="text-muted">1 Maund (મણ) = 20 Kg &nbsp;|&nbsp; 1 Quintal = 100 Kg (5 Maunds)</small>
                                </div>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold" style="font-size: 0.74rem;">
                                Instant Tool
                            </span>
                        </div>

                        <!-- Crop Quick Presets -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted mb-1.5">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Live Presets:
                            </label>
                            <div class="converter-preset-pills">
                                <button type="button" class="preset-chip-btn active" onclick="setPresetPrice(7440, this)">🌾 Cotton (₹1,488/maund)</button>
                                <button type="button" class="preset-chip-btn" onclick="setPresetPrice(6208, this)">🥜 Groundnut (₹1,241/maund)</button>
                                <button type="button" class="preset-chip-btn" onclick="setPresetPrice(28500, this)">🌿 Cumin (₹5,700/maund)</button>
                                <button type="button" class="preset-chip-btn" onclick="setPresetPrice(2565, this)">🌾 Wheat (₹513/maund)</button>
                                <button type="button" class="preset-chip-btn" onclick="setPresetPrice(5055, this)">🌾 Mustard (₹1,011/maund)</button>
                                <button type="button" class="preset-chip-btn" onclick="setPresetPrice(11546, this)">🌱 Sesamum (₹2,309/maund)</button>
                            </div>
                        </div>

                        <!-- Inputs -->
                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    Quintal (100 Kg) Rate (₹)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold text-success">₹</span>
                                    <input type="number" id="calcQuintalInput" class="form-control fw-bold shadow-none" value="7440" placeholder="e.g. 7440" oninput="convertFromQuintal(this.value)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    1 Maund (20 Kg) Rate (₹)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold text-primary">₹</span>
                                    <input type="number" id="calcMaundInput" class="form-control fw-bold shadow-none" value="1488" placeholder="e.g. 1488" oninput="convertFromMaund(this.value)" />
                                </div>
                            </div>
                        </div>

                        <!-- Converted Results Box -->
                        <div class="converter-result-grid">
                            <div class="converter-result-item">
                                <div class="converter-result-label">1 Maund (20 Kg)</div>
                                <div class="converter-result-val text-success" id="resMaund">₹1,488.00</div>
                            </div>
                            <div class="converter-result-item border-start border-end border-success border-opacity-25">
                                <div class="converter-result-label">1 Quintal (100 Kg)</div>
                                <div class="converter-result-val text-dark" id="resQuintal">₹7,440.00</div>
                            </div>
                            <div class="converter-result-item">
                                <div class="converter-result-label">1 Kg Rate</div>
                                <div class="converter-result-val text-primary" id="resKilo">₹74.40</div>
                            </div>
                        </div>

                        <div class="mt-3 text-muted small d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-info-circle me-1"></i>Formula: Quintal ÷ 5 = 1 Maund</span>
                            <a asp-controller="AI" asp-action="PricePredictor" class="text-success fw-bold text-decoration-none">
                                View AI Price Forecast →
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right: 📈 Today's Top Gaining Crops & APMC Momentum -->
                <div class="col-lg-6">
                    <div class="kisan-tool-card">
                        <div class="kisan-tool-header">
                            <div class="kisan-tool-title-box">
                                <div class="kisan-tool-icon bg-warning bg-opacity-10 text-warning">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">Today's Top Gaining Crops</h5>
                                    <small class="text-muted">Highest demand and price surge across Gujarat APMC mandis</small>
                                </div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.74rem;">
                                <span class="ticker-pulse-dot" style="background: #16a34a; width: 6px; height: 6px;"></span>
                                Live APMC Feeds
                            </span>
                        </div>

                        <!-- 4 Top Gaining Crop Rows -->
                        <a asp-controller="Home" asp-action="LiveMandi" class="gainer-crop-row">
                            <div class="gainer-crop-info">
                                <div class="gainer-crop-icon">🌿</div>
                                <div>
                                    <div class="gainer-crop-name">Cumin / Jeera (જીરું)</div>
                                    <div class="gainer-crop-market"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Unjha APMC (Mehsana)</div>
                                </div>
                            </div>
                            <div class="gainer-rate-box">
                                <div class="d-flex align-items-center justify-content-end gap-2 mb-0.5">
                                    <span class="gainer-modal-price">₹28,500 <small class="text-muted fw-normal" style="font-size: 0.7rem;">/Qtl</small></span>
                                    <span class="gainer-badge-pill"><i class="bi bi-caret-up-fill"></i> +12.4%</span>
                                </div>
                                <div class="gainer-maund-price">₹5,700 / Maund (20 Kg)</div>
                            </div>
                        </a>

                        <a asp-controller="Home" asp-action="LiveMandi" class="gainer-crop-row">
                            <div class="gainer-crop-info">
                                <div class="gainer-crop-icon">🌾</div>
                                <div>
                                    <div class="gainer-crop-name">Cotton (Shankar-6)</div>
                                    <div class="gainer-crop-market"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Rajkot APMC (Bedi Yard)</div>
                                </div>
                            </div>
                            <div class="gainer-rate-box">
                                <div class="d-flex align-items-center justify-content-end gap-2 mb-0.5">
                                    <span class="gainer-modal-price">₹7,440 <small class="text-muted fw-normal" style="font-size: 0.7rem;">/Qtl</small></span>
                                    <span class="gainer-badge-pill"><i class="bi bi-caret-up-fill"></i> +4.8%</span>
                                </div>
                                <div class="gainer-maund-price">₹1,488 / Maund (20 Kg)</div>
                            </div>
                        </a>

                        <a asp-controller="Home" asp-action="LiveMandi" class="gainer-crop-row">
                            <div class="gainer-crop-info">
                                <div class="gainer-crop-icon">🌱</div>
                                <div>
                                    <div class="gainer-crop-name">Sesamum (White Til)</div>
                                    <div class="gainer-crop-market"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Amreli APMC Yard</div>
                                </div>
                            </div>
                            <div class="gainer-rate-box">
                                <div class="d-flex align-items-center justify-content-end gap-2 mb-0.5">
                                    <span class="gainer-modal-price">₹11,546 <small class="text-muted fw-normal" style="font-size: 0.7rem;">/Qtl</small></span>
                                    <span class="gainer-badge-pill"><i class="bi bi-caret-up-fill"></i> +6.2%</span>
                                </div>
                                <div class="gainer-maund-price">₹2,309 / Maund (20 Kg)</div>
                            </div>
                        </a>

                        <a asp-controller="Home" asp-action="LiveMandi" class="gainer-crop-row">
                            <div class="gainer-crop-info">
                                <div class="gainer-crop-icon">🥜</div>
                                <div>
                                    <div class="gainer-crop-name">Groundnut (G-20 Bold)</div>
                                    <div class="gainer-crop-market"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Gondal APMC Yard</div>
                                </div>
                            </div>
                            <div class="gainer-rate-box">
                                <div class="d-flex align-items-center justify-content-end gap-2 mb-0.5">
                                    <span class="gainer-modal-price">₹6,208 <small class="text-muted fw-normal" style="font-size: 0.7rem;">/Qtl</small></span>
                                    <span class="gainer-badge-pill"><i class="bi bi-caret-up-fill"></i> +3.9%</span>
                                </div>
                                <div class="gainer-maund-price">₹1,241 / Maund (20 Kg)</div>
                            </div>
                        </a>

                        <!-- Action Footer -->
                        <div class="mt-auto pt-2 text-end">
                            <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3">
                                <i class="bi bi-table me-1"></i> View All 24+ Live Market Rates →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Official Multi-Year Gujarat APMC Market Benchmark Historical Report -->
    <div class="container my-5">
        <div class="gov-table-card">
            <!-- Header -->
            <div class="gov-table-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-bar-graph-fill fs-5 text-warning"></i>
                    <div>
                        <h4 class="gov-table-title">
                            Official Gujarat APMC Market Benchmark Report (<span id="activeBenchmarkYearLabel">2025-26 Season</span>)
                        </h4>
                        <small class="text-light opacity-75">Directorate of Marketing &amp; Inspection (DMI) &amp; Agmarknet Validated</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-sm btn-light fw-bold text-success rounded-pill px-3 shadow-sm">
                        <i class="bi bi-cpu-fill me-1"></i> Open AI Predictor
                    </a>
                </div>
            </div>

            <!-- Year Selector Tabs (2025-26, 2024-25, 2022-23, 2021-22) -->
            <div class="gov-year-tab-container">
                <span class="text-white-50 small fw-bold me-2"><i class="bi bi-calendar3 me-1"></i>Select Season Year:</span>
                <button type="button" class="gov-year-tab-btn active" onclick="switchBenchmarkYear('2025-26', this)">2025-26 (Latest)</button>
                <button type="button" class="gov-year-tab-btn" onclick="switchBenchmarkYear('2024-25', this)">2024-25</button>
                <button type="button" class="gov-year-tab-btn" onclick="switchBenchmarkYear('2022-23', this)">2022-23</button>
                <button type="button" class="gov-year-tab-btn" onclick="switchBenchmarkYear('2021-22', this)">2021-22</button>
            </div>

            <!-- Filter and Search toolbar inside table -->
            <div class="gov-table-filter-bar">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 8px; font-size: 0.8rem;"></i>
                    <input type="text" id="benchmarkTableSearch" class="form-control gov-table-search-input" placeholder="Search crop in this year..." oninput="filterBenchmarkTable()" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <select id="benchmarkSeasonFilter" class="form-select form-select-sm rounded-pill shadow-none" style="font-size: 0.8rem; width: 130px;" onchange="filterBenchmarkTable()">
                        <option value="">All Seasons</option>
                        <option value="Kharif">Kharif</option>
                        <option value="Rabi">Rabi</option>
                    </select>
                    <select id="benchmarkGroupFilter" class="form-select form-select-sm rounded-pill shadow-none" style="font-size: 0.8rem; width: 140px;" onchange="filterBenchmarkTable()">
                        <option value="">All Groups</option>
                        <option value="Fibre Crops">Fibre Crops</option>
                        <option value="Oil Seeds">Oil Seeds</option>
                        <option value="Pulses">Pulses</option>
                        <option value="Cereals">Cereals</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="gov-custom-table table table-hover mb-0" id="govBenchmarkTable">
                    <thead>
                        <tr>
                            <th>Commodity Group</th>
                            <th>Crop / Commodity</th>
                            <th>Govt. MSP (₹/Qtl)</th>
                            <th>Season</th>
                            <th>Market Modal Price (₹/Qtl)</th>
                            <th>Total Arrival (Metric Tonnes)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="benchmarkTableBody">
                        <!-- Rendered dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5. Featured Fresh Farm Produce Grid -->
    <div class="container mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Direct Farmer Produce Listings</h3>
                <p class="text-muted mb-0">Buy 100% verified, fresh organic harvests from local Gujarat farmers</p>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 fw-bold">
                Explore All Products <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model.Take(4))
                {
                    var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card bg-white">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(imgUrl))
                                {
                                    <img src="@imgUrl" class="card-img-top" alt="@item.Name" style="height: 190px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 190px;">
                                        <i class="bi bi-basket text-success display-4"></i>
                                    </div>
                                }
                                <span class="position-absolute top-0 end-0 m-3 badge bg-success fw-bold px-2.5 py-1.5 shadow-sm">
                                    Farm Fresh
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column p-3.5">
                                <small class="text-success fw-bold text-uppercase mb-1" style="font-size: 0.72rem;">
                                    @(item.Category?.Name ?? "Farm Produce")
                                </small>
                                <h6 class="card-title fw-bold text-dark mb-2">@item.Name</h6>
                                <p class="card-text text-muted small mb-3 flex-grow-1" style="font-size: 0.8rem;">
                                    @(item.Description != null && item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                </p>
                                
                                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                                    <div>
                                        <span class="fs-5 fw-extrabold text-success">₹@item.Price.ToString("F2")</span>
                                    </div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-success rounded-circle p-2 shadow-sm" title="View Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4 bg-white rounded-3 border">
                    <i class="bi bi-basket text-muted display-4 mb-2"></i>
                    <h6 class="text-muted fw-bold">No farm products listed currently.</h6>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-sm mt-2 fw-bold">Explore Marketplace</a>
                </div>
            }
        </div>
    </div>

    <!-- 6. National Krishi Statistics Counter Bar -->
    <div class="gov-stats-bar">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3">
                    <div class="gov-stat-item">
                        <div class="gov-stat-num">10,000+</div>
                        <div class="gov-stat-label">Verified Farmers</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gov-stat-item">
                        <div class="gov-stat-num">500+</div>
                        <div class="gov-stat-label">APMC Mandis Connected</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gov-stat-item">
                        <div class="gov-stat-num">₹26L Cr+</div>
                        <div class="gov-stat-label">MSP Procurements</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gov-stat-item">
                        <div class="gov-stat-num">98%</div>
                        <div class="gov-stat-label">AI Prediction Accuracy</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slides = document.querySelectorAll('.gov-carousel-slide');
            const dots = document.querySelectorAll('.gov-indicator-dot');
            const btnPrev = document.getElementById('btnPrevSlide');
            const btnNext = document.getElementById('btnNextSlide');
            let currentSlideIndex = 0;
            let slideInterval;

            function showSlide(index) {
                if (index >= slides.length) index = 0;
                if (index < 0) index = slides.length - 1;
                currentSlideIndex = index;

                slides.forEach((s, i) => {
                    s.classList.toggle('active', i === currentSlideIndex);
                });

                dots.forEach((d, i) => {
                    d.classList.toggle('active', i === currentSlideIndex);
                });
            }

            function nextSlide() {
                showSlide(currentSlideIndex + 1);
            }

            function prevSlide() {
                showSlide(currentSlideIndex - 1);
            }

            if (btnNext) {
                btnNext.addEventListener('click', function () {
                    nextSlide();
                    resetTimer();
                });
            }

            if (btnPrev) {
                btnPrev.addEventListener('click', function () {
                    prevSlide();
                    resetTimer();
                });
            }

            dots.forEach((dot, idx) => {
                dot.addEventListener('click', function () {
                    showSlide(idx);
                    resetTimer();
                });
            });

            function startTimer() {
                slideInterval = setInterval(nextSlide, 6000);
            }

            function resetTimer() {
                clearInterval(slideInterval);
                startTimer();
            }

            startTimer();

