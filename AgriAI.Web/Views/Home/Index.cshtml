                                    'મગ': '🟢',
                                    'Chana': '🌾',
                                    'ચણા': '🌾',
                                    'Urad': '⚫',
                                    'અડદ': '⚫',
                                    'Bajra': '🌾',
                                    'બાજરી': '🌾',
                                    'Jowar': '🌾',
                                    'જુવાર': '🌾',
                                    'Maize': '🌽',
                                    'મકાઈ': '🌽',
                                    'Soyabean': '🌱',
                                    'સોયાબીન': '🌱',
                                    'Garlic': '🧄',
                                    'લસણ': '🧄',
                                    'Onion': '🧅',
                                    'ડુંગળી': '🧅',
                                    'Chilli': '🌶️',
                                    'મરચાં': '🌶️',
                                    'Potato': '🥔',
                                    'બટાકા': '🥔',
                                    'Paddy': '🌾',
                                    'Rice': '🌾',
                                    'ડાંગર': '🌾',
                                    'Coriander': '🌿',
                                    'ધાણા': '🌿',
                                    'Fenugreek': '🌿',
                                    'મેથી': '🌿'
                                };

                                records.forEach(item => {
                                    const modalPrice = item.modal_Price || item.modalPrice || '0';
                                    const commodity = item.commodity || 'Crop';
                                    const market = item.market || 'APMC';
                                    const district = item.district ? `(${item.district})` : '';
                                    
                                    // Match icon
                                    let icon = '🌾';
                                    for (const [key, ic] of Object.entries(cropIcons)) {
                                        if (commodity.toLowerCase().includes(key.toLowerCase())) {
                                            icon = ic;
                                            break;
                                        }
                                    }

                                    marqueeHtml += `
                                        <span class="ticker-chip">
                                            <span class="ticker-crop">${icon} ${commodity}</span>
                                            <span class="ticker-market">[${market} ${district}]</span>
                                            <span class="ticker-price">₹${Number(modalPrice).toLocaleString('en-IN')}/Qtl</span>
                                            <span class="ticker-live-tag">▲ Live</span>
                                        </span>
                                    `;
                                });
                                marqueeHtml += `<span class="ticker-chip"><span class="ticker-crop">🇮🇳 data.gov.in Live API</span> <span class="ticker-market">[${records.length} Real-Time APMC Feeds Active]</span></span>`;
                                marquee.innerHTML = marqueeHtml;
                            }
                        }
                    }
                } catch (e) {
                    console.log("Live Mandi API active in background:", e);
                }
            }

            loadLiveGovMandiRates();
        });

        // 🧮 Kisan Maund ⇄ Quintal Calculator Functions
        function convertFromQuintal(val) {
            const qPrice = parseFloat(val) || 0;
            const mPrice = qPrice / 5;
            const kPrice = qPrice / 100;
            
            const maundInput = document.getElementById('calcMaundInput');
            if (maundInput && document.activeElement !== maundInput) {
                maundInput.value = mPrice ? mPrice.toFixed(2).replace(/\.00$/, '') : '';
            }
            document.getElementById('resMaund').innerText = '₹' + mPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('resQuintal').innerText = '₹' + qPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('resKilo').innerText = '₹' + kPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

