        // 🧮 Kisan Maund ⇄ Quintal Calculator Functions
        function convertFromQuintal(val) {
            const qPrice = parseFloat(val) || 0;
            const mPrice = qPrice / 5;
            const kPrice = qPrice / 100;
            
            const maundInput = document.getElementById('calcMaundInput');
            if (maundInput && document.activeElement !== maundInput) {
                maundInput.value = mPrice ? mPrice.toFixed(2).replace(/\.00$/, '') : '';
            }
            document.getElementById('resMaund').innerText = '₹' + mPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('resQuintal').innerText = '₹' + qPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('resKilo').innerText = '₹' + kPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

