        let currentSelectedYear = "2025-26";

        function renderBenchmarkRowHtml(item, groupBadgeMap) {
            const badgeClass = groupBadgeMap[item.group] || 'bg-secondary-subtle text-secondary';
            const diffMsp = ((item.price - item.msp) / item.msp) * 100;
            
            let diffBadge = '';
            if (diffMsp > 0) {
                diffBadge = `<span class="msp-diff-badge msp-diff-above">+${diffMsp.toFixed(1)}% vs MSP ▲</span>`;
            } else {
                diffBadge = `<span class="msp-diff-badge msp-diff-below">MSP Protected 🛡️</span>`;
            }

            return `
                <tr>
                    <td><span class="badge ${badgeClass}">${item.group}</span></td>
                    <td><strong>${item.crop}</strong></td>
                    <td>₹ ${item.msp.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td><span class="badge bg-light text-dark border">${item.season}</span></td>
                    <td>
                        <span class="gov-price-val">₹ ${item.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                        ${diffBadge}
                    </td>
                    <td><span class="gov-arrival-val">${item.arrival.toLocaleString('en-IN', { minimumFractionDigits: 2 })} MT</span></td>
                    <td>
                        <a class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 small fw-bold" href="/AI/PricePredictor">
                            Predict
                        </a>
                    </td>
                </tr>
            `;
        }

        function switchBenchmarkYear(year, btn) {
            currentSelectedYear = year;
            document.querySelectorAll('.gov-year-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            
            const previewLabel = document.getElementById('activeBenchmarkYearLabel');
            if (previewLabel) previewLabel.innerText = year + (year === '2025-26' ? ' Season' : ' Season');
            
            const modalLabel = document.getElementById('modalActiveBenchmarkYearLabel');
            if (modalLabel) modalLabel.innerText = year + (year === '2025-26' ? ' Season (Latest)' : ' Season');

            renderBenchmarkPreviewTable();
            renderBenchmarkModalTable();
        }

        function renderBenchmarkPreviewTable() {
            const tableBody = document.getElementById('benchmarkPreviewTableBody');
            if (!tableBody) return;

            const data = historicalBenchmarkData[currentSelectedYear] || [];
            const groupBadgeMap = {
                'Fibre Crops': 'bg-success-subtle text-success',
                'Oil Seeds': 'bg-warning-subtle text-warning-emphasis',
                'Pulses': 'bg-info-subtle text-info-emphasis',
                'Cereals': 'bg-primary-subtle text-primary'
            };

            let html = '';
            // Render top 5 benchmark crops on the homepage preview
            data.slice(0, 5).forEach(item => {
                html += renderBenchmarkRowHtml(item, groupBadgeMap);
            });

            tableBody.innerHTML = html;
        }

        function renderBenchmarkModalTable() {
            const tableBody = document.getElementById('benchmarkModalTableBody');
            if (!tableBody) return;

            const data = historicalBenchmarkData[currentSelectedYear] || [];
            const searchVal = (document.getElementById('modalBenchmarkSearch')?.value || '').toLowerCase().trim();
            const seasonVal = document.getElementById('modalBenchmarkSeasonFilter')?.value || '';
            const groupVal = document.getElementById('modalBenchmarkGroupFilter')?.value || '';

            const groupBadgeMap = {
                'Fibre Crops': 'bg-success-subtle text-success',
                'Oil Seeds': 'bg-warning-subtle text-warning-emphasis',
                'Pulses': 'bg-info-subtle text-info-emphasis',
                'Cereals': 'bg-primary-subtle text-primary'
            };

            let html = '';
            data.forEach(item => {
                const matchesSearch = !searchVal || item.crop.toLowerCase().includes(searchVal) || item.group.toLowerCase().includes(searchVal);
                const matchesSeason = !seasonVal || item.season === seasonVal;
                const matchesGroup = !groupVal || item.group === groupVal;

                if (matchesSearch && matchesSeason && matchesGroup) {
                    html += renderBenchmarkRowHtml(item, groupBadgeMap);
                }
            });

            if (!html) {
                html = `<tr><td colspan="7" class="text-center py-4 text-muted">No benchmark records found matching the filters.</td></tr>`;
            }

            tableBody.innerHTML = html;
        }

        function filterBenchmarkModalTable() {
            renderBenchmarkModalTable();
        }

        // Initialize both preview table & modal table on load
        renderBenchmarkPreviewTable();
        renderBenchmarkModalTable();

                        // =========================================================================
        // 3D Cinematic 7-Second Intro Controller (Plays on Website Start)
        // =========================================================================
        function init3dIntro() {
            const introOverlay = document.getElementById('agri3dIntroOverlay');
            const introVideo = document.getElementById('agri3dIntroVideo');
            const mainContent = document.getElementById('mainContent');

            // Only play once per session: do not replay on page refresh or navigation from other pages
            try {
                if (sessionStorage.getItem('agriai_3d_intro_shown') === 'true') {
                    if (introOverlay) {
                        introOverlay.style.display = 'none';
                        introOverlay.classList.add('dismissed');
                    }
                    if (introVideo) {
                        try { introVideo.pause(); } catch(e) {}
                    }
                    return;
                }
            } catch (e) {}

            if (!introOverlay || !introVideo) return;

            // Immediately mark as shown for this session
            try {
                sessionStorage.setItem('agriai_3d_intro_shown', 'true');
            } catch (e) {}

            // Select mobile vs desktop video based on screen width
            if (window.innerWidth <= 768) {
                const mobSrc = '@Url.Content("~/videos/agriai-intro-mobile.mp4")';
                if (!introVideo.currentSrc || !introVideo.currentSrc.includes('agriai-intro-mobile.mp4')) {
                    introVideo.src = mobSrc;
                    try { introVideo.load(); } catch (e) {}
                }
            } else {
                const deskSrc = '@Url.Content("~/videos/agriai-intro-3d.mp4")';
                if (!introVideo.currentSrc || !introVideo.currentSrc.includes('agriai-intro-3d.mp4')) {
                    introVideo.src = deskSrc;
                    try { introVideo.load(); } catch (e) {}
                }
            }

            let isDismissed = false;

            function dismissIntro() {
                if (isDismissed) return;
                isDismissed = true;

                introOverlay.classList.add('dismissed');
                if (mainContent) {
                    mainContent.classList.add('main-content-entering');
                }

                setTimeout(() => {
                    introOverlay.style.display = 'none';
                    try { introVideo.pause(); } catch(e) {}
                }, 850);
            }

            // Automatically dismiss when 7-second video finishes
            introVideo.addEventListener('ended', dismissIntro);

            // Safety timeout: 7.5 seconds
            setTimeout(dismissIntro, 7500);

            // Optional: click anywhere on screen to proceed early
            introOverlay.addEventListener('click', dismissIntro);

            // Optional: press ESC or Space to proceed early
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' || e.keyCode === 27 || e.key === ' ') {
                    dismissIntro();
                }
            });

            // Ensure attributes for reliable instant autoplay
            introVideo.muted = true;
            introVideo.defaultMuted = true;

            const tryPlay = () => {
                const p = introVideo.play();
                if (p !== undefined) {
                    p.catch(err => {
                        console.warn('Autoplay waiting for readyState:', err);
                    });
                }
            };

            if (introVideo.readyState >= 2) {
                tryPlay();
            } else {
                introVideo.addEventListener('canplay', tryPlay, { once: true });
                introVideo.addEventListener('loadeddata', tryPlay, { once: true });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init3dIntro);
        } else {
            init3dIntro();
        }

    </script>
