@model List<AgriAI.Web.Services.MandiRecordDto>

@{
    ViewData["Title"] = "Live Gujarat APMC Market Rates & Market Intelligence";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LiveMandi.css" asp-append-version="true" />
}

<div class="container py-4">
    <!-- Header Hero Banner -->
    <div class="live-mandi-header-hero">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 col-xl-8">
                <div class="live-mandi-badge">
                    <span class="ticker-pulse-dot"></span>
                    <span>LIVE APMC MARKET FEEDS (DATA.GOV.IN CONNECTED)</span>
                </div>
                <h1 class="live-mandi-title">
                    Gujarat Daily Market Prices &amp; Market Intelligence
                </h1>
                <p class="live-mandi-subtitle">
                    Real-time market yard commodity prices, daily arrivals, modal auction rates, and MSP benchmarks across 500+ APMC markets in Gujarat.
                </p>
            </div>
            <div class="col-lg-5 col-xl-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-inline-flex flex-column gap-2.5 text-start rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1.5px solid rgba(255, 255, 255, 0.28); padding: 20px 26px; min-width: 320px;">
                    <div class="d-flex align-items-center gap-2 text-warning fw-bold small" style="white-space: nowrap;">
                        <i class="bi bi-shield-check fs-5"></i>
                        <span>Ministry of Agriculture Verified</span>
                    </div>
                    <div class="text-white small d-flex align-items-center justify-content-between gap-3" style="white-space: nowrap;">
                        <span><strong>Live API Status:</strong></span>
                        <span class="badge bg-success px-2.5 py-1.5 rounded-pill fw-bold shadow-sm">2026 Live Active 🟢</span>
                    </div>
                    <div class="text-white-50 small mt-0.5" style="font-size: 0.78rem; white-space: nowrap;">
                        <i class="bi bi-clock-history me-1"></i> Last Synced: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Summary Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="mandi-stat-card d-flex align-items-center gap-3">
                <div class="mandi-stat-icon-box bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <div class="mandi-stat-num">@Model.Select(m => m.Market).Distinct().Count()+</div>
                    <div class="mandi-stat-label">Active Markets</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mandi-stat-card d-flex align-items-center gap-3">
                <div class="mandi-stat-icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-flower1"></i>
                </div>
                <div>
                    <div class="mandi-stat-num">@Model.Count()</div>
                    <div class="mandi-stat-label">Crops Tracked</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mandi-stat-card d-flex align-items-center gap-3">
                <div class="mandi-stat-icon-box bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <div class="mandi-stat-num">₹28,500</div>
                    <div class="mandi-stat-label">Top Commodity (Cumin)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mandi-stat-card d-flex align-items-center gap-3">
                <div class="mandi-stat-icon-box bg-info bg-opacity-10 text-info">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <div>
                    <div class="mandi-stat-num">98%</div>
                    <div class="mandi-stat-label">AI Forecast Accuracy</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar Panel -->
    <div class="mandi-filter-panel">
        <div class="row g-3 align-items-center">
            <!-- Search input -->
            <div class="col-lg-4 position-relative">
                <i class="bi bi-search position-absolute text-muted" style="left: 28px; top: 13px; font-size: 1rem;"></i>
                <input type="text" id="mandiSearchInput" class="form-control mandi-search-input" placeholder="Search crop, APMC yard (e.g. Cotton, Unjha, Rajkot)..." />
            </div>

            <!-- District Dropdown Filter -->
            <div class="col-md-4 col-lg-3">
                <select id="districtFilterSelect" class="form-select rounded-pill shadow-none" style="font-size: 0.88rem; padding: 10px 18px;">
                    <option value="">All Gujarat Districts</option>
                    @foreach (var district in Model.Select(m => m.District).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d))
                    {
                        <option value="@district">@district District</option>
                    }
                </select>
            </div>

            <!-- Category Pills -->
            <div class="col-lg-5 text-lg-end">
                <div class="d-flex flex-wrap gap-1.5 justify-content-lg-end" id="categoryPillContainer">
                    <button class="mandi-tab-btn active" data-filter="all">All Crops</button>
                    <button class="mandi-tab-btn" data-filter="cash">Cash Crops &amp; Spices</button>
                    <button class="mandi-tab-btn" data-filter="grains">Grains</button>
                    <button class="mandi-tab-btn" data-filter="pulses">Pulses</button>
                    <button class="mandi-tab-btn" data-filter="oilseeds">Oilseeds</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Live APMC Rates Table Card -->
    <div class="mandi-table-card">
        <div class="table-responsive">
            <table class="table mandi-table" id="mandiRatesTable">
                <thead>
                    <tr>
                        <th>Commodity / Crop</th>
                        <th>Market Yard (APMC)</th>
                        <th>District</th>
                        <th>Today's Modal Price</th>
                        <th>Min - Max Range</th>
                        <th>Market Status</th>
                        <th class="text-end">AI Action</th>
                    </tr>
                </thead>
                <tbody id="mandiTableBody">
                    @foreach (var item in Model)
                    {
                        var commodityLower = item.Commodity.ToLower();
                        var categoryType = "other";
                        if (commodityLower.Contains("cotton") || commodityLower.Contains("cumin") || commodityLower.Contains("fennel") || commodityLower.Contains("isabgol") || commodityLower.Contains("chilli") || commodityLower.Contains("garlic") || commodityLower.Contains("onion"))
                        {
                            categoryType = "cash";
                        }
                        else if (commodityLower.Contains("wheat") || commodityLower.Contains("paddy") || commodityLower.Contains("rice") || commodityLower.Contains("bajra") || commodityLower.Contains("jowar") || commodityLower.Contains("maize"))
                        {
                            categoryType = "grains";
                        }
                        else if (commodityLower.Contains("gram") || commodityLower.Contains("chana") || commodityLower.Contains("tur") || commodityLower.Contains("moong") || commodityLower.Contains("urad") || commodityLower.Contains("lentil"))
                        {
                            categoryType = "pulses";
                        }
                        else if (commodityLower.Contains("groundnut") || commodityLower.Contains("sesamum") || commodityLower.Contains("mustard") || commodityLower.Contains("castor") || commodityLower.Contains("soyabean"))
                        {
                            categoryType = "oilseeds";
                        }

                        // Icon selection
                        var icon = "🌾";
                        if (commodityLower.Contains("groundnut")) icon = "🥜";
                        else if (commodityLower.Contains("cumin") || commodityLower.Contains("fennel")) icon = "🌿";
                        else if (commodityLower.Contains("sesamum") || commodityLower.Contains("soyabean")) icon = "🌱";
                        else if (commodityLower.Contains("tur") || commodityLower.Contains("moong")) icon = "🍲";
                        else if (commodityLower.Contains("garlic")) icon = "🧄";
                        else if (commodityLower.Contains("onion")) icon = "🧅";
                        else if (commodityLower.Contains("chilli")) icon = "🌶️";
                        else if (commodityLower.Contains("potato")) icon = "🥔";
                        else if (commodityLower.Contains("maize")) icon = "🌽";

                        <tr class="mandi-row" data-commodity="@item.Commodity" data-market="@item.Market" data-district="@item.District" data-category="@categoryType">
                            <td>
                                <div class="commodity-name-box">
                                    <div class="commodity-icon-avatar">@icon</div>
                                    <div>
                                        <div class="commodity-title">@item.Commodity</div>
                                        <div class="commodity-variety">Variety: @(string.IsNullOrEmpty(item.Variety) ? "Standard FAQ" : item.Variety)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="mandi-market-name">@item.Market</div>
                                <small class="text-muted">Arrival: @(string.IsNullOrEmpty(item.Arrival_Date) ? DateTime.Now.ToString("dd/MM/yyyy") : item.Arrival_Date)</small>
                            </td>
                            <td>
                                <span class="mandi-district-badge">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrEmpty(item.District) ? "Gujarat" : item.District)
                                </span>
                            </td>
                            <td>
                                <div class="mandi-modal-price">₹@Convert.ToDouble(item.Modal_Price).ToString("N0")</div>
                                <div class="mandi-price-range">per Quintal (100 Kg)</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 0.88rem;">₹@Convert.ToDouble(item.Min_Price).ToString("N0") - ₹@Convert.ToDouble(item.Max_Price).ToString("N0")</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Daily Auction Band</div>
                            </td>
                            <td>
                                <span class="mandi-live-badge-pill">
                                    <i class="bi bi-broadcast"></i> Live Trading
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-outline-success btn-sm fw-bold rounded-pill px-3 shadow-sm" style="font-size: 0.78rem;">
                                    <i class="bi bi-magic me-1"></i> Predict Future
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="noResultsAlert" class="p-5 text-center d-none">
            <i class="bi bi-search fs-1 text-muted mb-2 d-block"></i>
            <h5 class="text-dark fw-bold">No Matching APMC Rates Found</h5>
            <p class="text-muted small">Try searching with a different crop name or clearing your district filter.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("mandiSearchInput");
            const districtSelect = document.getElementById("districtFilterSelect");
            const tabButtons = document.querySelectorAll(".mandi-tab-btn");
            const rows = document.querySelectorAll(".mandi-row");
            const noResults = document.getElementById("noResultsAlert");

            let currentCategory = "all";

            function filterRows() {
                const searchQuery = searchInput.value.toLowerCase().trim();
                const selectedDistrict = districtSelect.value.toLowerCase().trim();
                let visibleCount = 0;

                rows.forEach(row => {
                    const commodity = (row.getAttribute("data-commodity") || "").toLowerCase();
                    const market = (row.getAttribute("data-market") || "").toLowerCase();
                    const district = (row.getAttribute("data-district") || "").toLowerCase();
                    const category = row.getAttribute("data-category") || "";

                    const matchesSearch = !searchQuery || commodity.includes(searchQuery) || market.includes(searchQuery) || district.includes(searchQuery);
                    const matchesDistrict = !selectedDistrict || district.includes(selectedDistrict);
                    const matchesCategory = (currentCategory === "all") || (category === currentCategory);

                    if (matchesSearch && matchesDistrict && matchesCategory) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (noResults) {
                    noResults.classList.toggle("d-none", visibleCount > 0);
                }
            }

            if (searchInput) {
                searchInput.addEventListener("input", filterRows);
            }

            if (districtSelect) {
                districtSelect.addEventListener("change", filterRows);
            }

            tabButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    tabButtons.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    currentCategory = this.getAttribute("data-filter") || "all";
                    filterRows();
                });
            });
        });
    </script>
}
