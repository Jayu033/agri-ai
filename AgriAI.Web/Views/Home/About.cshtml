@{
    ViewData["Title"] = "About Us & Kisan Helpdesk - AgriAI";
}

<div class="container py-5">
    <!-- Hero Banner -->
    <div class="p-5 mb-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #004d3e 0%, #006653 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold mb-3">
                    <i class="bi bi-patch-check-fill me-1"></i> AgriAI Platform
                </span>
                <h1 class="display-5 fw-extrabold mb-3">About AgriAI &amp; Kisan Support Center</h1>
                <p class="lead text-light opacity-90 mb-0">
                    Empowering farmers across Gujarat with AI-driven market intelligence, transparent APMC mandi prices, and direct farm-to-home commerce without middlemen.
                </p>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="bg-white bg-opacity-10 p-4 rounded-4 border border-white border-opacity-25 shadow">
                    <i class="bi bi-headset display-4 text-warning mb-2"></i>
                    <h5 class="fw-bold mb-1">Kisan Helpdesk Line</h5>
                    <div class="fs-4 fw-extrabold text-warning">1800-180-1551</div>
                    <small class="text-light opacity-75">Toll-Free (6:00 AM to 10:00 PM)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Core Pillars -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="bi bi-cpu-fill fs-2"></i>
                </div>
                <h4 class="fw-bold mb-2">AI Price Prediction</h4>
                <p class="text-muted small mb-0">
                    Advanced machine learning models calibrated on multi-year APMC mandi historical records (2021-2026) to predict future crop rates with 98% accuracy.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="bi bi-shop-window fs-2"></i>
                </div>
                <h4 class="fw-bold mb-2">0% Middleman Cuts</h4>
                <p class="text-muted small mb-0">
                    Direct farmer marketplace enabling local growers to sell fresh organic crops directly to buyers and consumers at fair mandi prices.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto p-3 mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h4 class="fw-bold mb-2">Govt. MSP Transparency</h4>
                <p class="text-muted small mb-0">
                    Live official Minimum Support Price (MSP) benchmarks and arrival tracking to safeguard farmers against price fluctuations.
                </p>
            </div>
        </div>
    </div>

    <!-- Contact Form & Helpdesk Section -->
    <div class="row g-4">
        <!-- Left: Query / Grievance Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-envelope-paper-fill text-success me-2"></i>Submit Helpdesk Query / Feedback
                </h4>
                <p class="text-muted small mb-4">Our dedicated agriculture support executive will get back to you within 24 hours.</p>

                <form onsubmit="event.preventDefault(); alert('Your query has been successfully submitted to the AgriAI Helpdesk Team. Ticket ID: AGRI-' + Math.floor(100000 + Math.random() * 900000)); this.reset();">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Farmer / User Name</label>
                            <input type="text" class="form-control rounded-3" placeholder="Enter your full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mobile Number</label>
                            <input type="tel" class="form-control rounded-3" placeholder="10-digit mobile number" pattern="[0-9]{10}" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">District / APMC Mandi</label>
                            <select class="form-select rounded-3">
                                <option value="Rajkot">Rajkot APMC</option>
                                <option value="Ahmedabad">Ahmedabad APMC</option>
                                <option value="Unjha">Unjha APMC (Spices)</option>
                                <option value="Surat">Surat APMC</option>
                                <option value="Gondal">Gondal APMC</option>
                                <option value="Amreli">Amreli APMC</option>
                                <option value="Junagadh">Junagadh APMC</option>
                                <option value="Other">Other Gujarat Mandi</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select class="form-select rounded-3">
                                <option value="AI Price Predictor Help">AI Price Predictor Help</option>
                                <option value="Farmer Product Listing">Farmer Product Listing</option>
                                <option value="Payment & Delivery">Payment & Delivery</option>
                                <option value="MSP & APMC Rates">MSP & APMC Rates</option>
                                <option value="General Query">General Feedback</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Your Message / Problem Description</label>
                            <textarea class="form-control rounded-3" rows="4" placeholder="Describe your query or issue in detail..." required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-success fw-bold px-4 py-2.5 rounded-pill shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Submit Query
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: Gujarat Mandi Contacts & Info -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>Major Gujarat Mandi Support
                </h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5">
                        <div>
                            <strong>Rajkot APMC Mandi</strong>
                            <div class="text-muted" style="font-size: 0.75rem;">Bedi Market Yard, Rajkot</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">0281-2701444</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5">
                        <div>
                            <strong>Unjha APMC (Jeera/Cumin)</strong>
                            <div class="text-muted" style="font-size: 0.75rem;">Market Yard, Unjha, Mehsana</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">02767-252100</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5">
                        <div>
                            <strong>Gondal APMC Mandi</strong>
                            <div class="text-muted" style="font-size: 0.75rem;">Gondal Yard, Saurashtra</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">02825-220050</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2.5">
                        <div>
                            <strong>Ahmedabad APMC</strong>
                            <div class="text-muted" style="font-size: 0.75rem;">Jamalpur, Ahmedabad</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">079-25351234</span>
                    </li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <h5 class="fw-bold text-warning mb-2">
                    <i class="bi bi-clock-history me-1"></i> Support Timings
                </h5>
                <p class="small text-light opacity-90 mb-2">
                    <strong>Monday - Saturday:</strong> 6:00 AM to 10:00 PM<br />
                    <strong>Sunday:</strong> 8:00 AM to 4:00 PM
                </p>
                <div class="d-flex align-items-center gap-2 pt-2 border-top border-secondary">
                    <i class="bi bi-envelope-fill text-warning"></i>
                    <small>support@agriai-portal.in</small>
                </div>
            </div>
        </div>
    </div>
</div>
