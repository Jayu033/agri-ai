@model AgriAI.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="bg-white rounded-3 shadow-sm p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-key-fill text-warning fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">Forgot Password</h3>
                <p class="text-muted small">Enter your email address and we will send you a link to reset your password.</p>
            </div>
            
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3 rounded-3"></div>
                
                <div class="form-group mb-4">
                    <label asp-for="Email" class="form-label text-dark fw-medium small mb-1">Email Address</label>
                    <input asp-for="Email" class="form-control px-3 py-2" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <button type="submit" class="btn btn-warning w-100 py-2 mb-3 fw-semibold shadow-sm text-dark">Send Reset Link</button>
                
                <div class="text-center">
                    <a asp-action="Login" class="text-secondary fw-semibold text-decoration-none small hover-text-dark transition">
                        <i class="bi bi-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
