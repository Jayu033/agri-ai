@model AgriAI.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="bg-white rounded-3 shadow-sm p-4 p-md-5">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark">Reset Password</h3>
                <p class="text-muted small">Enter your new password below.</p>
            </div>
            
            <form asp-action="ResetPassword" method="post">
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3 rounded-3"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label text-dark fw-medium small mb-1">New Password</label>
                    <input asp-for="Password" class="form-control px-3 py-2" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-dark fw-medium small mb-1">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control px-3 py-2" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-semibold shadow-sm">Reset Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
