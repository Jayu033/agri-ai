@model AgriAI.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";

    string? statusMessage = null;
    string statusType = "info"; // "pending", "error", "success"

    if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        var firstError = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault();
        if (firstError != null)
        {
            statusMessage = firstError.ErrorMessage;
            if (statusMessage.Contains("verification", StringComparison.OrdinalIgnoreCase) || statusMessage.Contains("Admin", StringComparison.OrdinalIgnoreCase))
            {
                statusType = "pending";
            }
            else
            {
                statusType = "error";
            }
        }
    }
    else if (TempData["SuccessMessage"] != null)
    {
        statusMessage = TempData["SuccessMessage"]?.ToString();
        statusType = "success";
    }
    else if (TempData["ErrorMessage"] != null)
    {
        statusMessage = TempData["ErrorMessage"]?.ToString();
        statusType = "error";
    }

    // Modal Styling Configurations
    string glowGradient = "linear-gradient(90deg, #15803d, #22c55e)";
    string iconBg = "rgba(22, 101, 52, 0.12)";
    string iconColor = "#15803d";
    string iconBorder = "rgba(22, 101, 52, 0.25)";
    string iconClass = "bi bi-info-circle-fill";
    string badgeBg = "#dcfce7";
    string badgeColor = "#166534";
    string badgeText = "Notification";
    string modalTitle = "Notice";
    string btnGradient = "linear-gradient(135deg, #15803d 0%, #16a34a 100%)";
    string btnLabel = "Understood";

    if (statusType == "pending")
    {
        glowGradient = "linear-gradient(90deg, #d97706, #f59e0b, #fbbf24)";
        iconBg = "rgba(245, 158, 11, 0.12)";
        iconColor = "#d97706";
        iconBorder = "rgba(245, 158, 11, 0.35)";
        iconClass = "bi bi-hourglass-split";
        badgeBg = "#fef3c7";
        badgeColor = "#b45309";
        badgeText = "Pending Verification";
        modalTitle = "Account Under Review";
        btnGradient = "linear-gradient(135deg, #d97706 0%, #f59e0b 100%)";
        btnLabel = "Understood, I Will Wait";
    }
    else if (statusType == "success")
    {
        glowGradient = "linear-gradient(90deg, #15803d, #22c55e, #4ade80)";
        iconBg = "rgba(22, 101, 52, 0.12)";
        iconColor = "#15803d";
        iconBorder = "rgba(22, 101, 52, 0.35)";
        iconClass = "bi bi-check-circle-fill";
        badgeBg = "#dcfce7";
        badgeColor = "#166534";
        badgeText = "Registration Successful";
        modalTitle = "Welcome to AgriAI";
        btnGradient = "linear-gradient(135deg, #15803d 0%, #16a34a 100%)";
        btnLabel = "Continue to Login";
    }
    else if (statusType == "error")
    {
        glowGradient = "linear-gradient(90deg, #dc2626, #ef4444, #f87171)";
        iconBg = "rgba(220, 38, 38, 0.12)";
        iconColor = "#dc2626";
        iconBorder = "rgba(220, 38, 38, 0.35)";
        iconClass = "bi bi-shield-x";
        badgeBg = "#fee2e2";
        badgeColor = "#991b1b";
        badgeText = "Authentication Alert";
        modalTitle = "Unable to Sign In";
        btnGradient = "linear-gradient(135deg, #dc2626 0%, #ef4444 100%)";
        btnLabel = "Try Again";
    }
}

<div class="login-page-bg">
    <div class="modern-login-card">
        <!-- Brand Icon -->
        <div class="login-brand-icon-box">
            <i class="bi bi-tree-fill"></i>
        </div>

        <!-- Header -->
        <h2 class="login-card-title">Welcome Back</h2>
        <p class="login-card-subtext">Sign in with your credentials to access AgriAI</p>

        <form asp-action="Login" method="post" id="loginForm">
            <!-- Email / Username -->
            <div class="login-field-group">
                <label asp-for="UsernameOrEmail" class="login-field-label">Email or Username</label>
                <div class="login-input-wrapper">
                    <input asp-for="UsernameOrEmail" class="login-form-input" placeholder="e.g. admin or name@example.com" autofocus />
                    <i class="bi bi-person-fill login-input-icon"></i>
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password -->
            <div class="login-field-group">
                <label asp-for="Password" class="login-field-label">Password</label>
                <div class="login-input-wrapper">
                    <input asp-for="Password" type="password" id="loginPasswordInput" class="login-form-input pe-5" placeholder="Enter your password" />
                    <i class="bi bi-lock-fill login-input-icon"></i>
                    <button type="button" class="login-eye-toggle" id="loginPwdToggleBtn" tabindex="-1" aria-label="Toggle password visibility">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="login-meta-row">
                <div class="form-check m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                    <label class="form-check-label login-remember-text" for="rememberMeCheck">
                        Remember me
                    </label>
                </div>
                <a asp-action="ForgotPassword" class="login-forgot-pwd">Forgot Password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login-action">
                <span>Login</span>
                <i class="bi bi-box-arrow-in-right fs-5"></i>
            </button>

            <!-- Bottom Register Link -->
            <div class="login-register-prompt">
                <span>Don't have an account?</span>
                <a asp-action="Register">Register</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <!-- High-End Luxury Notification Popup Modal -->
    <div class="modal fade" id="statusNotificationModal" tabindex="-1" aria-labelledby="statusNotificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center position-relative overflow-hidden p-4" 
                 style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px); box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);">
                
                <!-- Top Right Close Button -->
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3.5 shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>

                <!-- Decorative Top Ambient Glow -->
                <div class="position-absolute top-0 start-0 w-100" style="height: 5px; background: @glowGradient;"></div>

                <!-- Animated Icon Circle -->
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mt-2 mb-3 shadow-sm" 
                     style="width: 76px; height: 76px; font-size: 2.2rem; background: @iconBg; color: @iconColor; border: 2px solid @iconBorder;">
                    <i class="@iconClass"></i>
                </div>

                <!-- Title & Badge -->
                <div class="mb-2">
                    <span class="badge rounded-pill px-3 py-1 mb-2 fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.6px; background: @badgeBg; color: @badgeColor;">
                        @badgeText
                    </span>
                    <h4 class="fw-extrabold text-dark mb-1" id="statusNotificationModalLabel">@modalTitle</h4>
                </div>

                <!-- Message Body -->
                <p class="text-muted small px-2 mb-4" style="font-size: 0.88rem; line-height: 1.55;">
                    @statusMessage
                </p>

                <!-- Action Button -->
                <button type="button" class="btn btn-lg rounded-pill fw-bold py-2.5 px-4 shadow-sm w-100" style="background: @btnGradient; color: #ffffff; border: none;" data-bs-dismiss="modal">
                    <span>@btnLabel</span>
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Password toggle
            const pwdToggleBtn = document.getElementById('loginPwdToggleBtn');
            const pwdInput = document.getElementById('loginPasswordInput');
            if (pwdToggleBtn && pwdInput) {
                pwdToggleBtn.addEventListener('click', function () {
                    const icon = this.querySelector('i');
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        pwdInput.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                });
            }

            // Auto-trigger Status Notification Modal if message exists
            const modalEl = document.getElementById('statusNotificationModal');
            if (modalEl) {
                if (window.bootstrap && bootstrap.Modal) {
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                } else if (window.jQuery && $(modalEl).modal) {
                    $(modalEl).modal('show');
                }
            }
        });
    </script>
}
