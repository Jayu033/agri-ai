
<style>
    /* Guaranteed Eye Icon Fix: Disable Edge native reveal and center custom toggle inside box */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="text"]::-ms-clear {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        pointer-events: none !important;
    }
    .login-input-wrapper {
        position: relative !important;
        display: flex !important;
        align-items: center !important;
        width: 100% !important;
    }
    .login-form-input {
        width: 100% !important;
        padding-left: 42px !important;
        padding-right: 48px !important;
        box-sizing: border-box !important;
    }
    .login-eye-toggle {
        position: absolute !important;
        right: 12px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        width: 32px !important;
        height: 32px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: transparent !important;
        border: none !important;
        color: #64748b !important;
        font-size: 1.15rem !important;
        border-radius: 50% !important;
        cursor: pointer !important;
        z-index: 10 !important;
        line-height: 1 !important;
    }
    .login-eye-toggle:hover {
        color: #007b49 !important;
        background-color: rgba(0, 123, 73, 0.08) !important;
    }
    .login-brand-icon-box {
        background: transparent !important;
        box-shadow: none !important;
        width: auto !important;
        height: auto !important;
        border-radius: 0 !important;
        margin: 0 auto 10px auto !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .login-brand-logo-img {
        height: 68px !important;
        width: 68px !important;
        object-fit: contain !important;
        filter: drop-shadow(0 4px 10px rgba(0, 102, 83, 0.12)) !important;
        transition: transform 0.25s ease !important;
    }
    .login-brand-logo-img:hover {
        transform: scale(1.06) !important;
    }
</style>
@model AgriAI.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";

    string? statusMessage = null;
    string statusType = "pending"; // "pending", "error", "success"

    if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        var firstError = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault();
        if (firstError != null)
        {
            statusMessage = firstError.ErrorMessage;
            if (statusMessage.Contains("verification", StringComparison.OrdinalIgnoreCase) || statusMessage.Contains("Admin", StringComparison.OrdinalIgnoreCase))
            {
                statusType = "pending";
            }
            else
            {
                statusType = "error";
            }
        }
    }
    else if (TempData["SuccessMessage"] != null)
    {
        statusMessage = TempData["SuccessMessage"]?.ToString();
        statusType = "success";
    }
    else if (TempData["ErrorMessage"] != null)
    {
        statusMessage = TempData["ErrorMessage"]?.ToString();
        statusType = "error";
    }

    string iconClass = statusType == "pending" ? "bi bi-hourglass-split" : (statusType == "success" ? "bi bi-check-circle-fill" : "bi bi-shield-x");
    string badgeText = statusType == "pending" ? "Pending Verification" : (statusType == "success" ? "Registration Successful" : "Authentication Alert");
    string modalTitle = statusType == "pending" ? "Account Under Review" : (statusType == "success" ? "Welcome to AgriAI" : "Unable to Sign In");
    string btnLabel = statusType == "pending" ? "Understood, I Will Wait" : (statusType == "success" ? "Continue to Login" : "Try Again");
}

<div class="login-page-bg">
    <div class="modern-login-card">
        <!-- Brand Logo (Pure Transparent Emblem, No Background Box) -->
        <div class="login-brand-icon-box" style="background: transparent !important; box-shadow: none !important; width: auto !important; height: auto !important; margin: 0 auto 10px auto !important; border-radius: 0 !important;">
            <img src="~/images/agriai-emblem-pure-trans.png" alt="AgriAI Logo" class="login-brand-logo-img" style="height: 68px; width: 68px; object-fit: contain; display: inline-block; filter: drop-shadow(0 4px 10px rgba(0, 102, 83, 0.12));" />
        </div>

        <!-- Header -->
        <h2 class="login-card-title brand-logo-title" style="font-size: 2.35rem; font-weight: 900; letter-spacing: -0.5px; margin-bottom: 6px; line-height: 1.1;"><span class="brand-text-agri" style="color: #007b49;">Agri</span><span class="brand-text-ai" style="color: #cb9d46;">AI</span></h2>
        <p class="login-card-subtext">Sign in with your credentials to access AgriAI</p>

        <form asp-action="Login" method="post" id="loginForm">
            <!-- Email / Username -->
            <div class="login-field-group">
                <label asp-for="UsernameOrEmail" class="login-field-label">Email or Username</label>
                <div class="login-input-wrapper">
                    <input asp-for="UsernameOrEmail" class="login-form-input" placeholder="e.g. admin or name@example.com" autofocus />
                    <i class="bi bi-person-fill login-input-icon"></i>
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password -->
            <div class="login-field-group">
                <label asp-for="Password" class="login-field-label">Password</label>
                <div class="login-input-wrapper" style="position: relative; display: flex; align-items: center; width: 100%;">
                    <input asp-for="Password" type="password" id="loginPasswordInput" class="login-form-input" placeholder="Enter your password" autocomplete="current-password" style="width: 100% !important; padding-left: 42px !important; padding-right: 48px !important; height: 46px !important; box-sizing: border-box !important;" />
                    <i class="bi bi-lock-fill login-input-icon" style="position: absolute !important; left: 14px !important; top: 50% !important; transform: translateY(-50%) !important; pointer-events: none !important; font-size: 1.05rem !important; color: #94a3b8 !important; z-index: 2 !important; margin: 0 !important;"></i>
                    <button type="button" class="login-eye-toggle" id="loginPwdToggleBtn" tabindex="-1" aria-label="Toggle password visibility" title="Show/Hide password" style="position: absolute !important; right: 12px !important; top: 50% !important; transform: translateY(-50%) !important; width: 32px !important; height: 32px !important; border: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; color: #64748b !important; font-size: 1.15rem !important; z-index: 10 !important; border-radius: 50% !important; outline: none !important; line-height: 1 !important;">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="login-meta-row">
                <div class="form-check m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                    <label class="form-check-label login-remember-text" for="rememberMeCheck">
                        Remember me
                    </label>
                </div>
                <a asp-action="ForgotPassword" class="login-forgot-pwd">Forgot Password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login-action">
                <span>Login</span>
                <i class="bi bi-box-arrow-in-right fs-5"></i>
            </button>

            <!-- Bottom Register Link -->
            <div class="login-register-prompt">
                <span>Don't have an account?</span>
                <a asp-action="Register">Register</a>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <!-- High-End Luxury Notification Popup Modal -->
    <div class="modal fade" id="statusNotificationModal" tabindex="-1" aria-labelledby="statusNotificationModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered status-modal-dialog">
            <div class="modal-content status-modal-content">
                
                <!-- Top Right Close Button -->
                <button type="button" class="status-modal-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>

                <!-- Status Icon Circle -->
                <div class="status-modal-icon-wrapper status-@statusType">
                    <i class="@iconClass"></i>
                </div>

                <!-- Badge -->
                <div>
                    <span class="status-modal-badge badge-@statusType">@badgeText</span>
                </div>

                <!-- Title -->
                <h4 class="status-modal-title" id="statusNotificationModalLabel">@modalTitle</h4>

                <!-- Description Message -->
                <p class="status-modal-desc">
                    @statusMessage
                </p>

                <!-- Action Button -->
                <button type="button" class="status-modal-action-btn btn-@statusType" data-bs-dismiss="modal">
                    <span>@btnLabel</span>
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Password toggle
            const pwdToggleBtn = document.getElementById('loginPwdToggleBtn');
            const pwdInput = document.getElementById('loginPasswordInput');
            if (pwdToggleBtn && pwdInput) {
                pwdToggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const icon = this.querySelector('i');
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        if (icon) {
                            icon.classList.remove('bi-eye');
                            icon.classList.add('bi-eye-slash');
                        }
                    } else {
                        pwdInput.type = 'password';
                        if (icon) {
                            icon.classList.remove('bi-eye-slash');
                            icon.classList.add('bi-eye');
                        }
                    }
                });
            }

            // Auto-trigger Status Notification Modal if message exists
            const modalEl = document.getElementById('statusNotificationModal');
            if (modalEl) {
                if (window.bootstrap && bootstrap.Modal) {
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                } else if (window.jQuery && $(modalEl).modal) {
                    $(modalEl).modal('show');
                }
            }
        });
    </script>
}
