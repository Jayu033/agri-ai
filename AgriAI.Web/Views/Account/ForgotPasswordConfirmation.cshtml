@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4 text-center">
        <div class="bg-white rounded-3 shadow-sm p-4 p-md-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-envelope-check text-success" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-3">Check your Email</h3>
            <p class="text-muted mb-4">
                If an account exists for that email, we have sent a password reset link.
            </p>

            @if (TempData["ResetLink"] != null)
            {
                <div class="alert alert-info text-start small mb-4">
                    <strong>For Testing Only:</strong> Since there is no email server configured yet, click the link below to reset your password:
                    <br /><br />
                    <a href="@TempData["ResetLink"]" class="fw-bold text-decoration-underline" style="word-break: break-all;">Reset My Password</a>
                </div>
            }

            <a asp-action="Login" class="btn btn-outline-secondary px-4 fw-medium">Back to Login</a>
        </div>
    </div>
</div>
