
<style>
    /* Guaranteed Eye Icon Fix: Disable Edge native reveal and center custom toggle inside box */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="text"]::-ms-clear {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        pointer-events: none !important;
    }
    .input-icon-box {
        position: relative !important;
        display: flex !important;
        align-items: center !important;
        width: 100% !important;
    }
    .input-icon-box .modern-form-control {
        width: 100% !important;
        padding-left: 42px !important;
        padding-right: 48px !important;
        box-sizing: border-box !important;
    }
    .password-toggle-btn {
        position: absolute !important;
        right: 12px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        width: 32px !important;
        height: 32px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: transparent !important;
        border: none !important;
        color: #64748b !important;
        font-size: 1.15rem !important;
        border-radius: 50% !important;
        cursor: pointer !important;
        z-index: 10 !important;
        line-height: 1 !important;
    }
    .password-toggle-btn:hover {
        color: #007b49 !important;
        background-color: rgba(0, 123, 73, 0.08) !important;
    }
    .register-brand-icon-box {
        background: transparent !important;
        box-shadow: none !important;
        width: auto !important;
        height: auto !important;
        border-radius: 0 !important;
        margin: 0 auto 10px auto !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .register-brand-logo-img {
        height: 68px !important;
        width: 68px !important;
        object-fit: contain !important;
        filter: drop-shadow(0 4px 10px rgba(0, 102, 83, 0.12)) !important;
        transition: transform 0.25s ease !important;
    }
    .register-brand-logo-img:hover {
        transform: scale(1.06) !important;
    }
</style>
@model AgriAI.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create an Account";
}

<div class="register-page-bg">
    <div class="modern-register-card">
        <!-- Brand Logo (Pure Transparent Emblem, No Background Box) -->
        <div class="register-brand-icon-box" style="background: transparent !important; box-shadow: none !important; width: auto !important; height: auto !important; margin: 0 auto 10px auto !important; border-radius: 0 !important;">
            <img src="~/images/agriai-emblem-pure-trans.png" alt="AgriAI Logo" class="register-brand-logo-img" style="height: 68px; width: 68px; object-fit: contain; display: inline-block; filter: drop-shadow(0 4px 10px rgba(0, 102, 83, 0.12));" />
        </div>

        <!-- Header -->
        <h2 class="register-card-title brand-logo-title" style="font-size: 2.35rem; font-weight: 900; letter-spacing: -0.5px; margin-bottom: 6px; line-height: 1.1;"><span class="brand-text-agri" style="color: #007b49;">Agri</span><span class="brand-text-ai" style="color: #cb9d46;">AI</span></h2>
        <p class="register-card-subtext">Join AgriAI to buy fresh farm produce or sell crops with smart AI tools</p>

        <form asp-action="Register" method="post" id="registerForm" enctype="multipart/form-data">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger alert-dismissible fade show small p-3 mb-3 rounded-4 shadow-sm position-relative" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-circle-fill text-danger fs-5 mt-0.5"></i>
                        <div class="pe-4">
                            <div asp-validation-summary="ModelOnly" class="mb-0 text-danger fw-medium"></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close p-2.5 shadow-none position-absolute top-0 end-0 m-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Farmer 2-Step Progress Stepper (Visible when Farmer role is selected) -->
            <div id="farmerWizardStepper" class="reg-stepper-container" style="display: none;">
                <div class="reg-step-item active" id="stepIndicator1">
                    <div class="reg-step-circle" id="stepCircle1">1</div>
                    <span>Account Profile</span>
                </div>
                <div class="reg-step-line" id="stepLine1"></div>
                <div class="reg-step-item" id="stepIndicator2">
                    <div class="reg-step-circle" id="stepCircle2">2</div>
                    <span>KYC &amp; Bank Details</span>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- STEP 1: Basic Account Profile Information -->
            <!-- ========================================== -->
            <div id="registerStep1">
                <!-- Native Interactive Role Selection Cards -->
                <div class="role-selection-wrapper">
                    <label class="modern-label">Choose your account type:</label>
                    <div class="role-cards-grid">
                        <!-- Customer Radio Card -->
                        <input type="radio" asp-for="Role" value="Customer" id="roleCustomer" class="btn-check" checked />
                        <label class="role-card-option" for="roleCustomer">
                            <div class="role-icon-box">
                                <i class="bi bi-cart-check-fill"></i>
                            </div>
                            <div class="role-card-text">
                                <h6 class="role-title">Customer</h6>
                                <p class="role-desc">Buy fresh farm produce</p>
                            </div>
                            <div class="role-radio-badge"></div>
                        </label>

                        <!-- Farmer Radio Card -->
                        <input type="radio" asp-for="Role" value="Farmer" id="roleFarmer" class="btn-check" />
                        <label class="role-card-option" for="roleFarmer">
                            <div class="role-icon-box">
                                <i class="bi bi-tree-fill"></i>
                            </div>
                            <div class="role-card-text">
                                <h6 class="role-title">Farmer</h6>
                                <p class="role-desc">Sell crops &amp; use AI tools</p>
                            </div>
                            <div class="role-radio-badge"></div>
                        </label>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Modern Mandatory Profile Photo Selector -->
                <div class="profile-photo-card p-2.5 px-3 bg-light rounded-4 border mb-2.5 shadow-xs">
                    <div class="profile-photo-user-info d-flex align-items-center gap-2">
                        <div class="position-relative d-inline-block flex-shrink-0">
                            <img id="avatarPreview" src="https://ui-avatars.com/api/?name=User&background=15803d&color=fff&size=128" 
                                 class="rounded-circle border border-2 border-success shadow-sm" style="width: 46px; height: 46px; object-fit: cover;" alt="Profile Avatar" />
                            <span id="photoTypeBadge" class="badge bg-success position-absolute bottom-0 end-0 rounded-circle p-0.5 shadow border border-white" style="display: none; width: 16px; height: 16px; font-size: 0.60rem;" title="Photo selected">
                                <i class="bi bi-check"></i>
                            </span>
                        </div>
                        <div class="lh-sm text-start ps-1 flex-grow-1">
                            <strong class="text-dark small d-block" style="font-size: 0.84rem;">Profile Photo <span class="text-danger fw-bold" style="font-size: 0.76rem;">* (Mandatory)</span></strong>
                            <small class="text-muted" id="photoStatusText" style="font-size: 0.72rem;">Camera or local file upload</small>
                        </div>
                    </div>

                    <!-- Clean Action Buttons with crisp icon spacing -->
                    <div class="profile-photo-btn-group d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold px-3 py-1.5 shadow-sm d-inline-flex align-items-center justify-content-center" style="font-size: 0.80rem; background-color: #15803d; border-color: #15803d;" data-bs-toggle="modal" data-bs-target="#cameraCaptureModal" onclick="startCameraStream()" title="Take Photo with Camera">
                            <i class="bi bi-camera-fill me-1.5" style="margin-right: 6px;"></i>
                            <span>Camera</span>
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3 py-1.5 shadow-sm d-inline-flex align-items-center justify-content-center" style="font-size: 0.80rem;" onclick="document.getElementById('profilePicInput').click()" title="Upload File from Device">
                            <i class="bi bi-cloud-arrow-up-fill me-1.5" style="margin-right: 6px;"></i>
                            <span>Upload</span>
                        </button>

                        <button type="button" id="btnRemovePhoto" class="btn btn-sm text-danger p-0 ms-1" style="display: none; font-size: 1rem;" onclick="resetProfilePhoto()" title="Remove Photo">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>

                    <!-- Hidden Inputs for File Upload, Native Camera & Camera Base64 -->
                    <input asp-for="ProfilePictureFile" type="file" id="profilePicInput" class="d-none" accept="image/*" onchange="previewUserAvatar(this)" />
                    <input type="file" id="mobileCameraInput" class="d-none" accept="image/*" capture="user" onchange="previewUserAvatar(this)" />
                    <input asp-for="CapturedProfilePictureBase64" type="hidden" id="capturedPhotoInput" />
                </div>

                <!-- Name Row (2 Columns) -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="FirstName" class="modern-label">First Name</label>
                            <div class="input-icon-box">
                                <input asp-for="FirstName" id="regFirstName" class="modern-form-control" placeholder="e.g. Ramesh" />
                                <i class="bi bi-person input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="LastName" class="modern-label">Last Name</label>
                            <div class="input-icon-box">
                                <input asp-for="LastName" id="regLastName" class="modern-form-control" placeholder="e.g. Patel" />
                                <i class="bi bi-person input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Username & Email Row -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Username" class="modern-label">Username</label>
                            <div class="input-icon-box">
                                <input asp-for="Username" id="regUsername" class="modern-form-control" placeholder="e.g. ramesh99" />
                                <i class="bi bi-at input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Email" class="modern-label">Email Address</label>
                            <div class="input-icon-box">
                                <input asp-for="Email" id="regEmail" class="modern-form-control" placeholder="e.g. name@example.com" />
                                <i class="bi bi-envelope input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="modern-input-group">
                    <label asp-for="PhoneNumber" class="modern-label">Phone Number</label>
                    <div class="input-icon-box">
                        <input asp-for="PhoneNumber" id="regPhone" class="modern-form-control" placeholder="e.g. +91 98765 43210" />
                        <i class="bi bi-telephone input-leading-icon"></i>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Passwords Row -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Password" class="modern-label">Password</label>
                            <div class="input-icon-box" style="position: relative; display: flex; align-items: center; width: 100%;">
                                <input asp-for="Password" type="password" id="regPassword" class="modern-form-control" placeholder="Min. 6 chars" autocomplete="new-password" style="width: 100% !important; padding-left: 42px !important; padding-right: 48px !important; height: 44px !important; box-sizing: border-box !important;" />
                                <i class="bi bi-lock input-leading-icon" style="position: absolute !important; left: 14px !important; top: 50% !important; transform: translateY(-50%) !important; pointer-events: none !important; font-size: 1rem !important; color: #94a3b8 !important; z-index: 2 !important; margin: 0 !important;"></i>
                                <button type="button" class="password-toggle-btn toggle-pwd" data-target="regPassword" tabindex="-1" aria-label="Toggle password visibility" title="Show/Hide password" style="position: absolute !important; right: 12px !important; top: 50% !important; transform: translateY(-50%) !important; width: 32px !important; height: 32px !important; border: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; color: #64748b !important; font-size: 1.15rem !important; z-index: 10 !important; border-radius: 50% !important; outline: none !important; line-height: 1 !important;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="ConfirmPassword" class="modern-label">Confirm Password</label>
                            <div class="input-icon-box" style="position: relative; display: flex; align-items: center; width: 100%;">
                                <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="modern-form-control" placeholder="Repeat password" autocomplete="new-password" style="width: 100% !important; padding-left: 42px !important; padding-right: 48px !important; height: 44px !important; box-sizing: border-box !important;" />
                                <i class="bi bi-shield-lock input-leading-icon" style="position: absolute !important; left: 14px !important; top: 50% !important; transform: translateY(-50%) !important; pointer-events: none !important; font-size: 1rem !important; color: #94a3b8 !important; z-index: 2 !important; margin: 0 !important;"></i>
                                <button type="button" class="password-toggle-btn toggle-pwd" data-target="regConfirmPassword" tabindex="-1" aria-label="Toggle password visibility" title="Show/Hide password" style="position: absolute !important; right: 12px !important; top: 50% !important; transform: translateY(-50%) !important; width: 32px !important; height: 32px !important; border: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; color: #64748b !important; font-size: 1.15rem !important; z-index: 10 !important; border-radius: 50% !important; outline: none !important; line-height: 1 !important;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div id="step1ErrorAlert" class="alert alert-danger alert-dismissible fade show small p-2.5 mb-3 rounded-4 shadow-sm d-none align-items-center justify-content-between position-relative" role="alert">
                    <div class="d-flex align-items-center gap-2 pe-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-6"></i> 
                        <span id="step1ErrorMsg"></span>
                    </div>
                    <button type="button" class="btn-close p-2 shadow-none position-absolute top-50 end-0 translate-middle-y me-2" onclick="document.getElementById('step1ErrorAlert').classList.add('d-none'); document.getElementById('step1ErrorAlert').classList.remove('d-flex');" aria-label="Close"></button>
                </div>

                <!-- Action Button: Customer Direct Submit -->
                <button type="button" id="btnCustomerSubmit" class="btn-register-submit" onclick="triggerRegistrationProcess()">
                    <span>Create Customer Account</span>
                    <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                </button>

                <!-- Action Button: Farmer Step 2 Trigger -->
                <button type="button" id="btnGoToStep2" class="btn-register-submit" style="display: none;" onclick="goToStep2()">
                    <span>Continue to Step 2: KYC &amp; Bank Details</span>
                    <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                </button>
            </div>

            <!-- ==================================================== -->
            <!-- STEP 2: Farmer Verification & Bank Payout (Step 2)   -->
            <!-- ==================================================== -->
            <div id="registerStep2" style="display: none;">
                
                

                <!-- Farm Location Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="City" class="modern-label">Village / Taluka / District</label>
                            <div class="input-icon-box">
                                <input asp-for="City" class="modern-form-control" placeholder="e.g. Gondal, Rajkot" />
                                <i class="bi bi-geo-alt input-leading-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Address" class="modern-label">Farm / Street Location</label>
                            <div class="input-icon-box">
                                <input asp-for="Address" class="modern-form-control" placeholder="e.g. Survey No. 42, Farm Road" />
                                <i class="bi bi-pin-map input-leading-icon"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bank Details Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankName" class="modern-label">Bank Name</label>
                            <div class="input-icon-box">
                                <select asp-for="BankName" id="regBankNameSelect" class="modern-form-control pe-4" style="cursor: pointer;">
                                    <option value="">-- Select Your Bank (બેંક પસંદ કરો) --</option>
                                    <optgroup label="🏛️ Public Sector Banks (સરકારી બેંકો)">
                                        <option value="State Bank of India (SBI)">State Bank of India (SBI)</option>
                                        <option value="Bank of Baroda (BOB)">Bank of Baroda (BOB)</option>
                                        <option value="Punjab National Bank (PNB)">Punjab National Bank (PNB)</option>
                                        <option value="Canara Bank">Canara Bank</option>
                                        <option value="Union Bank of India">Union Bank of India</option>
                                        <option value="Bank of India (BOI)">Bank of India (BOI)</option>
                                        <option value="Central Bank of India">Central Bank of India</option>
                                        <option value="Indian Bank">Indian Bank</option>
                                        <option value="Indian Overseas Bank">Indian Overseas Bank</option>
                                        <option value="UCO Bank">UCO Bank</option>
                                        <option value="Bank of Maharashtra">Bank of Maharashtra</option>
                                        <option value="Punjab & Sind Bank">Punjab &amp; Sind Bank</option>
                                    </optgroup>
                                    <optgroup label="🏢 Private Sector Banks (ખાનગી બેંકો)">
                                        <option value="HDFC Bank">HDFC Bank</option>
                                        <option value="ICICI Bank">ICICI Bank</option>
                                        <option value="Axis Bank">Axis Bank</option>
                                        <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
                                        <option value="IndusInd Bank">IndusInd Bank</option>
                                        <option value="Federal Bank">Federal Bank</option>
                                        <option value="IDBI Bank">IDBI Bank</option>
                                        <option value="Yes Bank">Yes Bank</option>
                                        <option value="Bandhan Bank">Bandhan Bank</option>
                                        <option value="AU Small Finance Bank">AU Small Finance Bank</option>
                                    </optgroup>
                                    <optgroup label="🌾 Regional Rural / Gramin Banks (ખેડૂત ગ્રામીણ બેંક)">
                                        <option value="Saurashtra Gramin Bank">Saurashtra Gramin Bank</option>
                                        <option value="Baroda Gujarat Gramin Bank (BGGB)">Baroda Gujarat Gramin Bank (BGGB)</option>
                                    </optgroup>
                                    <optgroup label="🤝 Gujarat District Co-operative Banks (સહકારી બેંકો)">
                                        <option value="Gujarat State Co-operative Bank (GSC Bank)">Gujarat State Co-operative Bank (GSC Bank)</option>
                                        <option value="Rajkot District Co-operative Bank (RDC Bank)">Rajkot District Co-operative Bank (RDC Bank)</option>
                                        <option value="Ahmedabad District Co-operative Bank (ADC Bank)">Ahmedabad District Co-operative Bank (ADC Bank)</option>
                                        <option value="Surat District Co-operative Bank">Surat District Co-operative Bank</option>
                                        <option value="Mehsana Urban Co-operative Bank">Mehsana Urban Co-operative Bank</option>
                                        <option value="Banaskantha District Central Co-op Bank">Banaskantha District Central Co-op Bank</option>
                                        <option value="Sabarkantha District Central Co-op Bank">Sabarkantha District Central Co-op Bank</option>
                                        <option value="Kheda District Central Co-operative Bank">Kheda District Central Co-operative Bank</option>
                                        <option value="Vadodara District Central Co-op Bank">Vadodara District Central Co-op Bank</option>
                                        <option value="Amreli Jilla Madhyastha Sahakari Bank">Amreli Jilla Madhyastha Sahakari Bank</option>
                                        <option value="Bhavnagar District Co-operative Bank">Bhavnagar District Co-operative Bank</option>
                                        <option value="Junagadh Jilla Sahakari Bank">Junagadh Jilla Sahakari Bank</option>
                                        <option value="Jamnagar District Co-operative Bank">Jamnagar District Co-operative Bank</option>
                                        <option value="Bharuch District Central Co-op Bank">Bharuch District Central Co-op Bank</option>
                                        <option value="Panchmahal District Co-op Bank">Panchmahal District Co-op Bank</option>
                                    </optgroup>
                                    <optgroup label="📮 Payment & Post Banks">
                                        <option value="India Post Payments Bank (IPPB)">India Post Payments Bank (IPPB)</option>
                                        <option value="Airtel Payments Bank">Airtel Payments Bank</option>
                                        <option value="Paytm Payments Bank">Paytm Payments Bank</option>
                                        <option value="Fino Payments Bank">Fino Payments Bank</option>
                                    </optgroup>
                                    <optgroup label="✨ Other Bank">
                                        <option value="Other Bank">Other Bank (અન્ય બેંક)</option>
                                    </optgroup>
                                </select>
                                <i class="bi bi-bank input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="BankName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankAccountNumber" class="modern-label">Bank Account Number</label>
                            <div class="input-icon-box">
                                <input asp-for="BankAccountNumber" class="modern-form-control" placeholder="e.g. 123456789012" />
                                <i class="bi bi-credit-card input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="BankAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- IFSC & UPI Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankIfscCode" class="modern-label">IFSC Code</label>
                            <div class="input-icon-box">
                                <input asp-for="BankIfscCode" class="modern-form-control text-uppercase" placeholder="e.g. SBIN0001234" />
                                <i class="bi bi-hash input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="BankIfscCode" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="UpiId" class="modern-label">UPI ID (Optional)</label>
                            <div class="input-icon-box">
                                <input asp-for="UpiId" class="modern-form-control" placeholder="e.g. 9876543210@upi" />
                                <i class="bi bi-qr-code input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="UpiId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Document Upload Row -->
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <div class="modern-input-group">
                            <label asp-for="KycDocumentType" class="modern-label">KYC Document Type</label>
                            <select asp-for="KycDocumentType" class="modern-form-control pe-4" style="cursor: pointer;">
                                <option value="7/12 (Satbara Utaro)">7/12 (Satbara Utaro)</option>
                                <option value="Aadhaar Card">Aadhaar Card</option>
                                <option value="Kisan Credit Card (KCC)">Kisan Credit Card (KCC)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="modern-input-group">
                            <label asp-for="KycDocumentFile" class="modern-label">Upload 7/12 or Aadhaar Photo/PDF</label>
                            <div class="input-icon-box">
                                <input asp-for="KycDocumentFile" type="file" class="modern-form-control" accept="image/*,.pdf" />
                                <i class="bi bi-file-earmark-arrow-up input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="KycDocumentFile" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons: Back to Step 1 and Submit Registration -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill py-2.5 px-4 fw-bold small" onclick="goToStep1()">
                        <i class="bi bi-arrow-left me-1"></i> Back to Step 1
                    </button>
                    <button type="button" id="btnFarmerSubmit" class="btn-register-submit flex-grow-1 m-0" onclick="triggerRegistrationProcess()">
                        <span>Submit Farmer Registration</span>
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </button>
                </div>
            </div>

            <!-- Bottom Link -->
            <div class="register-bottom-text">
                <span>Already have an account?</span>
                <a asp-action="Login">Log In Here</a>
            </div>
        </form>
    </div>
</div>

