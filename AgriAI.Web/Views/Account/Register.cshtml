@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let cameraStream = null;
        let capturedDataUrl = null;

        // Auto-update Avatar initials dynamically from First & Last Name
        const fnInput = document.getElementById('regFirstName');
        const lnInput = document.getElementById('regLastName');
        const avatarImg = document.getElementById('avatarPreview');

        function updateAvatarInitials() {
            if (capturedDataUrl || (document.getElementById('profilePicInput')?.files?.length > 0)) {
                return; // Don't override real image
            }
            const fn = fnInput?.value.trim() || '';
            const ln = lnInput?.value.trim() || '';
            const name = (fn + ' ' + ln).trim() || 'User';
            avatarImg.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=15803d&color=fff&size=128`;
        }

        if (fnInput) fnInput.addEventListener('input', updateAvatarInitials);
        if (lnInput) lnInput.addEventListener('input', updateAvatarInitials);

        // Role-based Farmer Stepper toggle
        const roleCustomer = document.getElementById('roleCustomer');
        const roleFarmer = document.getElementById('roleFarmer');
        const stepper = document.getElementById('farmerWizardStepper');
        const btnCustomerSubmit = document.getElementById('btnCustomerSubmit');
        const btnGoToStep2 = document.getElementById('btnGoToStep2');

        function toggleRoleView() {
            const isFarmer = roleFarmer && roleFarmer.checked;
            if (isFarmer) {
                if (stepper) stepper.style.display = 'flex';
                if (btnGoToStep2) btnGoToStep2.style.display = 'flex';
                if (btnCustomerSubmit) btnCustomerSubmit.style.display = 'none';
            } else {
                if (stepper) stepper.style.display = 'none';
                if (btnGoToStep2) btnGoToStep2.style.display = 'none';
                if (btnCustomerSubmit) btnCustomerSubmit.style.display = 'flex';
                goToStep1();
            }
        }

        if (roleCustomer) roleCustomer.addEventListener('change', toggleRoleView);
        if (roleFarmer) roleFarmer.addEventListener('change', toggleRoleView);
        toggleRoleView();

        // Password Toggle Buttons
        const toggleBtns = document.querySelectorAll('.toggle-pwd');
        toggleBtns.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                const icon = this.querySelector('i');
                if (input && icon) {
                    if (input.type === 'password') {
                        input.type = 'text';
                        if (icon) {
                            icon.classList.remove('bi-eye');
                            icon.classList.add('bi-eye-slash');
                        }
                    } else {
                        input.type = 'password';
                        if (icon) {
                            icon.classList.remove('bi-eye-slash');
                            icon.classList.add('bi-eye');
                        }
                    }
                }
            });
        });

        // ==========================================
        // AUTO-SAVE & RESTORE REGISTRATION FORM DRAFT
        // ==========================================
        const REG_STORAGE_KEY = 'agriai_reg_draft_v2';

        function saveRegistrationDraft() {
            try {
                const roleEl = document.querySelector('input[name="Role"]:checked');
                const draft = {
                    role: roleEl ? roleEl.value : 'Customer',
                    firstName: document.getElementById('regFirstName')?.value || '',
                    lastName: document.getElementById('regLastName')?.value || '',
                    username: document.getElementById('regUsername')?.value || '',
                    email: document.getElementById('regEmail')?.value || '',
                    phone: document.getElementById('regPhone')?.value || '',
                    password: document.getElementById('regPassword')?.value || '',
                    confirmPassword: document.getElementById('regConfirmPassword')?.value || '',
                    city: document.querySelector('input[name="City"]')?.value || '',
                    address: document.querySelector('input[name="Address"]')?.value || '',
                    bankName: document.getElementById('regBankNameSelect')?.value || '',
                    bankAccountNumber: document.querySelector('input[name="BankAccountNumber"]')?.value || '',
                    bankIfscCode: document.querySelector('input[name="BankIfscCode"]')?.value || '',
                    upiId: document.querySelector('input[name="UpiId"]')?.value || '',
                    kycDocumentType: document.querySelector('select[name="KycDocumentType"]')?.value || '',
                    capturedPhotoBase64: document.getElementById('capturedPhotoInput')?.value || '',
                    avatarSrc: document.getElementById('avatarPreview')?.src || '',
                    isStep2Active: (document.getElementById('registerStep2')?.style.display !== 'none')
                };
                localStorage.setItem(REG_STORAGE_KEY, JSON.stringify(draft));
            } catch (err) {
                console.warn('Draft auto-save warning:', err);
            }
        }

        function restoreRegistrationDraft() {
            try {
                const raw = localStorage.getItem(REG_STORAGE_KEY);
                if (!raw) return;
                const draft = JSON.parse(raw);
                if (!draft) return;

                if (draft.firstName && document.getElementById('regFirstName')) document.getElementById('regFirstName').value = draft.firstName;
                if (draft.lastName && document.getElementById('regLastName')) document.getElementById('regLastName').value = draft.lastName;
                if (draft.username && document.getElementById('regUsername')) document.getElementById('regUsername').value = draft.username;
                if (draft.email && document.getElementById('regEmail')) document.getElementById('regEmail').value = draft.email;
                if (draft.phone && document.getElementById('regPhone')) document.getElementById('regPhone').value = draft.phone;
                if (draft.password && document.getElementById('regPassword')) document.getElementById('regPassword').value = draft.password;
                if (draft.confirmPassword && document.getElementById('regConfirmPassword')) document.getElementById('regConfirmPassword').value = draft.confirmPassword;

                if (draft.capturedPhotoBase64 && document.getElementById('capturedPhotoInput')) {
                    document.getElementById('capturedPhotoInput').value = draft.capturedPhotoBase64;
                    capturedDataUrl = draft.capturedPhotoBase64;
                    if (draft.avatarSrc && document.getElementById('avatarPreview')) {
                        document.getElementById('avatarPreview').src = draft.avatarSrc;
                        const badge = document.getElementById('photoTypeBadge');
                        if (badge) badge.style.display = 'block';
                        const removeBtn = document.getElementById('btnRemovePhoto');
                        if (removeBtn) removeBtn.style.display = 'inline-block';
                        const statusTxt = document.getElementById('photoStatusText');
                        if (statusTxt) statusTxt.textContent = '📷 Restored profile photo';
                    }
                } else {
                    updateAvatarInitials();
                }

                if (draft.city && document.querySelector('input[name="City"]')) document.querySelector('input[name="City"]').value = draft.city;
                if (draft.address && document.querySelector('input[name="Address"]')) document.querySelector('input[name="Address"]').value = draft.address;
                if (draft.bankName && document.getElementById('regBankNameSelect')) document.getElementById('regBankNameSelect').value = draft.bankName;
                if (draft.bankAccountNumber && document.querySelector('input[name="BankAccountNumber"]')) document.querySelector('input[name="BankAccountNumber"]').value = draft.bankAccountNumber;
                if (draft.bankIfscCode && document.querySelector('input[name="BankIfscCode"]')) document.querySelector('input[name="BankIfscCode"]').value = draft.bankIfscCode;
                if (draft.upiId && document.querySelector('input[name="UpiId"]')) document.querySelector('input[name="UpiId"]').value = draft.upiId;
                if (draft.kycDocumentType && document.querySelector('select[name="KycDocumentType"]')) document.querySelector('select[name="KycDocumentType"]').value = draft.kycDocumentType;

                if (draft.role === 'Farmer') {
                    const farmerRadio = document.getElementById('roleFarmer');
                    if (farmerRadio) {
                        farmerRadio.checked = true;
                        toggleRoleView();
                    }
                    if (draft.isStep2Active) {
                        goToStep2();
                    }
                } else {
                    const customerRadio = document.getElementById('roleCustomer');
                    if (customerRadio) {
                        customerRadio.checked = true;
                        toggleRoleView();
                    }
                }
            } catch (err) {
                console.warn('Draft restore warning:', err);
            }
        }

        // Attach listeners for form inputs & restore draft
        const regFormElement = document.getElementById('registerForm');
        if (regFormElement) {
            regFormElement.addEventListener('input', saveRegistrationDraft);
            regFormElement.addEventListener('change', saveRegistrationDraft);
        }
        document.addEventListener('DOMContentLoaded', restoreRegistrationDraft);

        function goToStep2() {
            const errorAlert = document.getElementById('step1ErrorAlert');
            const errorMsg = document.getElementById('step1ErrorMsg');
            const fn = document.getElementById('regFirstName')?.value.trim();
            const ln = document.getElementById('regLastName')?.value.trim();
            const un = document.getElementById('regUsername')?.value.trim();
            const em = document.getElementById('regEmail')?.value.trim();
            const password = document.getElementById('regPassword')?.value;
            const confirmPass = document.getElementById('regConfirmPassword')?.value;

            // Check mandatory profile photo
            const hasProfilePhoto = (capturedDataUrl && capturedDataUrl.length > 100) || 
                                    (document.getElementById('capturedPhotoInput')?.value?.length > 100) ||
                                    (document.getElementById('profilePicInput')?.files?.length > 0) ||
                                    (document.getElementById('mobileCameraInput')?.files?.length > 0);

            if (!hasProfilePhoto) {
                if (errorMsg) errorMsg.textContent = 'Profile photo is mandatory. Please capture via Camera or Upload an image. / પ્રોફાઇલ ફોટો ઉમેરવો ફરજિયાત છે.';
                if (errorAlert) {
                    errorAlert.classList.remove('d-none');
                    errorAlert.classList.add('d-flex');
                }
                const avatarBox = document.getElementById('avatarPreview');
                if (avatarBox) avatarBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            if (!fn || !ln || !un || !em || !password || !confirmPass) {
                if (errorMsg) errorMsg.textContent = 'Please fill in all mandatory account details (Name, Username, Email, Password) to proceed.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (password.length < 6) {
                if (errorMsg) errorMsg.textContent = 'Password must be at least 6 characters long.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (password !== confirmPass) {
                if (errorMsg) errorMsg.textContent = 'Password and Confirm Password do not match.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (errorAlert) errorAlert.classList.add('d-none');

            // Switch to Step 2
            const step1 = document.getElementById('registerStep1');
            const step2 = document.getElementById('registerStep2');
            if (step1) step1.style.display = 'none';
            if (step2) step2.style.display = 'block';

            // Update Stepper indicators
            const ind1 = document.getElementById('stepIndicator1');
            const ind2 = document.getElementById('stepIndicator2');
            const circle1 = document.getElementById('stepCircle1');
            const circle2 = document.getElementById('stepCircle2');

            if (ind1) {
                ind1.classList.remove('active');
                ind1.classList.add('completed');
            }
            if (circle1) circle1.innerHTML = '<i class="bi bi-check-lg"></i>';

            if (ind2) ind2.classList.add('active');
            if (circle2) circle2.innerHTML = '2';

            // Smooth scroll to top of card
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function goToStep1() {
            const step1 = document.getElementById('registerStep1');
            const step2 = document.getElementById('registerStep2');
            if (step2) step2.style.display = 'none';
            if (step1) step1.style.display = 'block';

            const ind1 = document.getElementById('stepIndicator1');
            const ind2 = document.getElementById('stepIndicator2');
            const circle1 = document.getElementById('stepCircle1');
            const circle2 = document.getElementById('stepCircle2');

            if (ind1) {
                ind1.classList.remove('completed');
                ind1.classList.add('active');
            }
            if (circle1) circle1.innerHTML = '1';

            if (ind2) ind2.classList.remove('active');
            if (circle2) circle2.innerHTML = '2';
        }

        // ==========================================
        // DUAL PHOTO SELECTION (CAMERA & FILE UPLOAD)
        // ==========================================

        function previewUserAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarImg.src = e.target.result;
                    capturedDataUrl = null;
                    document.getElementById('capturedPhotoInput').value = '';
                    document.getElementById('photoTypeBadge').style.display = 'block';
                    document.getElementById('btnRemovePhoto').style.display = 'inline-block';
                    document.getElementById('photoStatusText').textContent = '📁 File photo selected: ' + input.files[0].name;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function resetProfilePhoto() {
            document.getElementById('profilePicInput').value = '';
            document.getElementById('capturedPhotoInput').value = '';
            capturedDataUrl = null;
            document.getElementById('photoTypeBadge').style.display = 'none';
            document.getElementById('btnRemovePhoto').style.display = 'none';
            document.getElementById('photoStatusText').textContent = 'Choose your photo via live camera or local file';
            updateAvatarInitials();
        }

        const cameraModalEl = document.getElementById('cameraCaptureModal');

        if (cameraModalEl) {
            cameraModalEl.addEventListener('shown.bs.modal', function () {
                if (!cameraStream) {
                    startCameraStream();
                }
            });
            cameraModalEl.addEventListener('hidden.bs.modal', function () {
                stopCameraStream();
            });
        }

        function showCameraLoading() {
            const loadingBox = document.getElementById('cameraLoadingBox');
            const overlay = document.getElementById('viewfinderOverlay');
            if (loadingBox) {
                loadingBox.style.display = 'block';
                loadingBox.classList.remove('d-none');
            }
            if (overlay) {
                overlay.style.display = 'none';
                overlay.classList.add('d-none');
            }
        }

        function hideCameraLoading() {
            const loadingBox = document.getElementById('cameraLoadingBox');
            const overlay = document.getElementById('viewfinderOverlay');
            if (loadingBox) {
                loadingBox.style.display = 'none';
                loadingBox.classList.add('d-none');
            }
            if (overlay) {
                overlay.style.display = 'block';
                overlay.classList.remove('d-none');
            }
        }

        async function startCameraStream() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const errorBox = document.getElementById('cameraErrorBox');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');
            const loadingBox = document.getElementById('cameraLoadingBox');

            if (!video) return;

            // Reset UI states
            video.classList.remove('d-none');
            video.style.display = 'block';
            if (canvas) canvas.classList.add('d-none');
            if (errorBox) errorBox.classList.add('d-none');
            if (liveControls) liveControls.classList.remove('d-none');
            if (previewControls) previewControls.classList.add('d-none');

            showCameraLoading();
            stopCameraStream();

            let permissionTimer = setTimeout(() => {
                if (loadingBox) {
                    loadingBox.innerHTML = `
                        <div class="spinner-border text-warning mb-2" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                        <div class="small fw-bold text-warning">Waiting for Permission...</div>
                        <div class="text-white small px-2 mt-1" style="font-size: 0.72rem;">Please click <strong>"Allow"</strong> on the camera prompt in your browser.</div>
                    `;
                }
            }, 1800);

            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error('Camera access is not supported by your browser or requires HTTPS / localhost.');
                }

                // 1. Try standard video constraint first for fastest startup
                let stream = null;
                try {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: { width: { ideal: 640 }, height: { ideal: 480 } },
                        audio: false
                    });
                } catch (e1) {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: true,
                        audio: false
                    });
                }

                clearTimeout(permissionTimer);

                if (!stream) {
                    throw new Error('Unable to connect to camera device.');
                }

                cameraStream = stream;
                video.srcObject = stream;
                video.muted = true;
                video.autoplay = true;
                video.playsInline = true;

                // Event handlers to ensure frame playback
                const onPlaySuccess = () => {
                    hideCameraLoading();
                };

                video.onloadeddata = onPlaySuccess;
                video.onloadedmetadata = () => {
                    video.play().catch(e => console.warn('Play on metadata failed:', e));
                    hideCameraLoading();
                };
                video.onplaying = onPlaySuccess;
                video.oncanplay = onPlaySuccess;

                // Immediate play call
                try {
                    await video.play();
                } catch (playErr) {
                    console.warn('Initial video.play() call:', playErr);
                }

                // Immediately hide loading box once stream object is assigned
                hideCameraLoading();

            } catch (err) {
                clearTimeout(permissionTimer);
                console.error('Camera stream error:', err);
                
                // Hide loading spinner and NEVER show viewfinder overlay on error
                const loadingBox = document.getElementById('cameraLoadingBox');
                if (loadingBox) {
                    loadingBox.style.display = 'none';
                    loadingBox.classList.add('d-none');
                }
                const overlay = document.getElementById('viewfinderOverlay');
                if (overlay) {
                    overlay.style.display = 'none';
                    overlay.classList.add('d-none');
                }
                if (video) video.classList.add('d-none');
                if (errorBox) {
                    errorBox.classList.remove('d-none');
                    errorBox.classList.add('d-flex');
                    errorBox.style.display = 'flex';
                }

                let message = 'Camera access was blocked or unavailable.';
                if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                    message = 'Camera permission was denied. Please click the camera/lock icon in your browser address bar and choose "Allow".';
                } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
                    message = 'No webcam or camera device was found on this system.';
                } else if (err.name === 'NotReadableError' || err.name === 'TrackStartError') {
                    message = 'Camera is already in use by another application (like Zoom/Teams) or Windows privacy settings.';
                } else if (err.message) {
                    message = err.message;
                }
                const errorMsg = document.getElementById('cameraErrorMessage');
                if (errorMsg) errorMsg.textContent = message;
                if (liveControls) liveControls.classList.add('d-none');
            }
        }

        function retryCamera() {
            startCameraStream();
        }

        function useDeviceCameraCapture() {
            stopCameraStream();
            const modalInstance = bootstrap.Modal.getInstance(cameraModalEl);
            if (modalInstance) modalInstance.hide();
            document.getElementById('mobileCameraInput').click();
        }

        function useDeviceFileUpload() {
            stopCameraStream();
            const modalInstance = bootstrap.Modal.getInstance(cameraModalEl);
            if (modalInstance) modalInstance.hide();
            document.getElementById('profilePicInput').click();
        }

        function stopCameraStream() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => {
                    track.stop();
                });
                cameraStream = null;
            }
            const video = document.getElementById('cameraFeed');
            if (video) {
                video.srcObject = null;
            }
        }

        function captureSnapshot() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const overlay = document.getElementById('viewfinderOverlay');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            if (!video || !canvas) return;

            const width = video.videoWidth || 640;
            const height = video.videoHeight || 480;

            canvas.width = width;
            canvas.height = height;

            const ctx = canvas.getContext('2d');
            // Mirror image horizontally to match webcam display
            ctx.translate(width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(video, 0, 0, width, height);

            // Freeze preview
            video.classList.add('d-none');
            canvas.classList.remove('d-none');
            if (overlay) overlay.classList.add('d-none');
            if (liveControls) liveControls.classList.add('d-none');
            if (previewControls) previewControls.classList.remove('d-none');

            capturedDataUrl = canvas.toDataURL('image/jpeg', 0.92);
        }

        function retakeSnapshot() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const overlay = document.getElementById('viewfinderOverlay');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            if (video) video.classList.remove('d-none');
            if (canvas) canvas.classList.add('d-none');
            if (overlay) overlay.classList.remove('d-none');
            if (liveControls) liveControls.classList.remove('d-none');
            if (previewControls) previewControls.classList.add('d-none');
            capturedDataUrl = null;
        }

        function confirmCapturedPhoto() {
            if (capturedDataUrl) {
                if (avatarImg) {
                    avatarImg.src = capturedDataUrl;
                }
                const capInput = document.getElementById('capturedPhotoInput');
                if (capInput) capInput.value = capturedDataUrl;

                const picInput = document.getElementById('profilePicInput');
                if (picInput) picInput.value = ''; // clear file input

                const badge = document.getElementById('photoTypeBadge');
                if (badge) badge.style.display = 'block';

                const removeBtn = document.getElementById('btnRemovePhoto');
                if (removeBtn) removeBtn.style.display = 'inline-block';

                const statusText = document.getElementById('photoStatusText');
                if (statusText) statusText.textContent = '📸 Live Camera snapshot captured successfully!';

                stopCameraStream();

                // 1. Try Bootstrap 5 getOrCreateInstance
                try {
                    if (window.bootstrap && bootstrap.Modal) {
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(cameraModalEl);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                } catch (e) {
                    console.warn('Bootstrap modal hide error:', e);
                }

                // 2. Trigger native close button click
                const closeBtn = cameraModalEl.querySelector('.btn-close') || cameraModalEl.querySelector('[data-bs-dismiss="modal"]');
                if (closeBtn) {
                    closeBtn.click();
                }

                // 3. Try jQuery fallback
                if (window.jQuery && cameraModalEl) {
                    $(cameraModalEl).modal('hide');
                }

                // 4. Force modal backdrop removal if needed
                setTimeout(() => {
                    cameraModalEl.classList.remove('show');
                    cameraModalEl.style.display = 'none';
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('padding-right');
                    document.body.style.removeProperty('overflow');
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                }, 300);
            }
        }
    
        
        /* ============================================================ */
        /* WhatsApp Direct Registration OTP Verification Logic         */
        /* ============================================================ */
        let isOtpVerified = false;
        let otpCountdownTimer = null;
        let currentOtpPhone = '';

        function showStep1Error(msg) {
            const errorAlert = document.getElementById('step1ErrorAlert');
            const errorMsg = document.getElementById('step1ErrorMsg');
            if (errorMsg) errorMsg.textContent = msg;
            if (errorAlert) {
                errorAlert.classList.remove('d-none');
                errorAlert.classList.add('d-flex');
                errorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                alert(msg);
            }
        }

        function triggerRegistrationProcess() {
            const role = document.querySelector('input[name="Role"]:checked')?.value || 'Customer';
            const phoneInput = document.getElementById('regPhone');
            const phoneNumber = phoneInput ? phoneInput.value.trim() : '';

            // Check mandatory profile photo
            const hasProfilePhoto = (capturedDataUrl && capturedDataUrl.length > 100) || 
                                    (document.getElementById('capturedPhotoInput')?.value?.length > 100) ||
                                    (document.getElementById('profilePicInput')?.files?.length > 0) ||
                                    (document.getElementById('mobileCameraInput')?.files?.length > 0);

            if (!hasProfilePhoto) {
                showStep1Error('Profile photo is mandatory. Please capture via Camera or Upload an image. / પ્રોફાઇલ ફોટો ઉમેરવો ફરજિયાત છે.');
                const avatarBox = document.getElementById('avatarPreview');
                if (avatarBox) avatarBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Validate Step 1 fields
            const fName = document.getElementById('regFirstName')?.value.trim();
            const lName = document.getElementById('regLastName')?.value.trim();
            const uName = document.getElementById('regUsername')?.value.trim();
            const email = document.getElementById('regEmail')?.value.trim();
            const pwd = document.getElementById('regPassword')?.value;
            const cPwd = document.getElementById('regConfirmPassword')?.value;

            if (!fName || !lName || !uName || !email || !pwd || !cPwd) {
                showStep1Error('Please fill in all mandatory account details (Name, Username, Email, Password).');
                return;
            }

            if (pwd.length < 6) {
                showStep1Error('Password must be at least 6 characters long.');
                return;
            }

            if (pwd !== cPwd) {
                showStep1Error('Password and Confirm Password do not match.');
                return;
            }

            if (!phoneNumber) {
                showStep1Error('Please enter your 10-digit mobile number.');
                if (phoneInput) phoneInput.focus();
                return;
            }

            const digitsOnly = phoneNumber.replace(/\D/g, '');
            if (digitsOnly.length < 10) {
                showStep1Error('Please enter a valid 10-digit mobile number.');
                if (phoneInput) phoneInput.focus();
                return;
            }

            // If Farmer, validate Step 2 fields
            if (role === 'Farmer') {
                const step2 = document.getElementById('registerStep2');
                if (step2 && step2.style.display === 'none') {
                    goToStep2();
                    return;
                }
                const bankNum = document.getElementById('BankAccountNumber')?.value?.trim();
                const ifsc = document.getElementById('BankIfscCode')?.value?.trim();
                const kycFile = document.getElementById('KycDocumentFile');
                if (!bankNum || !ifsc) {
                    alert('Bank Account Number and IFSC Code are required for Farmer registration.');
                    return;
                }
                if (!kycFile || !kycFile.files || kycFile.files.length === 0) {
                    alert('Please upload your 7/12 (Satbara) or Aadhaar Card document photo or PDF.');
                    return;
                }
            }

            // Hide any previous errors
            const errorAlert = document.getElementById('step1ErrorAlert');
            if (errorAlert) {
                errorAlert.classList.add('d-none');
                errorAlert.classList.remove('d-flex');
            }

            // Button loading state
            const submitBtn = role === 'Farmer'
                ? document.getElementById('btnFarmerSubmit')
                : document.getElementById('btnCustomerSubmit');

            const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span><span>Sending OTP to Email...</span>';
            }

            const formData = new FormData();
            formData.append('phoneNumber', phoneNumber);
            formData.append('username', uName);
            formData.append('email', email);
            formData.append('role', role);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('/Account/SendRegistrationOtp', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }

                if (data.success) {
                    currentOtpPhone = digitsOnly;
                    document.getElementById('otpPhoneDisplay').textContent = data.email || email;
                    document.getElementById('whatsappOtpInput').value = '';
                    document.getElementById('otpErrorAlert').classList.add('d-none');
                    document.getElementById('otpSuccessAlert').classList.add('d-none');

                    // Open OTP Verification Modal
                    const modalEl = document.getElementById('whatsappOtpModal');
                    const otpModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    otpModal.show();

                    setTimeout(() => {
                        const inp = document.getElementById('whatsappOtpInput');
                        if (inp) inp.focus();
                    }, 400);

                    startOtpTimer(45);
                } else {
                    showStep1Error(data.message || 'Could not send verification OTP to Email.');
                }
            })
            .catch(err => {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
                showStep1Error('Network error while connecting to verification service: ' + err.message);
            });
        }

        function verifyOtpAndRegister() {
            const otpInput = document.getElementById('whatsappOtpInput');
            const otp = otpInput ? otpInput.value.trim() : '';

            if (!otp || otp.length < 6) {
                showOtpError('Please enter the 6-digit verification code received in your Email.');
                if (otpInput) otpInput.focus();
                return;
            }

            const btn = document.getElementById('btnConfirmOtp');
            const txt = document.getElementById('btnConfirmOtpText');
            const icon = document.getElementById('btnConfirmOtpIcon');
            const spinner = document.getElementById('btnConfirmOtpSpinner');

            if (btn) btn.disabled = true;
            if (txt) txt.textContent = 'Verifying...';
            if (icon) icon.classList.add('d-none');
            if (spinner) spinner.classList.remove('d-none');

            const formData = new FormData();
            formData.append('phoneNumber', currentOtpPhone);
            formData.append('otp', otp);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('/Account/VerifyRegistrationOtp', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('otpErrorAlert').classList.add('d-none');
                    document.getElementById('otpSuccessAlert').classList.remove('d-none');

                    isOtpVerified = true;

                    setTimeout(() => {
                        const modalEl = document.getElementById('whatsappOtpModal');
                        const otpModal = bootstrap.Modal.getInstance(modalEl);
                        if (otpModal) otpModal.hide();

                        // Clear saved draft and submit the form natively
                        try { localStorage.removeItem(REG_STORAGE_KEY); } catch(e) {}
                        document.getElementById('registerForm').submit();
                    }, 800);
                } else {
                    if (btn) btn.disabled = false;
                    if (txt) txt.textContent = 'Verify & Create Account';
                    if (icon) icon.classList.remove('d-none');
                    if (spinner) spinner.classList.add('d-none');

                    showOtpError(data.message || 'Incorrect OTP code. Please check your Email.');
                    if (otpInput) {
                        otpInput.focus();
                        otpInput.select();
                    }
                }
            })
            .catch(err => {
                if (btn) btn.disabled = false;
                if (txt) txt.textContent = 'Verify & Create Account';
                if (icon) icon.classList.remove('d-none');
                if (spinner) spinner.classList.add('d-none');
                showOtpError('Verification request failed: ' + err.message);
            });
        }

        function startOtpTimer(seconds) {
            if (otpCountdownTimer) clearInterval(otpCountdownTimer);
            let remaining = seconds;
            const secEl = document.getElementById('otpTimerSeconds');
            const resendBtn = document.getElementById('btnResendOtp');
            const timerText = document.getElementById('otpTimerText');

            if (resendBtn) resendBtn.classList.add('disabled');
            if (timerText) timerText.style.display = 'inline-block';

            otpCountdownTimer = setInterval(() => {
                remaining--;
                if (secEl) secEl.textContent = remaining;
                if (remaining <= 0) {
                    clearInterval(otpCountdownTimer);
                    if (resendBtn) resendBtn.classList.remove('disabled');
                    if (timerText) timerText.style.display = 'none';
                }
            }, 1000);
        }

        function resendOtpViaWhatsApp() {
            const resendBtn = document.getElementById('btnResendOtp');
            if (resendBtn && resendBtn.classList.contains('disabled')) return;

            const phoneInput = document.getElementById('regPhone');
            const phoneNumber = phoneInput ? phoneInput.value.trim() : '';
            const role = document.querySelector('input[name="Role"]:checked')?.value || 'Customer';
            const username = document.getElementById('regUsername')?.value || '';
            const email = document.getElementById('regEmail')?.value || '';

            if (resendBtn) {
                resendBtn.classList.add('disabled');
                resendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Resending...';
            }

            const formData = new FormData();
            formData.append('phoneNumber', phoneNumber);
            formData.append('username', username);
            formData.append('email', email);
            formData.append('role', role);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('/Account/SendRegistrationOtp', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (resendBtn) {
                    resendBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Resend Code';
                }
                if (data.success) {
                    document.getElementById('otpErrorAlert').classList.add('d-none');
                    startOtpTimer(45);
                } else {
                    showOtpError(data.message || 'Could not resend OTP.');
                }
            })
            .catch(err => {
                if (resendBtn) {
                    resendBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Resend Code';
                }
                showOtpError('Error resending OTP: ' + err.message);
            });
        }

        function showOtpError(msg) {
            const errBox = document.getElementById('otpErrorAlert');
            const errMsg = document.getElementById('otpErrorMsg');
            if (errMsg) errMsg.textContent = msg;
            if (errBox) errBox.classList.remove('d-none');
        }

        function resetOtpModal() {
            if (otpCountdownTimer) clearInterval(otpCountdownTimer);
            document.getElementById('otpErrorAlert')?.classList.add('d-none');
            document.getElementById('otpSuccessAlert')?.classList.add('d-none');
        }

        // Auto-advance or submit on 6th digit
        document.getElementById('whatsappOtpInput')?.addEventListener('input', function(e) {
            this.value = this.value.replace(/\D/g, '');
            if (this.value.length === 6) {
                verifyOtpAndRegister();
            }
        });

    </script>
}
