@model AgriAI.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create an Account";
}

<div class="register-page-bg">
    <div class="modern-register-card">
        <!-- Brand Icon -->
        <div class="register-brand-icon-box">
            <i class="bi bi-tree-fill"></i>
        </div>

        <!-- Header -->
        <h2 class="register-card-title">Create an Account</h2>
        <p class="register-card-subtext">Join AgriAI to buy fresh farm produce or sell crops with smart AI tools</p>

        <form asp-action="Register" method="post" id="registerForm" enctype="multipart/form-data">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger alert-dismissible fade show small p-3 mb-3 rounded-4 shadow-sm position-relative" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-circle-fill text-danger fs-5 mt-0.5"></i>
                        <div class="pe-4">
                            <div asp-validation-summary="ModelOnly" class="mb-0 text-danger fw-medium"></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close p-2.5 shadow-none position-absolute top-0 end-0 m-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Farmer 2-Step Progress Stepper (Visible when Farmer role is selected) -->
            <div id="farmerWizardStepper" class="reg-stepper-container" style="display: none;">
                <div class="reg-step-item active" id="stepIndicator1">
                    <div class="reg-step-circle" id="stepCircle1">1</div>
                    <span>Account Profile</span>
                </div>
                <div class="reg-step-line" id="stepLine1"></div>
                <div class="reg-step-item" id="stepIndicator2">
                    <div class="reg-step-circle" id="stepCircle2">2</div>
                    <span>KYC &amp; Bank Details</span>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- STEP 1: Basic Account Profile Information -->
            <!-- ========================================== -->
            <div id="registerStep1">
                <!-- Native Interactive Role Selection Cards -->
                <div class="role-selection-wrapper">
                    <label class="modern-label">Choose your account type:</label>
                    <div class="role-cards-grid">
                        <!-- Customer Radio Card -->
                        <input type="radio" asp-for="Role" value="Customer" id="roleCustomer" class="btn-check" checked />
                        <label class="role-card-option" for="roleCustomer">
                            <div class="role-icon-box">
                                <i class="bi bi-cart-check-fill"></i>
                            </div>
                            <div>
                                <h6 class="role-title">Customer</h6>
                                <p class="role-desc">Buy fresh farm produce</p>
                            </div>
                            <div class="role-radio-badge"></div>
                        </label>

                        <!-- Farmer Radio Card -->
                        <input type="radio" asp-for="Role" value="Farmer" id="roleFarmer" class="btn-check" />
                        <label class="role-card-option" for="roleFarmer">
                            <div class="role-icon-box">
                                <i class="bi bi-tree-fill"></i>
                            </div>
                            <div>
                                <h6 class="role-title">Farmer</h6>
                                <p class="role-desc">Sell crops &amp; use AI tools</p>
                            </div>
                            <div class="role-radio-badge"></div>
                        </label>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Super Compact Profile Photo Selector (Space-Saving Row) -->
                <div class="d-flex align-items-center justify-content-between p-2 px-3 bg-light rounded-4 border mb-2.5">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="position-relative d-inline-block">
                            <img id="avatarPreview" src="https://ui-avatars.com/api/?name=User&background=15803d&color=fff&size=128" 
                                 class="rounded-circle border border-2 border-success shadow-sm" style="width: 44px; height: 44px; object-fit: cover;" alt="Profile Avatar" />
                            <span id="photoTypeBadge" class="badge bg-success position-absolute bottom-0 end-0 rounded-circle p-0.5 shadow border border-white" style="display: none; width: 14px; height: 14px; font-size: 0.55rem;" title="Photo selected">
                                <i class="bi bi-check"></i>
                            </span>
                        </div>
                        <div class="lh-sm text-start">
                            <strong class="text-dark small d-block" style="font-size: 0.82rem;">Profile Photo <span class="text-muted fw-normal" style="font-size: 0.70rem;">(Optional)</span></strong>
                            <small class="text-muted" id="photoStatusText" style="font-size: 0.70rem;">Camera or local file upload</small>
                        </div>
                    </div>

                    <!-- Compact Action Buttons -->
                    <div class="d-flex align-items-center gap-1.5">
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-2.5 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.76rem;" data-bs-toggle="modal" data-bs-target="#cameraCaptureModal" onclick="openLiveCameraModal()" title="Take Photo with Camera">
                            <i class="bi bi-camera-fill"></i>
                            <span>Camera</span>
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-2.5 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.76rem;" onclick="document.getElementById('profilePicInput').click()" title="Upload File from Device">
                            <i class="bi bi-folder-fill"></i>
                            <span>Upload</span>
                        </button>

                        <button type="button" id="btnRemovePhoto" class="btn btn-sm text-danger p-0 ms-1" style="display: none; font-size: 0.90rem;" onclick="resetProfilePhoto()" title="Remove Photo">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>

                    <!-- Hidden Inputs for File Upload, Native Camera & Camera Base64 -->
                    <input asp-for="ProfilePictureFile" type="file" id="profilePicInput" class="d-none" accept="image/*" onchange="previewUserAvatar(this)" />
                    <input type="file" id="mobileCameraInput" class="d-none" accept="image/*" capture="user" onchange="previewUserAvatar(this)" />
                    <input asp-for="CapturedProfilePictureBase64" type="hidden" id="capturedPhotoInput" />
                </div>

                <!-- Name Row (2 Columns) -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="FirstName" class="modern-label">First Name</label>
                            <div class="input-icon-box">
                                <input asp-for="FirstName" id="regFirstName" class="modern-form-control" placeholder="e.g. Ramesh" />
                                <i class="bi bi-person input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="LastName" class="modern-label">Last Name</label>
                            <div class="input-icon-box">
                                <input asp-for="LastName" id="regLastName" class="modern-form-control" placeholder="e.g. Patel" />
                                <i class="bi bi-person input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Username & Email Row -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Username" class="modern-label">Username</label>
                            <div class="input-icon-box">
                                <input asp-for="Username" id="regUsername" class="modern-form-control" placeholder="e.g. ramesh99" />
                                <i class="bi bi-at input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Email" class="modern-label">Email Address</label>
                            <div class="input-icon-box">
                                <input asp-for="Email" id="regEmail" class="modern-form-control" placeholder="e.g. name@example.com" />
                                <i class="bi bi-envelope input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="modern-input-group">
                    <label asp-for="PhoneNumber" class="modern-label">Phone Number</label>
                    <div class="input-icon-box">
                        <input asp-for="PhoneNumber" id="regPhone" class="modern-form-control" placeholder="e.g. +91 98765 43210" />
                        <i class="bi bi-telephone input-leading-icon"></i>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Passwords Row -->
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Password" class="modern-label">Password</label>
                            <div class="input-icon-box">
                                <input asp-for="Password" type="password" id="regPassword" class="modern-form-control pe-5" placeholder="Min. 6 chars" />
                                <i class="bi bi-lock input-leading-icon"></i>
                                <button type="button" class="password-toggle-btn toggle-pwd" data-target="regPassword" tabindex="-1" aria-label="Toggle password visibility">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="ConfirmPassword" class="modern-label">Confirm Password</label>
                            <div class="input-icon-box">
                                <input asp-for="ConfirmPassword" type="password" id="regConfirmPassword" class="modern-form-control pe-5" placeholder="Repeat password" />
                                <i class="bi bi-shield-lock input-leading-icon"></i>
                                <button type="button" class="password-toggle-btn toggle-pwd" data-target="regConfirmPassword" tabindex="-1" aria-label="Toggle password visibility">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div id="step1ErrorAlert" class="alert alert-danger alert-dismissible fade show small p-2.5 mb-3 rounded-4 shadow-sm d-none align-items-center justify-content-between position-relative" role="alert">
                    <div class="d-flex align-items-center gap-2 pe-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-6"></i> 
                        <span id="step1ErrorMsg"></span>
                    </div>
                    <button type="button" class="btn-close p-2 shadow-none position-absolute top-50 end-0 translate-middle-y me-2" onclick="document.getElementById('step1ErrorAlert').classList.add('d-none'); document.getElementById('step1ErrorAlert').classList.remove('d-flex');" aria-label="Close"></button>
                </div>

                <!-- Action Button: Customer Direct Submit -->
                <button type="submit" id="btnCustomerSubmit" class="btn-register-submit">
                    <span>Create Customer Account</span>
                    <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                </button>

                <!-- Action Button: Farmer Step 2 Trigger -->
                <button type="button" id="btnGoToStep2" class="btn-register-submit" style="display: none;" onclick="goToStep2()">
                    <span>Continue to Step 2: KYC &amp; Bank Details</span>
                    <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                </button>
            </div>

            <!-- ==================================================== -->
            <!-- STEP 2: Farmer Verification & Bank Payout (Step 2)   -->
            <!-- ==================================================== -->
            <div id="registerStep2" style="display: none;">
                
                <div class="d-flex align-items-center justify-content-between p-2.5 mb-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-0 small">Farmer Verification &amp; Bank Payout Setup</h6>
                            <span class="text-muted" style="font-size: 0.72rem;">Bank account for sale payouts &amp; 7/12 land verification</span>
                        </div>
                    </div>
                    <span class="badge bg-success text-white px-2.5 py-1 rounded-pill small">Step 2 of 2</span>
                </div>

                <!-- Farm Location Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="City" class="modern-label">Village / Taluka / District</label>
                            <div class="input-icon-box">
                                <input asp-for="City" class="modern-form-control" placeholder="e.g. Gondal, Rajkot" />
                                <i class="bi bi-geo-alt input-leading-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="Address" class="modern-label">Farm / Street Location</label>
                            <div class="input-icon-box">
                                <input asp-for="Address" class="modern-form-control" placeholder="e.g. Survey No. 42, Farm Road" />
                                <i class="bi bi-pin-map input-leading-icon"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bank Details Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankName" class="modern-label">Bank Name</label>
                            <div class="input-icon-box">
                                <input asp-for="BankName" class="modern-form-control" placeholder="e.g. State Bank of India / HDFC" />
                                <i class="bi bi-bank input-leading-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankAccountNumber" class="modern-label">Bank Account Number</label>
                            <div class="input-icon-box">
                                <input asp-for="BankAccountNumber" class="modern-form-control" placeholder="e.g. 123456789012" />
                                <i class="bi bi-credit-card input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="BankAccountNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- IFSC & UPI Row -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="BankIfscCode" class="modern-label">IFSC Code</label>
                            <div class="input-icon-box">
                                <input asp-for="BankIfscCode" class="modern-form-control text-uppercase" placeholder="e.g. SBIN0001234" />
                                <i class="bi bi-hash input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="BankIfscCode" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="modern-input-group">
                            <label asp-for="UpiId" class="modern-label">UPI ID (Optional)</label>
                            <div class="input-icon-box">
                                <input asp-for="UpiId" class="modern-form-control" placeholder="e.g. 9876543210@upi" />
                                <i class="bi bi-qr-code input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="UpiId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Document Upload Row -->
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <div class="modern-input-group">
                            <label asp-for="KycDocumentType" class="modern-label">KYC Document Type</label>
                            <select asp-for="KycDocumentType" class="modern-form-control pe-4" style="cursor: pointer;">
                                <option value="7/12 (Satbara Utaro)">7/12 (Satbara Utaro)</option>
                                <option value="Aadhaar Card">Aadhaar Card</option>
                                <option value="Kisan Credit Card (KCC)">Kisan Credit Card (KCC)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="modern-input-group">
                            <label asp-for="KycDocumentFile" class="modern-label">Upload 7/12 or Aadhaar Photo/PDF</label>
                            <div class="input-icon-box">
                                <input asp-for="KycDocumentFile" type="file" class="modern-form-control" accept="image/*,.pdf" />
                                <i class="bi bi-file-earmark-arrow-up input-leading-icon"></i>
                            </div>
                            <span asp-validation-for="KycDocumentFile" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons: Back to Step 1 and Submit Registration -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill py-2.5 px-4 fw-bold small" onclick="goToStep1()">
                        <i class="bi bi-arrow-left me-1"></i> Back to Step 1
                    </button>
                    <button type="submit" class="btn-register-submit flex-grow-1 m-0">
                        <span>Submit Farmer Registration</span>
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </button>
                </div>
            </div>

            <!-- Bottom Link -->
            <div class="register-bottom-text">
                <span>Already have an account?</span>
                <a asp-action="Login">Log In Here</a>
            </div>
        </form>
    </div>
</div>

<!-- Live Camera Capture Modal -->
<div class="modal fade" id="cameraCaptureModal" tabindex="-1" aria-labelledby="cameraCaptureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom py-3 px-4 bg-white d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 fs-5">
                        <i class="bi bi-camera-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark" id="cameraCaptureModalLabel">Take Profile Photo</h6>
                        <small class="text-muted" style="font-size: 0.72rem;">Align your face within the frame</small>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3 p-md-4 text-center bg-light">
                <!-- Camera Viewfinder Box -->
                <div class="position-relative overflow-hidden rounded-4 shadow-sm bg-dark mx-auto" style="max-width: 360px; height: 270px;">
                    <video id="cameraFeed" autoplay playsinline muted class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);"></video>
                    <canvas id="photoCanvas" class="w-100 h-100 d-none" style="object-fit: cover;"></canvas>
                    
                    <!-- Viewfinder Overlay Circle -->
                    <div id="viewfinderOverlay" class="position-absolute top-50 start-50 translate-middle rounded-circle border border-2 border-white border-opacity-75" 
                         style="width: 180px; height: 180px; box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35); pointer-events: none;">
                    </div>

                    <!-- Camera Error Notice -->
                    <div id="cameraErrorBox" class="position-absolute top-50 start-50 translate-middle w-100 px-3 d-none text-white text-center">
                        <i class="bi bi-camera-video-off display-6 text-danger mb-2 d-block"></i>
                        <span class="small fw-semibold d-block mb-2" id="cameraErrorMessage">Camera permission denied or camera not found.</span>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1 fw-bold shadow-sm" onclick="document.getElementById('mobileCameraInput').click(); if (cameraModal) cameraModal.hide();">
                            <i class="bi bi-camera me-1"></i> Use Device Camera
                        </button>
                    </div>
                </div>

                <div class="mt-2 text-muted small" id="cameraInstructionText" style="font-size: 0.75rem;">
                    Look directly at the camera and click <strong>Capture Photo</strong>.
                </div>
            </div>

            <div class="modal-footer border-top bg-white py-3 px-4 d-flex justify-content-between">
                <!-- State 1: Live Stream Controls -->
                <div id="cameraLiveControls" class="d-flex justify-content-between w-100">
                    <button type="button" class="btn btn-light rounded-pill px-3 py-2 text-muted border" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" id="btnCapturePhoto" onclick="captureSnapshot()">
                        <i class="bi bi-camera-fill"></i>
                        <span>Capture Photo</span>
                    </button>
                </div>

                <!-- State 2: Preview & Confirm Controls -->
                <div id="cameraPreviewControls" class="d-flex justify-content-between w-100 d-none">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-1" onclick="retakeSnapshot()">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Retake</span>
                    </button>
                    <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" style="background-color: #006653;" onclick="confirmCapturedPhoto()">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Use This Photo</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let cameraStream = null;
        let capturedDataUrl = null;

        // Auto-update Avatar initials dynamically from First & Last Name
        const fnInput = document.getElementById('regFirstName');
        const lnInput = document.getElementById('regLastName');
        const avatarImg = document.getElementById('avatarPreview');

        function updateAvatarInitials() {
            if (capturedDataUrl || (document.getElementById('profilePicInput')?.files?.length > 0)) {
                return; // Don't override real image
            }
            const fn = fnInput?.value.trim() || '';
            const ln = lnInput?.value.trim() || '';
            const name = (fn + ' ' + ln).trim() || 'User';
            avatarImg.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=15803d&color=fff&size=128`;
        }

        if (fnInput) fnInput.addEventListener('input', updateAvatarInitials);
        if (lnInput) lnInput.addEventListener('input', updateAvatarInitials);

        // Role-based Farmer Stepper toggle
        const roleCustomer = document.getElementById('roleCustomer');
        const roleFarmer = document.getElementById('roleFarmer');
        const stepper = document.getElementById('farmerWizardStepper');
        const btnCustomerSubmit = document.getElementById('btnCustomerSubmit');
        const btnGoToStep2 = document.getElementById('btnGoToStep2');

        function toggleRoleView() {
            const isFarmer = roleFarmer && roleFarmer.checked;
            if (isFarmer) {
                if (stepper) stepper.style.display = 'flex';
                if (btnGoToStep2) btnGoToStep2.style.display = 'flex';
                if (btnCustomerSubmit) btnCustomerSubmit.style.display = 'none';
            } else {
                if (stepper) stepper.style.display = 'none';
                if (btnGoToStep2) btnGoToStep2.style.display = 'none';
                if (btnCustomerSubmit) btnCustomerSubmit.style.display = 'flex';
                goToStep1();
            }
        }

        if (roleCustomer) roleCustomer.addEventListener('change', toggleRoleView);
        if (roleFarmer) roleFarmer.addEventListener('change', toggleRoleView);
        toggleRoleView();

        // Password Toggle Buttons
        const toggleBtns = document.querySelectorAll('.toggle-pwd');
        toggleBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                const icon = this.querySelector('i');
                if (input && icon) {
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                }
            });
        });

        function goToStep2() {
            const errorAlert = document.getElementById('step1ErrorAlert');
            const errorMsg = document.getElementById('step1ErrorMsg');
            const fn = document.getElementById('regFirstName')?.value.trim();
            const ln = document.getElementById('regLastName')?.value.trim();
            const un = document.getElementById('regUsername')?.value.trim();
            const em = document.getElementById('regEmail')?.value.trim();
            const password = document.getElementById('regPassword')?.value;
            const confirmPass = document.getElementById('regConfirmPassword')?.value;

            if (!fn || !ln || !un || !em || !password || !confirmPass) {
                if (errorMsg) errorMsg.textContent = 'Please fill in all mandatory account details (Name, Username, Email, Password) to proceed.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (password.length < 6) {
                if (errorMsg) errorMsg.textContent = 'Password must be at least 6 characters long.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (password !== confirmPass) {
                if (errorMsg) errorMsg.textContent = 'Password and Confirm Password do not match.';
                if (errorAlert) errorAlert.classList.remove('d-none');
                return;
            }

            if (errorAlert) errorAlert.classList.add('d-none');

            // Switch to Step 2
            const step1 = document.getElementById('registerStep1');
            const step2 = document.getElementById('registerStep2');
            if (step1) step1.style.display = 'none';
            if (step2) step2.style.display = 'block';

            // Update Stepper indicators
            const ind1 = document.getElementById('stepIndicator1');
            const ind2 = document.getElementById('stepIndicator2');
            const circle1 = document.getElementById('stepCircle1');
            const circle2 = document.getElementById('stepCircle2');

            if (ind1) {
                ind1.classList.remove('active');
                ind1.classList.add('completed');
            }
            if (circle1) circle1.innerHTML = '<i class="bi bi-check-lg"></i>';

            if (ind2) ind2.classList.add('active');
            if (circle2) circle2.innerHTML = '2';

            // Smooth scroll to top of card
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function goToStep1() {
            const step1 = document.getElementById('registerStep1');
            const step2 = document.getElementById('registerStep2');
            if (step2) step2.style.display = 'none';
            if (step1) step1.style.display = 'block';

            const ind1 = document.getElementById('stepIndicator1');
            const ind2 = document.getElementById('stepIndicator2');
            const circle1 = document.getElementById('stepCircle1');
            const circle2 = document.getElementById('stepCircle2');

            if (ind1) {
                ind1.classList.remove('completed');
                ind1.classList.add('active');
            }
            if (circle1) circle1.innerHTML = '1';

            if (ind2) ind2.classList.remove('active');
            if (circle2) circle2.innerHTML = '2';
        }

        // ==========================================
        // DUAL PHOTO SELECTION (CAMERA & FILE UPLOAD)
        // ==========================================

        function previewUserAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarImg.src = e.target.result;
                    capturedDataUrl = null;
                    document.getElementById('capturedPhotoInput').value = '';
                    document.getElementById('photoTypeBadge').style.display = 'block';
                    document.getElementById('btnRemovePhoto').style.display = 'inline-block';
                    document.getElementById('photoStatusText').textContent = '📁 File photo selected: ' + input.files[0].name;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function resetProfilePhoto() {
            document.getElementById('profilePicInput').value = '';
            document.getElementById('capturedPhotoInput').value = '';
            capturedDataUrl = null;
            document.getElementById('photoTypeBadge').style.display = 'none';
            document.getElementById('btnRemovePhoto').style.display = 'none';
            document.getElementById('photoStatusText').textContent = 'Choose your photo via live camera or local file';
            updateAvatarInitials();
        }

        const cameraModalEl = document.getElementById('cameraCaptureModal');
        let cameraModal = null;

        function openLiveCameraModal() {
            if (!cameraModal && cameraModalEl) {
                if (window.bootstrap && bootstrap.Modal) {
                    cameraModal = bootstrap.Modal.getInstance(cameraModalEl) || new bootstrap.Modal(cameraModalEl);
                }
            }
            if (cameraModal) {
                cameraModal.show();
            } else if (window.jQuery && cameraModalEl) {
                $(cameraModalEl).modal('show');
            }
        }

        if (cameraModalEl) {
            cameraModalEl.addEventListener('shown.bs.modal', function () {
                startCameraStream();
            });
            cameraModalEl.addEventListener('hidden.bs.modal', function () {
                stopCameraStream();
            });
        }

        async function startCameraStream() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const overlay = document.getElementById('viewfinderOverlay');
            const errorBox = document.getElementById('cameraErrorBox');
            const errorMsg = document.getElementById('cameraErrorMessage');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            // Reset UI
            video.classList.remove('d-none');
            canvas.classList.add('d-none');
            overlay.classList.remove('d-none');
            errorBox.classList.add('d-none');
            liveControls.classList.remove('d-none');
            previewControls.classList.add('d-none');

            stopCameraStream();

            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    const legacyGetUserMedia = navigator.getUserMedia || navigator.webkitGetUserMedia || navigator.mozGetUserMedia || navigator.msGetUserMedia;
                    if (legacyGetUserMedia) {
                        navigator.mediaDevices = navigator.mediaDevices || {};
                        navigator.mediaDevices.getUserMedia = function (constraints) {
                            return new Promise(function (resolve, reject) {
                                legacyGetUserMedia.call(navigator, constraints, resolve, reject);
                            });
                        };
                    } else {
                        throw new Error('Camera access is not supported by your browser or requires a secure context (HTTPS / localhost).');
                    }
                }

                let stream = null;
                try {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
                        audio: false
                    });
                } catch (e1) {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: true,
                        audio: false
                    });
                }

                cameraStream = stream;
                video.srcObject = stream;
                video.muted = true;
                
                await new Promise((resolve) => {
                    video.onloadedmetadata = () => {
                        video.play().then(resolve).catch(resolve);
                    };
                });
            } catch (err) {
                console.error('Camera stream error:', err);
                video.classList.add('d-none');
                overlay.classList.add('d-none');
                errorBox.classList.remove('d-none');

                let message = 'Camera access was blocked or unavailable.';
                if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                    message = 'Camera permission was denied. Please allow camera access in your browser.';
                } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
                    message = 'No webcam or camera device was found on this system.';
                } else if (err.message) {
                    message = err.message;
                }
                errorMsg.textContent = message;
                liveControls.classList.add('d-none');
            }
        }

        function stopCameraStream() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
        }

        function captureSnapshot() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const overlay = document.getElementById('viewfinderOverlay');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            if (!video || !canvas) return;

            const width = video.videoWidth || 640;
            const height = video.videoHeight || 480;

            canvas.width = width;
            canvas.height = height;

            const ctx = canvas.getContext('2d');
            // Mirror image horizontally to match webcam display
            ctx.translate(width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(video, 0, 0, width, height);

            // Freeze preview
            video.classList.add('d-none');
            canvas.classList.remove('d-none');
            overlay.classList.add('d-none');
            liveControls.classList.add('d-none');
            previewControls.classList.remove('d-none');

            capturedDataUrl = canvas.toDataURL('image/jpeg', 0.92);
        }

        function retakeSnapshot() {
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('photoCanvas');
            const overlay = document.getElementById('viewfinderOverlay');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            video.classList.remove('d-none');
            canvas.classList.add('d-none');
            overlay.classList.remove('d-none');
            liveControls.classList.remove('d-none');
            previewControls.classList.add('d-none');
            capturedDataUrl = null;
        }

        function confirmCapturedPhoto() {
            if (capturedDataUrl) {
                avatarImg.src = capturedDataUrl;
                document.getElementById('capturedPhotoInput').value = capturedDataUrl;
                document.getElementById('profilePicInput').value = ''; // clear file input
                document.getElementById('photoTypeBadge').style.display = 'block';
                document.getElementById('btnRemovePhoto').style.display = 'inline-block';
                document.getElementById('photoStatusText').textContent = '📸 Live Camera snapshot captured successfully!';

                stopCameraStream();
                if (cameraModal) {
                    cameraModal.hide();
                } else if (window.jQuery && cameraModalEl) {
                    $(cameraModalEl).modal('hide');
                }
            }
        }
    </script>
}
