                        <div class="d-flex flex-column gap-2 align-items-center w-100 px-3" style="max-width: 320px;">
                            <button type="button" class="btn btn-sm btn-success rounded-pill py-2 px-3 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center" style="background-color: #15803d; border-color: #15803d; font-size: 0.82rem;" onclick="useDeviceCameraCapture()">
