@model IEnumerable<AgriAI.Domain.Entities.Order>
@{
    ViewData["Title"] = "My Total Purchases & Expenditure Summary";
    var userName = User.Identity?.Name ?? "Customer";
    decimal totalSpent = ViewBag.TotalSpent != null ? (decimal)ViewBag.TotalSpent : 0m;
    int totalKg = ViewBag.TotalKg != null ? (int)ViewBag.TotalKg : 0;
    decimal estimatedSavings = ViewBag.EstimatedSavings != null ? (decimal)ViewBag.EstimatedSavings : 0m;
    int successfulOrdersCount = ViewBag.SuccessfulOrdersCount != null ? (int)ViewBag.SuccessfulOrdersCount : 0;
    int totalOrdersCount = ViewBag.TotalOrdersCount != null ? (int)ViewBag.TotalOrdersCount : 0;
    var allOrders = ViewBag.AllOrders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
}

@section Styles {
    <style>
        /* 1. Hero Header Banner (Matching Farmer Portal) */
        .purchases-hero-header {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border-radius: 1.25rem;
            padding: 2.25rem 2rem;
            color: #ffffff;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            animation: purchasesFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .purchases-hero-header::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 220px;
            height: 220px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            pointer-events: none;
        }

        .purchases-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 30px;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            margin-bottom: 10px;
            backdrop-filter: blur(8px);
        }

        .purchases-hero-title {
            font-size: 2.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .purchases-hero-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.88);
            max-width: 760px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        @@keyframes purchasesFadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .total-purchases-main-container {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1.5rem;
            padding: 1.75rem 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            margin-bottom: 2rem;
        }
        @@media (max-width: 768px) {
            .purchases-hero-header {
                padding: 1.6rem 1.25rem !important;
                border-radius: 1.15rem !important;
            }
            .purchases-header-actions {
                width: 100% !important;
                justify-content: flex-start !important;
                margin-top: 1rem !important;
            }
            .purchases-header-actions .btn {
                flex: 1 1 auto !important;
                text-align: center !important;
                justify-content: center !important;
            }
            .total-purchases-main-container {
                padding: 1.25rem 1rem;
                border-radius: 1.25rem;
            }
        }
        @@media (max-width: 576px) {
            .purchases-hero-header {
                padding: 1.4rem 1.1rem !important;
                border-radius: 1rem !important;
                margin-bottom: 1.25rem !important;
            }
            .purchases-hero-title {
                font-size: 1.45rem !important;
            }
            .purchases-hero-subtitle {
                font-size: 0.82rem !important;
            }
            .purchases-hero-badge {
                font-size: 0.75rem !important;
                padding: 4px 12px !important;
            }
        }
        .purchase-metric-box {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 1.15rem;
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            transition: all 0.2s ease;
            height: 100%;
        }
        .purchase-metric-box:hover {
            background: #ffffff;
            border-color: #006653;
            box-shadow: 0 6px 20px rgba(0, 102, 83, 0.08);
            transform: translateY(-2px);
        }
        .purchase-metric-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .purchase-table-filter-btn {
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #64748b;
            padding: 0.45rem 1.15rem;
            border-radius: 9999px;
            font-size: 0.825rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .purchase-table-filter-btn:hover,
        .purchase-table-filter-btn.active {
            background: #006653;
            color: #ffffff;
            border-color: #006653;
            box-shadow: 0 2px 6px rgba(0, 102, 83, 0.2);
        }
        .ledger-table-card {
            border: 1px solid #e2e8f0;
            border-radius: 1.25rem;
            overflow: hidden;
            background: #ffffff;
        }
    </style>
}

<div class="container-fluid py-3 px-2 px-md-3 px-xl-4" style="max-width: 1680px;">
    
    <!-- 1. Hero Header Banner (Matching Farmer Portal) -->
    <div class="purchases-hero-header shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-lg-7">
                <div class="purchases-hero-badge">
                    <i class="bi bi-wallet2 text-warning"></i>
                    <span>Customer Account Ledger &bull; 100% Escrow Protected</span>
                </div>
                <h1 class="purchases-hero-title">
                    My Total Purchases &amp; Financial Summary
                </h1>
                <p class="purchases-hero-subtitle">
                    Itemized purchase ledger, cumulative crop weight (Kg), and direct farmer savings verified under AgriAI Escrow standards.
                </p>
            </div>
            <div class="col-lg-5 text-lg-end mt-3 mt-lg-0 d-flex flex-wrap gap-2 justify-content-lg-end purchases-header-actions">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light rounded-pill px-3.5 py-2 fw-bold small shadow-sm d-inline-flex align-items-center">
                    <i class="bi bi-shop me-1.5"></i><span>Browse Crops</span>
                </a>
                <a href="/Customer/Dashboard?tab=activeOrdersTab" class="btn btn-outline-light rounded-pill px-3.5 py-2 fw-bold small shadow-sm d-inline-flex align-items-center">
                    <i class="bi bi-box-seam me-1.5"></i><span>Active Orders</span>
                </a>
                <a href="/Customer/Dashboard?tab=overviewTab" class="btn btn-outline-light rounded-pill px-3.5 py-2 fw-bold small shadow-sm d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1.5"></i><span>Dashboard</span>
                </a>
                <button type="button" class="btn btn-light text-success rounded-pill px-3.5 py-2 fw-bold small shadow-sm d-inline-flex align-items-center" onclick="printPurchaseStatement()">
                    <i class="bi bi-printer-fill me-1.5"></i><span>Print Statement</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Master Unified Container -->
    <div class="total-purchases-main-container shadow-sm">
        <!-- Header inside Master Box (Matching Farmer Portal) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
            <div>
                <h3 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2" style="letter-spacing: -0.3px;">
                    <i class="bi bi-journal-text text-success fs-4"></i> Cumulative Purchase Ledger &amp; Analytics
                </h3>
                <p class="text-muted small mb-0">
                    Real-time aggregated spending, direct producer transactions, and crop volume metrics.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge rounded-pill px-3 py-1.5 fw-bold shadow-xs" style="background-color: #ecfdf5; color: #047857; border: 1.5px solid #86efac; font-size: 0.8rem;">
                    <i class="bi bi-shield-check me-1 text-success"></i> 100% Escrow Protected
                </span>
            </div>
        </div>

            <!-- 4 Clean & Modern Metric Summary Cards -->
            <div class="row g-3 g-lg-4 mb-4">
                <!-- Metric 1: Total Amount Spent -->
                <div class="col-sm-6 col-lg-3">
                    <div class="purchase-metric-box">
                        <div class="purchase-metric-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-extrabold text-dark mb-0">₹@totalSpent.ToString("N2")</div>
                            <div class="text-muted small fw-semibold">Total Expenditure</div>
                        </div>
                    </div>
                </div>

                <!-- Metric 2: Total Volume in Kg -->
                <div class="col-sm-6 col-lg-3">
                    <div class="purchase-metric-box">
                        <div class="purchase-metric-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-boxes"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-extrabold text-dark mb-0">@totalKg Kg</div>
                            <div class="text-muted small fw-semibold">Total Produce Volume</div>
                        </div>
                    </div>
                </div>

                <!-- Metric 3: Successful Orders -->
                <div class="col-sm-6 col-lg-3">
                    <div class="purchase-metric-box">
                        <div class="purchase-metric-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-extrabold text-dark mb-0">@successfulOrdersCount <span class="fs-6 text-muted fw-normal">/ @totalOrdersCount</span></div>
                            <div class="text-muted small fw-semibold">Orders Placed</div>
                        </div>
                    </div>
                </div>

                <!-- Metric 4: Direct Producer Savings -->
                <div class="col-sm-6 col-lg-3">
                    <div class="purchase-metric-box">
                        <div class="purchase-metric-icon bg-warning bg-opacity-15 text-warning" style="color: #d97706 !important;">
                            <i class="bi bi-piggy-bank-fill"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-extrabold text-dark mb-0">₹@estimatedSavings.ToString("N2")</div>
                            <div class="text-muted small fw-semibold">Estimated Direct Savings</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Itemized Purchases Breakdown Table Card -->
            <div class="ledger-table-card shadow-sm mb-2">
                <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-receipt-cutoff text-success"></i> Itemized Purchase Ledger &amp; Invoices
                        </h5>
                        <span class="text-muted small">All organic farm orders placed through AgriAI verified network.</span>
                    </div>
                    
                    <!-- Filter Pills -->
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button" class="purchase-table-filter-btn active" onclick="filterPurchaseTable('all', this)">
                            All (@allOrders.Count)
                        </button>
                        <button type="button" class="purchase-table-filter-btn" onclick="filterPurchaseTable('delivered', this)">
                            Delivered
                        </button>
                        <button type="button" class="purchase-table-filter-btn" onclick="filterPurchaseTable('active', this)">
                            Active Orders
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="purchasesTable">
                        <thead class="table-light">
                            <tr class="small text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                <th class="ps-4 py-3">Order ID &amp; Date</th>
                                <th class="py-3">Produce / Crop</th>
                                <th class="py-3">Quantity (Kg)</th>
                                <th class="py-3">Rate (₹/Kg)</th>
                                <th class="py-3">Logistics</th>
                                <th class="py-3">Total Amount</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!allOrders.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="bi bi-receipt display-4 opacity-50 d-block mb-2"></i>
                                        No purchases recorded yet. Browse fresh crops to start shopping.
                                    </td>
                                </tr>
                            }
                            @foreach (var order in allOrders)
                            {
                                var firstItem = order.OrderItems.FirstOrDefault();
                                var prodName = firstItem?.Product?.Name ?? "Farm Produce";
                                var prodImg = firstItem?.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                var prodCat = firstItem?.Product?.Category?.Name ?? "Grains";
                                var qty = firstItem?.Quantity ?? 1;
                                var rate = firstItem?.UnitPrice ?? order.TotalAmount;
                                var isDelivered = order.Status.Contains("Delivered") || order.Status.Contains("Settled");
                                var isActive = order.Status == "Requested" || order.Status == "Accepted" || order.Status == "In Transit" || order.Status == "Ready for Pickup";
                                var rowCategory = isDelivered ? "delivered" : (isActive ? "active" : "cancelled");
                                var baseAmt = order.TotalAmount - order.LogisticsFee - order.PlatformFee;
                                var orderNoStr = "AG-" + order.Id.ToString("D5");
                                var dateFormatted = order.OrderDate.ToString("dd MMM yyyy, hh:mm tt");

                                <tr class="purchase-row" data-category="@rowCategory">
                                    <td class="ps-4">
                                        <strong class="text-dark d-block">#@order.Id.ToString("D5")</strong>
                                        <small class="text-muted">@order.OrderDate.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            @if (!string.IsNullOrEmpty(prodImg))
                                            {
                                                <img src="@prodImg" class="rounded-3 shadow-sm" alt="@prodName" style="width: 44px; height: 44px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-success" style="width: 44px; height: 44px;">
                                                    <i class="bi bi-tree fs-5"></i>
                                                </div>
                                            }
                                            <div>
                                                <span class="badge bg-light text-success border small" style="font-size: 0.7rem;">@prodCat</span>
                                                <strong class="text-dark d-block small">@prodName</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1">
                                            @qty Kg
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">₹@rate.ToString("N2") / Kg</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border small">
                                            <i class="bi bi-truck me-1"></i>@(order.TransportType ?? "Direct Farm Pickup")
                                        </span>
                                    </td>
                                    <td>
                                        <strong class="text-success fs-6">₹@order.TotalAmount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        @if (isDelivered)
                                        {
                                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Delivered 🟢
                                            </span>
                                        }
                                        else if (order.Status == "Requested")
                                        {
                                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Requested
                                            </span>
                                        }
                                        else if (order.Status == "Accepted")
                                        {
                                            <span class="badge bg-info text-dark fw-bold px-2.5 py-1 rounded-pill">
                                                <i class="bi bi-clock-history me-1"></i>Accepted
                                            </span>
                                        }
                                        else if (order.Status == "In Transit")
                                        {
                                            <span class="badge bg-primary text-white fw-bold px-2.5 py-1 rounded-pill">
                                                <i class="bi bi-truck me-1"></i>In Transit
                                            </span>
                                        }
                                        else if (order.Status == "Declined" || order.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary text-white fw-bold px-2.5 py-1 rounded-pill">
                                                @order.Status (Refunded)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@order.Status</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1.5">
                                            <a asp-action="OrderDetails" asp-route-id="@order.Id" asp-route-from="totalPurchases" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold shadow-sm">
                                                Details →
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fw-bold" title="Print Invoice" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@userName', '@prodName', @qty, @rate, @baseAmt, @order.LogisticsFee, @order.PlatformFee, @order.TotalAmount, '@(order.PaymentMethod ?? "Online (Escrow)")', '@(order.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(order.ShippingAddress) ? "Gujarat Farm Location" : order.ShippingAddress)')">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

<!-- Print Invoice Helper Script -->
<script>
    function filterPurchaseTable(category, btn) {
        document.querySelectorAll('.purchase-table-filter-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.purchase-row');
        rows.forEach(r => {
            if (category === 'all') {
                r.style.display = '';
            } else {
                const rowCat = r.getAttribute('data-category');
                r.style.display = (rowCat === category) ? '' : 'none';
            }
        });
    }

    function printOrderInvoice(orderNo, orderDate, buyerName, produceName, quantity, unitPrice, baseAmount, logisticsFee, platformFee, grandTotal, paymentMethod, transportType, deliveryAddress) {
        const printWindow = window.open('', '_blank', 'width=850,height=900');
        if (!printWindow) {
            alert('Please allow popups to print official Tax Invoice.');
            return;
        }

        const invoiceHtml = `
            <!DOCTYPE html>
            <html>
            <head>
                <title>Tax Invoice - ${orderNo}</title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
                <style>
                    body { font-family: 'Segoe UI', system-ui, sans-serif; color: #1e293b; padding: 40px; }
                    .invoice-header { border-bottom: 2px solid #006653; padding-bottom: 20px; margin-bottom: 25px; }
                    .brand-logo { font-size: 26px; font-weight: 800; color: #006653; }
                    .invoice-title { font-size: 22px; font-weight: 700; color: #0f172a; text-transform: uppercase; }
                    .table-invoice th { background-color: #f1f5f9; color: #475569; font-weight: 600; font-size: 13px; text-transform: uppercase; }
                    .grand-total-row { font-size: 18px; font-weight: 800; color: #006653; background-color: #f0fdf4; }
                    .seal-box { border: 2px dashed #94a3b8; border-radius: 8px; padding: 15px; text-align: center; margin-top: 30px; }
                    @@media print {
                        body { padding: 0; }
                        .no-print { display: none; }
                    }
                </style>
            </head>
            <body>
                <div class="invoice-header d-flex justify-content-between align-items-start">
                    <div>
                        <div class="brand-logo">🌾 AgriAI</div>
                        <div class="text-muted small">Direct Farm-to-Buyer Digital Agricultural Marketplace</div>
                        <div class="text-muted small">Govt. Mandi &amp; APMC Verified Trade System &bull; Gujarat, India</div>
                    </div>
                    <div class="text-end">
                        <div class="invoice-title">Tax Invoice / Receipt</div>
                        <div class="fw-bold fs-5 text-dark">${orderNo}</div>
                        <div class="text-muted small">Date: ${orderDate}</div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Billed To (Buyer):</div>
                        <div class="fw-bold text-dark fs-6">${buyerName}</div>
                        <div class="text-muted small">Delivery Address: ${deliveryAddress}</div>
                    </div>
                    <div class="col-6 text-end">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Transaction Details:</div>
                        <div class="small"><strong>Payment:</strong> ${paymentMethod}</div>
                        <div class="small"><strong>Logistics:</strong> ${transportType}</div>
                        <div class="small text-success"><strong>Escrow Protected:</strong> Verified 100% Safe</div>
                    </div>
                </div>

                <table class="table table-bordered table-invoice mb-4">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Produce / Crop Harvest</th>
                            <th class="text-center">Weight / Qty</th>
                            <th class="text-end">Rate (₹ / Unit)</th>
                            <th class="text-end">Net Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td><strong>${produceName}</strong><br><small class="text-muted">Direct Farmer Source &bull; Grade A Harvest</small></td>
                            <td class="text-center fw-bold">${quantity} Kg</td>
                            <td class="text-end">₹${parseFloat(unitPrice).toFixed(2)}</td>
                            <td class="text-end fw-bold">₹${parseFloat(baseAmount).toFixed(2)}</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end text-muted small">Logistics &amp; Transport Charges (${transportType}):</td>
                            <td class="text-end small">₹${parseFloat(logisticsFee).toFixed(2)}</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end text-muted small">Platform Safety &amp; Quality Inspection Fee:</td>
                            <td class="text-end small">₹${parseFloat(platformFee).toFixed(2)}</td>
                        </tr>
                        <tr class="grand-total-row">
                            <td colspan="4" class="text-end">Total Amount Paid (INR):</td>
                            <td class="text-end">₹${parseFloat(grandTotal).toFixed(2)}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="row align-items-center mt-4">
                    <div class="col-8">
                        <div class="seal-box">
                            <strong class="text-success d-block">✓ Digitally Verified Agricultural Invoice</strong>
                            <small class="text-muted">Direct transaction between verified farmer and customer via AgriAI Escrow Protection.</small>
                        </div>
                    </div>
                    <div class="col-4 text-end">
                        <div class="small text-muted mb-4">Authorized Signature</div>
                        <div class="fw-bold text-dark">AgriAI Marketplace System</div>
                    </div>
                </div>

                <div class="text-center mt-4 pt-3 border-top no-print">
                    <button class="btn btn-success px-4 rounded-pill fw-bold" onclick="window.print()">Print Invoice</button>
                    <button class="btn btn-secondary px-4 rounded-pill fw-bold ms-2" onclick="window.close()">Close</button>
                </div>
            </body>
            </html>
        `;

        printWindow.document.write(invoiceHtml);
        printWindow.document.close();
    }

    function printPurchaseStatement() {
        const printWindow = window.open('', '_blank', 'width=950,height=950');
        const statementOrdersData = [
            @foreach (var o in allOrders)
            {
                var firstIt = o.OrderItems.FirstOrDefault();
                var pName = (firstIt?.Product?.Name ?? "Farm Produce").Replace("'", "\\'");
                var pCat = (firstIt?.Product?.Category?.Name ?? "Farm Crop").Replace("'", "\\'");
                var pQty = (firstIt?.Quantity ?? 1) + " Kg";
                var pRate = "₹" + (firstIt?.UnitPrice ?? o.TotalAmount).ToString("N2");
                var pLog = (o.TransportType ?? "Direct Farm Pickup").Replace("'", "\\'");
                var pStat = (o.Status.Contains("Delivered") || o.Status.Contains("Settled")) ? "Delivered" : o.Status;
                var pTotal = "₹" + o.TotalAmount.ToString("N2");
                var pDate = o.OrderDate.ToString("dd MMM yyyy");
                var pId = o.Id.ToString("D5");
                @:{ id: '@pId', orderDate: '@pDate', productName: '@pName', category: '@pCat', quantity: '@pQty', rate: '@pRate', logistics: '@pLog', status: '@pStat', total: '@pTotal' },
            }
        ];

        let rowsHtml = '';
        if (statementOrdersData.length === 0) {
            rowsHtml = '<tr><td colspan="7" style="text-align:center; padding: 30px; color: #64748b;">No purchase transactions recorded yet.</td></tr>';
        } else {
            statementOrdersData.forEach((item, index) => {
                const isDeliv = item.status === 'Delivered';
                const isCanc = item.status === 'Cancelled' || item.status === 'Declined';
                const statusColor = isDeliv ? '#15803d' : (isCanc ? '#b91c1c' : '#b45309');
                const statusBg = isDeliv ? '#dcfce7' : (isCanc ? '#fee2e2' : '#fef3c7');

                rowsHtml += `
                <tr>
                    <td style="padding: 10px 12px; font-weight: bold; color: #0f172a; border-bottom: 1px solid #e2e8f0; font-size: 12px;">
                        #${item.id}<br><small style="color: #64748b; font-weight: normal;">${item.orderDate}</small>
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 12.5px;">
                        <span style="font-size: 10.5px; background: #f1f5f9; color: #006653; padding: 2px 6px; border-radius: 4px; font-weight: 600;">${item.category}</span><br>
                        <strong style="color: #1e293b;">${item.productName}</strong>
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; text-align: center; font-weight: 600; font-size: 12.5px;">
                        ${item.quantity}
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; text-align: right; color: #475569; font-size: 12px;">
                        ${item.rate}
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 11.5px; color: #475569;">
                        ${item.logistics}
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; text-align: center;">
                        <span style="background: ${statusBg}; color: ${statusColor}; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; display: inline-block;">
                            ${item.status}
                        </span>
                    </td>
                    <td style="padding: 10px 12px; border-bottom: 1px solid #e2e8f0; text-align: right; font-weight: 800; color: #006653; font-size: 13px;">
                        ${item.total}
                    </td>
                </tr>`;
            });
        }

        const statementHtml = `
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="utf-8">
            <title>Purchase Statement - @userName - AgriAI Platform</title>
            <style>
                @@page { size: A4 portrait; margin: 12mm 10mm; }
                body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 25px; color: #1e293b; background: #fff; line-height: 1.4; }
                .statement-card { max-width: 820px; margin: auto; }
                .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #006653; padding-bottom: 14px; margin-bottom: 18px; }
                .logo-title { color: #006653; font-size: 22px; font-weight: 800; margin: 0; }
                .logo-sub { color: #64748b; font-size: 11.5px; margin: 2px 0 0 0; }
                .badge-doc { background: #ecfdf5; color: #047857; border: 1.5px solid #86efac; padding: 4px 12px; border-radius: 20px; font-weight: 800; font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase; }
                .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
                .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; }
                .info-box h4 { margin: 0 0 4px 0; font-size: 11.5px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
                .info-box p { margin: 2px 0; font-size: 12.5px; color: #1e293b; }
                .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }
                .metric-cell { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px; text-align: center; }
                .metric-val { font-size: 16px; font-weight: 800; color: #006653; margin-bottom: 2px; }
                .metric-lbl { font-size: 10.5px; color: #475569; font-weight: 600; text-transform: uppercase; }
                table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
                th { background: #f1f5f9; text-align: left; padding: 9px 12px; font-size: 11.5px; color: #334155; border-bottom: 2px solid #cbd5e1; border-top: 1px solid #e2e8f0; text-transform: uppercase; letter-spacing: 0.3px; }
                .grand-total-row td { background: #f8fafc; border-top: 2px solid #006653 !important; font-size: 13.5px; font-weight: 800; color: #006653; padding: 10px 12px; }
                .footer { border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #64748b; }
                .stamp { border: 1.5px dashed #86efac; background: #f0fdf4; padding: 5px 12px; border-radius: 6px; color: #15803d; font-weight: 800; font-size: 11px; }
                @@media print {
                    body { padding: 0 !important; }
                    .statement-card { border: none !important; padding: 0 !important; }
                }
            </style>
        </head>
        <body>
            <div class="statement-card">
                <div class="header">
                    <div>
                        <h1 class="logo-title">🌱 AgriAI Customer Purchase Statement</h1>
                        <p class="logo-sub">Direct Farm-to-Buyer Agricultural Trade Platform &bull; Gujarat, India</p>
                    </div>
                    <div style="text-align: right;">
                        <span class="badge-doc">Official Account Ledger</span>
                        <p style="margin: 5px 0 0 0; font-size: 11.5px; color: #64748b;"><strong>Statement Date:</strong> @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</p>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-box">
                        <h4>Account Holder (Buyer)</h4>
                        <p><strong>Customer Name:</strong> @userName</p>
                        <p><strong>Account Status:</strong> Verified Buyer</p>
                        <p><strong>Platform Security:</strong> 100% Escrow Protected</p>
                    </div>
                    <div class="info-box">
                        <h4>Audit &amp; Security Standard</h4>
                        <p><strong>Platform Escrow:</strong> 100% Escrow Protected Trade</p>
                        <p><strong>Fulfillment Mode:</strong> Direct Gujarat Producer Network</p>
                        <p><strong>Total Transactions:</strong> @totalOrdersCount Orders</p>
                    </div>
                </div>

                <div class="metrics-grid">
                    <div class="metric-cell">
                        <div class="metric-val">₹@totalSpent.ToString("N2")</div>
                        <div class="metric-lbl">Total Expenditure</div>
                    </div>
                    <div class="metric-cell">
                        <div class="metric-val">@totalKg Kg</div>
                        <div class="metric-lbl">Produce Volume</div>
                    </div>
                    <div class="metric-cell">
                        <div class="metric-val">@successfulOrdersCount / @totalOrdersCount</div>
                        <div class="metric-lbl">Fulfilled Orders</div>
                    </div>
                    <div class="metric-cell">
                        <div class="metric-val">₹@estimatedSavings.ToString("N2")</div>
                        <div class="metric-lbl">Direct Farmer Savings</div>
                    </div>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th style="width: 15%;">Order ID &amp; Date</th>
                            <th style="width: 25%;">Produce / Crop</th>
                            <th style="width: 12%; text-align: center;">Quantity</th>
                            <th style="width: 12%; text-align: right;">Rate (₹/Kg)</th>
                            <th style="width: 18%;">Logistics</th>
                            <th style="width: 10%; text-align: center;">Status</th>
                            <th style="width: 18%; text-align: right;">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rowsHtml}
                    </tbody>
                    <tfoot>
                        <tr class="grand-total-row">
                            <td colspan="5" style="text-align: right; text-transform: uppercase;">Cumulative Total Expenditure:</td>
                            <td colspan="2" style="text-align: right;">₹@totalSpent.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>

                <div class="footer">
                    <div>
                        <p style="margin: 0;"><strong>Official Verified Record &bull; AgriAI Platform</strong></p>
                        <p style="margin: 2px 0 0 0;">This is a computer-generated financial purchase statement verified under AgriAI Escrow Protection standards.</p>
                    </div>
                    <div class="stamp">
                        ✓ VERIFIED BUYER LEDGER
                    </div>
                </div>
            </div>

            <script>
                window.onload = function() {
                    setTimeout(function() {
                        window.print();
                    }, 400);
                };
            <\/script>
        </body>
        </html>
        `;

        printWindow.document.open();
        printWindow.document.write(statementHtml);
        printWindow.document.close();
    }
</script>
