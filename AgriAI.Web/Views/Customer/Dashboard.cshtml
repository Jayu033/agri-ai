@model IEnumerable<AgriAI.Domain.Entities.Product>

@{
    ViewData["Title"] = "Customer Dashboard";
    var userName = User.Identity?.Name ?? "Customer";
    var displayName = userName.Split('@')[0];
    var userEmail = userName.Contains("@") ? userName : (userName + "@agriai.com");
    var userPhone = "+91 97245 60047";
    var userInitial = !string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "C";
    var customerOrders = ViewBag.Orders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    int totalOrdersCount = ViewBag.TotalOrdersCount != null ? (int)ViewBag.TotalOrdersCount : customerOrders.Count;
    decimal totalSpent = ViewBag.TotalSpent != null ? (decimal)ViewBag.TotalSpent : customerOrders.Sum(o => o.TotalAmount);

    // Instant server-side active tab (0ms delay, no JS flicker)
    string activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab))
    {
        activeTab = "overviewTab";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (280px Clean Card) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- User Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge">
                            <i class="bi bi-shield-check me-1"></i>Verified Buyer
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons (In Exact Requested Order) -->
                    <div class="dash-nav-pills">
                        <button type="button" class="dash-tab-link @(activeTab == "overviewTab" ? "active" : "")" onclick="switchDashTab('overviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Overview</span>
                        </button>
                        
                        <button type="button" class="dash-tab-link @(activeTab == "shopTab" ? "active" : "")" onclick="switchDashTab('shopTab', this)">
                            <i class="bi bi-shop"></i>
                            <span>Shop Farm Produce</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "cartTab" ? "active" : "")" onclick="switchDashTab('cartTab', this)">
                            <i class="bi bi-cart3"></i>
                            <span>My Cart</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "ordersTab" ? "active" : "")" onclick="switchDashTab('ordersTab', this)">
                            <i class="bi bi-clock-history"></i>
                            <span>Order History</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "profileTab" ? "active" : "")" onclick="switchDashTab('profileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Profile Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    <!-- TAB 1: Dashboard Overview (Default) -->
                    <div id="overviewTab" class="dash-tab-panel @(activeTab == "overviewTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Welcome back, @userName.Split('@')[0]! 👋</h3>
                                <p class="text-muted small mb-0">Track your organic produce orders, check live APMC market prices, and manage account.</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                <i class="bi bi-cart-plus me-1"></i> Browse Fresh Harvest
                            </button>
                        </div>

                        <!-- 4 Summary Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@totalOrdersCount</div>
                                        <div class="dash-metric-label">Completed Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@totalOrdersCount</div>
                                        <div class="dash-metric-label">Active Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@totalSpent.ToString("N2")</div>
                                        <div class="dash-metric-label">Total Purchases</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-geo-alt-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">Gujarat</div>
                                        <div class="dash-metric-label">Primary Region</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Shortcuts & Active Delivery Card -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-truck text-success me-2"></i>Active Shipments</h5>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-bold px-2.5 py-1 rounded-pill">No Active Orders</span>
                                        </div>
                                        <div class="p-4 bg-white rounded-3 border text-center my-2">
                                            <i class="bi bi-box-seam text-muted fs-2 d-block mb-2 opacity-50"></i>
                                            <p class="text-muted small mb-0">You have no active orders in transit. Start shopping fresh harvests directly from verified farmers.</p>
                                        </div>
                                    </div>
                                    <div class="pt-2">
                                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                            <i class="bi bi-shop me-1"></i> Start Shopping →
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Market Intelligence</span>
                                        <h6 class="fw-bold text-dark mb-1">Today's Best Farmer Produce</h6>
                                        <p class="text-muted small mb-3">Unjha Jeera (Cumin) and Saurashtra Groundnut are currently at peak harvest quality with direct farmer rates.</p>
                                    </div>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Check Live Market Rates
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: Shop Farm Produce (Embedded directly in Dashboard) -->
                    <div id="shopTab" class="dash-tab-panel @(activeTab == "shopTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Shop Farm Fresh Produce</h3>
                                <p class="text-muted small mb-0">Browse and purchase organic harvests directly from verified Gujarat farmers.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Full Catalogue
                            </a>
                        </div>

                        <!-- Embedded Product Grid -->
                        @if (Model != null && Model.Any())
                        {
                            <div class="row g-3 mb-3">
                                @foreach (var item in Model)
                                {
                                    var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
                                    <div class="col-md-6 col-xl-4">
                                        <div class="card h-100 bg-white shadow-sm rounded-4 border product-card overflow-hidden">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(imgUrl))
                                                {
                                                    <img src="@imgUrl" class="card-img-top" alt="@item.Name" style="height: 160px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 160px;">
                                                        <i class="bi bi-basket text-success fs-1"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute top-0 end-0 m-2 badge bg-success fw-bold px-2 py-1 shadow-sm" style="font-size: 0.7rem;">
                                                    Farm Direct
                                                </span>
                                            </div>

                                            <div class="card-body d-flex flex-column p-3">
                                                <small class="text-success fw-bold text-uppercase mb-1" style="font-size: 0.70rem;">
                                                    @(item.Category?.Name ?? "Farm Produce")
                                                </small>
                                                <h6 class="card-title fw-bold text-dark mb-1">@item.Name</h6>
                                                <p class="card-text text-muted small mb-3 flex-grow-1" style="font-size: 0.78rem;">
                                                    @(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                                </p>
                                                
                                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                                    <div>
                                                        <span class="text-muted small d-block" style="font-size: 0.68rem;">Direct Price</span>
                                                        <span class="fw-bold text-success fs-6">₹@item.Price.ToString("N2")</span>
                                                    </div>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="/Customer/Dashboard?tab=shopTab" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                                        Buy Now
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-basket display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No farm harvests listed right now.</h5>
                                <p class="text-muted small mb-3">Verified local farmers will list fresh produce shortly. Check today's market rates in the meantime.</p>
                                <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill px-4 py-2 fw-bold">
                                    <i class="bi bi-graph-up-arrow me-1"></i> View Live Market Rates
                                </a>
                            </div>
                        }
                    </div>

                    <!-- TAB 3: My Cart -->
                    <div id="cartTab" class="dash-tab-panel @(activeTab == "cartTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Cart</h3>
                                <p class="text-muted small mb-0">Review items in your shopping bag and proceed to checkout.</p>
                            </div>
                        </div>

                        <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                            <i class="bi bi-cart-x display-4 text-success opacity-50 d-block mb-3"></i>
                            <h5 class="fw-bold text-dark mb-2">Your Shopping Cart is empty</h5>
                            <p class="text-muted small mb-4">You have not added any farm produce to your cart yet. Explore fresh crops directly from Gujarat farmers.</p>
                            <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                <i class="bi bi-shop me-1"></i> Explore Farm Produce
                            </button>
                        </div>
                    </div>

                    <!-- TAB 4: Order History -->
                    <div id="ordersTab" class="dash-tab-panel @(activeTab == "ordersTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Order History &amp; Purchases</h3>
                                <p class="text-muted small mb-0">Track your past purchases, direct farmer produce orders, and status.</p>
                            </div>
                        </div>

                        @if (customerOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in customerOrders)
                                {
                                    var orderNoStr = "AG-" + order.Id.ToString("D5");
                                    var orderLabel = "#" + order.Id.ToString("D5");
                                    var dateFormatted = order.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
                                    var firstItem = order.OrderItems.FirstOrDefault();
                                    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
                                    var itemQty = firstItem?.Quantity ?? 1;
                                    var unitPrice = firstItem?.UnitPrice ?? order.TotalAmount;
                                    var baseAmt = order.TotalAmount - order.LogisticsFee - order.PlatformFee;

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        <!-- Card Header: Order ID, Date & Status -->
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order @orderLabel
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@dateFormatted
                                                </span>
                                            </div>
                                            <div>
                                                @if (order.Status == "Pending" || order.Status == "Awaiting Cash on Pickup")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-clock-history me-1"></i>@order.Status
                                                    </span>
                                                }
                                                else if (order.Status.Contains("Delivered") || order.Status.Contains("Settled"))
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Completed 🟢
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-truck me-1"></i>@order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Card Body: Clean Produce Summary (Strict Privacy, No Open OTP) -->
                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 55px; height: 55px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Ordered: <strong>@item.Quantity unit(s)</strong> @@ ₹@item.UnitPrice.ToString("N2")</small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Footer: Total Paid & Security Protected Action Buttons -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1"></i>@(order.PaymentMethod ?? "Online")</span>
                                                <span class="text-muted small">Total Paid:</span>
                                                <span class="fw-extrabold text-success fs-5">₹@order.TotalAmount.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;" onclick="openSecurityGate(@order.Id, '@orderLabel')">
                                                    <i class="bi bi-shield-lock-fill me-1"></i> View More Details &amp; OTP
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@userName', '@produceName', @itemQty, @unitPrice, @baseAmt, @order.LogisticsFee, @order.PlatformFee, @order.TotalAmount, '@(order.PaymentMethod ?? "Online (Escrow)")', '@(order.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(order.ShippingAddress) ? "Gujarat Farm Location" : order.ShippingAddress)')">
                                                    <i class="bi bi-printer me-1"></i> Print Invoice
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-clock-history display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Order History Found</h5>
                                <p class="text-muted small mb-4">You haven't placed any orders yet. When you buy crops or farm produce, your order invoices and tracking will appear here.</p>
                                <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                    <i class="bi bi-bag-plus me-1"></i> Start Your First Order
                                </button>
                            </div>
                        }
                    </div>

                    <!-- TAB 5: My Profile Settings -->
                    <div id="profileTab" class="dash-tab-panel @(activeTab == "profileTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Account &amp; Profile Settings</h3>
                                <p class="text-muted small mb-0">Manage your verified customer profile and delivery address.</p>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person text-success me-1"></i> Account Details</h6>
                                    <div class="mb-3">
                                        <label class="form-label small text-muted">Full Name</label>
                                        <input type="text" class="form-control bg-light" value="@displayName" readonly />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small text-muted">Email Address</label>
                                        <input type="email" class="form-control bg-light" value="@userEmail" readonly />
                                    </div>
                                    <div>
                                        <label class="form-label small text-muted">Phone Number</label>
                                        <input type="text" class="form-control bg-light" value="@userPhone" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-success me-1"></i> Security &amp; Guarantee</h6>
                                    <p class="text-muted small mb-3">Your purchases on AgriAI are protected by automated 2-way Escrow security and verified Farmer certificates.</p>
                                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-0">
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>100% Direct Farmer Produce</li>
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Escrow Holding until Delivery</li>
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>4-Digit Secure Delivery OTP verification</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Security Gate Verification Modal -->
<div class="modal fade" id="securityGateModal" tabindex="-1" aria-labelledby="securityGateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 p-4 pb-0 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="securityGateModalLabel">Security Verification</h5>
                        <span class="text-muted small">Account Password Confirmation</span>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 pt-3">
                <p class="text-muted small mb-3">
                    To protect your privacy and unlock confidential farmer contact and your <strong>4-Digit Delivery OTP</strong> for <strong id="secOrderLabel" class="text-dark"></strong>, please enter your account password.
                </p>

                <div id="secGateAlert" class="alert alert-danger p-2.5 rounded-3 small mb-3 d-none">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="secGateAlertMsg"></span>
                </div>

                <form id="secGateForm" onsubmit="submitSecurityGate(event)">
                    <input type="hidden" id="secGateOrderId" value="" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Enter Account Password</label>
                        <div class="input-group">
                            <input type="password" id="secGatePassword" class="form-control rounded-start-3 shadow-none" placeholder="Enter your password..." required />
                            <button type="button" class="btn btn-outline-secondary rounded-end-3" onclick="toggleSecPassVisibility()">
                                <i class="bi bi-eye" id="secPassEyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="secGateSubmitBtn" class="btn btn-success rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                            <i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab') || (window.location.hash ? window.location.hash.replace('#', '') : null);
            if (tabParam) {
                const targetBtn = document.querySelector(`.dash-tab-link[onclick*="${tabParam}"]`);
                if (targetBtn) {
                    switchDashTab(tabParam, targetBtn);
                }
            }
        });

        function switchDashTab(tabId, btn) {
            // Hide all tab panels
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            // Show selected tab panel
            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            // Update active state in sidebar
            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }

        let currentSecOrderId = 0;
        let secModalInstance = null;

        function openSecurityGate(orderId, orderLabel) {
            currentSecOrderId = orderId;
            document.getElementById('secGateOrderId').value = orderId;
            document.getElementById('secOrderLabel').textContent = 'Order ' + orderLabel;
            document.getElementById('secGatePassword').value = '';
            document.getElementById('secGateAlert').classList.add('d-none');
            
            const submitBtn = document.getElementById('secGateSubmitBtn');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';

            const modalEl = document.getElementById('securityGateModal');
            secModalInstance = new bootstrap.Modal(modalEl);
            secModalInstance.show();

            setTimeout(() => {
                document.getElementById('secGatePassword').focus();
            }, 500);
        }

        function toggleSecPassVisibility() {
            const passInput = document.getElementById('secGatePassword');
            const icon = document.getElementById('secPassEyeIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        async function submitSecurityGate(e) {
            e.preventDefault();
            const orderId = document.getElementById('secGateOrderId').value;
            const password = document.getElementById('secGatePassword').value;
            const submitBtn = document.getElementById('secGateSubmitBtn');
            const alertBox = document.getElementById('secGateAlert');
            const alertMsg = document.getElementById('secGateAlertMsg');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Verifying Password...';
            alertBox.classList.add('d-none');

            try {
                const formData = new FormData();
                formData.append('orderId', orderId);
                formData.append('password', password);

                const response = await fetch('/Customer/VerifySecurityGate', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Unlocked! Opening...';
                    window.location.href = data.redirectUrl;
                } else {
                    alertMsg.textContent = data.message || 'Invalid password. Please try again.';
                    alertBox.classList.remove('d-none');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';
                    document.getElementById('secGatePassword').focus();
                }
            } catch (err) {
                alertMsg.textContent = 'Error connecting to server. Please try again.';
                alertBox.classList.remove('d-none');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';
            }
        }

        function printOrderInvoice(orderNo, orderDate, buyerName, produceName, qty, unitPrice, baseAmt, logisticsFee, platformFee, grandTotal, paymentMode, transportType, deliveryLocation) {
            const printWindow = window.open('', '_blank', 'width=850,height=900');
            const formattedTotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(grandTotal);
            const formattedBase = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(baseAmt);
            const formattedLogistics = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(logisticsFee);
            const formattedFee = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(platformFee);
            const formattedUnit = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(unitPrice);

            const invoiceHtml = `
            <!DOCTYPE html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Tax Invoice - ${orderNo} - AgriAI Platform</title>
                <style>
                    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 25px; color: #1e293b; line-height: 1.4; }
                    .invoice-card { max-width: 780px; margin: auto; border: 1px solid #cbd5e1; border-radius: 12px; padding: 30px; background: #fff; }
                    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #006653; padding-bottom: 15px; margin-bottom: 20px; }
                    .logo-title { color: #006653; font-size: 24px; font-weight: 800; margin: 0; }
                    .logo-sub { color: #64748b; font-size: 12px; margin: 2px 0 0 0; }
                    .badge-inv { background: #f0fdf4; color: #15803d; border: 1px solid #86efac; padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; }
                    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
                    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px; }
                    .info-box h4 { margin: 0 0 6px 0; font-size: 13px; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px; }
                    .info-box p { margin: 3px 0; font-size: 12.5px; color: #475569; }
                    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                    th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-size: 12.5px; color: #334155; border-bottom: 2px solid #cbd5e1; }
                    td { padding: 12px; font-size: 13px; border-bottom: 1px solid #e2e8f0; }
                    .totals-table { width: 320px; margin-left: auto; margin-bottom: 20px; }
                    .totals-table td { padding: 5px 8px; border: none; font-size: 12.5px; }
                    .grand-row { border-top: 2px solid #006653 !important; font-size: 16px !important; font-weight: 800; color: #006653; padding-top: 8px !important; }
                    .footer { border-top: 1px solid #e2e8f0; padding-top: 15px; display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: #64748b; }
                    .stamp { border: 2px dashed #86efac; background: #f0fdf4; padding: 6px 12px; border-radius: 6px; color: #15803d; font-weight: bold; font-size: 12px; }
                    @@media print {
                        body { padding: 0; }
                        .invoice-card { border: none; padding: 10px; }
                    }
                </style>
            </head>
            <body>
                <div class="invoice-card">
                    <div class="header">
                        <div>
                            <h1 class="logo-title">🌾 AgriAI Produce Invoice</h1>
                            <p class="logo-sub">Direct Farm-to-Consumer Agricultural Platform &bull; Gujarat, India</p>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge-inv">OFFICIAL TAX RECEIPT</span>
                            <p style="margin: 5px 0 0 0; font-size: 12px; color: #64748b;"><strong>Invoice No:</strong> ${orderNo}</p>
                            <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;"><strong>Date & Time:</strong> ${orderDate}</p>
                        </div>
                    </div>

                    <div class="info-grid">
                        <div class="info-box">
                            <h4>Billed To (Customer)</h4>
                            <p><strong>Name:</strong> ${buyerName}</p>
                            <p><strong>Account Type:</strong> Verified Buyer</p>
                            <p><strong>Delivery / Destination:</strong> ${deliveryLocation}</p>
                        </div>
                        <div class="info-box">
                            <h4>Logistics & Payment Details</h4>
                            <p><strong>Payment Mode:</strong> ${paymentMode}</p>
                            <p><strong>Logistics Type:</strong> ${transportType}</p>
                            <p><strong>Fulfillment:</strong> Direct Farm Harvest Pickup</p>
                        </div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Farm Harvest / Produce Name</th>
                                <th>Quantity</th>
                                <th>Unit Rate</th>
                                <th style="text-align: right;">Total (INR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td><strong>${produceName}</strong><br><small style="color: #64748b;">100% Direct Certified Farm Produce</small></td>
                                <td>${qty} unit(s)</td>
                                <td>${formattedUnit}</td>
                                <td style="text-align: right; font-weight: bold;">${formattedBase}</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="totals-table">
                        <tr>
                            <td class="text-muted">Produce Subtotal:</td>
                            <td style="text-align: right; font-weight: 600;">${formattedBase}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Transport / Logistics:</td>
                            <td style="text-align: right; font-weight: 600;">${formattedLogistics}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Platform Guarantee Fee (2%):</td>
                            <td style="text-align: right; font-weight: 600;">${formattedFee}</td>
                        </tr>
                        <tr class="grand-row">
                            <td>Total Amount Paid:</td>
                            <td style="text-align: right;">${formattedTotal}</td>
                        </tr>
                    </table>

                    <div class="footer">
                        <div>
                            <p style="margin: 0;"><strong>Thank you for empowering Gujarat Farmers! 🚜</strong></p>
                            <p style="margin: 3px 0 0 0;">This is a computer-generated tax receipt backed by AgriAI Escrow Protection.</p>
                        </div>
                        <div class="stamp">
                            ✓ VERIFIED PAID
                        </div>
                    </div>
                </div>

                <script>
                    window.onload = function() {
                        setTimeout(function() {
                            window.print();
                        }, 400);
                    };
                <\/script>
            </body>
            </html>
            `;

            printWindow.document.open();
            printWindow.document.write(invoiceHtml);
            printWindow.document.close();
        }
    </script>
}
