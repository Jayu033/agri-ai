@model IEnumerable<AgriAI.Domain.Entities.Product>

@{
    ViewData["Title"] = "Customer Dashboard";
    var userName = User.Identity?.Name ?? "Customer";
    var displayName = userName.Split('@')[0];
    var userEmail = userName.Contains("@") ? userName : (userName + "@agriai.com");
    var userPhone = "+91 97245 60047";
    var userInitial = !string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "C";
    var customerOrders = ViewBag.Orders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    var activeOrders = ViewBag.ActiveOrders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    var completedOrders = ViewBag.CompletedOrders as List<AgriAI.Domain.Entities.Order> ?? new List<AgriAI.Domain.Entities.Order>();
    int totalOrdersCount = ViewBag.TotalOrdersCount != null ? (int)ViewBag.TotalOrdersCount : customerOrders.Count;
    int activeOrdersCount = ViewBag.ActiveOrdersCount != null ? (int)ViewBag.ActiveOrdersCount : activeOrders.Count;
    int completedOrdersCount = ViewBag.CompletedOrdersCount != null ? (int)ViewBag.CompletedOrdersCount : completedOrders.Count;
    decimal totalSpent = ViewBag.TotalSpent != null ? (decimal)ViewBag.TotalSpent : 0m;
    int totalKgPurchased = ViewBag.TotalKgPurchased != null ? (int)ViewBag.TotalKgPurchased : 0;

    // Instant server-side active tab (0ms delay, no JS flicker)
    string activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab))
    {
        activeTab = "overviewTab";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (280px Clean Card) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- User Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge">
                            <i class="bi bi-shield-check me-1"></i>Verified Buyer
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons (In Exact Requested Order) -->
                    <div class="dash-nav-pills">
                        <!-- 1. Dashboard Overview -->
                        <button type="button" class="dash-tab-link @(activeTab == "overviewTab" ? "active" : "")" onclick="switchDashTab('overviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard Overview</span>
                        </button>

                        <!-- 2. Shop Farm Product -->
                        <button type="button" class="dash-tab-link @(activeTab == "shopTab" ? "active" : "")" onclick="switchDashTab('shopTab', this)">
                            <i class="bi bi-shop"></i>
                            <span>Shop Farm Product</span>
                        </button>

                        <!-- 3. My Active Orders -->
                        <button type="button" class="dash-tab-link @(activeTab == "activeOrdersTab" ? "active" : "")" onclick="switchDashTab('activeOrdersTab', this)">
                            <i class="bi bi-box-seam"></i>
                            <span>My Active Orders</span>
                            @if (activeOrdersCount > 0)
                            {
                                <span class="badge bg-warning text-dark ms-auto fw-bold">@activeOrdersCount</span>
                            }
                        </button>

                        <!-- 4. Total Purchases -->
                        <a asp-action="TotalPurchases" class="dash-tab-link text-decoration-none">
                            <i class="bi bi-wallet2"></i>
                            <span>Total Purchases</span>
                        </a>

                        <!-- 5. My Cart -->
                        <button type="button" class="dash-tab-link @(activeTab == "cartTab" ? "active" : "")" onclick="switchDashTab('cartTab', this)">
                            <i class="bi bi-cart3"></i>
                            <span>My Cart</span>
                        </button>

                        <!-- 6. Order History -->
                        <button type="button" class="dash-tab-link @(activeTab == "ordersTab" || activeTab == "historyTab" ? "active" : "")" onclick="switchDashTab('ordersTab', this)">
                            <i class="bi bi-clock-history"></i>
                            <span>Order History</span>
                            @if (completedOrdersCount > 0)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success ms-auto fw-bold">@completedOrdersCount</span>
                            }
                        </button>

                        <!-- 7. Profile Settings -->
                        <button type="button" class="dash-tab-link @(activeTab == "profileTab" ? "active" : "")" onclick="switchDashTab('profileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Profile Settings</span>
                        </button>

                        <!-- 8. Logout -->
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    <!-- TAB 1: Dashboard Overview (Default) -->
                    <div id="overviewTab" class="dash-tab-panel @(activeTab == "overviewTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Welcome back, @userName.Split('@')[0]! 👋</h3>
                                <p class="text-muted small mb-0">Track your organic produce orders, check live APMC market prices, and manage account.</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                <i class="bi bi-cart-plus me-1"></i> Browse Fresh Harvest
                            </button>
                        </div>

                        <!-- 4 Summary Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@completedOrdersCount</div>
                                        <div class="dash-metric-label">Completed Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@activeOrdersCount</div>
                                        <div class="dash-metric-label">Active Orders</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@totalSpent.ToString("N2")</div>
                                        <div class="dash-metric-label">Total Purchases</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-boxes"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@totalKgPurchased Kg</div>
                                        <div class="dash-metric-label">Produce Volume</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Shortcuts & Active Delivery Card -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-truck text-success me-2"></i>Active Shipments</h5>
                                            @if (activeOrdersCount > 0)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill">@activeOrdersCount Active In-Progress</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary fw-bold px-2.5 py-1 rounded-pill">No Active Orders</span>
                                            }
                                        </div>

                                        @if (activeOrders.Any())
                                        {
                                            <div class="d-flex flex-column gap-2 mb-2">
                                                @foreach (var actOrder in activeOrders.Take(2))
                                                {
                                                    var actItem = actOrder.OrderItems.FirstOrDefault();
                                                    <div class="p-3 bg-white rounded-3 border d-flex justify-content-between align-items-center gap-2">
                                                        <div>
                                                            <strong class="text-dark d-block small">Order #@actOrder.Id.ToString("D5") &bull; @(actItem?.Product?.Name ?? "Crop Harvest")</strong>
                                                            <small class="text-muted">@(actItem?.Quantity ?? 1) Kg &bull; Status: <span class="text-success fw-bold">@actOrder.Status</span></small>
                                                        </div>
                                                        <a href="/Customer/OrderDetails?id=@actOrder.Id" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 fw-bold small">
                                                            View Details →
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-4 bg-white rounded-3 border text-center my-2">
                                                <i class="bi bi-box-seam text-muted fs-2 d-block mb-2 opacity-50"></i>
                                                <p class="text-muted small mb-0">You have no active orders in transit. Start shopping fresh harvests directly from verified farmers.</p>
                                            </div>
                                        }
                                    </div>
                                    <div class="pt-2">
                                        @if (activeOrdersCount > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-success fw-bold rounded-pill px-3.5 shadow-sm" onclick="switchDashTab('activeOrdersTab', document.querySelectorAll('.dash-tab-link')[2])" style="background-color: #006653; border-color: #006653;">
                                                <i class="bi bi-box-seam me-1"></i> Manage All Active Orders (@activeOrdersCount) →
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                                <i class="bi bi-shop me-1"></i> Start Shopping →
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Market Intelligence</span>
                                        <h6 class="fw-bold text-dark mb-1">Today's Best Farmer Produce</h6>
                                        <p class="text-muted small mb-3">Unjha Jeera (Cumin) and Saurashtra Groundnut are currently at peak harvest quality with direct farmer rates.</p>
                                    </div>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Check Live Market Rates
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: Shop Farm Produce (Embedded directly in Dashboard) -->
                    <div id="shopTab" class="dash-tab-panel @(activeTab == "shopTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Shop Farm Fresh Produce</h3>
                                <p class="text-muted small mb-0">Browse and purchase organic harvests directly from verified Gujarat farmers.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Full Catalogue
                            </a>
                        </div>

                        <!-- Embedded Product Grid with Modern Cards -->
                        @if (Model != null && Model.Any())
                        {
                            <div class="row g-4 mb-3">
                                @foreach (var item in Model)
                                {
                                    var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
                                    var catName = item.Category?.Name ?? "Farm Produce";
                                    var stockQty = item.StockQuantity;
                                    var maundPrice = item.Price * 20;

                                    <div class="col-md-6 col-xl-4">
                                        <div class="card h-100 bg-white shadow-sm rounded-4 border overflow-hidden position-relative" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                            <div class="position-relative" style="height: 190px; overflow: hidden; background: #f8fafc; border-bottom: 1px solid #f1f5f9;">
                                                @if (!string.IsNullOrEmpty(imgUrl))
                                                {
                                                    <img src="@imgUrl" class="card-img-top w-100 h-100" alt="@item.Name" style="object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center h-100 text-success">
                                                        <i class="bi bi-tree fs-1 opacity-50"></i>
                                                    </div>
                                                }
                                                <span class="position-absolute top-0 start-0 m-2.5 badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill shadow-sm" style="font-size: 0.68rem;">
                                                    <i class="bi bi-patch-check-fill me-1"></i>100% Organic
                                                </span>
                                                <span class="position-absolute top-0 end-0 m-2.5 badge bg-white text-dark fw-bold px-2.5 py-1 rounded-pill shadow-sm border" style="font-size: 0.68rem;">
                                                    @if (stockQty > 0)
                                                    {
                                                        <span class="text-success">● @stockQty Kg in Stock</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">● Out of Stock</span>
                                                    }
                                                </span>
                                            </div>

                                            <div class="card-body d-flex flex-column p-4">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25 rounded-pill px-2.5 py-0.5" style="font-size: 0.70rem;">
                                                        @catName
                                                    </span>
                                                    <span class="text-muted small fw-semibold" style="font-size: 0.70rem;">
                                                        <i class="bi bi-geo-alt-fill text-success"></i> Gujarat APMC
                                                    </span>
                                                </div>

                                                <h6 class="card-title fw-bold text-dark mb-1.5 text-truncate" title="@item.Name" style="font-size: 1.05rem;">@item.Name</h6>
                                                
                                                <p class="card-text text-muted small mb-3 text-truncate flex-grow-1" style="font-size: 0.80rem; min-height: 18px;">
                                                    @(string.IsNullOrEmpty(item.Description) ? "Fresh organic farm crop harvested directly by local Gujarat farmers." : item.Description)
                                                </p>
                                                
                                                <div class="p-3 bg-light rounded-3 border mb-3">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="fw-extrabold text-success fs-5">₹@item.Price.ToString("N2")</span>
                                                            <small class="text-muted fw-bold">/ Kg</small>
                                                        </div>
                                                        <span class="badge bg-white text-dark border small fw-semibold" style="font-size: 0.68rem;">
                                                            ₹@maundPrice.ToString("N0") / Maund
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="mt-auto pt-1">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="/Customer/Dashboard?tab=shopTab" class="btn btn-success rounded-pill w-100 fw-bold py-2.5 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #006653; border-color: #006653;">
                                                        <i class="bi bi-cart-check-fill fs-6"></i> View &amp; Buy Now
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-basket display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No farm harvests listed right now.</h5>
                                <p class="text-muted small mb-3">Verified local farmers will list fresh produce shortly. Check today's market rates in the meantime.</p>
                                <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill px-4 py-2 fw-bold">
                                    <i class="bi bi-graph-up-arrow me-1"></i> View Live Market Rates
                                </a>
                            </div>
                        }
                    </div>

                    <!-- TAB 3: My Cart -->
                    <div id="cartTab" class="dash-tab-panel @(activeTab == "cartTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Cart</h3>
                                <p class="text-muted small mb-0">Review items in your shopping bag and proceed to checkout.</p>
                            </div>
                        </div>

                        <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                            <i class="bi bi-cart-x display-4 text-success opacity-50 d-block mb-3"></i>
                            <h5 class="fw-bold text-dark mb-2">Your Shopping Cart is empty</h5>
                            <p class="text-muted small mb-4">You have not added any farm produce to your cart yet. Explore fresh crops directly from Gujarat farmers.</p>
                            <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[1])">
                                <i class="bi bi-shop me-1"></i> Explore Farm Produce
                            </button>
                        </div>
                    </div>

                    <!-- TAB: My Active Orders -->
                    <div id="activeOrdersTab" class="dash-tab-panel @(activeTab == "activeOrdersTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Active Orders 🚚</h3>
                                <p class="text-muted small mb-0">Live tracking of ongoing farm requests, 3-hour review window, transport in-transit and delivery OTP.</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[4])" style="background-color: #006653; border-color: #006653;">
                                <i class="bi bi-cart-plus me-1"></i> Order More Crops
                            </button>
                        </div>

                        @if (activeOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in activeOrders)
                                {
                                    var orderNoStr = "AG-" + order.Id.ToString("D5");
                                    var orderLabel = "#" + order.Id.ToString("D5");
                                    var dateFormatted = order.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
                                    var firstItem = order.OrderItems.FirstOrDefault();
                                    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
                                    var itemQty = firstItem?.Quantity ?? 1;
                                    var unitPrice = firstItem?.UnitPrice ?? order.TotalAmount;
                                    var baseAmt = order.TotalAmount - order.LogisticsFee - order.PlatformFee;
                                    var remSec = order.CancellationDeadline.HasValue ? (int)Math.Max(0, (order.CancellationDeadline.Value - DateTime.UtcNow).TotalSeconds) : 0;

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        <!-- Card Header: Order ID, Date & Live Status -->
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Active Order @orderLabel
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-event me-1"></i>@dateFormatted
                                                </span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (order.Status == "Requested")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-hourglass-top me-1"></i>Request Sent ⏳ (Awaiting Farmer)
                                                    </span>
                                                }
                                                else if (order.Status == "Accepted")
                                                {
                                                    @if (order.CancellationDeadline.HasValue && DateTime.UtcNow < order.CancellationDeadline.Value)
                                                    {
                                                        int ch = remSec / 3600;
                                                        int cm = (remSec % 3600) / 60;
                                                        int cs = remSec % 60;
                                                        <span class="badge bg-info text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                            <i class="bi bi-clock-history me-1"></i>Review Window Active (@($"{ch:D2}h {cm:D2}m {cs:D2}s"))
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                            <i class="bi bi-lock-fill me-1"></i>Locked for Harvest &amp; Dispatch
                                                        </span>
                                                    }
                                                }
                                                else if (order.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-truck me-1"></i>In Transit (@(string.IsNullOrEmpty(order.CargoServiceName) ? "Logistics" : order.CargoServiceName))
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-box-seam me-1"></i>@order.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Card Body: Produce Items Summary in Kg -->
                                        <div class="card-body p-3.5">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                                <div class="d-flex flex-wrap align-items-center justify-content-between py-1 gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(itemImg))
                                                        {
                                                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 58px; height: 58px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                                                <i class="bi bi-tree text-success fs-4"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <span class="badge bg-light text-success border small mb-1">@(item.Product?.Category?.Name ?? "Organic Crop")</span>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <small class="text-muted">Quantity: <strong class="text-dark">@item.Quantity Kg</strong> @@ ₹@item.UnitPrice.ToString("N2") / Kg</small>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(order.BiltyNumber))
                                            {
                                                <div class="mt-3 p-2.5 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <small class="text-muted d-block">GSRTC / Cargo Bilty LR Number:</small>
                                                        <strong class="text-primary font-monospace">@order.BiltyNumber</strong>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(order.BiltyImageUrl))
                                                    {
                                                        <a href="@order.BiltyImageUrl" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-3 py-1 fw-bold small">
                                                            <i class="bi bi-receipt me-1"></i> View Bilty Slip
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Footer: Total Paid & Security Protected Action Buttons -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1"></i>@(order.PaymentMethod ?? "Online (Escrow)")</span>
                                                <span class="badge bg-light text-dark border"><i class="bi bi-truck me-1"></i>@(order.TransportType ?? "Direct Farm Pickup")</span>
                                                <span class="text-muted small">Total:</span>
                                                <span class="fw-extrabold text-success fs-5">₹@order.TotalAmount.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;" onclick="openSecurityGate(@order.Id, '@orderLabel')">
                                                    <i class="bi bi-shield-lock-fill me-1"></i> View More Details &amp; OTP
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@userName', '@produceName', @itemQty, @unitPrice, @baseAmt, @order.LogisticsFee, @order.PlatformFee, @order.TotalAmount, '@(order.PaymentMethod ?? "Online (Escrow)")', '@(order.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(order.ShippingAddress) ? "Gujarat Farm Location" : order.ShippingAddress)')">
                                                    <i class="bi bi-printer me-1"></i> Print Invoice
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-box-seam display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Active Orders Currently</h5>
                                <p class="text-muted small mb-4">You have no in-progress orders. Browse freshly harvested crops directly from verified Gujarat farmers.</p>
                                <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="switchDashTab('shopTab', document.querySelectorAll('.dash-tab-link')[4])" style="background-color: #006653; border-color: #006653;">
                                    <i class="bi bi-bag-plus me-1"></i> Explore Farm Produce
                                </button>
                            </div>
                        }
                    </div>

                    <!-- TAB: Order History (Completed Orders) - Detailed Micro-Breakdown -->
                    <div id="ordersTab" class="dash-tab-panel @(activeTab == "ordersTab" || activeTab == "historyTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Order History &amp; Fulfilled Purchases 📋</h3>
                                <p class="text-muted small mb-0">Master record of all completed, delivered and fulfilled farm purchases.</p>
                            </div>
                            <a asp-action="TotalPurchases" class="btn btn-sm btn-outline-success rounded-pill px-3.5 py-2 fw-bold">
                                <i class="bi bi-graph-up me-1"></i> Full Purchase Statement
                            </a>
                        </div>

                        @if (completedOrders.Any())
                        {
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var order in completedOrders)
                                {
                                    var orderNoStr = "AG-" + order.Id.ToString("D5");
                                    var orderLabel = "#" + order.Id.ToString("D5");
                                    var dateFormatted = order.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
                                    var deliveredDateStr = order.DeliveredAt.HasValue ? order.DeliveredAt.Value.ToString("dd MMM yyyy, hh:mm tt") : dateFormatted;
                                    var firstItem = order.OrderItems.FirstOrDefault();
                                    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
                                    var itemQty = firstItem?.Quantity ?? 1;
                                    var unitPrice = firstItem?.UnitPrice ?? order.TotalAmount;
                                    var baseAmt = order.TotalAmount - order.LogisticsFee - order.PlatformFee;

                                    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-2">
                                        <!-- Card Header: Order ID, Delivered Date & Final Status -->
                                        <div class="card-header bg-white border-bottom p-3.5 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small">
                                                    Order @orderLabel
                                                </span>
                                                <span class="text-muted small">
                                                    <i class="bi bi-calendar-check me-1"></i>Ordered: @dateFormatted
                                                </span>
                                            </div>
                                            <div>
                                                @if (order.Status.Contains("Delivered") || order.Status.Contains("Settled"))
                                                {
                                                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Delivered &amp; Settled 🟢
