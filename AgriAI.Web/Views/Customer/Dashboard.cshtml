        function filterPurchaseTable(category, btn) {
            document.querySelectorAll('.purchase-table-filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const rows = document.querySelectorAll('.purchase-row');
            rows.forEach(r => {
                if (category === 'all') {
                    r.style.display = '';
                } else {
                    const rowCat = r.getAttribute('data-category');
                    r.style.display = (rowCat === category) ? '' : 'none';
                }
            });
        }

        // ==========================================
        // MULTI-PRODUCT SHOPPING CART ENGINE (AJAX)
        // ==========================================
        function showFloatingToast(message, isSuccess = true) {
            let toast = document.getElementById('agriai-floating-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'agriai-floating-toast';
                toast.style.position = 'fixed';
                toast.style.bottom = '28px';
                toast.style.right = '28px';
                toast.style.zIndex = '999999';
                toast.style.transition = 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
                document.body.appendChild(toast);
            }
            toast.innerHTML = `
                <div class="alert ${isSuccess ? 'alert-success border-success' : 'alert-danger border-danger'} shadow-lg rounded-4 p-3 d-flex align-items-center gap-2 mb-0" style="min-width: 280px; background-color: #ffffff;">
                    <i class="bi ${isSuccess ? 'bi-check-circle-fill text-success' : 'bi-exclamation-circle-fill text-danger'} fs-5"></i>
                    <div class="flex-grow-1 small fw-bold text-dark">${message}</div>
                    <button type="button" class="btn-close btn-sm shadow-none" onclick="this.closest('#agriai-floating-toast').style.display='none'"></button>
                </div>
            `;
            toast.style.display = 'block';
            setTimeout(() => {
                if (toast) toast.style.display = 'none';
            }, 4000);
        }

        function addToCartAjax(productId, qty, name) {
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${productId}&quantity=${qty || 1}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showFloatingToast(data.message || `🌾 ${name} added to cart!`);
                    updateCartBadgeCount(data.count);
                    loadCartItems();
                } else {
                    showFloatingToast(data.message || 'Could not add to cart', false);
                }
            })
            .catch(err => {
                console.error(err);
                showFloatingToast('Error adding to cart', false);
            });
        }

        function updateCartBadgeCount(count) {
            const badge = document.getElementById('sidebarCartCountBadge');
            if (badge) {
                badge.textContent = count;
                badge.style.display = count > 0 ? 'inline-block' : 'none';
            }
        }

        function updateCartQty(productId, qty) {
            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${productId}&quantity=${qty}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    renderCartUI(data);
                    updateCartBadgeCount(data.totalItemsCount);
                }
            });
        }

        let cartConfirmModalInstance = null;
        let cartPendingAction = null;

        function showCartConfirmModal({ title, message, iconClass, iconBg, iconColor, btnText, btnColor, onConfirm }) {
            const modalEl = document.getElementById('cartConfirmModal');
            if (!modalEl) {
                if (confirm(message)) onConfirm();
                return;
            }

            document.getElementById('cartConfirmModalTitle').textContent = title || 'Confirm Action';
            document.getElementById('cartConfirmModalMessage').textContent = message || 'Are you sure?';

            const iconWrapper = document.getElementById('cartModalIconWrapper');
            const icon = document.getElementById('cartModalIcon');
            const actionBtn = document.getElementById('cartConfirmActionBtn');

            if (icon) {
                icon.className = `bi ${iconClass || 'bi-trash3-fill'} fs-2`;
            }
            if (iconWrapper) {
                iconWrapper.style.background = iconBg || '#fee2e2';
                iconWrapper.style.color = iconColor || '#ef4444';
            }
            if (actionBtn) {
                actionBtn.innerHTML = btnText || '<i class="bi bi-trash3-fill me-1"></i> Remove';
                actionBtn.style.backgroundColor = btnColor || '#dc2626';
                actionBtn.style.borderColor = btnColor || '#dc2626';
            }

            cartPendingAction = onConfirm;

            if (!cartConfirmModalInstance) {
                cartConfirmModalInstance = new bootstrap.Modal(modalEl);
            }
            cartConfirmModalInstance.show();
        }

        function confirmCartModalAction() {
            if (cartConfirmModalInstance) {
                cartConfirmModalInstance.hide();
            }
            if (typeof cartPendingAction === 'function') {
                const action = cartPendingAction;
                cartPendingAction = null;
                action();
            }
        }

        function removeCartItem(productId, productName) {
            const name = productName ? `"${productName}"` : 'this crop';
            showCartConfirmModal({
                title: 'Remove Item from Cart?',
                message: `Are you sure you want to remove ${name} from your shopping cart?`,
                iconClass: 'bi-trash3-fill',
                iconBg: '#fee2e2',
                iconColor: '#ef4444',
                btnText: '<i class="bi bi-trash3-fill me-1"></i> Remove',
                btnColor: '#dc2626',
                onConfirm: () => {
                    fetch('/Cart/RemoveItem', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `productId=${productId}`
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            renderCartUI(data);
                            updateCartBadgeCount(data.totalItemsCount);
                            showFloatingToast('Item removed from cart');
                        }
                    })
                    .catch(() => showFloatingToast('Failed to remove item', false));
                }
            });
        }

        function clearCart() {
            showCartConfirmModal({
                title: 'Clear Shopping Cart?',
                message: 'Are you sure you want to clear all items in your cart? This will empty your current produce selection.',
                iconClass: 'bi-cart-x-fill',
                iconBg: '#fef3c7',
                iconColor: '#d97706',
                btnText: '<i class="bi bi-trash3-fill me-1"></i> Clear Cart',
                btnColor: '#d97706',
                onConfirm: () => {
                    fetch('/Cart/ClearCart', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            updateCartBadgeCount(0);
                            renderCartUI({ items: [], totalItemsCount: 0, baseTotal: 0, platformFee: 0, grandTotal: 0 });
                            showFloatingToast('Cart cleared');
                        }
                    })
                    .catch(() => showFloatingToast('Failed to clear cart', false));
                }
            });
        }

        function loadCartItems() {
            fetch('/Cart/GetCart')
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    renderCartUI(data);
                    updateCartBadgeCount(data.totalItemsCount);
                }
            });
        }

        function renderCartUI(data) {
            const emptyState = document.getElementById('cartEmptyState');
            const contentWrapper = document.getElementById('cartContentWrapper');
            const clearBtn = document.getElementById('btnClearCartBtn');
            const itemsList = document.getElementById('cartItemsList');

            if (!data.items || data.items.length === 0) {
                if (emptyState) emptyState.style.display = 'block';
                if (contentWrapper) contentWrapper.style.display = 'none';
                if (clearBtn) clearBtn.style.display = 'none';
                return;
            }

            if (emptyState) emptyState.style.display = 'none';
            if (contentWrapper) contentWrapper.style.display = 'block';
            if (clearBtn) clearBtn.style.display = 'inline-block';

            if (itemsList) {
                let html = '';
                data.items.forEach(item => {
                    const img = item.imageUrl ? `<img src="${item.imageUrl}" class="rounded-4 shadow-sm" alt="${item.productName}" style="width: 85px; height: 85px; object-fit: cover; border: 1px solid #f1f5f9;" />`
                                             : `<div class="bg-light rounded-4 d-flex align-items-center justify-content-center border" style="width: 85px; height: 85px;"><i class="bi bi-tree text-success fs-2"></i></div>`;
                    html += `
                        <div class="cart-item-card" id="cartItemRow_${item.productId}">
                            <div class="d-flex align-items-start gap-3">
                                ${img}
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill small mb-1 border border-success border-opacity-25" style="font-size: 0.72rem;">
                                                ${item.categoryName || 'Farm Produce'}
                                            </span>
                                            <h5 class="fw-extrabold text-dark mb-1 fs-5">${item.productName}</h5>
                                            <div class="text-muted small">
                                                <span>Producer: <strong class="text-dark">${item.farmerName || 'Verified Farmer'}</strong></span>
                                                <span class="ms-2 text-success fw-semibold">&bull; ₹${Number(item.unitPrice).toFixed(2)} / Kg</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5 shadow-sm" title="Remove Item" onclick="removeCartItem(${item.productId}, '${(item.productName || '').replace(/'/g, "\\'")}')">
                                            <i class="bi bi-trash3"></i> <span class="d-none d-sm-inline">Remove</span>
                                        </button>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted small fw-bold">Quantity:</span>
                                            <div class="cart-stepper-container">
                                                <button type="button" class="cart-stepper-btn" onclick="updateCartQty(${item.productId}, ${item.quantity - 1})">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <span class="cart-stepper-value" id="cartItemQty_${item.productId}">${item.quantity} Kg</span>
                                                <button type="button" class="cart-stepper-btn" onclick="updateCartQty(${item.productId}, ${item.quantity + 1})">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="text-end mt-2 mt-sm-0">
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">Item Total</small>
                                            <span class="fs-4 fw-extrabold text-success" id="cartItemTotal_${item.productId}">₹${Number(item.totalPrice).toFixed(2)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });
                itemsList.innerHTML = html;
            }

            // Update Totals
            const countEl = document.getElementById('cartSummaryItemCount');
            const baseEl = document.getElementById('cartSummaryBaseTotal');
            const feeEl = document.getElementById('cartSummaryPlatformFee');
            const grandEl = document.getElementById('cartSummaryGrandTotal');

            if (countEl) countEl.textContent = `${data.totalItemsCount} Kg (${data.items.length} Varieties)`;
            if (baseEl) baseEl.textContent = `₹${Number(data.baseTotal).toFixed(2)}`;
            if (feeEl) feeEl.textContent = `₹${Number(data.platformFee).toFixed(2)}`;
            if (grandEl) grandEl.textContent = `₹${Number(data.grandTotal).toFixed(2)}`;
        }

        function openFullPhotoModal(imgSrc, userName) {
            if (!imgSrc || imgSrc.trim() === '') return;
            const imgEl = document.getElementById('fullPhotoModalImg');
            const titleEl = document.getElementById('fullPhotoModalTitle');
            const dlBtn = document.getElementById('fullPhotoDownloadBtn');
            if (imgEl) imgEl.src = imgSrc;
            if (titleEl) titleEl.textContent = (userName && userName.trim() !== '') ? userName : 'Profile Picture';
            if (dlBtn) dlBtn.href = imgSrc;
            const modalEl = document.getElementById('fullPhotoModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            }
        }
    </script>
}
