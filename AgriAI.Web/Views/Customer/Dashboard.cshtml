                                                            <span class="badge bg-light text-success border small mb-1">@(item.Product?.Category?.Name ?? "Produce")</span>
                                                            <h6 class="fw-bold text-dark mb-0">@(item.Product?.Name ?? "Farm Produce")</h6>
                                                            <div class="small text-muted mt-0.5">
                                                                <span>Delivered Quantity: <strong class="text-dark">@item.Quantity Kg</strong></span> &bull; 
                                                                <span>Rate: <strong>₹@item.UnitPrice.ToString("N2") / Kg</strong></span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="text-end">
                                                        <span class="fw-extrabold text-success fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Micro-Details Pill Bar -->
                                            <div class="row g-2 mt-2 pt-2 border-top small text-muted">
                                                <div class="col-sm-6 col-md-4">
                                                    <i class="bi bi-truck text-success me-1"></i> <strong>Logistics:</strong> @(order.TransportType ?? "Direct Farm Pickup")
                                                </div>
                                                <div class="col-sm-6 col-md-4">
                                                    <i class="bi bi-credit-card text-success me-1"></i> <strong>Payment:</strong> @(order.PaymentMethod ?? "Online Escrow")
                                                </div>
                                                <div class="col-sm-12 col-md-4 text-md-end">
                                                    <i class="bi bi-geo-alt text-success me-1"></i> <strong>Destination:</strong> @(string.IsNullOrEmpty(order.ShippingAddress) ? "Farm Location" : order.ShippingAddress)
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(order.BiltyNumber))
                                            {
                                                <div class="mt-2 p-2 bg-light rounded-3 d-flex justify-content-between align-items-center small">
                                                    <span><i class="bi bi-bus-front text-primary me-1"></i> <strong>GSRTC/Cargo Bilty LR:</strong> @order.BiltyNumber (@(order.CargoServiceName ?? "ST Bus Parcel"))</span>
                                                    @if (!string.IsNullOrEmpty(order.BiltyImageUrl))
                                                    {
                                                        <a href="@order.BiltyImageUrl" target="_blank" class="text-primary text-decoration-none fw-bold">
                                                            <i class="bi bi-image me-1"></i> View Slip
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <!-- Card Footer: Total Paid & Action Buttons -->
                                        <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted small">Total Paid Amount:</span>
                                                <span class="fw-extrabold text-success fs-5">₹@order.TotalAmount.ToString("N2")</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <a asp-action="OrderDetails" asp-route-id="@order.Id" asp-route-from="history" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                                                    <i class="bi bi-eye-fill me-1"></i> View Order Details
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@userName', '@produceName', @itemQty, @unitPrice, @baseAmt, @order.LogisticsFee, @order.PlatformFee, @order.TotalAmount, '@(order.PaymentMethod ?? "Online (Escrow)")', '@(order.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(order.ShippingAddress) ? "Gujarat Farm Location" : order.ShippingAddress)')">
                                                    <i class="bi bi-printer me-1"></i> Print Tax Invoice
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 rounded-4 border bg-white shadow-sm text-center my-3">
                                <i class="bi bi-clock-history display-4 text-success opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No Completed Order History</h5>
                                <p class="text-muted small mb-4">When your ongoing orders are delivered and settled, they will be archived with full invoices in this history section.</p>
                                <button type="button" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="switchDashTab('activeOrdersTab', document.querySelectorAll('.dash-tab-link')[2])">
                                    <i class="bi bi-box-seam me-1"></i> View Active Orders
                                </button>
                            </div>
                        }
                    </div>

                    <!-- TAB 5: My Profile Settings -->
                    <div id="profileTab" class="dash-tab-panel @(activeTab == "profileTab" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">My Account &amp; Profile Settings</h3>
                                <p class="text-muted small mb-0">Manage your verified customer profile and delivery address.</p>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person text-success me-1"></i> Account Details</h6>
                                    <div class="mb-3">
                                        <label class="form-label small text-muted">Full Name</label>
                                        <input type="text" class="form-control bg-light" value="@displayName" readonly />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small text-muted">Email Address</label>
                                        <input type="email" class="form-control bg-light" value="@userEmail" readonly />
                                    </div>
                                    <div>
                                        <label class="form-label small text-muted">Phone Number</label>
                                        <input type="text" class="form-control bg-light" value="@userPhone" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border bg-white shadow-sm h-100">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-success me-1"></i> Security &amp; Guarantee</h6>
                                    <p class="text-muted small mb-3">Your purchases on AgriAI are protected by automated 2-way Escrow security and verified Farmer certificates.</p>
                                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-0">
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>100% Direct Farmer Produce</li>
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Escrow Holding until Delivery</li>
                                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>4-Digit Secure Delivery OTP verification</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Security Gate Verification Modal -->
<div class="modal fade" id="securityGateModal" tabindex="-1" aria-labelledby="securityGateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 p-4 pb-0 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="securityGateModalLabel">Security Verification</h5>
                        <span class="text-muted small">Account Password Confirmation</span>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 pt-3">
                <p class="text-muted small mb-3">
                    To protect your privacy and unlock confidential farmer contact and your <strong>4-Digit Delivery OTP</strong> for <strong id="secOrderLabel" class="text-dark"></strong>, please enter your account password.
                </p>

                <div id="secGateAlert" class="alert alert-danger p-2.5 rounded-3 small mb-3 d-none">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="secGateAlertMsg"></span>
                </div>

                <form id="secGateForm" onsubmit="submitSecurityGate(event)">
                    <input type="hidden" id="secGateOrderId" value="" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Enter Account Password</label>
                        <div class="input-group">
                            <input type="password" id="secGatePassword" class="form-control rounded-start-3 shadow-none" placeholder="Enter your password..." required />
                            <button type="button" class="btn btn-outline-secondary rounded-end-3" onclick="toggleSecPassVisibility()">
                                <i class="bi bi-eye" id="secPassEyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="secGateSubmitBtn" class="btn btn-success rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                            <i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab') || (window.location.hash ? window.location.hash.replace('#', '') : null);
            if (tabParam) {
                const targetBtn = document.querySelector(`.dash-tab-link[onclick*="${tabParam}"]`);
                if (targetBtn) {
                    switchDashTab(tabParam, targetBtn);
                }
            }
        });

        function switchDashTab(tabId, btn) {
            // Hide all tab panels
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            // Show selected tab panel
            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            // Update active state in sidebar
            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }

        let currentSecOrderId = 0;
        let secModalInstance = null;

        function openSecurityGate(orderId, orderLabel) {
            currentSecOrderId = orderId;
            document.getElementById('secGateOrderId').value = orderId;
            document.getElementById('secOrderLabel').textContent = 'Order ' + orderLabel;
            document.getElementById('secGatePassword').value = '';
            document.getElementById('secGateAlert').classList.add('d-none');
            
            const submitBtn = document.getElementById('secGateSubmitBtn');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';

            const modalEl = document.getElementById('securityGateModal');
            secModalInstance = new bootstrap.Modal(modalEl);
            secModalInstance.show();

            setTimeout(() => {
                document.getElementById('secGatePassword').focus();
            }, 500);
        }

        function toggleSecPassVisibility() {
            const passInput = document.getElementById('secGatePassword');
            const icon = document.getElementById('secPassEyeIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        async function submitSecurityGate(e) {
            e.preventDefault();
            const orderId = document.getElementById('secGateOrderId').value;
            const password = document.getElementById('secGatePassword').value;
            const submitBtn = document.getElementById('secGateSubmitBtn');
            const alertBox = document.getElementById('secGateAlert');
            const alertMsg = document.getElementById('secGateAlertMsg');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Verifying Password...';
            alertBox.classList.add('d-none');

            try {
                const formData = new FormData();
                formData.append('orderId', orderId);
                formData.append('password', password);

                const response = await fetch('/Customer/VerifySecurityGate', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Unlocked! Opening...';
                    window.location.href = data.redirectUrl;
                } else {
                    alertMsg.textContent = data.message || 'Invalid password. Please try again.';
                    alertBox.classList.remove('d-none');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';
                    document.getElementById('secGatePassword').focus();
                }
            } catch (err) {
                alertMsg.textContent = 'Error connecting to server. Please try again.';
                alertBox.classList.remove('d-none');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-unlock-fill me-1"></i> Unlock Order Details &amp; OTP';
            }
        }

        function printOrderInvoice(orderNo, orderDate, buyerName, produceName, qty, unitPrice, baseAmt, logisticsFee, platformFee, grandTotal, paymentMode, transportType, deliveryLocation) {
            const printWindow = window.open('', '_blank', 'width=850,height=900');
            const formattedTotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(grandTotal);
            const formattedBase = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(baseAmt);
            const formattedLogistics = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(logisticsFee);
            const formattedFee = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(platformFee);
            const formattedUnit = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(unitPrice);

            const invoiceHtml = `
            <!DOCTYPE html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Tax Invoice - ${orderNo} - AgriAI Platform</title>
                <style>
                    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 25px; color: #1e293b; line-height: 1.4; }
                    .invoice-card { max-width: 780px; margin: auto; border: 1px solid #cbd5e1; border-radius: 12px; padding: 30px; background: #fff; }
                    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #006653; padding-bottom: 15px; margin-bottom: 20px; }
                    .logo-title { color: #006653; font-size: 24px; font-weight: 800; margin: 0; }
                    .logo-sub { color: #64748b; font-size: 12px; margin: 2px 0 0 0; }
                    .badge-inv { background: #f0fdf4; color: #15803d; border: 1px solid #86efac; padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; }
                    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
                    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px; }
                    .info-box h4 { margin: 0 0 6px 0; font-size: 13px; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px; }
                    .info-box p { margin: 3px 0; font-size: 12.5px; color: #475569; }
                    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                    th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-size: 12.5px; color: #334155; border-bottom: 2px solid #cbd5e1; }
                    td { padding: 12px; font-size: 13px; border-bottom: 1px solid #e2e8f0; }
                    .totals-table { width: 320px; margin-left: auto; margin-bottom: 20px; }
                    .totals-table td { padding: 5px 8px; border: none; font-size: 12.5px; }
                    .grand-row { border-top: 2px solid #006653 !important; font-size: 16px !important; font-weight: 800; color: #006653; padding-top: 8px !important; }
                    .footer { border-top: 1px solid #e2e8f0; padding-top: 15px; display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: #64748b; }
                    .stamp { border: 2px dashed #86efac; background: #f0fdf4; padding: 6px 12px; border-radius: 6px; color: #15803d; font-weight: bold; font-size: 12px; }
                    @@media print {
                        body { padding: 0; }
                        .invoice-card { border: none; padding: 10px; }
                    }
                </style>
            </head>
            <body>
                <div class="invoice-card">
                    <div class="header">
                        <div>
                            <h1 class="logo-title">🌾 AgriAI Produce Invoice</h1>
                            <p class="logo-sub">Direct Farm-to-Consumer Agricultural Platform &bull; Gujarat, India</p>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge-inv">OFFICIAL TAX RECEIPT</span>
