@model AgriAI.Domain.Entities.Order
@using AgriAI.Infrastructure.Identity

@{
    ViewData["Title"] = $"Order #{Model.Id:D5} Details";
    var farmerUser = ViewBag.FarmerUser as ApplicationUser;
    var farmerName = farmerUser != null 
        ? (!string.IsNullOrEmpty(farmerUser.FirstName) || !string.IsNullOrEmpty(farmerUser.LastName) 
            ? $"{farmerUser.FirstName} {farmerUser.LastName}".Trim() 
            : farmerUser.UserName) 
        : "Verified Gujarat Producer";
    var farmerPhone = farmerUser?.PhoneNumber ?? "+91 97245 60047";
    var baseAmount = Model.TotalAmount - Model.LogisticsFee - Model.PlatformFee;
    var orderNoStr = "AG-" + Model.Id.ToString("D5");
    var dateFormatted = Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
    var firstItem = Model.OrderItems.FirstOrDefault();
    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
    var itemQty = firstItem?.Quantity ?? 1;
    var unitPrice = firstItem?.UnitPrice ?? Model.TotalAmount;
    var remainingSeconds = Model.CancellationDeadline.HasValue ? (int)Math.Max(0, (Model.CancellationDeadline.Value - DateTime.UtcNow).TotalSeconds) : 0;
    string returnUrl = Context.Request.Query["returnUrl"].ToString();
    string from = Context.Request.Query["from"].ToString();
    string backUrl = !string.IsNullOrEmpty(returnUrl) 
        ? returnUrl 
        : (from == "totalPurchases" ? "/Customer/TotalPurchases" : (from == "active" ? "/Customer/Dashboard?tab=activeOrdersTab" : "/Customer/Dashboard?tab=ordersTab"));
    string backLabel = from == "totalPurchases" ? "Back to Total Purchases" : (from == "active" ? "Back to Active Orders" : "Back to Order History");
}

<div class="container-fluid py-4 my-2 px-3 px-md-4 px-lg-5" style="max-width: 1380px;">
    
    <!-- Top Header Bar with Clean Single Back Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3">
            <h2 class="fw-extrabold text-dark mb-0">Order #@Model.Id.ToString("D5")</h2>
            @if (Model.Status == "Requested")
            {
                <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill shadow-sm">
                    <i class="bi bi-hourglass-top me-1"></i>Request Sent ⏳
                </span>
            }
            else if (Model.Status == "Accepted")
            {
                @if (Model.CancellationDeadline.HasValue && DateTime.UtcNow < Model.CancellationDeadline.Value)
                {
                    <span class="badge bg-info text-dark fw-bold px-3 py-1.5 rounded-pill">
                        <i class="bi bi-clock-history me-1"></i>Accepted (3h Review Window)
                    </span>
                }
                else
                {
                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                        <i class="bi bi-lock-fill me-1"></i>Locked for Harvest &amp; Dispatch
                    </span>
                }
            }
            else if (Model.Status == "Declined")
            {
                <span class="badge bg-danger text-white fw-bold px-3 py-1.5 rounded-pill">
                    <i class="bi bi-x-circle-fill me-1"></i>Declined (Refunded)
                </span>
            }
            else if (Model.Status == "Cancelled")
            {
                <span class="badge bg-secondary text-white fw-bold px-3 py-1.5 rounded-pill">
                    <i class="bi bi-slash-circle me-1"></i>Cancelled (Refunded)
                </span>
            }
            else if (Model.Status.Contains("Delivered") || Model.Status.Contains("Settled"))
            {
                <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i>Completed 🟢
                </span>
            }
            else
            {
                <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                    <i class="bi bi-truck me-1"></i>@Model.Status
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@backUrl" class="btn btn-outline-secondary rounded-pill px-3.5 py-2 fw-bold small">
                <i class="bi bi-arrow-left me-1"></i> @backLabel
            </a>
            <button type="button" class="btn btn-success rounded-pill px-3.5 py-2 fw-bold small shadow-sm" style="background-color: #006653; border-color: #006653;" onclick="printOrderInvoice('@orderNoStr', '@dateFormatted', '@User.Identity?.Name', '@produceName', @itemQty, @unitPrice, @baseAmount, @Model.LogisticsFee, @Model.PlatformFee, @Model.TotalAmount, '@(Model.PaymentMethod ?? "Online (Escrow)")', '@(Model.TransportType ?? "Direct Farm Pickup")', '@(string.IsNullOrEmpty(Model.ShippingAddress) ? "Gujarat Farm Location" : Model.ShippingAddress)')">
                <i class="bi bi-printer me-1"></i> Print Tax Invoice
            </button>
        </div>
    </div>

    <!-- Step 2: 3-Hour Cancellation & Review Window Card -->
    @if (Model.Status == "Requested")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-dark bg-warning bg-opacity-10 border border-warning border-opacity-25">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                            <i class="bi bi-hourglass-split me-1"></i>AWAITING PRODUCER ACCEPTANCE
                        </span>
                        <span class="text-muted small">100% Escrow Protected</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Your Order Request has been sent to the Producer</h5>
                    <p class="text-muted small mb-0">
                        The farmer will review and accept your order shortly. You can cancel with an instant 100% refund at any time before dispatch lock.
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3.5 py-2 fw-bold shadow-sm" onclick="openCancelModal()">
                        <i class="bi bi-x-circle me-1"></i> Cancel Request (100% Refund)
                    </button>
                </div>
            </div>
        </div>
    }
    else if (Model.Status == "Accepted")
    {
        @if (Model.CancellationDeadline.HasValue && DateTime.UtcNow < Model.CancellationDeadline.Value)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%);">
                <div class="row align-items-center g-3">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                                <i class="bi bi-clock-history me-1"></i>3-HOUR CANCELLATION WINDOW ACTIVE
                            </span>
                            <span class="text-white-50 small">100% Instant Refund Available</span>
                        </div>
                        <h4 class="fw-bold text-white mb-1">Your Order is in the 3-Hour Review Period</h4>
                        <p class="text-white-50 small mb-0">
                            The farmer accepted your order! You have a 3-hour window to review or cancel for an immediate refund. When the countdown reaches zero, the order will lock for fresh harvest packaging.
                        </p>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <div class="d-inline-block bg-black bg-opacity-25 p-3 rounded-4 border border-white border-opacity-20 text-center">
                            <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">CANCELLATION COUNTDOWN</small>
                            <span class="fs-2 fw-extrabold text-warning font-monospace d-block" id="customerCountdownTimer" data-remaining="@remainingSeconds">
                                @{
                                    int ch = remainingSeconds / 3600;
                                    int cm = (remainingSeconds % 3600) / 60;
                                    int cs = remainingSeconds % 60;
                                    @($"{ch:D2}h {cm:D2}m {cs:D2}s")
                                }
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-bold mt-2" onclick="openCancelModal()">
                                <i class="bi bi-x-circle me-1"></i> Cancel &amp; Instant Refund
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-3.5 mb-4 d-flex align-items-center gap-3" style="background-color: #d1fae5; color: #065f46;">
                <i class="bi bi-lock-fill fs-3"></i>
                <div>
                    <strong>Order Locked for Harvest &amp; Dispatch:</strong>
                    <p class="small mb-0">The 3-hour review window has concluded. The farmer is now preparing and packing your fresh harvest produce.</p>
                </div>
            </div>
        }
    }
    else if (Model.Status == "Declined")
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 p-3.5 mb-4 d-flex align-items-center gap-3" style="background-color: #fee2e2; color: #991b1b;">
            <i class="bi bi-x-circle-fill fs-3"></i>
            <div>
                <strong>Order Declined by Farmer:</strong>
                <p class="small mb-0">Reason: @(string.IsNullOrEmpty(Model.FarmerDeclineReason) ? "Stock unavailable / logistics constraint" : Model.FarmerDeclineReason). Total payment of ₹@Model.TotalAmount.ToString("N2") has been refunded to your payment method.</p>
            </div>
        </div>
    }
    else if (Model.Status == "Cancelled")
    {
        <div class="alert alert-secondary border-0 shadow-sm rounded-4 p-3.5 mb-4 d-flex align-items-center gap-3">
            <i class="bi bi-slash-circle-fill fs-3 text-secondary"></i>
            <div>
                <strong>Order Cancelled by Buyer:</strong>
                <p class="small mb-0">Reason: @(string.IsNullOrEmpty(Model.CustomerCancelReason) ? "Cancelled within review window" : Model.CustomerCancelReason). 100% refund of ₹@Model.TotalAmount.ToString("N2") has been credited back.</p>
            </div>
        </div>
    }

    <!-- GSRTC / Private Cargo Bilty Dispatch Card (Step 5 Blueprint - Parcel Only) -->
    @if (Model.TransportType != null && (Model.TransportType.Contains("Cargo") || Model.TransportType.Contains("GSRTC") || Model.TransportType.Contains("Parcel")) && (!string.IsNullOrEmpty(Model.BiltyNumber) || !string.IsNullOrEmpty(Model.BiltyImageUrl)))
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                            <i class="bi bi-bus-front-fill me-1"></i>GSRTC / CARGO DISPATCHED
                        </span>
                        <span class="text-white-50 small">"To-Pay" Parcel Model</span>
                    </div>
                    <h4 class="fw-bold text-white mb-1">Harvest Dispatched via @(Model.CargoServiceName ?? "GSRTC ST Bus Parcel")</h4>
                    <p class="text-white-50 small mb-2">
                        Your produce is in transit! Show the Bilty LR Number at the parcel counter in your city and collect your harvest by paying the nominal counter parcel fee.
                    </p>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white-50 small"><i class="bi bi-clock-history me-1"></i>Dispatched: @(Model.DispatchedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently")</span>
                    </div>
                </div>

                <div class="col-md-5 text-md-end">
                    <div class="d-inline-flex flex-column align-items-md-end gap-2 bg-white bg-opacity-10 p-3 rounded-4 border border-white border-opacity-20 shadow">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-white-50 small">BILTY / LR NO:</span>
                            <span class="fs-4 fw-extrabold text-warning letter-spacing-2 font-monospace">
                                @Model.BiltyNumber
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-bold shadow-sm" onclick="navigator.clipboard.writeText('@Model.BiltyNumber'); this.innerHTML='<i class=\'bi bi-check2\'></i> Copied!';">
                                <i class="bi bi-clipboard me-1"></i> Copy Bilty #
                            </button>
                            @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
                            {
                                <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#biltyViewerModal">
                                    <i class="bi bi-receipt-cutoff me-1"></i> View Bilty Slip 📄
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
        {
            <!-- Modal for viewing Bilty Slip in HD -->
            <div class="modal fade" id="biltyViewerModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                        <div class="modal-header bg-dark text-white p-3.5 px-4">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-receipt-cutoff text-warning fs-5"></i>
                                <h5 class="modal-title fw-bold mb-0">Official Bilty / LR Slip: @Model.BiltyNumber</h5>
                            </div>
                            <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4 text-center bg-light">
                            <div class="mb-3 d-flex justify-content-between align-items-center bg-white p-2.5 px-3 rounded-3 border">
                                <span class="text-muted small">
                                    <i class="bi bi-truck text-primary me-1"></i> Transport Service: <strong>@(string.IsNullOrEmpty(Model.CargoServiceName) ? "GSRTC / Cargo" : Model.CargoServiceName)</strong>
                                </span>
                                <a href="@Model.BiltyImageUrl" target="_blank" download class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold">
                                    <i class="bi bi-download me-1"></i> Download / Open Original
                                </a>
                            </div>
                            <div class="rounded-3 overflow-hidden border shadow-sm bg-white p-2 text-center">
                                <img src="@Model.BiltyImageUrl" alt="Bilty Receipt" class="img-fluid rounded" style="max-height: 520px; object-fit: contain; width: 100%;" />
                            </div>
                        </div>
                        <div class="modal-footer bg-white p-3 px-4 d-flex justify-content-between">
                            <small class="text-muted">Show this official parcel slip at the ST counter to receive your produce.</small>
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Quality & Weight Inspection Checklist (Step 6 Blueprint) -->
    <div class="card border-0 shadow-sm rounded-4 p-3.5 mb-4 bg-light border border-success border-opacity-25">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-patch-check-fill text-success fs-5"></i>
            <h6 class="fw-bold text-dark mb-0">Buyer Pre-Delivery Quality Inspection Guide</h6>
        </div>
        <div class="row g-2 small text-muted">
            <div class="col-md-4">
                <i class="bi bi-check-circle-fill text-success me-1"></i> <strong>1. Bag Seals &amp; Weight:</strong> Inspect packaging seals and ensure total measured weight matches invoice.
            </div>
            <div class="col-md-4">
                <i class="bi bi-check-circle-fill text-success me-1"></i> <strong>2. Quality &amp; Moisture:</strong> Check crop cleanliness, grain size purity, and appropriate moisture levels.
            </div>
            <div class="col-md-4">
                <i class="bi bi-check-circle-fill text-success me-1"></i> <strong>3. Share Delivery OTP:</strong> Share your confidential 4-digit Delivery OTP only after complete inspection.
            </div>
        </div>
    </div>

    <!-- 1. Confidential 4-Digit Delivery OTP Card (Protected by Security Gate) -->
    @if (Model.PaymentMethod != "Cash on Delivery" && !Model.Status.Contains("Delivered") && Model.Status != "Declined" && Model.Status != "Cancelled")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1 rounded-pill small">
                            <i class="bi bi-shield-lock-fill me-1"></i>CONFIDENTIAL DELIVERY PASS
                        </span>
                        <span class="text-white-50 small">Unlocked via Security Verification</span>
                    </div>
                    <h4 class="fw-bold text-white mb-1">Your 4-Digit Delivery Verification OTP</h4>
                    <p class="text-white-50 small mb-0">
                        Give this 4-digit code to the farmer/delivery person <strong>ONLY after inspecting the quality</strong> of your harvest upon pickup.
                    </p>
                </div>

                <div class="col-md-5 text-md-end">
                    <div class="d-inline-flex align-items-center gap-3 bg-white bg-opacity-10 p-2.5 px-4 rounded-4 border border-white border-opacity-20 shadow">
                        <span class="fs-2 fw-extrabold text-warning letter-spacing-3 font-monospace" id="confidentialOtp">
                            @(string.IsNullOrEmpty(Model.DeliveryOtp) ? "7492" : Model.DeliveryOtp)
                        </span>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-bold" onclick="navigator.clipboard.writeText('@Model.DeliveryOtp'); this.innerHTML='<i class=\'bi bi-check2\'></i> Copied!';">
                            <i class="bi bi-clipboard me-1"></i> Copy OTP
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        
        <!-- Left Column: Ordered Produce & Farm Farmer Info -->
        <div class="col-lg-7">
            
            <!-- Produce Items Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-basket-fill text-success"></i> Purchased Farm Produce
                </h5>

                @foreach (var item in Model.OrderItems)
                {
                    var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-3">
                        @if (!string.IsNullOrEmpty(itemImg))
                        {
                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 75px; height: 75px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-white rounded-3 d-flex align-items-center justify-content-center border" style="width: 75px; height: 75px;">
                                <i class="bi bi-tree text-success fs-2"></i>
                            </div>
                        }

                        <div class="flex-grow-1">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold small mb-1">
                                @(item.Product?.Category?.Name ?? "Farm Produce")
                            </span>
                            <h5 class="fw-bold text-dark mb-1">@(item.Product?.Name ?? "Farm Produce")</h5>
                            <span class="text-muted small">Unit Rate: ₹@item.UnitPrice.ToString("N2")</span>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-white text-dark border px-2.5 py-1 mb-1 d-inline-block fw-bold">
                                @item.Quantity unit(s)
                            </span>
                            <div class="fw-extrabold text-success fs-5">
                                ₹@((item.UnitPrice * item.Quantity).ToString("N2"))
                            </div>
                        </div>
                    </div>
                }

                <!-- Fulfillment / Pickup Location Card -->
                <div class="p-3 bg-light rounded-3 border">
                    <strong class="text-dark small d-block mb-1">
                        <i class="bi bi-geo-alt-fill text-success me-1"></i> Delivery &amp; Pickup Location
                    </strong>
                    <span class="text-muted small">
                        @(string.IsNullOrEmpty(Model.ShippingAddress) ? "Gujarat Direct Farm Pickup Location" : Model.ShippingAddress)
                    </span>
                </div>
            </div>

            <!-- Farmer / Producer Direct Contact Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-person-badge-fill text-success"></i> Farmer &amp; Producer Contact
                </h5>

                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 bg-light rounded-3 border gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                            @(!string.IsNullOrEmpty(farmerName) ? farmerName.Substring(0, 1).ToUpper() : "F")
                        </div>
                        <div>
                            <strong class="text-dark d-block fs-6">@farmerName</strong>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
                                <i class="bi bi-patch-check-fill me-1"></i>Verified Gujarat Farmer
                            </span>
                            <span class="text-muted small d-block mt-0.5"><i class="bi bi-telephone text-success me-1"></i>@farmerPhone</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="tel:@farmerPhone" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-telephone-fill me-1"></i> Call Farmer
                        </a>
                        <a href="https://wa.me/@(farmerPhone.Replace("+","").Replace(" ",""))?text=Hello%20@farmerName,%20regarding%20my%20AgriAI%20Order%20#@Model.Id:D5..." target="_blank" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #25D366; border-color: #25D366;">
                            <i class="bi bi-whatsapp me-1"></i> WhatsApp
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Itemized Invoice & Order Timeline -->
        <div class="col-lg-5">
            
            <!-- Itemized Price Breakdown Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3">Itemized Invoice Breakdown</h5>

                <div class="d-flex justify-content-between text-muted mb-2 small">
                    <span>Base Produce Cost (@itemQty units)</span>
                    <strong class="text-dark">₹@baseAmount.ToString("N2")</strong>
                </div>

                <div class="d-flex justify-content-between text-muted mb-2 small">
                    <span>Transport / Logistics (@Model.TransportType)</span>
                    <strong class="text-dark">₹@Model.LogisticsFee.ToString("N2")</strong>
                </div>

                <div class="d-flex justify-content-between text-muted mb-3 small">
                    <span>Platform Safety Fee (2%)</span>
                    <strong class="text-dark">₹@Model.PlatformFee.ToString("N2")</strong>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-6 fw-bold text-dark">Total Amount Paid</span>
                    <span class="fs-4 fw-extrabold text-success">₹@Model.TotalAmount.ToString("N2")</span>
                </div>

                <div class="p-2.5 bg-light rounded-3 border small text-muted">
                    <div class="d-flex justify-content-between">
                        <span>Payment Method:</span>
                        <strong class="text-success">@(Model.PaymentMethod ?? "Online (Escrow Protected)")</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span>Order Date &amp; Time:</span>
                        <strong class="text-dark">@dateFormatted</strong>
                    </div>
                </div>
            </div>

            <!-- Order Fulfillment Progress Timeline -->
            <div class="bg-white rounded-4 p-4 border shadow-sm">
                <h5 class="fw-bold text-dark mb-3">Fulfillment Progress</h5>

                <div class="position-relative ps-4 border-start border-2 border-success ms-2 my-2">
                    <div class="mb-3 position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 bg-success rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">Order Placed &amp; Escrow Secured</strong>
                        <span class="text-muted small">@dateFormatted</span>
                    </div>

                    <div class="mb-3 position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 @(Model.Status != "Pending" ? "bg-success" : "bg-warning") rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">Harvest Packed &amp; Ready for Pickup</strong>
                        <span class="text-muted small">@(Model.Status != "Pending" ? "Ready at Gujarat Farm" : "Farmer preparing produce")</span>
                    </div>

                    <div class="position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 @(Model.Status.Contains("Delivered") ? "bg-success" : "bg-secondary") rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">OTP Verified &amp; Completed</strong>
                        <span class="text-muted small">@(Model.Status.Contains("Delivered") ? "Completed 🟢" : "Pending Handover Verification")</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Customer Cancel Order Confirmation Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white p-3.5 px-4">
                <h5 class="modal-title fw-bold" id="cancelOrderModalLabel">
                    <i class="bi bi-x-circle me-1"></i> Cancel Order &amp; Request Refund
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Customer" asp-action="CancelOrder" method="post">
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="modal-body p-4">
                    <div class="alert alert-warning p-2.5 rounded-3 mb-3 small">
                        <i class="bi bi-shield-check me-1"></i> <strong>100% Instant Refund:</strong> Your entire payment of ₹@Model.TotalAmount.ToString("N2") will be returned to your original payment method.
                    </div>

                    <label class="form-label small fw-bold text-dark mb-1">Reason for Cancellation (Optional):</label>
                    <textarea name="reason" class="form-control rounded-3 mb-2 shadow-none small" rows="3" placeholder="e.g. Ordered incorrect quantity / changed delivery plans..."></textarea>
                    <small class="text-muted d-block">Are you sure you want to cancel this order?</small>
                </div>
                <div class="modal-footer bg-light p-3 px-4 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Keep Order</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Yes, Cancel &amp; Refund</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCancelModal() {
            const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
            modal.show();
        }

        // Live Countdown Timer on Customer Order Details
        let customerRemSeconds = parseInt(document.getElementById('customerCountdownTimer')?.getAttribute('data-remaining') || '0', 10);

        function updateCustomerCountdown() {
            const timerEl = document.getElementById('customerCountdownTimer');
            if (!timerEl) return;

            if (customerRemSeconds <= 0) {
                timerEl.textContent = "00h 00m 00s (Locking...)";
                setTimeout(() => { location.reload(); }, 2000);
                return;
            }

            const hours = Math.floor(customerRemSeconds / 3600);
            const minutes = Math.floor((customerRemSeconds % 3600) / 60);
            const seconds = customerRemSeconds % 60;
            timerEl.textContent = `${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;
            customerRemSeconds--;
        }

        if (customerRemSeconds > 0) {
            setInterval(updateCustomerCountdown, 1000);
        }

        function printOrderInvoice(orderNo, orderDate, buyerName, produceName, qty, unitPrice, baseAmt, logisticsFee, platformFee, grandTotal, paymentMode, transportType, deliveryLocation) {
            const printWindow = window.open('', '_blank', 'width=850,height=900');
            const formattedTotal = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(grandTotal);
            const formattedBase = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(baseAmt);
            const formattedLogistics = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(logisticsFee);
            const formattedFee = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(platformFee);
            const formattedUnit = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(unitPrice);

            const invoiceHtml = `
            <!DOCTYPE html>
            <html>
            <head>
                <meta charset="utf-8">
                <title>Tax Invoice - ${orderNo} - AgriAI Platform</title>
                <style>
                    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 25px; color: #1e293b; line-height: 1.4; }
                    .invoice-card { max-width: 780px; margin: auto; border: 1px solid #cbd5e1; border-radius: 12px; padding: 30px; background: #fff; }
                    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #006653; padding-bottom: 15px; margin-bottom: 20px; }
                    .logo-title { color: #006653; font-size: 24px; font-weight: 800; margin: 0; }
                    .logo-sub { color: #64748b; font-size: 12px; margin: 2px 0 0 0; }
                    .badge-inv { background: #f0fdf4; color: #15803d; border: 1px solid #86efac; padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; }
                    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
                    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px; }
                    .info-box h4 { margin: 0 0 6px 0; font-size: 13px; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px; }
                    .info-box p { margin: 3px 0; font-size: 12.5px; color: #475569; }
                    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                    th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-size: 12.5px; color: #334155; border-bottom: 2px solid #cbd5e1; }
                    td { padding: 12px; font-size: 13px; border-bottom: 1px solid #e2e8f0; }
                    .totals-table { width: 320px; margin-left: auto; margin-bottom: 20px; }
                    .totals-table td { padding: 5px 8px; border: none; font-size: 12.5px; }
                    .grand-row { border-top: 2px solid #006653 !important; font-size: 16px !important; font-weight: 800; color: #006653; padding-top: 8px !important; }
                    .footer { border-top: 1px solid #e2e8f0; padding-top: 15px; display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: #64748b; }
                    .stamp { border: 2px dashed #86efac; background: #f0fdf4; padding: 6px 12px; border-radius: 6px; color: #15803d; font-weight: bold; font-size: 12px; }
                    @@media print {
                        body { padding: 0; }
                        .invoice-card { border: none; padding: 10px; }
                    }
                </style>
            </head>
            <body>
                <div class="invoice-card">
                    <div class="header">
                        <div>
                            <h1 class="logo-title">🌾 AgriAI Produce Invoice</h1>
                            <p class="logo-sub">Direct Farm-to-Consumer Agricultural Platform &bull; Gujarat, India</p>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge-inv">OFFICIAL TAX RECEIPT</span>
                            <p style="margin: 5px 0 0 0; font-size: 12px; color: #64748b;"><strong>Invoice No:</strong> ${orderNo}</p>
                            <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;"><strong>Date & Time:</strong> ${orderDate}</p>
                        </div>
                    </div>

                    <div class="info-grid">
                        <div class="info-box">
                            <h4>Billed To (Customer)</h4>
                            <p><strong>Name:</strong> ${buyerName}</p>
                            <p><strong>Account Type:</strong> Verified Buyer</p>
                            <p><strong>Delivery / Destination:</strong> ${deliveryLocation}</p>
                        </div>
                        <div class="info-box">
                            <h4>Logistics & Payment Details</h4>
                            <p><strong>Payment Mode:</strong> ${paymentMode}</p>
                            <p><strong>Logistics Type:</strong> ${transportType}</p>
                            <p><strong>Fulfillment:</strong> Direct Farm Harvest Pickup</p>
                        </div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Farm Harvest / Produce Name</th>
                                <th>Quantity</th>
                                <th>Unit Rate</th>
                                <th style="text-align: right;">Total (INR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td><strong>${produceName}</strong><br><small style="color: #64748b;">100% Direct Certified Farm Produce</small></td>
                                <td>${qty} unit(s)</td>
                                <td>${formattedUnit}</td>
                                <td style="text-align: right; font-weight: bold;">${formattedBase}</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="totals-table">
                        <tr>
                            <td class="text-muted">Produce Subtotal:</td>
                            <td style="text-align: right; font-weight: 600;">${formattedBase}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Transport / Logistics:</td>
                            <td style="text-align: right; font-weight: 600;">${formattedLogistics}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Platform Guarantee Fee (2%):</td>
                            <td style="text-align: right; font-weight: 600;">${formattedFee}</td>
                        </tr>
                        <tr class="grand-row">
                            <td>Total Amount Paid:</td>
                            <td style="text-align: right;">${formattedTotal}</td>
                        </tr>
                    </table>

                    <div class="footer">
                        <div>
                            <p style="margin: 0;"><strong>Thank you for empowering Gujarat Farmers! 🚜</strong></p>
                            <p style="margin: 3px 0 0 0;">This is a computer-generated tax receipt backed by AgriAI Escrow Protection.</p>
                        </div>
                        <div class="stamp">
                            ✓ VERIFIED PAID
                        </div>
                    </div>
                </div>

                <script>
                    window.onload = function() {
                        setTimeout(function() {
                            window.print();
                        }, 400);
                    };
                <\/script>
            </body>
            </html>
            `;

            printWindow.document.open();
            printWindow.document.write(invoiceHtml);
            printWindow.document.close();
        }
    </script>
}
