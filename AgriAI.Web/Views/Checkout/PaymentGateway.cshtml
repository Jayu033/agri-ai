@{
    ViewData["Title"] = "Secure Payment";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="glass-panel p-5">
            <h3 class="mb-4">Complete Your Payment</h3>
            <p class="text-muted mb-4">You are securely redirecting to Razorpay gateway.</p>
            
            <form action="/Checkout/PaymentSuccess" method="POST">
                <!-- Using dummy button to simulate success since no real Razorpay key is present -->
                <script
                    src="https://checkout.razorpay.com/v1/checkout.js"
                    data-key="@ViewBag.Key"
                    data-amount="@ViewBag.Amount" 
                    data-currency="INR"
                    data-order_id="@ViewBag.RazorpayOrderId"
                    data-buttontext="Pay with Razorpay"
                    data-name="AgriAI Platform"
                    data-description="Purchase from Farmer"
                    data-image="https://via.placeholder.com/150"
                    data-prefill.name="Customer"
                    data-prefill.email="customer@example.com"
                    data-theme.color="#2e7d32">
                </script>
                <input type="hidden" custom="Hidden Element" name="hidden">
            </form>
            
            <div class="mt-4">
                <form action="/Checkout/PaymentSuccess" method="POST">
                    <input type="hidden" name="razorpay_payment_id" value="mock_pay_id_123" />
                    <button type="submit" class="btn btn-outline-success mt-3 w-100">Simulate Success (Bypass Razorpay)</button>
                </form>
            </div>
        </div>
    </div>
</div>
