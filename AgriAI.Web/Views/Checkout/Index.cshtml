@{
    ViewData["Title"] = "Direct Farm Checkout";
    var product = ViewBag.Product as AgriAI.Domain.Entities.Product;
    int quantity = ViewBag.Quantity != null ? (int)ViewBag.Quantity : 1;
    decimal baseTotal = ViewBag.BaseTotal != null ? (decimal)ViewBag.BaseTotal : (product != null ? (product.Price * quantity) : 0m);
    decimal platformFee = ViewBag.PlatformFee != null ? (decimal)ViewBag.PlatformFee : Math.Round(baseTotal * 0.02m, 2);
    var imgUrl = product?.Images?.FirstOrDefault()?.ImageUrl;
}

<div class="container py-4 my-2" style="max-width: 960px;">
    
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-success text-decoration-none">Shop Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Direct Farm Checkout</li>
                </ol>
            </nav>
            <h2 class="fw-extrabold text-dark mb-0">Direct Farm Checkout 🛒</h2>
        </div>
        <div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success rounded-pill px-3 py-1.5 fw-bold small">
                <i class="bi bi-arrow-left me-1"></i> Back to Shop
            </a>
        </div>
    </div>

    @if (product != null)
    {
        <form asp-action="ProcessPayment" method="post" id="checkoutForm">
            <input type="hidden" name="productId" value="@product.Id" />
            <input type="hidden" name="quantity" value="@quantity" />

            <div class="row g-4">
                <!-- Left Column: Produce Summary & Payment Options -->
                <div class="col-lg-7">
                    
                    <!-- 1. Order Summary Card -->
                    <div class="bg-white shadow-sm rounded-4 p-4 border mb-4">
                        <h5 class="mb-3 text-dark fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-receipt-cutoff text-success"></i> Produce Details
                        </h5>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-2">
                            @if (!string.IsNullOrEmpty(imgUrl))
                            {
                                <img src="@imgUrl" class="rounded-3 shadow-sm" alt="@product.Name" style="width: 70px; height: 70px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-white rounded-3 d-flex align-items-center justify-content-center border" style="width: 70px; height: 70px;">
                                    <i class="bi bi-tree text-success fs-2"></i>
                                </div>
                            }
                            <div class="flex-grow-1">
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold small mb-1">
                                    @(product.Category?.Name ?? "Farm Crop")
                                </span>
                                <h6 class="mb-0 fw-bold text-dark fs-6">@product.Name</h6>
                                <small class="text-muted">Rate: ₹@product.Price.ToString("N2") / unit</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-white text-dark border px-2.5 py-1 mb-1 d-inline-block fw-bold">
                                    Qty: @quantity unit(s)
                                </span>
                                <div class="fw-extrabold text-success fs-5">₹@baseTotal.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Logistics & Delivery Option (Blueprint Architecture) -->
                    <div class="bg-white shadow-sm rounded-4 p-4 border mb-4">
                        <h5 class="mb-3 text-dark fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-truck text-success"></i> Choose Delivery / Logistics Mode
                        </h5>

                        <div class="form-check p-3 rounded-3 border mb-2 cursor-pointer bg-light">
                            <input class="form-check-input ms-0 me-2" type="radio" name="transportType" id="transPickup" value="Direct Farm Pickup" checked onchange="updateBillTotal()">
                            <label class="form-check-label fw-bold text-dark d-flex justify-content-between align-items-center w-100" for="transPickup">
                                <span><i class="bi bi-geo-alt-fill text-success me-1"></i> 1. Direct Farm Pickup (Self Pickup)</span>
                                <span class="badge bg-success text-white">FREE ₹0</span>
                            </label>
                            <small class="text-muted d-block ps-4 mt-1">Pick up harvest directly from the verified farmer's field or godown.</small>
                        </div>

                        <div class="form-check p-3 rounded-3 border cursor-pointer bg-light">
                            <input class="form-check-input ms-0 me-2" type="radio" name="transportType" id="transCargo" value="GSRTC / Private Cargo (To-Pay)" onchange="updateBillTotal()">
                            <label class="form-check-label fw-bold text-dark d-flex justify-content-between align-items-center w-100" for="transCargo">
                                <span><i class="bi bi-bus-front-fill text-primary me-1"></i> 2. GSRTC / Private Cargo (Parcel Delivery)</span>
                                <span class="badge bg-primary text-white">"To-Pay" Model</span>
                            </label>
                            <small class="text-muted d-block ps-4 mt-1">Farmer books produce via GSRTC ST Bus parcel or private cargo (Patel, Shrinath, Eagle) and uploads Bilty receipt. Pay nominal parcel freight directly at counter upon pickup.</small>
                        </div>

                        <div class="mt-3">
                            <label class="form-label small fw-bold text-muted">Destination City / Delivery Address (Where to receive parcel)</label>
                            <input type="text" name="deliveryAddress" class="form-control bg-white shadow-none" placeholder="e.g. ST Bus Station Parcel Office, Rajkot / Surat / Ahmedabad" />
                        </div>
                    </div>

                    <!-- 3. Payment Method Selection -->
                    <div class="bg-white shadow-sm rounded-4 p-4 border">
                        <h5 class="mb-3 text-dark fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success"></i> Choose Payment Method
                        </h5>

                        <div class="form-check p-3 rounded-3 border mb-2 cursor-pointer bg-success bg-opacity-10 border-success">
                            <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod" id="payOnline" value="Online" checked>
                            <label class="form-check-label fw-bold text-dark d-flex justify-content-between align-items-center w-100" for="payOnline">
                                <span><i class="bi bi-shield-lock-fill text-success me-1"></i> Online UPI / Escrow Safe Payment</span>
                                <span class="badge bg-success text-white">Recommended</span>
                            </label>
                            <small class="text-muted d-block ps-4 mt-1">Payment is held securely in AgriAI Escrow. Funds are released to farmer only after you give your 4-digit Delivery OTP.</small>
                        </div>

                        <div class="form-check p-3 rounded-3 border cursor-pointer bg-light">
                            <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod" id="payCOD" value="COD">
                            <label class="form-check-label fw-bold text-dark d-flex justify-content-between align-items-center w-100" for="payCOD">
                                <span><i class="bi bi-cash-stack text-warning me-1"></i> Cash on Delivery / Pay on Pickup</span>
                                <span class="badge bg-secondary text-white">COD</span>
                            </label>
                            <small class="text-muted d-block ps-4 mt-1">Pay 100% cash directly to the farmer after inspecting crop quality.</small>
                        </div>
                    </div>

                </div>

                <!-- Right Column: Final Bill Breakdown & Place Order -->
                <div class="col-lg-5">
                    <div class="bg-white shadow-sm rounded-4 p-4 border sticky-top" style="top: 20px;">
                        <h5 class="fw-bold text-dark mb-3">Price Breakdown</h5>

                        <div class="d-flex justify-content-between text-muted mb-2 small">
                            <span>Base Produce Price (@quantity units)</span>
                            <span class="fw-bold text-dark">₹@baseTotal.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between text-muted mb-2 small">
                            <span>Transport / Logistics</span>
                            <span class="fw-bold text-dark" id="billTransport">₹0.00</span>
                        </div>

                        <div class="d-flex justify-content-between text-muted mb-3 small">
                            <span>
                                Platform Safety Fee (2%)
                                <i class="bi bi-info-circle text-muted" title="Covers Escrow guarantee, buyer protection, and 24/7 resolution."></i>
                            </span>
                            <span class="fw-bold text-dark">₹@platformFee.ToString("N2")</span>
                        </div>

                        <hr class="my-3">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-6 fw-bold text-dark">Total Amount Payable</span>
                            <span class="fs-4 fw-extrabold text-success" id="billGrandTotal">
                                ₹@((baseTotal + platformFee).ToString("N2"))
                            </span>
                        </div>

                        <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 rounded-3 mb-4 p-2.5 small">
                            <i class="bi bi-shield-fill-check text-success me-1"></i>
                            <strong>100% Money-Back Guarantee:</strong> 4-digit Delivery OTP protects your payment until you verify the harvest.
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold rounded-pill shadow-sm" style="background-color: #006653; border-color: #006653;">
                                <i class="bi bi-check-circle-fill me-2"></i> Confirm &amp; Place Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-warning rounded-4 p-5 text-center my-4">
            <i class="bi bi-cart-x display-4 text-warning mb-3 d-block"></i>
            <h5 class="fw-bold text-dark mb-2">No items selected for checkout</h5>
            <p class="text-muted small mb-4">Please explore available farm crops from Gujarat farmers and select your required quantity.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 fw-bold">
                <i class="bi bi-shop me-1"></i> Browse Farm Produce
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        const baseTotal = @baseTotal;
        const platformFee = @platformFee;

        function updateBillTotal() {
            const isCargo = document.getElementById("transCargo")?.checked;
            const billTrans = document.getElementById("billTransport");
            if (billTrans) {
                billTrans.textContent = isCargo ? "To-Pay (At Counter)" : "₹0.00 (Free)";
            }
            const grandTotal = baseTotal + platformFee;
            const grandEl = document.getElementById("billGrandTotal");
            if (grandEl) {
                grandEl.textContent = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(grandTotal);
            }
        }
    </script>
}
