@model AgriAI.Domain.Entities.Category

@{
    ViewData["Title"] = "Add New Category - Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<div class="container-fluid py-4 px-lg-4 px-md-3" style="max-width: 900px; min-height: calc(100vh - 180px);">
    
    <!-- Top Header Navigation Card -->
    <div class="admin-header-card d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 shadow-sm">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold small">
                    <i class="bi bi-plus-circle-fill me-1"></i> New Classification
                </span>
            </div>
            <h2 class="fw-extrabold text-dark mb-1 fs-3">
                🌱 Add New Crop Category
            </h2>
            <p class="text-muted small mb-0">Create a new produce taxonomy for Gujarat farmers to list crops under.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn-back-custom shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Categories</span>
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="user-info-card shadow-sm p-4 p-md-5">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold text-dark mb-1">Category Name <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag-fill text-success"></i></span>
                    <input asp-for="Name" class="form-control ps-2 rounded-end-3 py-2.5" placeholder="e.g. Organic Pulses &amp; Lentils" required />
                </div>
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                <small class="text-muted" style="font-size: 0.75rem;">This name will appear in marketplace filter pills and farmer harvest upload dropdowns.</small>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold text-dark mb-1">Description</label>
                <textarea asp-for="Description" class="form-control rounded-3 p-3" rows="4" placeholder="Describe the type of agricultural crops or commodities included in this category..."></textarea>
                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-end gap-2.5 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-bold">Cancel</a>
                <button type="submit" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%); border: none;">
                    <i class="bi bi-check-circle-fill me-1.5"></i> Save &amp; Publish Category
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
