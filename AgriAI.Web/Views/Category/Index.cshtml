@model IEnumerable<AgriAI.Domain.Entities.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Product Categories</h2>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle me-1"></i> Add New Category
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-panel" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Created At</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No categories found. Click 'Add New Category' to create one.</td>
                    </tr>
                }
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td class="text-center">
                            <a href="#" class="btn btn-sm btn-outline-info rounded-circle me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a href="#" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
