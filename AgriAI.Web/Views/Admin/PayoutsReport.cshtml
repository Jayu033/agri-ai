@model IEnumerable<AgriAI.Web.ViewModels.UserManagementViewModel>

@{
    ViewData["Title"] = "Farmer Banking & Payouts Audit Report - Official Statement";
    int totalFarmers = Model.Count(u => u.Role == "Farmer");
    int kycVerified = Model.Count(u => u.Role == "Farmer" && u.IsApprovedByAdmin);
    int pendingKyc = Model.Count(u => u.Role == "Farmer" && !u.IsApprovedByAdmin);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <style>
        @@media print {
            .no-print, header, footer, .floating-chatbot, #openChatBtn, #agriAiChatbot {
                display: none !important;
            }
            body {
                background: #ffffff !important;
                color: #000000 !important;
                font-size: 11pt !important;
            }
            .statement-container {
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .statement-card {
                border: 1px solid #ddd !important;
                box-shadow: none !important;
            }
        }
    </style>
}

<div class="container-fluid py-4 px-lg-4 px-md-3 statement-container" style="max-width: 1440px;">
    
    <!-- Top Action Bar (No Print) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 no-print">
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Admin" asp-action="Dashboard" asp-route-tab="reports" class="btn-back-custom shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Reports Dashboard</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="ExportPayoutsCsv" class="btn btn-outline-primary bg-white rounded-pill px-3.5 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" style="font-size: 0.86rem;">
                <i class="bi bi-file-earmark-excel-fill text-primary"></i> Download Excel / CSV
            </a>
            <button type="button" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" onclick="window.print()" style="font-size: 0.86rem;">
                <i class="bi bi-printer-fill"></i> Print / Save as PDF
            </button>
        </div>
    </div>

    <!-- Statement Document Paper -->
    <div class="bg-white rounded-4 border shadow-sm p-4 p-md-5 statement-card">
        
        <!-- Header Banner -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-4 mb-4 border-bottom gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold small">
                        🏦 Farmer Banking &amp; Payouts Ledger
                    </span>
                    <span class="text-muted small">&bull; Disbursal Compliance</span>
                </div>
                <h2 class="fw-extrabold text-dark mb-1 fs-3">
                    🌾 Farmer Banking &amp; Escrow Payout Audit
                </h2>
                <p class="text-muted small mb-0">Master register of verified Gujarat farmers, bank accounts, IFSC credentials, and NEFT/RTGS disbursals.</p>
            </div>
            <div class="text-md-end text-muted small">
                <div>Statement Date: <strong class="text-dark">@DateTime.UtcNow.ToString("dd MMMM yyyy")</strong></div>
                <div>Generated By: <strong class="text-dark">Super Administrator</strong></div>
                <div>Registered Farmers: <strong class="text-dark">@totalFarmers Producers</strong></div>
            </div>
        </div>

        <!-- 3 Summary Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 border">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem;">Total Farmers Registered</small>
                    <h4 class="fw-extrabold text-dark mb-0 fs-5">@totalFarmers Farmers</h4>
                    <small class="text-muted" style="font-size: 0.70rem;">Active on Gujarat marketplace</small>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 border">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem;">KYC Verified Producers</small>
                    <h4 class="fw-extrabold text-success mb-0 fs-5">@kycVerified Approved</h4>
                    <small class="text-muted" style="font-size: 0.70rem;">Bank &amp; 7/12 document verified</small>
                </div>
            </div>

            <div class="col-md-4 col-sm-12">
                <div class="p-3 bg-light rounded-4 border">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem;">Pending KYC Review</small>
                    <h4 class="fw-extrabold text-warning mb-0 fs-5 text-dark">@pendingKyc Under Review</h4>
                    <small class="text-muted" style="font-size: 0.70rem;">Awaiting administrator sign-off</small>
                </div>
            </div>
        </div>

        <!-- Farmers Banking Table -->
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="table-light text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-3">Farmer Name &amp; Role</th>
                        <th>Contact / Email</th>
                        <th>KYC Status</th>
                        <th>Bank Name</th>
                        <th>Account Number</th>
                        <th>IFSC Code</th>
                        <th>UPI Handle</th>
                        <th class="text-end pe-3">Account Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <strong class="text-dark d-block">@user.FullName</strong>
                                <small class="text-muted font-monospace" style="font-size: 0.70rem;">ID: #@user.Id.Substring(0, Math.Min(8, user.Id.Length))</small>
                            </td>
                            <td>
                                <div class="text-dark">@user.Email</div>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(user.City) ? "Gujarat, India" : user.City)</small>
                            </td>
                            <td>
                                @if (user.Role == "Farmer")
                                {
                                    if (user.IsApprovedByAdmin)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold">
                                            <i class="bi bi-patch-check-fill me-1"></i> KYC Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1 fw-bold text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1">
                                        @user.Role
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(user.BankName) ? "Not Provided" : user.BankName)</span>
                            </td>
                            <td>
                                <span class="font-monospace text-dark fw-bold">@(string.IsNullOrEmpty(user.BankAccountNumber) ? "N/A" : user.BankAccountNumber)</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@(string.IsNullOrEmpty(user.BankIfscCode) ? "N/A" : user.BankIfscCode)</span>
                            </td>
                            <td>
                                <span class="small text-muted font-monospace">@(string.IsNullOrEmpty(user.UpiId) ? "N/A" : user.UpiId)</span>
                            </td>
                            <td class="text-end pe-3">
                                @if (user.IsBlocked)
                                {
                                    <span class="badge bg-danger rounded-pill px-2.5 py-1">Blocked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold">
                                        Active
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer Seal -->
        <div class="mt-4 pt-3 border-top text-center text-muted small">
            <span>Official banking register verified by AgriAI Governance &amp; Escrow Infrastructure.</span>
        </div>

    </div>

</div>
