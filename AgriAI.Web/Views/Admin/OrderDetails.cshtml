@model AgriAI.Domain.Entities.Order
@using AgriAI.Infrastructure.Identity

@{
    string from = (Context.Request.Query["from"].ToString() ?? "").ToLower();
    string returnUrl = Context.Request.Query["returnUrl"].ToString();

    bool isEscrowAudit = from == "escrow" || from == "bilty";
    ViewData["Title"] = isEscrowAudit ? $"Order #{Model.Id:D5} - Financial Escrow & Bilty Audit" : $"Order #{Model.Id:D5} - Details & Moderation";
    
    var farmerUser = ViewBag.FarmerUser as ApplicationUser;
    var customerUser = ViewBag.CustomerUser as ApplicationUser;

    var farmerName = farmerUser != null 
        ? (!string.IsNullOrEmpty(farmerUser.FirstName) || !string.IsNullOrEmpty(farmerUser.LastName) 
            ? $"{farmerUser.FirstName} {farmerUser.LastName}".Trim() 
            : farmerUser.UserName) 
        : "Verified Gujarat Producer";
    var farmerEmail = farmerUser?.Email ?? "farmer@agriai.com";
    var farmerPhone = !string.IsNullOrEmpty(farmerUser?.PhoneNumber) ? farmerUser.PhoneNumber : "+91 97245 60047";
    var farmerLocation = !string.IsNullOrEmpty(farmerUser?.City) ? $"{farmerUser.City}, {farmerUser.State ?? "Gujarat"}" : "Gujarat Agricultural Farm Location";
    var farmerBank = !string.IsNullOrEmpty(farmerUser?.BankName) ? $"{farmerUser.BankName} (A/C: {farmerUser.BankAccountNumber})" : "Primary Bank Account";
    var farmerIfsc = !string.IsNullOrEmpty(farmerUser?.BankIfscCode) ? farmerUser.BankIfscCode : "BARB0RAJKOT";

    var customerName = customerUser != null 
        ? (!string.IsNullOrEmpty(customerUser.FirstName) || !string.IsNullOrEmpty(customerUser.LastName) 
            ? $"{customerUser.FirstName} {customerUser.LastName}".Trim() 
            : customerUser.UserName) 
        : (!string.IsNullOrEmpty(Model.CustomerId) ? Model.CustomerId : "Verified Buyer");
    var customerEmail = customerUser?.Email ?? (!string.IsNullOrEmpty(Model.CustomerId) && Model.CustomerId.Contains("@") ? Model.CustomerId : "buyer@agriai.com");
    var customerPhone = !string.IsNullOrEmpty(customerUser?.PhoneNumber) ? customerUser.PhoneNumber : "+91 98790 12345";
    var deliveryAddress = !string.IsNullOrEmpty(Model.ShippingAddress) ? Model.ShippingAddress : (customerUser?.Address ?? "Gujarat Delivery Location");

    var baseAmount = Model.TotalAmount - Model.LogisticsFee - Model.PlatformFee;
    var dateFormatted = Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
    
    // Order Lifecycle Steps Calculation
    bool isCancelled = Model.Status == "Cancelled" || Model.Status == "Declined";
    bool step2_Accepted = Model.Status != "Requested" && !isCancelled;
    bool step3_Dispatched = (Model.Status == "In Transit" || Model.Status.Contains("Delivered") || Model.Status.Contains("Settled") || !string.IsNullOrEmpty(Model.BiltyImageUrl)) && !isCancelled;
    bool step4_OtpVerified = (Model.Status.Contains("Delivered") || Model.Status.Contains("Settled") || Model.Status == "Ready for Pickup") && !isCancelled;
    bool step5_Settled = (Model.Status.Contains("Delivered") || Model.Status.Contains("Settled") || Model.AdminApprovedPayout) && !isCancelled;

    // Dynamic Contextual Back Navigation
    string backUrl = "/Admin/Dashboard?tab=orders";
    string backLabel = "Back to Orders";

    if (!string.IsNullOrEmpty(returnUrl))
    {
        backUrl = returnUrl;
        backLabel = "Back";
    }
    else if (isEscrowAudit)
    {
        backUrl = "/Admin/Dashboard?tab=escrow";
        backLabel = "Back to Escrow & Payouts";
    }
    else if (from == "users")
    {
        backUrl = "/Admin/Dashboard?tab=users";
        backLabel = "Back to Farmer & Users";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <style>
        .order-step-track {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            margin: 24px 0 10px;
        }
        .order-step-track::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 30px;
            right: 30px;
            height: 4px;
            background: #e2e8f0;
            z-index: 1;
        }
        .order-step-item {
            position: relative;
            z-index: 2;
            text-align: center;
            flex: 1;
        }
        .order-step-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #ffffff;
            border: 3px solid #cbd5e1;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            transition: all 0.3s ease;
        }
        .order-step-item.completed .order-step-circle {
            background: #15803d;
            border-color: #15803d;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.3);
        }
        .order-step-item.active .order-step-circle {
            background: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.2);
            animation: pulseBlue 2s infinite;
        }
        .order-step-item.cancelled .order-step-circle {
            background: #dc2626;
            border-color: #dc2626;
            color: #ffffff;
        }
        .order-step-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #475569;
            display: block;
        }
        .order-step-item.completed .order-step-label {
            color: #15803d;
        }
        .order-step-item.active .order-step-label {
            color: #2563eb;
        }
        @@keyframes pulseBlue {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }
        .order-profile-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            padding: 22px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            height: 100%;
        }
    </style>
}

<div class="container-fluid py-4 px-lg-4 px-md-3" style="max-width: 1380px; min-height: calc(100vh - 180px);">
    
    <!-- Top Header Navigation Banner Card -->
    <div class="admin-header-card d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 shadow-sm">
        <div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <h2 class="fw-extrabold text-dark mb-0 fs-3">
                    @if (isEscrowAudit)
                    {
                        <span><i class="bi bi-shield-check text-success me-1.5"></i>Escrow &amp; Bilty Audit #@Model.Id.ToString("D5")</span>
                    }
                    else
                    {
                        <span>Order #@Model.Id.ToString("D5")</span>
                    }
                </h2>
                
                @if (isCancelled)
                {
                    <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold fs-6">
                        <i class="bi bi-x-circle-fill me-1"></i>@Model.Status
                    </span>
                }
                else if (step5_Settled)
                {
                    <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold fs-6" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%) !important;">
                        <i class="bi bi-patch-check-fill me-1"></i>Delivered &amp; Settled 🟢
                    </span>
                }
                else if (Model.Status == "In Transit")
                {
                    <span class="badge bg-primary rounded-pill px-3 py-1.5 fw-bold fs-6">
                        <i class="bi bi-truck me-1"></i>In Transit (Held in Escrow)
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-bold fs-6">
                        <i class="bi bi-hourglass-split me-1"></i>@Model.Status
                    </span>
                }

                <span class="text-muted small fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@dateFormatted
                </span>
            </div>
            @if (isEscrowAudit)
            {
                <p class="text-muted small mb-0 mt-1">Audit transport bilty proof, inspect farmer banking destination, and authorize escrow payout release.</p>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@backUrl" class="btn-back-custom shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>@backLabel</span>
            </a>
            <button type="button" class="btn btn-outline-dark rounded-pill px-3.5 py-2 fw-bold small shadow-sm" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> Print Audit
            </button>
        </div>
    </div>

    <!-- Specialized Top Escrow Moderation Box (When in Audit mode) -->
    @if (isEscrowAudit)
    {
        <div class="p-4 rounded-4 border @(step5_Settled ? "border-success bg-white" : "border-primary") shadow-sm mb-4" style="@(step5_Settled ? "" : "background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);")">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle @(step5_Settled ? "bg-success" : "bg-primary") text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi @(step5_Settled ? "bi-patch-check-fill" : "bi-shield-shaded")"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(step5_Settled ? "bg-success" : "bg-primary") fw-bold rounded-pill px-2.5 py-1" style="font-size: 0.70rem;">
                                @(step5_Settled ? "ESCROW SETTLED 🟢" : "PAYOUT MODERATION ACTIVE")
                            </span>
                            <span class="text-muted small">Escrow Vault: <strong>₹@Model.TotalAmount.ToString("N2")</strong></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-0.5 mt-1">
                            @(step5_Settled ? "Farmer Payout Released to Bank Account" : "Verify Bilty & Release Farmer Payout")
                        </h5>
                        <p class="text-muted small mb-0">
                            Farmer: <strong>@farmerName</strong> &bull; Bank: <strong class="text-dark">@farmerBank</strong> &bull; IFSC: <code>@farmerIfsc</code>
                        </p>
                    </div>
                </div>

                <div>
                    @if (Model.Status == "In Transit" && !Model.AdminApprovedPayout)
                    {
                        <form asp-controller="Admin" asp-action="ReleaseEscrowPayoutViaBilty" method="post" class="d-inline" onsubmit="return confirm('Confirm release of ₹@Model.TotalAmount to @farmerName bank account?');">
                            <input type="hidden" name="orderId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%); border: none;">
                                <i class="bi bi-shield-check me-1"></i> Release ₹@Model.TotalAmount.ToString("N2") Payout Now
                            </button>
                        </form>
                    }
                    else if (step5_Settled)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-bold">
                            <i class="bi bi-check-all me-1"></i> Funds Credited to Farmer
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 1. Executive Lifecycle Progress Stepper (Single-Glance Order Status) -->
    <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h6 class="fw-extrabold text-dark mb-0 text-uppercase" style="font-size: 0.78rem; letter-spacing: 0.6px;">
                <i class="bi bi-diagram-3-fill text-success me-1.5"></i>Live Order Lifecycle &amp; Fulfillment Stepper
            </h6>
            <span class="small text-muted">Auto-Synchronized with Escrow Engine</span>
        </div>

        <div class="order-step-track">
            <!-- Step 1: Placed -->
            <div class="order-step-item completed">
                <div class="order-step-circle"><i class="bi bi-cart-check"></i></div>
                <span class="order-step-label">1. Order Placed</span>
                <small class="text-muted" style="font-size: 0.68rem;">Escrow Secured</small>
            </div>

            <!-- Step 2: Farmer Accepted -->
            <div class="order-step-item @(step2_Accepted ? "completed" : (isCancelled ? "cancelled" : "active"))">
                <div class="order-step-circle">
                    <i class="bi @(step2_Accepted ? "bi-check2" : (isCancelled ? "bi-x" : "bi-tree"))"></i>
                </div>
                <span class="order-step-label">2. Farmer Confirmed</span>
                <small class="text-muted" style="font-size: 0.68rem;">Harvest Packed</small>
            </div>

            <!-- Step 3: Logistics / Bilty -->
            <div class="order-step-item @(step3_Dispatched ? "completed" : (!isCancelled && step2_Accepted ? "active" : ""))">
                <div class="order-step-circle">
                    <i class="bi @(step3_Dispatched ? "bi-check2" : "bi-truck")"></i>
                </div>
                <span class="order-step-label">3. Dispatched</span>
                <small class="text-muted" style="font-size: 0.68rem;">@(string.IsNullOrEmpty(Model.BiltyNumber) ? "Direct Cargo" : $"Bilty #{Model.BiltyNumber}")</small>
            </div>

            <!-- Step 4: Handover & OTP -->
            <div class="order-step-item @(step4_OtpVerified ? "completed" : (!isCancelled && step3_Dispatched ? "active" : ""))">
                <div class="order-step-circle">
                    <i class="bi @(step4_OtpVerified ? "bi-check2" : "bi-key")"></i>
                </div>
                <span class="order-step-label">4. Handover &amp; OTP</span>
                <small class="text-muted" style="font-size: 0.68rem;">Buyer Verification</small>
            </div>

            <!-- Step 5: Escrow Released -->
            <div class="order-step-item @(step5_Settled ? "completed" : (!isCancelled && step4_OtpVerified ? "active" : ""))">
                <div class="order-step-circle">
                    <i class="bi @(step5_Settled ? "bi-check-all" : "bi-bank")"></i>
                </div>
                <span class="order-step-label">5. Escrow Settled</span>
                <small class="text-muted" style="font-size: 0.68rem;">Farmer Paid</small>
            </div>
        </div>
    </div>

    <!-- 2. High-Impact Quick Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. Escrow Balance & Vault -->
        <div class="col-lg-4 col-sm-6">
            <div class="user-stat-card">
                <div class="user-stat-icon-wrap" style="background: rgba(21, 128, 61, 0.12); color: #15803d;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem;">Escrow Settlement Status</small>
                    <h4 class="fw-extrabold text-success mb-0 fs-5">₹@Model.TotalAmount.ToString("N2")</h4>
                    <span class="badge @(step5_Settled ? "bg-success" : "bg-warning text-dark") fw-bold rounded-pill mt-1" style="font-size: 0.68rem;">
                        @(step5_Settled ? "Released to Farmer Bank Account" : "Safely Held in Platform Escrow")
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Transport / Bilty Mode -->
        <div class="col-lg-4 col-sm-6">
            <div class="user-stat-card">
                <div class="user-stat-icon-wrap" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="flex-grow-1">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem;">Logistics &amp; Transport Mode</small>
                    <h4 class="fw-extrabold text-dark mb-0 fs-6">@(Model.TransportType ?? "Direct Farm Pickup")</h4>
                    @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
                    {
                        <a href="@Model.BiltyImageUrl" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none fw-bold rounded-pill mt-1 d-inline-flex align-items-center gap-1" style="font-size: 0.70rem;">
                            <i class="bi bi-file-earmark-image"></i> Bilty #@(Model.BiltyNumber ?? "View Receipt")
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border rounded-pill mt-1" style="font-size: 0.68rem;">No Cargo Bilty Required</span>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Delivery Handover OTP -->
        <div class="col-lg-4 col-sm-12">
            <div class="user-stat-card" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
                <div class="user-stat-icon-wrap" style="background: rgba(255, 255, 255, 0.15); color: #facc15;">
                    <i class="bi bi-key-fill"></i>
                </div>
                <div class="flex-grow-1">
                    <small class="text-white-50 d-block text-uppercase fw-bold" style="font-size: 0.68rem;">Buyer Verification OTP</small>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4 fw-extrabold text-warning font-monospace letter-spacing-2">
                            @(string.IsNullOrEmpty(Model.DeliveryOtp) ? "7492" : Model.DeliveryOtp)
                        </span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 rounded-pill small" style="font-size: 0.65rem;">
                            @(step4_OtpVerified ? "Verified" : "Active Code")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Main Content: Produce Items & Stakeholder Profiles (Left) vs Financials & Escrow Release (Right) -->
    <div class="row g-4 mb-5">
        
        <!-- Left Column: Produce Items, Farmer Card & Buyer Card -->
        <div class="col-lg-7">
            
            <!-- Ordered Produce Items Card -->
            <div class="user-info-card mb-4">
                <div class="user-info-header">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-basket-fill text-success"></i> Ordered Produce Items (@Model.OrderItems.Count)
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-bold px-2.5 py-1 rounded-pill">
                        Direct Farm Harvest
                    </span>
                </div>

                <div class="user-info-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-4">Produce Details</th>
                                    <th>Unit Price</th>
                                    <th>Quantity</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.OrderItems.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4 ps-4">Gross order record value ₹@Model.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                                @foreach (var item in Model.OrderItems)
                                {
                                    var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(itemImg))
                                                {
                                                    <img src="@itemImg" class="rounded-3 border shadow-xs" alt="@(item.Product?.Name ?? "Crop")" style="width: 52px; height: 52px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-success" style="width: 52px; height: 52px; font-size: 1.5rem;">
                                                        <i class="bi bi-tree"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <strong class="text-dark d-block">@(item.Product?.Name ?? "Farm Produce Harvest")</strong>
                                                    <span class="badge bg-light text-muted border small">@(item.Product?.Category?.Name ?? "Gujarat Crop")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold text-dark">₹@item.UnitPrice.ToString("N2")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2.5 py-1 fw-bold">@item.Quantity units</span>
                                        </td>
                                        <td class="text-end pe-4 fw-extrabold text-success fs-6">
                                            ₹@((item.UnitPrice * item.Quantity).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Two Stakeholder Cards (Farmer vs Customer) -->
            <div class="row g-3 mb-4">
                <!-- Farmer Card -->
                <div class="col-md-6">
                    <div class="order-profile-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5">
                                <i class="bi bi-tree-fill text-success"></i> Seller (Farmer)
                            </h6>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-0.5 small fw-bold rounded-pill">
                                Producer
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2.5 mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 44px; height: 44px; background: linear-gradient(135deg, #15803d 0%, #22c55e 100%);">
                                @(!string.IsNullOrEmpty(farmerName) ? farmerName.Substring(0, 1).ToUpper() : "F")
                            </div>
                            <div class="overflow-hidden">
                                <strong class="text-dark d-block text-truncate">@farmerName</strong>
                                <small class="text-muted d-block text-truncate">@farmerEmail</small>
                            </div>
                        </div>

                        <div class="p-2.5 bg-light rounded-3 border small mb-3">
                            <div class="text-muted d-flex justify-content-between mb-1">
                                <span>Phone:</span>
                                <strong class="text-dark">@farmerPhone</strong>
                            </div>
                            <div class="text-muted d-flex justify-content-between mb-1">
                                <span>Location:</span>
                                <strong class="text-dark text-truncate" style="max-width: 140px;">@farmerLocation</strong>
                            </div>
                            <div class="text-muted d-flex justify-content-between">
                                <span>Bank:</span>
                                <strong class="text-success text-truncate" style="max-width: 140px;">@farmerBank</strong>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="tel:@farmerPhone" class="btn btn-xs btn-outline-success rounded-pill px-3 py-1 fw-bold flex-grow-1 text-center">
                                <i class="bi bi-telephone-fill me-1"></i> Call
                            </a>
                            <a href="https://wa.me/@(farmerPhone.Replace("+","").Replace(" ",""))?text=AgriAI%20Order%20#@Model.Id:D5" target="_blank" class="btn btn-xs btn-success rounded-pill px-3 py-1 fw-bold flex-grow-1 text-center" style="background-color: #25D366; border-color: #25D366;">
                                <i class="bi bi-whatsapp me-1"></i> Chat
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Customer Card -->
                <div class="col-md-6">
                    <div class="order-profile-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5">
                                <i class="bi bi-bag-heart-fill text-primary"></i> Buyer (Customer)
                            </h6>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-0.5 small fw-bold rounded-pill">
                                Retail Buyer
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2.5 mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 44px; height: 44px; background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                                @(!string.IsNullOrEmpty(customerName) ? customerName.Substring(0, 1).ToUpper() : "C")
                            </div>
                            <div class="overflow-hidden">
                                <strong class="text-dark d-block text-truncate">@customerName</strong>
                                <small class="text-muted d-block text-truncate">@customerEmail</small>
                            </div>
                        </div>

                        <div class="p-2.5 bg-light rounded-3 border small mb-3">
                            <div class="text-muted d-flex justify-content-between mb-1">
                                <span>Phone:</span>
                                <strong class="text-dark">@customerPhone</strong>
                            </div>
                            <div class="text-muted d-flex justify-content-between mb-1">
                                <span>Delivery To:</span>
                                <strong class="text-dark text-truncate" style="max-width: 140px;">@deliveryAddress</strong>
                            </div>
                            <div class="text-muted d-flex justify-content-between">
                                <span>Payment:</span>
                                <strong class="text-primary">@(Model.PaymentMethod ?? "Online Escrow")</strong>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="tel:@customerPhone" class="btn btn-xs btn-outline-primary rounded-pill px-3 py-1 fw-bold w-100 text-center">
                                <i class="bi bi-telephone-fill me-1"></i> Call Buyer
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bilty Transport Consignment Preview (If available) -->
            @if (!string.IsNullOrEmpty(Model.BiltyImageUrl))
            {
                <div class="user-info-card mb-4">
                    <div class="user-info-header">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-image-fill text-primary me-2"></i>Consignment Bilty / Lorry Receipt Proof</h5>
                        <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold">#@(Model.BiltyNumber ?? "Proof")</span>
                    </div>
                    <div class="user-info-body text-center bg-light">
                        <img src="@Model.BiltyImageUrl" class="img-fluid rounded-3 border shadow-sm" style="max-height: 280px; object-fit: contain;" alt="Bilty Receipt" />
                        <div class="mt-3">
                            <a href="@Model.BiltyImageUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-arrows-fullscreen me-1"></i> View Full Bilty Image
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Right Column: Financial Breakdown & Escrow Actions -->
        <div class="col-lg-5">
            
            <!-- Itemized Invoice Card -->
            <div class="user-info-card mb-4">
                <div class="user-info-header">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt-cutoff text-dark me-2"></i>Itemized Invoice Breakdown</h5>
                </div>

                <div class="user-info-body">
                    <div class="d-flex justify-content-between text-muted mb-2.5 small">
                        <span>Base Produce Harvest Cost:</span>
                        <strong class="text-dark fs-6">₹@baseAmount.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between text-muted mb-2.5 small">
                        <span>Transport &amp; Freight Fee:</span>
                        <strong class="text-dark">₹@Model.LogisticsFee.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between text-muted mb-3 small">
                        <span>Platform Escrow Security Fee (2%):</span>
                        <strong class="text-dark">₹@Model.PlatformFee.ToString("N2")</strong>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-6 fw-bold text-dark">Gross Buyer Invoice:</span>
                        <span class="fs-3 fw-extrabold text-success">₹@Model.TotalAmount.ToString("N2")</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border small">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-muted">Payment Security:</span>
                            <strong class="text-success"><i class="bi bi-shield-check me-1"></i>100% Escrow Protected</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-muted">Farmer Net Payout:</span>
                            <strong class="text-dark fw-bold">₹@baseAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Settlement Destination:</span>
                            <strong class="text-dark font-monospace">Farmer Bank Account</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Escrow Release Action Card (If In-Transit / Pending Release) -->
            @if (Model.Status == "In Transit" && !Model.AdminApprovedPayout)
            {
                <div class="p-4 rounded-4 border border-success shadow-sm mb-4" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.3rem;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0.5">Release Escrow Payout to Farmer</h6>
                            <p class="text-muted small mb-0">Verified Bilty receipt received. Transfer ₹@Model.TotalAmount.ToString("N2") to farmer bank account.</p>
                        </div>
                    </div>

                    <form asp-controller="Admin" asp-action="ReleaseEscrowPayoutViaBilty" method="post" onsubmit="return confirm('Confirm release of ₹@Model.TotalAmount.ToString("N2") to Farmer Bank Account?');">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success rounded-pill w-100 py-2.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%); border: none;">
                            <i class="bi bi-check-circle-fill me-1"></i> Release ₹@Model.TotalAmount.ToString("N2") to Farmer Bank
                        </button>
                    </form>
                </div>
            }
            else if (step5_Settled)
            {
                <div class="p-4 rounded-4 border border-success bg-white shadow-sm mb-4 text-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-2" style="width: 52px; height: 52px; font-size: 1.6rem;">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Escrow Settled &amp; Completed</h5>
                    <p class="text-muted small mb-0">The funds have been released to the verified farmer bank account.</p>
                </div>
            }

        </div>

    </div>

</div>
