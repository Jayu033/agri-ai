@model AgriAI.Domain.Entities.Order
@using AgriAI.Infrastructure.Identity

@{
    ViewData["Title"] = $"Admin - Order #{Model.Id:D5} Inspection & Moderation";
    
    var farmerUser = ViewBag.FarmerUser as ApplicationUser;
    var customerUser = ViewBag.CustomerUser as ApplicationUser;

    var farmerName = farmerUser != null 
        ? (!string.IsNullOrEmpty(farmerUser.FirstName) || !string.IsNullOrEmpty(farmerUser.LastName) 
            ? $"{farmerUser.FirstName} {farmerUser.LastName}".Trim() 
            : farmerUser.UserName) 
        : "Verified Gujarat Producer";
    var farmerEmail = farmerUser?.Email ?? "farmer@agriai.com";
    var farmerPhone = !string.IsNullOrEmpty(farmerUser?.PhoneNumber) ? farmerUser.PhoneNumber : "+91 97245 60047";
    var farmerLocation = !string.IsNullOrEmpty(farmerUser?.City) ? $"{farmerUser.City}, {farmerUser.State ?? "Gujarat"}" : "Gujarat Agricultural Farm Location";

    var customerName = customerUser != null 
        ? (!string.IsNullOrEmpty(customerUser.FirstName) || !string.IsNullOrEmpty(customerUser.LastName) 
            ? $"{customerUser.FirstName} {customerUser.LastName}".Trim() 
            : customerUser.UserName) 
        : (!string.IsNullOrEmpty(Model.CustomerId) ? Model.CustomerId : "Verified Buyer");
    var customerEmail = customerUser?.Email ?? (!string.IsNullOrEmpty(Model.CustomerId) && Model.CustomerId.Contains("@") ? Model.CustomerId : "buyer@agriai.com");
    var customerPhone = !string.IsNullOrEmpty(customerUser?.PhoneNumber) ? customerUser.PhoneNumber : "+91 98790 12345";
    var deliveryAddress = !string.IsNullOrEmpty(Model.ShippingAddress) ? Model.ShippingAddress : (customerUser?.Address ?? "Gujarat Location");

    var baseAmount = Model.TotalAmount - Model.LogisticsFee - Model.PlatformFee;
    var orderNoStr = "AG-" + Model.Id.ToString("D5");
    var dateFormatted = Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt");
    var firstItem = Model.OrderItems.FirstOrDefault();
    var produceName = firstItem?.Product?.Name ?? "Farm Crop Harvest";
    var itemQty = firstItem?.Quantity ?? 1;
    var unitPrice = firstItem?.UnitPrice ?? Model.TotalAmount;
}

<div class="container py-4 my-2" style="max-width: 1100px;">
    
    <!-- Top Breadcrumb & Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard" class="text-success text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard?tab=ordersTab" class="text-success text-decoration-none">Transactions & Orders</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Order #@Model.Id.ToString("D5") Inspection</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-extrabold text-dark mb-0">Order #@Model.Id.ToString("D5")</h2>
                @if (Model.Status == "Pending" || Model.Status == "Awaiting Cash on Pickup")
                {
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1.5 rounded-pill">
                        <i class="bi bi-clock-history me-1"></i>@Model.Status
                    </span>
                }
                else if (Model.Status.Contains("Delivered") || Model.Status.Contains("Settled") || Model.Status.Contains("Completed"))
                {
                    <span class="badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i>Completed 🟢
                    </span>
                }
                else
                {
                    <span class="badge bg-primary text-white fw-bold px-3 py-1.5 rounded-pill">
                        <i class="bi bi-truck me-1"></i>@Model.Status
                    </span>
                }
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3.5 py-2 fw-bold small">
                <i class="bi bi-arrow-left me-1"></i> Back to Admin Dashboard
            </a>
            <button type="button" class="btn btn-success rounded-pill px-3.5 py-2 fw-bold small shadow-sm" style="background-color: #006653; border-color: #006653;" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> Print Order Audit
            </button>
        </div>
    </div>

    <!-- Security & Escrow Protection Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill small">
                        <i class="bi bi-shield-check me-1"></i>ADMIN AUDIT PANEL
                    </span>
                    <span class="text-white-50 small">Escrow Transaction Verification</span>
                </div>
                <h4 class="fw-bold text-white mb-1">Order #@Model.Id.ToString("D5") Verification OTP</h4>
                <p class="text-white-50 small mb-0">
                    Payment Method: <strong>@(Model.PaymentMethod ?? "Online (Escrow Protected)")</strong> &bull; Transport: <strong>@(Model.TransportType ?? "Direct Farm Pickup")</strong>
                </p>
            </div>

            <div class="col-md-5 text-md-end">
                <div class="d-inline-flex align-items-center gap-3 bg-white bg-opacity-10 p-2.5 px-4 rounded-4 border border-white border-opacity-20 shadow">
                    <div>
                        <span class="text-white-50 small d-block">Handover OTP</span>
                        <span class="fs-2 fw-extrabold text-warning letter-spacing-3 font-monospace">
                            @(string.IsNullOrEmpty(Model.DeliveryOtp) ? "7492" : Model.DeliveryOtp)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        
        <!-- Left Column: Ordered Farm Produce & Farmer Contact Card -->
        <div class="col-lg-7">
            
            <!-- 1. Ordered Farm Produce List -->
            <div class="bg-white rounded-4 p-4 border shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-basket-fill text-success"></i> Ordered Produce Details (@Model.OrderItems.Count Item(s))
                </h5>

                @if (!Model.OrderItems.Any())
                {
                    <div class="p-3 bg-light rounded-3 text-muted text-center">
                        Produce details recorded in gross order amount.
                    </div>
                }

                @foreach (var item in Model.OrderItems)
                {
                    var itemImg = item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-3">
                        @if (!string.IsNullOrEmpty(itemImg))
                        {
                            <img src="@itemImg" class="rounded-3 shadow-sm" alt="@(item.Product?.Name ?? "Produce")" style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-white rounded-3 d-flex align-items-center justify-content-center border" style="width: 70px; height: 70px;">
                                <i class="bi bi-tree text-success fs-2"></i>
                            </div>
                        }

                        <div class="flex-grow-1">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold small mb-1">
                                @(item.Product?.Category?.Name ?? "Farm Produce")
                            </span>
                            <h5 class="fw-bold text-dark mb-1">@(item.Product?.Name ?? "Farm Produce")</h5>
                            <span class="text-muted small">Unit Rate: <strong>₹@item.UnitPrice.ToString("N2")</strong></span>
                        </div>

                        <div class="text-end">
                            <span class="badge bg-white text-dark border px-2.5 py-1 mb-1 d-inline-block fw-bold">
                                Quantity: @item.Quantity
                            </span>
                            <div class="fw-extrabold text-success fs-5">
                                ₹@((item.UnitPrice * item.Quantity).ToString("N2"))
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 2. Farmer / Producer Contact Profile Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-person-workspace text-success fs-4"></i> Farmer Details (વેચનાર ખેડૂત)
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 fw-bold">
                        <i class="bi bi-patch-check-fill me-1"></i>Verified Farmer
                    </span>
                </div>

                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                            @(!string.IsNullOrEmpty(farmerName) ? farmerName.Substring(0, 1).ToUpper() : "F")
                        </div>
                        <div>
                            <strong class="text-dark fs-5 d-block">@farmerName</strong>
                            <small class="text-muted">Farmer Account &bull; Direct Gujarat Producer</small>
                        </div>
                    </div>

                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Email Address:</span>
                                <strong class="text-dark">@farmerEmail</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Mobile / Contact:</span>
                                <strong class="text-success">@farmerPhone</strong>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Farm Location / Address:</span>
                                <strong class="text-dark">@farmerLocation</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <a href="tel:@farmerPhone" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-telephone-fill me-1"></i> Call Farmer
                        </a>
                        <a href="https://wa.me/@(farmerPhone.Replace("+","").Replace(" ",""))?text=Hello%20@farmerName,%20regarding%20AgriAI%20Order%20#@Model.Id:D5..." target="_blank" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #25D366; border-color: #25D366;">
                            <i class="bi bi-whatsapp me-1"></i> WhatsApp
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. Customer / Buyer Contact Profile Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle text-primary fs-4"></i> Customer Details (ખરીદનાર ગ્રાહક)
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 fw-bold">
                        <i class="bi bi-bag-check-fill me-1"></i>Registered Buyer
                    </span>
                </div>

                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width: 48px; height: 48px; background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                            @(!string.IsNullOrEmpty(customerName) ? customerName.Substring(0, 1).ToUpper() : "C")
                        </div>
                        <div>
                            <strong class="text-dark fs-5 d-block">@customerName</strong>
                            <small class="text-muted">Customer Account &bull; Verified Buyer</small>
                        </div>
                    </div>

                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Email Address:</span>
                                <strong class="text-dark">@customerEmail</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Mobile / Contact:</span>
                                <strong class="text-primary">@customerPhone</strong>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-2 bg-white rounded border">
                                <span class="text-muted d-block" style="font-size: 0.75rem;">Delivery Destination / Address:</span>
                                <strong class="text-dark">@deliveryAddress</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <a href="tel:@customerPhone" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-telephone-fill me-1"></i> Call Buyer
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Financial Breakdown & Timeline -->
        <div class="col-lg-5">
            
            <!-- Financial Breakdown Card -->
            <div class="bg-white rounded-4 p-4 border shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3">Itemized Invoice Breakdown</h5>

                <div class="d-flex justify-content-between text-muted mb-2 small">
                    <span>Base Produce Cost (@itemQty units)</span>
                    <strong class="text-dark">₹@baseAmount.ToString("N2")</strong>
                </div>

                <div class="d-flex justify-content-between text-muted mb-2 small">
                    <span>Transport / Logistics (@Model.TransportType)</span>
                    <strong class="text-dark">₹@Model.LogisticsFee.ToString("N2")</strong>
                </div>

                <div class="d-flex justify-content-between text-muted mb-3 small">
                    <span>Platform Guarantee Fee (2%)</span>
                    <strong class="text-dark">₹@Model.PlatformFee.ToString("N2")</strong>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-6 fw-bold text-dark">Total Gross Value</span>
                    <span class="fs-4 fw-extrabold text-success">₹@Model.TotalAmount.ToString("N2")</span>
                </div>

                <div class="p-3 bg-light rounded-3 border small text-muted">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Payment Mode:</span>
                        <strong class="text-success">@(Model.PaymentMethod ?? "Online (Escrow)")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Order Date:</span>
                        <strong class="text-dark">@dateFormatted</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Current Status:</span>
                        <span class="badge bg-success">@Model.Status</span>
                    </div>
                </div>
            </div>

            <!-- Fulfillment Audit Trail -->
            <div class="bg-white rounded-4 p-4 border shadow-sm">
                <h5 class="fw-bold text-dark mb-3">Fulfillment Audit Trail</h5>

                <div class="position-relative ps-4 border-start border-2 border-success ms-2 my-2">
                    <div class="mb-3 position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 bg-success rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">Order Placed & Escrow Secured</strong>
                        <span class="text-muted small">@dateFormatted</span>
                    </div>

                    <div class="mb-3 position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 @(Model.Status != "Pending" ? "bg-success" : "bg-warning") rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">Harvest Packed & Prepared by Farmer</strong>
                        <span class="text-muted small">@(Model.Status != "Pending" ? "Confirmed at Farm" : "In Progress")</span>
                    </div>

                    <div class="position-relative">
                        <span class="position-absolute top-0 start-0 translate-middle p-1.5 @(Model.Status.Contains("Delivered") ? "bg-success" : "bg-secondary") rounded-circle border border-white"></span>
                        <strong class="small text-dark d-block">Handover Completed with OTP</strong>
                        <span class="text-muted small">@(Model.Status.Contains("Delivered") ? "Completed 🟢" : "Awaiting Verification")</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
