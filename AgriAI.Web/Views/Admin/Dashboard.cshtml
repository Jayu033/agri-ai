@model IEnumerable<AgriAI.Domain.Entities.Order>

@{
    ViewData["Title"] = "Admin Command Center";
    var userName = User.Identity?.Name ?? "Administrator";
    var userInitial = userName.Substring(0, 1).ToUpper();
    var allUsers = ViewBag.AllUsers as List<AgriAI.Web.ViewModels.UserManagementViewModel> ?? new List<AgriAI.Web.ViewModels.UserManagementViewModel>();
    var allProducts = ViewBag.AllProducts as List<AgriAI.Domain.Entities.Product> ?? new List<AgriAI.Domain.Entities.Product>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (Admin Portal) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- Admin Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle" style="background: linear-gradient(135deg, #0f172a 0%, #006653 100%);">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge" style="background: #f1f5f9; color: #0f172a; border-color: #cbd5e1;">
                            <i class="bi bi-shield-lock-fill me-1 text-success"></i>Super Administrator
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons -->
                    <div class="dash-nav-pills">
                        <button type="button" class="dash-tab-link active" onclick="switchDashTab('adminOverviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Platform Overview</span>
                        </button>
                        
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminUsersTab', this)">
                            <i class="bi bi-people-fill"></i>
                            <span>Manage All Users</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminProductsTab', this)">
                            <i class="bi bi-tree"></i>
                            <span>All Listed Produce</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminOrdersTab', this)">
                            <i class="bi bi-receipt"></i>
                            <span>Orders &amp; Financials</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminProfileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Admin Profile Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 border-success p-3 mb-4 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-danger p-3 mb-4 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- TAB 1: Platform Overview -->
                    <div id="adminOverviewTab" class="dash-tab-panel active">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Platform Master Dashboard 🛡️</h3>
                                <p class="text-muted small mb-0">System-wide monitoring for Gujarat APMC market rates, direct farmer transactions, and user accounts.</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i> Print System Report
                            </button>
                        </div>

                        <!-- 4 Real Dynamic Stat Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@ViewBag.TotalRevenue.ToString("N2")</div>
                                        <div class="dash-metric-label">Platform Gross Sales</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalOrders</div>
                                        <div class="dash-metric-label">Total Transactions</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-tree-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalProducts</div>
                                        <div class="dash-metric-label">Active Listed Crops</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-people-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalUsers</div>
                                        <div class="dash-metric-label">Total Accounts</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- System Breakdown Cards -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart text-success me-2"></i>User Base Demographics</h5>
                                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill">Real Database Data</span>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <div class="p-3 bg-white rounded-3 border text-center">
                                                    <span class="fs-4 fw-extrabold text-success d-block">@ViewBag.FarmersCount</span>
                                                    <span class="text-muted small fw-bold">Registered Farmers</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-white rounded-3 border text-center">
                                                    <span class="fs-4 fw-extrabold text-primary d-block">@ViewBag.CustomersCount</span>
                                                    <span class="text-muted small fw-bold">Retail &amp; Direct Buyers</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="pt-3">
                                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill" onclick="switchDashTab('adminUsersTab', document.querySelectorAll('.dash-tab-link')[1])">
                                            Manage Accounts &amp; Permissions →
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Live Agmarknet Sync</span>
                                        <h6 class="fw-bold text-dark mb-1">APMC Market Gateway</h6>
                                        <p class="text-muted small mb-3">Gujarat daily mandi rates and MSP benchmarks are active and synchronizing in real time.</p>
                                    </div>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                                        <i class="bi bi-broadcast me-1"></i> View Live Market Feed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: User Management (Embedded directly in Admin Dashboard) -->
                    <div id="adminUsersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">User Accounts &amp; Security Moderation</h3>
                                <p class="text-muted small mb-0">View registered farmers &amp; buyers, block fraudulent accounts, or remove rule violators.</p>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>User</th>
                                        <th>Role</th>
                                        <th>Email Address</th>
                                        <th>Joined Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!allUsers.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">No non-admin users registered yet.</td></tr>
                                    }
                                    @foreach (var user in allUsers)
                                    {
                                        var init = !string.IsNullOrEmpty(user.Username) ? user.Username.Substring(0, 1).ToUpper() : "U";
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 34px; height: 34px; font-size: 0.85rem; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                                        @init
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block">@(string.IsNullOrEmpty(user.FirstName) && string.IsNullOrEmpty(user.LastName) ? user.Username : $"{user.FirstName} {user.LastName}")</strong>
                                                        <small class="text-muted">@@@user.Username</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (user.Role == "Farmer")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">Farmer</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">Customer</span>
                                                }
                                            </td>
                                            <td>@user.Email</td>
                                            <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (user.IsBlocked)
                                                {
                                                    <span class="badge bg-danger">Blocked 🔴</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active 🟢</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5">
                                                    <form asp-controller="Admin" asp-action="ToggleBlockUser" method="post" class="m-0 d-inline">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn btn-sm @(user.IsBlocked ? "btn-outline-success" : "btn-outline-warning") rounded-pill px-2.5 py-1" title="@(user.IsBlocked ? "Unblock User" : "Block User")">
                                                            <i class="bi @(user.IsBlocked ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="m-0 d-inline" onsubmit="return confirm('Are you sure you want to permanently delete user @user.Email?');">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Delete User">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 3: All Listed Produce -->
                    <div id="adminProductsTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">All Platform Listed Farm Produce</h3>
                                <p class="text-muted small mb-0">Review all farm products listed across Gujarat by verified farmers.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                                <i class="bi bi-shop me-1"></i> Public Storefront
                            </a>
                        </div>

                        @if (allProducts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Produce Name</th>
                                            <th>Category</th>
                                            <th>Direct Price (₹)</th>
                                            <th>Stock (Kg/Qtl)</th>
                                            <th>Farmer ID</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prod in allProducts)
                                        {
                                            <tr>
                                                <td><strong>@prod.Name</strong></td>
                                                <td><span class="badge bg-light text-dark border">@(prod.Category?.Name ?? "General Produce")</span></td>
                                                <td class="fw-bold text-success">₹@prod.Price.ToString("N2")</td>
                                                <td>@prod.StockQuantity</td>
                                                <td class="small text-muted">@prod.FarmerId</td>
                                                <td>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1">
                                                        View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-basket display-4 text-muted opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No farm produce listed yet</h5>
                                <p class="text-muted small mb-0">When farmers list their harvests, they will appear in this administrative catalogue.</p>
                            </div>
                        }
                    </div>

                    <!-- TAB 4: Orders & Financials -->
                    <div id="adminOrdersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Transactions &amp; Order Feed</h3>
                                <p class="text-muted small mb-0">Master record of all purchases between retail buyers and farmers.</p>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Order Date</th>
                                        <th>Gross Amount</th>
                                        <th>Status</th>
                                        <th>Customer ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">No customer orders recorded in system yet.</td></tr>
                                    }
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><strong>#@order.Id.ToString("D5")</strong></td>
                                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                            <td class="fw-bold text-success">₹@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @if (order.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                                else if (order.Status == "Delivered") { <span class="badge bg-success">Delivered 🟢</span> }
                                                else { <span class="badge bg-info">@order.Status</span> }
                                            </td>
                                            <td class="small text-muted">@order.CustomerId</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 5: Admin Profile Settings -->
                    <div id="adminProfileTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Super Admin Credentials</h3>
                                <p class="text-muted small mb-0">Manage root administrator password and system configuration.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Admin Account Identifier</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="@userName" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Security Privileges</label>
                                    <input type="text" class="form-control bg-white shadow-none text-danger fw-bold" value="Full System Root Privileges" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-shield-lock me-1"></i> Update Admin Password &amp; Profile
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDashTab(tabId, btn) {
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }
    </script>
}
