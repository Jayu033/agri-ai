@model IEnumerable<AgriAI.Domain.Entities.Order>

@{
    ViewData["Title"] = "Admin Command Center";
    var userName = User.Identity?.Name ?? "Administrator";
    var userInitial = userName.Substring(0, 1).ToUpper();
    var allUsers = ViewBag.AllUsers as List<AgriAI.Web.ViewModels.UserManagementViewModel> ?? new List<AgriAI.Web.ViewModels.UserManagementViewModel>();
    var allProducts = ViewBag.AllProducts as List<AgriAI.Domain.Entities.Product> ?? new List<AgriAI.Domain.Entities.Product>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (Admin Portal) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- Admin Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle" style="background: linear-gradient(135deg, #0f172a 0%, #006653 100%);">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge" style="background: #f1f5f9; color: #0f172a; border-color: #cbd5e1;">
                            <i class="bi bi-shield-lock-fill me-1 text-success"></i>Super Administrator
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons -->
                    <div class="dash-nav-pills">
                        <button type="button" class="dash-tab-link active" onclick="switchDashTab('adminOverviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>Platform Overview</span>
                        </button>
                        
                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminUsersTab', this)">
                            <i class="bi bi-people-fill"></i>
                            <span>Manage All Users</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminProductsTab', this)">
                            <i class="bi bi-tree"></i>
                            <span>All Listed Produce</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminOrdersTab', this)">
                            <i class="bi bi-receipt"></i>
                            <span>Orders &amp; Financials</span>
                        </button>

                        <button type="button" class="dash-tab-link" onclick="switchDashTab('adminProfileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Admin Profile Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm border-0" style="background-color: #d1fae5; color: #065f46;" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i> <strong>Success:</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm border-0" style="background-color: #fee2e2; color: #991b1b;" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <strong>Notice:</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- TAB 1: Platform Overview -->
                    <div id="adminOverviewTab" class="dash-tab-panel active">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Platform Master Dashboard 🛡️</h3>
                                <p class="text-muted small mb-0">System-wide monitoring for Gujarat APMC market rates, direct farmer transactions, and user accounts.</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i> Print System Report
                            </button>
                        </div>

                        <!-- 4 Real Dynamic Stat Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">₹@ViewBag.TotalRevenue.ToString("N2")</div>
                                        <div class="dash-metric-label">Platform Gross Sales</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalOrders</div>
                                        <div class="dash-metric-label">Total Transactions</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-tree-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalProducts</div>
                                        <div class="dash-metric-label">Active Listed Crops</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-people-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num">@ViewBag.TotalUsers</div>
                                        <div class="dash-metric-label">Total Accounts</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- System Breakdown Cards -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart text-success me-2"></i>User Base Demographics</h5>
                                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill">Real Database Data</span>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <div class="p-3 bg-white rounded-3 border text-center">
                                                    <span class="fs-4 fw-extrabold text-success d-block">@ViewBag.FarmersCount</span>
                                                    <span class="text-muted small fw-bold">Registered Farmers</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-white rounded-3 border text-center">
                                                    <span class="fs-4 fw-extrabold text-primary d-block">@ViewBag.CustomersCount</span>
                                                    <span class="text-muted small fw-bold">Retail &amp; Direct Buyers</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="pt-3">
                                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill" onclick="switchDashTab('adminUsersTab', document.querySelectorAll('.dash-tab-link')[1])">
                                            Manage Accounts &amp; Permissions →
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Live Agmarknet Sync</span>
                                        <h6 class="fw-bold text-dark mb-1">APMC Market Gateway</h6>
                                        <p class="text-muted small mb-3">Gujarat daily mandi rates and MSP benchmarks are active and synchronizing in real time.</p>
                                    </div>
                                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                                        <i class="bi bi-broadcast me-1"></i> View Live Market Feed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: User Management (Embedded directly in Admin Dashboard) -->
                    <div id="adminUsersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">User Accounts &amp; Security Moderation</h3>
                                <p class="text-muted small mb-0">View registered farmers &amp; buyers, block fraudulent accounts, or remove rule violators.</p>
                            </div>
                        </div>

                        <!-- Role Filter Action Buttons -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 bg-light p-2 rounded-4 border">
                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-dark text-white active shadow-sm" data-filter="all" onclick="filterUsersTable('all', this)">
                                <i class="bi bi-people-fill me-1"></i> All Users (@allUsers.Count)
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-success" data-filter="Farmer" onclick="filterUsersTable('Farmer', this)">
                                <i class="bi bi-tree-fill me-1"></i> Farmers (@allUsers.Count(u => u.Role == "Farmer"))
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-primary" data-filter="Customer" onclick="filterUsersTable('Customer', this)">
                                <i class="bi bi-person-fill me-1"></i> Customers / Buyers (@allUsers.Count(u => u.Role == "Customer"))
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>User</th>
                                        <th>Role</th>
                                        <th>Email Address</th>
                                        <th>Joined Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!allUsers.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">No non-admin users registered yet.</td></tr>
                                    }
                                    @foreach (var user in allUsers)
                                    {
                                        var init = !string.IsNullOrEmpty(user.Username) ? user.Username.Substring(0, 1).ToUpper() : "U";
                                        <tr class="user-table-row" data-role="@user.Role">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                                    {
                                                        <img src="@user.ProfilePicturePath" class="rounded-circle shadow-sm border border-2 border-success" style="width: 36px; height: 36px; object-fit: cover;" alt="@user.FullName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 36px; height: 36px; font-size: 0.85rem; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                                            @init
                                                        </div>
                                                    }
                                                    <div>
                                                        <strong class="text-dark d-block">@(string.IsNullOrEmpty(user.FirstName) && string.IsNullOrEmpty(user.LastName) ? user.Username : $"{user.FirstName} {user.LastName}")</strong>
                                                        <small class="text-muted">@@@user.Username</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (user.Role == "Farmer")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">Farmer</span>
                                                    @if (!string.IsNullOrEmpty(user.KycDocumentPath))
                                                    {
                                                        <div class="mt-1">
                                                            <a href="@user.KycDocumentPath" target="_blank" class="badge bg-light text-primary border text-decoration-none" style="font-size: 0.70rem;">
                                                                <i class="bi bi-file-earmark-text me-1"></i>@(user.KycDocumentType ?? "7/12 Doc")
                                                            </a>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">Customer</span>
                                                }
                                            </td>
                                            <td>@user.Email</td>
                                            <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (user.IsBlocked)
                                                {
                                                    <span class="badge bg-danger rounded-pill px-2.5 py-1">Blocked 🔴</span>
                                                }
                                                else if (user.Role == "Farmer" && !user.IsApprovedByAdmin)
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold"><i class="bi bi-clock-history me-1"></i>Pending KYC</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success rounded-pill px-2.5 py-1">Active 🟢</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5 align-items-center">
                                                    @if (user.Role == "Farmer")
                                                    {
                                                        <!-- Review KYC Inspector Modal Button -->
                                                        <button type="button" class="btn btn-sm @(user.IsApprovedByAdmin ? "btn-outline-success" : "btn-success") rounded-pill px-2.5 py-1 fw-bold shadow-sm" 
                                                                onclick="openKycReviewModal('@user.Id', '@user.FullName', '@user.Email', '@(user.City ?? "")', '@(user.Address ?? "")', '@(user.BankName ?? "")', '@(user.BankAccountNumber ?? "")', '@(user.BankIfscCode ?? "")', '@(user.UpiId ?? "")', '@(user.KycDocumentType ?? "7/12 (Satbara)")', '@(user.KycDocumentPath ?? "")', @(user.IsApprovedByAdmin ? "true" : "false"), '@(user.KycRejectionReason ?? "")', '@(user.ProfilePicturePath ?? "")')"
                                                                title="Inspect Document & Bank KYC">
                                                            <i class="bi bi-shield-check me-1"></i>@(user.IsApprovedByAdmin ? "KYC Details" : "Review KYC")
                                                        </button>
                                                    }

                                                    <form asp-controller="Admin" asp-action="ToggleBlockUser" method="post" class="m-0 d-inline">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn btn-sm @(user.IsBlocked ? "btn-outline-success" : "btn-outline-warning") rounded-pill px-2.5 py-1" title="@(user.IsBlocked ? "Unblock User" : "Block User")">
                                                            <i class="bi @(user.IsBlocked ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="m-0 d-inline" onsubmit="return confirm('Are you sure you want to permanently delete user @user.Email?');">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Delete User">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    <tr id="noFilteredUsersRow" style="display: none;">
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="bi bi-people display-6 d-block mb-1 text-secondary opacity-50"></i>
                                            No users found for this selected role.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 3: All Listed Produce -->
                    <div id="adminProductsTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">All Platform Listed Farm Produce</h3>
                                <p class="text-muted small mb-0">Review all farm products listed across Gujarat by verified farmers.</p>
                            </div>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                                <i class="bi bi-shop me-1"></i> Public Storefront
                            </a>
                        </div>

                        @if (allProducts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Produce Name</th>
                                            <th>Category</th>
                                            <th>Direct Price (₹)</th>
                                            <th>Stock (Kg/Qtl)</th>
                                            <th>Farmer ID</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prod in allProducts)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@prod.Name</strong>
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@(prod.Category?.Name ?? "General Produce")</span></td>
                                                <td class="fw-bold text-success">₹@prod.Price.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @(prod.StockQuantity > 0 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25") fw-bold px-2.5 py-1 rounded-pill">
                                                        @prod.StockQuantity units
                                                    </span>
                                                </td>
                                                <td class="small text-muted" title="@prod.FarmerId">
                                                    <span style="max-width: 140px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle;">
                                                        @prod.FarmerId
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1" title="View Details">
                                                        <i class="bi bi-eye"></i> View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-basket display-4 text-muted opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No farm produce listed yet</h5>
                                <p class="text-muted small mb-0">When farmers list their harvests, they will appear in this administrative catalogue.</p>
                            </div>
                        }
                    </div>

                    <!-- TAB 4: Orders & Financials -->
                    <div id="adminOrdersTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Transactions &amp; Order Feed</h3>
                                <p class="text-muted small mb-0">Master record of all purchases between retail buyers and farmers.</p>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Order Date</th>
                                        <th>Gross Amount</th>
                                        <th>Status</th>
                                        <th>Customer ID</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">No customer orders recorded in system yet.</td></tr>
                                    }
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><strong>#@order.Id.ToString("D5")</strong></td>
                                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                            <td class="fw-bold text-success">₹@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @if (order.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                                else if (order.Status == "Delivered") { <span class="badge bg-success">Delivered 🟢</span> }
                                                else { <span class="badge bg-info">@order.Status</span> }
                                            </td>
                                            <td class="small text-muted">@order.CustomerId</td>
                                            <td class="text-end">
                                                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold">
                                                    <i class="bi bi-eye-fill me-1"></i> View Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 5: Admin Profile Settings -->
                    <div id="adminProfileTab" class="dash-tab-panel">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Super Admin Credentials</h3>
                                <p class="text-muted small mb-0">Manage root administrator password and system configuration.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Admin Account Identifier</label>
                                    <input type="text" class="form-control bg-white shadow-none" value="@userName" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3.5 bg-light rounded-4 border mb-3">
                                    <label class="form-label small fw-bold text-dark">Security Privileges</label>
                                    <input type="text" class="form-control bg-white shadow-none text-danger fw-bold" value="Full System Root Privileges" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-shield-lock me-1"></i> Update Admin Password &amp; Profile
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Farmer KYC Review Inspector Modal -->
<div class="modal fade" id="kycReviewModal" tabindex="-1" aria-labelledby="kycReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3.5 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="kycReviewModalLabel">Farmer KYC &amp; Anti-Fraud Inspector</h5>
                        <small class="text-light opacity-75">Verify 7/12 (Satbara) &amp; Bank Payout Details</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Left: Document Preview -->
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 bg-light text-center h-100 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border fw-bold px-3 py-1.5 rounded-pill mb-2" id="kycDocTypeBadge">
                                    7/12 (Satbara)
                                </span>
                                <h6 class="fw-bold text-dark mb-2">Uploaded Document Proof</h6>
                            </div>
                            
                            <div class="my-3 d-flex align-items-center justify-content-center overflow-hidden rounded-3 border bg-white" style="min-height: 240px; max-height: 320px;">
                                <img id="kycDocImg" src="" class="img-fluid rounded" alt="KYC Document" style="max-height: 300px; object-fit: contain; display: none;" />
                                <iframe id="kycDocPdf" src="" class="w-100" style="height: 300px; border: none; display: none;"></iframe>
                                <div id="kycNoDoc" class="text-muted p-4">
                                    <i class="bi bi-file-earmark-x display-4 text-secondary opacity-50 d-block mb-2"></i>
                                    <p class="small mb-0">No document uploaded yet</p>
                                </div>
                            </div>

                            <a id="kycDocFullLink" href="#" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill w-100 fw-bold">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Open Original Document
                            </a>
                        </div>
                    </div>

                    <!-- Right: Farmer & Bank Verification Details -->
                    <div class="col-md-6">
                        <div class="h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
                                    <img id="kycFarmerAvatar" src="" class="rounded-circle border border-2 border-success shadow-sm" style="width: 54px; height: 54px; object-fit: cover;" alt="Farmer Face Photo" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-6" id="kycFarmerName"></h6>
                                        <small class="text-muted d-block" id="kycFarmerEmail"></small>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-0.5 rounded-pill" style="font-size: 0.70rem;">
                                            <i class="bi bi-person-check-fill me-1"></i> Registered Farmer
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted d-block">Farm Location</small>
                                    <span class="fw-semibold text-dark" id="kycFarmerLocation"></span>
                                </div>

                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Bank Account &amp; UPI Details</h6>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <small class="text-muted d-block">Bank Name</small>
                                        <span class="fw-bold text-dark" id="kycBankName"></span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Account Number</small>
                                        <span class="fw-bold text-success font-monospace" id="kycBankAcc"></span>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <small class="text-muted d-block">IFSC Code</small>
                                        <span class="fw-bold text-dark font-monospace" id="kycBankIfsc"></span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">UPI ID</small>
                                        <span class="fw-semibold text-dark font-monospace" id="kycUpiId"></span>
                                    </div>
                                </div>

                                <div id="kycRejectionAlert" class="alert alert-danger p-2.5 rounded-3 small mb-2 d-none">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Rejection Reason:</strong> <span id="kycRejectionMsg"></span>
                                </div>
                            </div>

                            <!-- Approval / Rejection Action Controls -->
                            <div class="border-top pt-3">
                                <div class="d-flex gap-2 mb-2">
                                    <form asp-action="ApproveFarmer" method="post" class="flex-grow-1">
                                        <input type="hidden" name="id" id="kycApproveUserId" value="" />
                                        <button type="submit" class="btn btn-success rounded-pill fw-bold w-100 py-2 shadow-sm" style="background-color: #006653; border-color: #006653;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approve &amp; Activate Farmer
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 fw-bold" onclick="toggleRejectBox()">
                                        <i class="bi bi-x-circle me-1"></i> Reject
                                    </button>
                                </div>

                                <!-- Collapsible Reject with Reason Form -->
                                <div id="rejectReasonBox" class="mt-2 p-3 bg-light rounded-3 border" style="display: none;">
                                    <form asp-action="RejectFarmer" method="post">
                                        <input type="hidden" name="id" id="kycRejectUserId" value="" />
                                        <label class="form-label small fw-bold text-danger mb-1">State Reason for Rejection:</label>
                                        <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. 7/12 document photo is blurred / Name does not match bank account..." required></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleRejectBox()">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Submit Rejection</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                const targetBtn = Array.from(document.querySelectorAll('.dash-tab-link')).find(btn => {
                    const onclickAttr = btn.getAttribute('onclick') || '';
                    return onclickAttr.includes(tabParam);
                });
                if (targetBtn) {
                    switchDashTab(tabParam, targetBtn);
                }
            }
        });

        function switchDashTab(tabId, btn) {
            document.querySelectorAll('.dash-tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });

            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) {
                selectedPanel.classList.add('active');
            }

            document.querySelectorAll('.dash-tab-link').forEach(b => {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            }
        }

        function openKycReviewModal(id, name, email, city, address, bankName, bankAcc, bankIfsc, upi, docType, docPath, isApproved, rejectionReason, profilePic) {
            document.getElementById('kycApproveUserId').value = id;
            document.getElementById('kycRejectUserId').value = id;
            document.getElementById('kycFarmerName').textContent = name || 'N/A';
            document.getElementById('kycFarmerEmail').textContent = email || 'N/A';
            document.getElementById('kycFarmerLocation').textContent = (address ? address + ', ' : '') + (city || 'Gujarat');
            document.getElementById('kycBankName').textContent = bankName || 'Not Provided';
            document.getElementById('kycBankAcc').textContent = bankAcc || 'Not Provided';
            document.getElementById('kycBankIfsc').textContent = bankIfsc || 'Not Provided';
            document.getElementById('kycUpiId').textContent = upi || 'None';
            document.getElementById('kycDocTypeBadge').textContent = docType || '7/12 (Satbara)';

            const avatarImg = document.getElementById('kycFarmerAvatar');
            if (profilePic && profilePic.trim() !== '') {
                avatarImg.src = profilePic;
            } else {
                avatarImg.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name || 'Farmer') + '&background=15803d&color=fff&size=128';
            }

            const docImg = document.getElementById('kycDocImg');
            const docPdf = document.getElementById('kycDocPdf');
            const noDoc = document.getElementById('kycNoDoc');
            const fullLink = document.getElementById('kycDocFullLink');

            docImg.style.display = 'none';
            docPdf.style.display = 'none';
            noDoc.style.display = 'none';

            if (docPath && docPath.trim() !== '') {
                fullLink.href = docPath;
                fullLink.style.display = 'block';
                if (docPath.toLowerCase().endsWith('.pdf')) {
                    docPdf.src = docPath;
                    docPdf.style.display = 'block';
                } else {
                    docImg.src = docPath;
                    docImg.style.display = 'block';
                }
            } else {
                noDoc.style.display = 'block';
                fullLink.style.display = 'none';
            }

            const rejAlert = document.getElementById('kycRejectionAlert');
            const rejMsg = document.getElementById('kycRejectionMsg');
            if (rejectionReason && rejectionReason.trim() !== '') {
                rejMsg.textContent = rejectionReason;
                rejAlert.classList.remove('d-none');
            } else {
                rejAlert.classList.add('d-none');
            }

            document.getElementById('rejectReasonBox').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('kycReviewModal'));
            modal.show();
        }

        function toggleRejectBox() {
            const box = document.getElementById('rejectReasonBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        function filterUsersTable(role, btn) {
            document.querySelectorAll('.user-filter-btn').forEach(b => {
                b.classList.remove('active', 'bg-dark', 'text-white', 'bg-success', 'bg-primary', 'shadow-sm');
                const filter = b.getAttribute('data-filter');
                if (filter === 'Farmer') {
                    b.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-success';
                } else if (filter === 'Customer') {
                    b.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-primary';
                } else {
                    b.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-secondary';
                }
            });

            if (btn) {
                if (role === 'Farmer') {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-success text-white active shadow-sm';
                } else if (role === 'Customer') {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-primary text-white active shadow-sm';
                } else {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-dark text-white active shadow-sm';
                }
            }

            const rows = document.querySelectorAll('.user-table-row');
            let visibleCount = 0;
            rows.forEach(row => {
                const userRole = row.getAttribute('data-role');
                if (role === 'all' || userRole === role) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noUsersRow = document.getElementById('noFilteredUsersRow');
            if (noUsersRow) {
                noUsersRow.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        // Auto-dismiss alert banners smoothly after 3.5 seconds
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    alert.style.transition = 'opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease';
                    alert.style.opacity = '0';
                    alert.style.maxHeight = '0';
                    alert.style.margin = '0';
                    alert.style.padding = '0';
                    alert.style.overflow = 'hidden';
                    setTimeout(function () {
                        alert.remove();
                    }, 600);
                }, 3500);
            });
        });
    </script>
}
