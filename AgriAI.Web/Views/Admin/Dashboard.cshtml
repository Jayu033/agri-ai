                                    <form asp-action="RejectFarmer" method="post">
                                        <input type="hidden" name="id" id="kycRejectUserId" value="" />
                                        <label class="form-label small fw-bold text-danger mb-1">State Reason for Rejection:</label>
                                        <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. 7/12 document photo is blurred / Name does not match bank account..." required></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleRejectBox()">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Confirm &amp; Delete Data</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchDashTab(tabId, element) {
            document.querySelectorAll('.dash-tab-panel').forEach(function (panel) {
                panel.classList.remove('active');
            });
            document.querySelectorAll('.dash-tab-link').forEach(function (link) {
                link.classList.remove('active');
            });

            const targetPanel = document.getElementById(tabId);
            if (targetPanel) {
                targetPanel.classList.add('active');
            }
            if (element) {
                element.classList.add('active');
            }

            const tabMap = {
                'adminOverviewTab': 'overview',
                'adminUsersTab': 'users',
                'adminEscrowTab': 'escrow',
                'adminProductsTab': 'products',
                'adminOrdersTab': 'orders',
                'adminAiTab': 'ai',
                'adminReportsTab': 'reports',
                'adminProfileTab': 'profile'
            };
            const tabName = tabMap[tabId] || 'overview';
            const newUrl = window.location.pathname + '?tab=' + tabName;
            window.history.replaceState({ tab: tabName }, '', newUrl);
        }

        function filterUsersTable(role, element) {
            document.querySelectorAll('.user-filter-btn').forEach(function (btn) {
                btn.classList.remove('active', 'btn-dark', 'text-white');
                if (btn.getAttribute('data-filter') === 'Farmer') {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-success';
                } else if (btn.getAttribute('data-filter') === 'Customer') {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-primary';
                } else {
                    btn.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-secondary';
                }
            });

            element.className = 'btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-dark text-white active shadow-sm';

            const rows = document.querySelectorAll('.dash-user-row');
            rows.forEach(function (row) {
                if (role === 'all' || row.getAttribute('data-role') === role) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Live search filter inside dashboard user tab & tab URL parameter selector
        document.addEventListener("DOMContentLoaded", function () {
            // Check for tab query param e.g. ?tab=users or hash e.g. #adminUsersTab
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = (urlParams.get('tab') || '').toLowerCase();
            const hash = window.location.hash;

            if (tabParam === 'users' || hash === '#adminUsersTab') {
                const usersTabBtn = document.querySelector(".dash-tab-link[onclick*='adminUsersTab']");
                switchDashTab('adminUsersTab', usersTabBtn);
            } else if (tabParam === 'escrow' || hash === '#adminEscrowTab') {
                const escrowTabBtn = document.querySelector(".dash-tab-link[onclick*='adminEscrowTab']");
                switchDashTab('adminEscrowTab', escrowTabBtn);
            } else if (tabParam === 'products' || hash === '#adminProductsTab') {
                const prodTabBtn = document.querySelector(".dash-tab-link[onclick*='adminProductsTab']");
                switchDashTab('adminProductsTab', prodTabBtn);
            } else if (tabParam === 'orders' || hash === '#adminOrdersTab') {
                const orderTabBtn = document.querySelector(".dash-tab-link[onclick*='adminOrdersTab']");
                switchDashTab('adminOrdersTab', orderTabBtn);
            } else if (tabParam === 'ai' || hash === '#adminAiTab') {
                const aiTabBtn = document.querySelector(".dash-tab-link[onclick*='adminAiTab']");
                switchDashTab('adminAiTab', aiTabBtn);
            } else if (tabParam === 'reports' || hash === '#adminReportsTab') {
                const repTabBtn = document.querySelector(".dash-tab-link[onclick*='adminReportsTab']");
                switchDashTab('adminReportsTab', repTabBtn);
            }

            const searchInput = document.getElementById('dashUserSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.toLowerCase().trim();
                    document.querySelectorAll('.dash-user-row').forEach(function (row) {
                        const content = row.getAttribute('data-search') || '';
                        if (!q || content.includes(q)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }
        });

        function openKycReviewModal(id, name, email, city, address, bankName, bankAcc, bankIfsc, upi, docType, docPath, isApproved, rejectionReason, profilePic) {
            document.getElementById('kycApproveUserId').value = id;
            document.getElementById('kycRejectUserId').value = id;
            document.getElementById('kycFarmerName').textContent = name || 'N/A';
            document.getElementById('kycFarmerEmail').textContent = email || 'N/A';
            document.getElementById('kycFarmerLocation').textContent = (address ? address + ', ' : '') + (city || 'Gujarat');
            document.getElementById('kycBankName').textContent = bankName || 'Not Provided';
            document.getElementById('kycBankAcc').textContent = bankAcc || 'Not Provided';
            document.getElementById('kycBankIfsc').textContent = bankIfsc || 'Not Provided';
            document.getElementById('kycUpiId').textContent = upi || 'None';
            document.getElementById('kycDocTypeBadge').textContent = docType || '7/12 (Satbara)';

            const avatarImg = document.getElementById('kycFarmerAvatar');
            if (profilePic && profilePic.trim() !== '') {
                avatarImg.src = profilePic;
            } else {
                avatarImg.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name || 'Farmer') + '&background=15803d&color=fff&size=128';
            }

            const docImg = document.getElementById('kycDocImg');
            const docPdf = document.getElementById('kycDocPdf');
            const noDoc = document.getElementById('kycNoDoc');
            const fullLink = document.getElementById('kycDocFullLink');

            docImg.style.display = 'none';
            docPdf.style.display = 'none';
            noDoc.style.display = 'none';

            if (docPath && docPath.trim() !== '') {
                fullLink.href = docPath;
                fullLink.style.display = 'block';
                if (docPath.toLowerCase().endsWith('.pdf')) {
                    docPdf.src = docPath;
                    docPdf.style.display = 'block';
                } else {
                    docImg.src = docPath;
                    docImg.style.display = 'block';
                }
            } else {
                noDoc.style.display = 'block';
                fullLink.style.display = 'none';
            }

            const rejAlert = document.getElementById('kycRejectionAlert');
            const rejMsg = document.getElementById('kycRejectionMsg');
            if (rejectionReason && rejectionReason.trim() !== '') {
                rejMsg.textContent = rejectionReason;
                rejAlert.classList.remove('d-none');
            } else {
                rejAlert.classList.add('d-none');
            }

            document.getElementById('rejectReasonBox').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('kycReviewModal'));
            modal.show();
        }

        function toggleRejectBox() {
            const box = document.getElementById('rejectReasonBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }
    
        // Escrow Table Live Filter & Search
        function filterEscrowTable(filterType, element) {
            document.querySelectorAll('#escrowFilterPills .escrow-pill-btn').forEach(function(btn) {
                btn.classList.remove('active');
            });
            if (element) {
                element.classList.add('active');
            }

            const rows = document.querySelectorAll('#escrowModerationTable tbody .escrow-order-row');
            rows.forEach(function(row) {
                const rowType = row.getAttribute('data-filter-type');
                if (filterType === 'all' || rowType === filterType) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function searchEscrowTable() {
            const query = (document.getElementById('escrowSearchInput')?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#escrowModerationTable tbody .escrow-order-row');
            rows.forEach(function(row) {
                const text = (row.getAttribute('data-search-text') || '').toLowerCase();
                if (text.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    
    </script>
}
