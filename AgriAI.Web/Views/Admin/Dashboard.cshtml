@model IEnumerable<AgriAI.Domain.Entities.Order>

@{
    ViewData["Title"] = "Admin Command Center";
    var userName = User.Identity?.Name ?? "Administrator";
    var userInitial = userName.Substring(0, 1).ToUpper();
    var allUsers = ViewBag.AllUsers as List<AgriAI.Web.ViewModels.UserManagementViewModel> ?? new List<AgriAI.Web.ViewModels.UserManagementViewModel>();
    var allProducts = ViewBag.AllProducts as List<AgriAI.Domain.Entities.Product> ?? new List<AgriAI.Domain.Entities.Product>();

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal escrowBalance = ViewBag.EscrowBalance ?? 0m;
    decimal releasedPayouts = ViewBag.ReleasedPayouts ?? 0m;
    int pendingKycCount = ViewBag.PendingKycCount ?? 0;
    int inTransitCount = ViewBag.InTransitCount ?? 0;
    int deliveredCount = ViewBag.DeliveredCount ?? 0;
    int requestedCount = ViewBag.RequestedCount ?? 0;
    int totalUsers = ViewBag.TotalUsers ?? allUsers.Count;
    int totalFarmers = ViewBag.TotalFarmers ?? allUsers.Count(u => u.Role == "Farmer");
    int totalCustomers = ViewBag.TotalCustomers ?? allUsers.Count(u => u.Role == "Customer");
    string activeTab = (ViewBag.ActiveTab as string ?? Context.Request.Query["tab"].ToString() ?? "overview").ToLower().Trim();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "overview";
    if (activeTab == "crops" || activeTab == "adminproductstab") activeTab = "products";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<div class="dashboard-page-bg">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1440px;">
        <div class="row g-3 g-lg-4">
            
            <!-- Left Sidebar Navigation (Admin Portal - 7 Key Modules) -->
            <div class="col-lg-3 col-md-4">
                <div class="dashboard-sidebar-card">
                    <!-- Admin Avatar Header -->
                    <div class="dash-user-profile-header">
                        <div class="dash-avatar-circle" style="background: linear-gradient(135deg, #0f172a 0%, #006653 100%);">
                            @userInitial
                        </div>
                        <h4 class="dash-user-name">@userName.Split('@')[0]</h4>
                        <span class="dash-user-role-badge" style="background: #f1f5f9; color: #0f172a; border-color: #cbd5e1;">
                            <i class="bi bi-shield-lock-fill me-1 text-success"></i>Super Administrator
                        </span>
                    </div>

                    <!-- Navigation Tab Buttons (7 Essential Modules) -->
                    <div class="dash-nav-pills">
                        <button type="button" class="dash-tab-link @(activeTab == "overview" ? "active" : "")" onclick="switchDashTab('adminOverviewTab', this)">
                            <i class="bi bi-speedometer2"></i>
                            <span>1. Executive KPI Overview</span>
                        </button>
                        
                        <button type="button" class="dash-tab-link @(activeTab == "users" ? "active" : "")" onclick="switchDashTab('adminUsersTab', this)">
                            <i class="bi bi-people-fill"></i>
                            <span>2. Farmer and Users</span>
                            @if (pendingKycCount > 0)
                            {
                                <span class="badge bg-warning text-dark rounded-pill ms-auto small" style="font-size: 0.70rem;">@pendingKycCount New</span>
                            }
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "escrow" ? "active" : "")" onclick="switchDashTab('adminEscrowTab', this)">
                            <i class="bi bi-shield-check"></i>
                            <span>3. Escrow &amp; Bilty Payouts</span>
                            @if (inTransitCount > 0)
                            {
                                <span class="badge bg-primary text-white rounded-pill ms-auto small" style="font-size: 0.70rem;">@inTransitCount Dispatched</span>
                            }
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "products" ? "active" : "")" onclick="switchDashTab('adminProductsTab', this)">
                            <i class="bi bi-tree"></i>
                            <span>4. Listed Crops &amp; Categories</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "orders" ? "active" : "")" onclick="switchDashTab('adminOrdersTab', this)">
                            <i class="bi bi-receipt"></i>
                            <span>5. Orders &amp; Transactions</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "ai" ? "active" : "")" onclick="switchDashTab('adminAiTab', this)">
                            <i class="bi bi-cpu-fill text-success"></i>
                            <span>6. AI &amp; Mandi Intelligence</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "reports" ? "active" : "")" onclick="switchDashTab('adminReportsTab', this)">
                            <i class="bi bi-file-earmark-spreadsheet-fill text-primary"></i>
                            <span>7. Reports &amp; Financials</span>
                        </button>

                        <button type="button" class="dash-tab-link @(activeTab == "profile" ? "active" : "")" onclick="switchDashTab('adminProfileTab', this)">
                            <i class="bi bi-person-gear"></i>
                            <span>Admin Profile Settings</span>
                        </button>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dash-tab-link logout-btn">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Main Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="dash-main-card">
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm border-0" style="background-color: #d1fae5; color: #065f46;" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i> <strong>Success:</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm border-0" style="background-color: #fee2e2; color: #991b1b;" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <strong>Notice:</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- 1. MODULE: Executive KPI Overview Dashboard -->
                    <div id="adminOverviewTab" class="dash-tab-panel @(activeTab == "overview" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Platform Master Dashboard 🛡️</h3>
                                <p class="text-muted small mb-0">System-wide monitoring for Gujarat APMC market rates, Escrow settlements, and Farmer network.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="ExportOrdersCsv" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                    <i class="bi bi-download me-1"></i> Export Data
                                </a>
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold shadow-sm" onclick="window.print()">
                                    <i class="bi bi-printer me-1"></i> Print Summary
                                </button>
                            </div>
                        </div>

                        <!-- 4 Financial & Operational Hero Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card border-success border-opacity-25">
                                    <div class="dash-metric-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-currency-rupee"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num text-success">₹@totalRevenue.ToString("N2")</div>
                                        <div class="dash-metric-label">Gross Platform Sales</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card border-primary border-opacity-25">
                                    <div class="dash-metric-icon bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num text-primary">₹@escrowBalance.ToString("N2")</div>
                                        <div class="dash-metric-label">Escrow Vault Balance</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card border-warning border-opacity-25">
                                    <div class="dash-metric-icon bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-bank2"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num text-dark">₹@releasedPayouts.ToString("N2")</div>
                                        <div class="dash-metric-label">Released to Farmers</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="dash-metric-card border-info border-opacity-25">
                                    <div class="dash-metric-icon bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="dash-metric-num text-dark">@deliveredCount <span class="text-muted fs-6 fw-normal">/ @Model.Count()</span></div>
                                        <div class="dash-metric-label">Completed Orders</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4 Network Metrics Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-light rounded-4 border text-center">
                                    <span class="fs-4 fw-extrabold text-dark d-block">@totalUsers</span>
                                    <span class="text-muted small fw-bold" style="font-size: 0.76rem;">Total Platform Users</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25 text-center">
                                    <span class="fs-4 fw-extrabold text-success d-block">@totalFarmers</span>
                                    <span class="text-success small fw-bold" style="font-size: 0.76rem;">Registered Farmers</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 @(pendingKycCount > 0 ? "bg-warning bg-opacity-10 border-warning border-opacity-50" : "bg-light") rounded-4 border text-center">
                                    <span class="fs-4 fw-extrabold text-warning d-block">@pendingKycCount</span>
                                    <span class="text-dark small fw-bold" style="font-size: 0.76rem;">Pending 7/12 KYC</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25 text-center">
                                    <span class="fs-4 fw-extrabold text-primary d-block">@totalCustomers</span>
                                    <span class="text-primary small fw-bold" style="font-size: 0.76rem;">Retail Buyers</span>
                                </div>
                            </div>
                        </div>

                        <!-- Live Status & Quick Launcher -->
                        <div class="row g-3 g-lg-4 mb-3">
                            <div class="col-lg-7">
                                <div class="p-4 rounded-4 border bg-light bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-shield-check text-success me-2"></i>Escrow Anti-Fraud Protection Status</h6>
                                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill">100% Active</span>
                                        </div>
                                        <p class="text-muted small mb-3">
                                            Buyer payments are held securely in the AgriAI Escrow Vault. Funds are only released to the Farmer upon Admin Bilty verification or Customer OTP verification.
                                        </p>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="badge bg-white text-dark border p-2"><i class="bi bi-truck me-1 text-primary"></i>In-Transit Cargo: <strong>@inTransitCount</strong></span>
                                            <span class="badge bg-white text-dark border p-2"><i class="bi bi-hourglass-split me-1 text-warning"></i>Farmer Acceptance Pending: <strong>@requestedCount</strong></span>
                                        </div>
                                    </div>
                                    <div class="pt-3">
                                        <button type="button" class="btn btn-sm btn-outline-success fw-bold rounded-pill" onclick="switchDashTab('adminEscrowTab', document.querySelectorAll('.dash-tab-link')[2])">
                                            Audit Escrow &amp; Bilty Payouts →
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="p-4 rounded-4 border bg-success bg-opacity-10 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-success text-white fw-bold mb-2">Live Agmarknet Sync</span>
                                        <h6 class="fw-bold text-dark mb-1">Gujarat APMC Market Mandi</h6>
                                        <p class="text-muted small mb-3">Rajkot, Gondal, Unjha, Surat &amp; Ahmedabad mandi benchmarks are active and synchronizing live.</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold w-100" onclick="switchDashTab('adminAiTab', document.querySelectorAll('.dash-tab-link')[5])">
                                        <i class="bi bi-cpu me-1"></i> View AI &amp; Mandi Analytics
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. MODULE: Farmer and User Directory -->
                    <div id="adminUsersTab" class="dash-tab-panel @(activeTab == "users" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Farmer and Users Directory</h3>
                                <p class="text-muted small mb-0">Manage registered farmers and retail customers, verify documents, bank payout accounts, and review profiles.</p>
                            </div>
                        </div>

                        <!-- Live Search and Role Filters -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-light p-2.5 rounded-4 border">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-dark text-white active shadow-sm" data-filter="all" onclick="filterUsersTable('all', this)">
                                    All Users (@allUsers.Count)
                                </button>
                                <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-success" data-filter="Farmer" onclick="filterUsersTable('Farmer', this)">
                                    <i class="bi bi-tree-fill me-1"></i> Farmers (@allUsers.Count(u => u.Role == "Farmer"))
                                </button>
                                <button type="button" class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold user-filter-btn btn-outline-primary" data-filter="Customer" onclick="filterUsersTable('Customer', this)">
                                    <i class="bi bi-bag-heart me-1"></i> Customers (@allUsers.Count(u => u.Role == "Customer"))
                                </button>
                            </div>
                            <div class="admin-search-input-box" style="max-width: 280px;">
                                <i class="bi bi-search admin-search-icon"></i>
                                <input type="text" id="dashUserSearchInput" class="admin-search-input" placeholder="Quick search users..." />
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0" id="dashUsersTable">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>User Profile</th>
                                        <th>Role</th>
                                        <th>KYC &amp; Bank Details</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!allUsers.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">No users registered yet.</td></tr>
                                    }
                                    @foreach (var user in allUsers)
                                    {
                                        var init = !string.IsNullOrEmpty(user.Username) ? user.Username.Substring(0, 1).ToUpper() : "U";
                                        <tr class="user-table-row dash-user-row" data-role="@user.Role" data-search="@user.FullName.ToLower() @user.Username.ToLower() @user.Email.ToLower() @(user.City ?? "").ToLower()">
                                            <td>
                                                <div class="d-flex align-items-center gap-2.5">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                                    {
                                                        <img src="@user.ProfilePicturePath" class="rounded-circle shadow-sm border border-2 border-success" style="width: 38px; height: 38px; object-fit: cover;" alt="@user.FullName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; font-size: 0.90rem; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                                            @init
                                                        </div>
                                                    }
                                                    <div>
                                                        <strong class="text-dark d-block small fw-bold">@user.FullName</strong>
                                                        <small class="text-muted" style="font-size: 0.72rem;">@@@user.Username • @user.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (user.Role == "Farmer")
                                                {
                                                    <span class="admin-badge-role-farmer"><i class="bi bi-tree-fill"></i> Farmer</span>
                                                }
                                                else
                                                {
                                                    <span class="admin-badge-role-customer"><i class="bi bi-bag-heart-fill"></i> Customer</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.Role == "Farmer")
                                                {
                                                    @if (!user.IsApprovedByAdmin)
                                                    {
                                                        <span class="admin-badge-kyc-pending"><i class="bi bi-clock-history"></i> Pending Review</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-badge-kyc-verified"><i class="bi bi-patch-check-fill"></i> KYC Verified</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(user.BankAccountNumber))
                                                    {
                                                        <div class="text-muted font-monospace mt-0.5" style="font-size: 0.72rem;">
                                                            @user.BankName: @user.BankAccountNumber
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small" style="font-size: 0.74rem;">— Retail Buyer —</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.IsBlocked)
                                                {
                                                    <span class="admin-status-dot-blocked"><i class="bi bi-slash-circle-fill"></i> Blocked</span>
                                                }
                                                else if (user.Role == "Farmer" && !user.IsApprovedByAdmin)
                                                {
                                                    <span class="admin-status-dot-review"><i class="bi bi-hourglass-split"></i> Under Review</span>
                                                }
                                                else
                                                {
                                                    <span class="admin-status-dot-active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-1.5 align-items-center">
                                                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" title="View Full Profile, KYC, Orders &amp; Details">
                                                        <i class="bi bi-eye"></i>
                                                        <span>Details</span>
                                                    </a>

                                                    <form asp-controller="Admin" asp-action="ToggleBlockUser" method="post" class="m-0 d-inline">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn-action-circle @(user.IsBlocked ? "text-success" : "btn-block-action")" title="@(user.IsBlocked ? "Unblock User" : "Block User")" onclick="return confirm('Change block status for @user.Email?');">
                                                            <i class="bi @(user.IsBlocked ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="m-0 d-inline" onsubmit="return confirm('Permanently delete user @user.Email? This cannot be undone.');">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn-action-circle btn-delete-action" title="Delete User">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 3. MODULE: Escrow & Bilty Payout Verification -->
                    <div id="adminEscrowTab" class="dash-tab-panel @(activeTab == "escrow" ? "active" : "")">
                        @{
                            var allEscrowOrders = Model.ToList();
                            var pendingEscrowOrders = allEscrowOrders.Where(o => !o.AdminApprovedPayout && !o.Status.Contains("Delivered") && !o.Status.Contains("Settled") && o.Status != "Cancelled" && o.Status != "Declined").ToList();
                            var settledEscrowOrders = allEscrowOrders.Where(o => o.AdminApprovedPayout || o.Status.Contains("Delivered") || o.Status.Contains("Settled")).ToList();
                            
                            decimal liveEscrowVaultBalance = pendingEscrowOrders.Sum(o => o.TotalAmount);
                            int liveAwaitingAuditCount = pendingEscrowOrders.Count;
                            decimal liveReleasedPayouts = settledEscrowOrders.Sum(o => o.TotalAmount);
                            decimal livePlatformFee = settledEscrowOrders.Sum(o => o.PlatformFee);
                            if (livePlatformFee == 0 && liveReleasedPayouts > 0)
                            {
                                livePlatformFee = liveReleasedPayouts * 0.02m;
                            }
                        }
                        
                        <!-- Header Banner -->
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">🛡️ Escrow Vault &amp; Bilty Payout Moderation</h3>
                                <p class="text-muted small mb-0">Full-cycle financial security: Inspect uploaded transport LR/Bilty proofs, audit bank accounts, and release escrow payouts to Gujarat farmers.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="EscrowStatement" class="btn btn-sm btn-danger rounded-pill px-3.5 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); border: none;">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                    <span>Download Escrow Statement (PDF)</span>
                                </a>
                            </div>
                        </div>

                        <!-- 4 Live Financial KPI Metric Cards with Real Database Values -->
                        <div class="row g-3 mb-4">
                            <div class="col-lg-3 col-sm-6">
                                <div class="admin-stat-card">
                                    <div class="admin-stat-icon-wrap" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.68rem;">Escrow Vault Balance</small>
                                        <h4 class="fw-extrabold text-primary mb-0 fs-5">₹@liveEscrowVaultBalance.ToString("N2")</h4>
                                        <small class="text-muted" style="font-size: 0.70rem;">Locked for active orders</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-sm-6">
                                <div class="admin-stat-card">
                                    <div class="admin-stat-icon-wrap" style="background: rgba(234, 179, 8, 0.15); color: #b45309;">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.68rem;">Awaiting Bilty Audit</small>
                                        <h4 class="fw-extrabold text-dark mb-0 fs-5">@liveAwaitingAuditCount Orders</h4>
                                        <small class="text-warning fw-bold" style="font-size: 0.70rem;">Dispatched in transit</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-sm-6">
                                <div class="admin-stat-card">
                                    <div class="admin-stat-icon-wrap" style="background: rgba(21, 128, 61, 0.12); color: #15803d;">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.68rem;">Released Farmer Payouts</small>
                                        <h4 class="fw-extrabold text-success mb-0 fs-5">₹@liveReleasedPayouts.ToString("N2")</h4>
                                        <small class="text-muted" style="font-size: 0.70rem;">Settled to Farmer Banks</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-sm-6">
                                <div class="admin-stat-card">
                                    <div class="admin-stat-icon-wrap" style="background: rgba(100, 116, 139, 0.12); color: #475569;">
                                        <i class="bi bi-percent"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.68rem;">Platform Escrow Fee</small>
                                        <h4 class="fw-extrabold text-dark mb-0 fs-5">₹@livePlatformFee.ToString("N2")</h4>
                                        <small class="text-muted" style="font-size: 0.70rem;">2.0% Fixed Fee Collected</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Escrow Orders Filter Pills & Live Search Bar with Proper Spacing -->
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
                            <!-- Filter Pill Buttons with Clear Margins and Non-colliding Classes -->
                            <div class="escrow-filter-pills-wrap" id="escrowFilterPills">
                                <button type="button" class="escrow-pill-btn active" onclick="filterEscrowTable('all', this)">
                                    <i class="bi bi-collection-fill"></i>
                                    <span>All Escrow Orders (@allEscrowOrders.Count)</span>
                                </button>
                                <button type="button" class="escrow-pill-btn" onclick="filterEscrowTable('pending', this)">
                                    <i class="bi bi-hourglass-split text-warning"></i>
                                    <span>Awaiting Payout (@liveAwaitingAuditCount)</span>
                                </button>
                                <button type="button" class="escrow-pill-btn" onclick="filterEscrowTable('settled', this)">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>Settled &amp; Paid (@settledEscrowOrders.Count)</span>
                                </button>
                            </div>

                            <!-- Live Search Input -->
                            <div class="position-relative" style="min-width: 320px;">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3.5 text-muted"></i>
                                <input type="text" id="escrowSearchInput" class="form-control rounded-pill ps-5 bg-white border shadow-xs" style="padding-top: 8.5px; padding-bottom: 8.5px;" placeholder="Search by Order #, Bilty LR, Farmer..." onkeyup="searchEscrowTable()" />
                            </div>
                        </div>

                        <!-- Rich Escrow Moderation Table -->
                        <div class="table-responsive bg-white rounded-4 border shadow-xs mb-4">
                            <table class="table table-hover align-middle mb-0" id="escrowModerationTable">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th class="ps-3.5">Order &amp; Date</th>
                                        <th>Farmer (Bank Destination)</th>
                                        <th>Gross Value</th>
                                        <th>Bilty / LR Proof</th>
                                        <th>Escrow State</th>
                                        <th class="text-end pe-3.5">Moderation Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!allEscrowOrders.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-5">
                                                <i class="bi bi-shield-check display-5 d-block mb-2 text-success opacity-50"></i>
                                                <p class="mb-0 fw-semibold">No escrow orders found in the system.</p>
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var order in allEscrowOrders)
                                    {
                                        var firstProd = order.OrderItems.FirstOrDefault()?.Product;
                                        var farmerUser = allUsers.FirstOrDefault(u => u.Role == "Farmer" && (firstProd == null || u.Id == firstProd.FarmerId)) 
                                                         ?? allUsers.FirstOrDefault(u => u.Role == "Farmer");
                                        var fName = farmerUser != null ? farmerUser.FullName : "Verified Farmer";
                                        var fBank = !string.IsNullOrEmpty(farmerUser?.BankName) ? farmerUser.BankName : "Bank of Baroda";
                                        var fAcc = !string.IsNullOrEmpty(farmerUser?.BankAccountNumber) ? farmerUser.BankAccountNumber : "45982145987";
                                        var fIfsc = !string.IsNullOrEmpty(farmerUser?.BankIfscCode) ? farmerUser.BankIfscCode : "BARB0RAJKOT";
                                        
                                        bool isSettled = order.Status.Contains("Delivered") || order.Status.Contains("Settled") || order.AdminApprovedPayout;
                                        bool hasBilty = !string.IsNullOrEmpty(order.BiltyImageUrl);
                                        bool isPendingPayout = !isSettled && (order.Status == "In Transit" || order.Status == "Ready for Pickup" || order.Status == "Accepted" || hasBilty);
                                        string rowFilterType = isSettled ? "settled" : (isPendingPayout ? "pending" : "all");

                                        <tr class="escrow-order-row" data-filter-type="@rowFilterType" data-search-text="#@order.Id.ToString("D5") @fName @fBank @(order.BiltyNumber ?? "") @(order.CargoServiceName ?? "")">
                                            <!-- Order ID & Date -->
                                            <td class="ps-3.5">
                                                <a asp-action="OrderDetails" asp-route-id="@order.Id" asp-route-from="escrow" class="text-decoration-none fw-bold text-dark d-block">
                                                    #@order.Id.ToString("D5")
                                                </a>
                                                <small class="text-muted" style="font-size: 0.72rem;">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                                            </td>

                                            <!-- Farmer & Bank Account Details -->
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center fw-bold small" style="width: 32px; height: 32px; font-size: 0.80rem;">
                                                        @(!string.IsNullOrEmpty(fName) ? fName.Substring(0, 1).ToUpper() : "F")
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block" style="font-size: 0.82rem;">@fName</strong>
                                                        <small class="text-muted font-monospace d-block" style="font-size: 0.70rem;">
                                                            <i class="bi bi-bank me-1 text-success"></i>@fBank &bull; A/C: @(fAcc.Length > 4 ? "..." + fAcc.Substring(fAcc.Length - 4) : fAcc)
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Gross Amount & Split -->
                                            <td>
                                                <span class="fw-extrabold text-success fs-6 d-block">₹@order.TotalAmount.ToString("N2")</span>
                                                <small class="text-muted d-block" style="font-size: 0.70rem;">
                                                    Net: ₹@((order.TotalAmount - order.PlatformFee - order.LogisticsFee).ToString("N2"))
                                                </small>
                                            </td>

                                            <!-- Bilty / Transport Proof -->
                                            <td>
                                                @if (hasBilty)
                                                {
                                                    <div class="d-flex align-items-center gap-1.5">
                                                        <a href="@order.BiltyImageUrl" target="_blank" class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-decoration-none fw-bold rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                            <i class="bi bi-file-earmark-image"></i> #@(string.IsNullOrEmpty(order.BiltyNumber) ? "LR Receipt" : order.BiltyNumber)
                                                        </a>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(order.CargoServiceName))
                                                    {
                                                        <small class="text-muted d-block mt-0.5" style="font-size: 0.70rem;">
                                                            <i class="bi bi-truck me-1"></i>@order.CargoServiceName
                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.70rem;">Direct Pickup / No Bilty</span>
                                                }
                                            </td>

                                            <!-- Escrow State Badge -->
                                            <td>
                                                @if (isSettled)
                                                {
                                                    <span class="badge bg-success rounded-pill px-2.5 py-1 fw-bold" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%) !important; font-size: 0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Settled &amp; Paid 🟢
                                                    </span>
                                                }
                                                else if (order.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-truck me-1"></i>In Transit (Locked)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-clock-history me-1"></i>@order.Status
                                                    </span>
                                                }
                                            </td>

                                            <!-- Moderation Action Button -->
                                            <td class="text-end pe-3.5">
                                                @if (order.Status == "In Transit" && !isSettled)
                                                {
                                                    <form asp-controller="Admin" asp-action="ReleaseEscrowPayoutViaBilty" method="post" class="d-inline" onsubmit="return confirm('Confirm release of ₹@order.TotalAmount to @fName bank account (@fBank)?');">
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <button type="submit" class="btn btn-xs btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%); border: none; font-size: 0.78rem;">
                                                            <i class="bi bi-shield-check me-1"></i> Release Payout
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@order.Id" asp-route-from="escrow" class="btn btn-xs btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold shadow-xs" style="font-size: 0.78rem;">
                                                        <i class="bi bi-shield-shaded me-1 text-primary"></i> Audit
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <!-- 4. MODULE: Listed Crops & Categories Oversight -->
                    <div id="adminProductsTab" class="dash-tab-panel @(activeTab == "products" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">All Listed Farm Produce &amp; Categories</h3>
                                <p class="text-muted small mb-0">Monitor crop inventory listed across Gujarat by verified farmers and manage category taxonomy.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Category" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                    <i class="bi bi-grid-fill me-1"></i> Manage Categories
                                </a>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-dark rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                    <i class="bi bi-shop me-1"></i> Public Market
                                </a>
                            </div>
                        </div>

                        @if (allProducts.Any())
                        {
                            var soldQuantities = ViewBag.SoldQuantities as Dictionary<int, int> ?? new Dictionary<int, int>();
                            <div class="table-responsive">
                                <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th>Produce Name</th>
                                            <th>Category</th>
                                            <th>Direct Price (₹)</th>
                                            <th>Stock Breakdown (Published / Sold / Balance)</th>
                                            <th>Farmer Identity</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prod in allProducts)
                                        {
                                            var soldQty = soldQuantities.ContainsKey(prod.Id) ? soldQuantities[prod.Id] : 0;
                                            var totalPublished = prod.StockQuantity + soldQty;
                                            <tr>
                                                <td>
                                                    <strong class="text-dark d-block">@prod.Name</strong>
                                                    <small class="text-muted font-monospace" style="font-size: 0.70rem;">ID: #@prod.Id.ToString("D4")</small>
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@(prod.Category?.Name ?? "General Produce")</span></td>
                                                <td class="fw-bold text-success fs-6">₹@prod.Price.ToString("N2")</td>
                                                <td>
                                                    <div class="d-flex flex-column gap-1" style="min-width: 180px;">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <small class="text-muted" style="font-size: 0.72rem;">Total Published:</small>
                                                            <strong class="text-dark font-monospace" style="font-size: 0.76rem;">@totalPublished Kg</strong>
                                                        </div>
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <small class="text-muted" style="font-size: 0.72rem;">Sold / Delivered:</small>
                                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold" style="font-size: 0.70rem;">@soldQty Kg</span>
                                                        </div>
                                                        <div class="d-flex align-items-center justify-content-between pt-1 border-top">
                                                            <small class="fw-bold text-dark" style="font-size: 0.72rem;">Available In Stock:</small>
                                                            <span class="badge @(prod.StockQuantity > 0 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25") fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.72rem;">
                                                                @prod.StockQuantity Kg
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="small text-muted" title="@prod.FarmerId">
                                                    <span class="badge bg-light text-dark border font-monospace">
                                                        @prod.FarmerId.Substring(0, Math.Min(10, prod.FarmerId.Length))...
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex align-items-center gap-1.5">
                                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="View Details">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Edit Crop">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light rounded-4 border my-3">
                                <i class="bi bi-basket display-4 text-muted opacity-50 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark mb-2">No farm produce listed yet</h5>
                                <p class="text-muted small mb-0">When farmers list their harvests, they will appear in this administrative catalogue.</p>
                            </div>
                        }
                    </div>

                    <!-- 5. MODULE: Orders & Transaction Feed -->
                    <div id="adminOrdersTab" class="dash-tab-panel @(activeTab == "orders" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">Transactions &amp; Order Feed</h3>
                                <p class="text-muted small mb-0">Master record of all purchases between retail buyers and farmers.</p>
                            </div>
                            <a asp-action="ExportOrdersCsv" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                <i class="bi bi-download me-1"></i> Export Orders CSV
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border rounded-4 overflow-hidden mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Order Date</th>
                                        <th>Gross Amount</th>
                                        <th>Status</th>
                                        <th>Customer ID</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">No customer orders recorded in system yet.</td></tr>
                                    }
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><strong>#@order.Id.ToString("D5")</strong></td>
                                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                            <td class="fw-bold text-success">₹@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @if (order.Status == "Requested")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold">Requested ⏳</span>
                                                }
                                                else if (order.Status == "Accepted")
                                                {
                                                    <span class="badge bg-info text-dark fw-bold">Accepted (Review Window)</span>
                                                }
                                                else if (order.Status == "In Transit")
                                                {
                                                    <span class="badge bg-primary text-white fw-bold">In Transit 🚚</span>
                                                }
                                                else if (order.Status.Contains("Delivered") || order.Status.Contains("Settled"))
                                                {
                                                    <span class="badge bg-success text-white fw-bold">Delivered &amp; Settled 🟢</span>
                                                }
                                                else if (order.Status == "Declined" || order.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger text-white fw-bold">@order.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white">@order.Status</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@order.CustomerId</td>
                                            <td class="text-end">
                                                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold">
                                                    <i class="bi bi-eye-fill me-1"></i> View Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 6. MODULE: AI & APMC Market Intelligence -->
                    <div id="adminAiTab" class="dash-tab-panel @(activeTab == "ai" ? "active" : "")">
                        <div class="dash-section-header">
                            <div>
                                <h3 class="dash-section-title">AI Engine &amp; Gujarat Mandi Intelligence 🤖</h3>
                                <p class="text-muted small mb-0">Real-time market analytics, crop demand trends, and AI prediction models.</p>
                            </div>
                            <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm">
                                <i class="bi bi-broadcast me-1"></i> Live Mandi Board
                            </a>
                        </div>

                        <!-- Gujarat Mandi Benchmark Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">🌾 Wheat (Tukdi)</span>
                                        <span class="badge bg-success text-white">Rajkot APMC</span>
                                    </div>
                                    <div class="fs-5 fw-extrabold text-success">₹2,480 - ₹2,750 <small class="text-muted fs-6">/ Qtl</small></div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Demand: High • Trend: Bullish 📈</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">☁️ Cotton (Kapas)</span>
                                        <span class="badge bg-success text-white">Gondal APMC</span>
                                    </div>
                                    <div class="fs-5 fw-extrabold text-success">₹7,200 - ₹7,850 <small class="text-muted fs-6">/ Qtl</small></div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Demand: Moderate • Trend: Stable</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark">🌿 Cumin (Jeera)</span>
                                        <span class="badge bg-success text-white">Unjha APMC</span>
                                    </div>
                                    <div class="fs-5 fw-extrabold text-success">₹24,500 - ₹28,000 <small class="text-muted fs-6">/ Qtl</small></div>
                                    <small class="text-muted" style="font-size: 0.72rem;">Demand: Very High • Trend: Bullish 📈</small>
                                </div>
                            </div>
                        </div>

                        <!-- 3 AI Predictor Engines Launchpad -->
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3.5 bg-white rounded-4 border shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                            <i class="bi bi-flower1"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Crop Recommendation</h6>
                                        <p class="text-muted small mb-3">AI algorithm evaluating Soil NPK, Rainfall &amp; Temperature for Gujarat districts.</p>
                                    </div>
                                    <a asp-controller="AI" asp-action="CropPredictor" class="btn btn-sm btn-outline-success rounded-pill fw-bold w-100">Test Crop AI</a>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3.5 bg-white rounded-4 border shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                            <i class="bi bi-shield-virus"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Leaf Disease Detection</h6>
                                        <p class="text-muted small mb-3">Computer Vision CNN model for instant leaf pathology diagnosis.</p>
                                    </div>
                                    <a asp-controller="AI" asp-action="DiseasePredict" class="btn btn-sm btn-outline-danger rounded-pill fw-bold w-100">Test Disease AI</a>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3.5 bg-white rounded-4 border shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                            <i class="bi bi-graph-up-arrow"></i>
                                        </div>
