@model IEnumerable<AgriAI.Web.ViewModels.UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
    string currentFilter = ViewBag.CurrentFilter as string ?? "All";
}

<div class="container-fluid py-4 px-lg-4 px-md-3" style="max-width: 1440px; min-height: calc(100vh - 180px);">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-success me-2"></i>User &amp; Farmer Management</h2>
            <p class="text-muted small mb-0">Manage registered Farmers and Customers (Verify 7/12 KYC / Block / Delete).</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3.5 py-1.5 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-4 border-0" style="background-color: #d1fae5; color: #065f46;" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i> <strong>Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-4 border-0" style="background-color: #fee2e2; color: #991b1b;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <strong>Notice:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Role Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-3 shadow-sm border">
    <li class="nav-item">
        <a asp-action="Users" asp-route-roleFilter="All" class="nav-link rounded-pill @(currentFilter == "All" ? "active bg-success" : "text-dark")">
            All Users (@Model.Count())
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Users" asp-route-roleFilter="Farmer" class="nav-link rounded-pill @(currentFilter == "Farmer" ? "active bg-success" : "text-dark")">
            <i class="bi bi-person-workspace me-1"></i> Farmers (@Model.Count(u => u.Role == "Farmer"))
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Users" asp-route-roleFilter="Customer" class="nav-link rounded-pill @(currentFilter == "Customer" ? "active bg-success" : "text-dark")">
            <i class="bi bi-bag-heart me-1"></i> Customers (@Model.Count(u => u.Role == "Customer"))
        </a>
    </li>
</ul>

<div class="bg-white rounded-4 shadow-sm border overflow-hidden p-0 mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                <tr>
                    <th class="ps-4 py-3">User</th>
                    <th class="py-3">Role</th>
                    <th class="py-3">Email Address</th>
                    <th class="py-3">KYC &amp; Bank Details</th>
                    <th class="py-3">Account Status</th>
                    <th class="text-end pe-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-people display-4 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0 fw-semibold">No registered users found under this category.</p>
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <!-- User Column (Avatar + Name + Location) -->
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                {
                                    <img src="@user.ProfilePicturePath" class="rounded-circle border border-2 border-success shadow-sm" style="width: 44px; height: 44px; object-fit: cover;" alt="@user.FullName" />
                                }
                                else
                                {
                                    <div class="avatar-circle text-white fw-bold rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <small class="text-muted d-block">@@@user.Username</small>
                                    @if (!string.IsNullOrEmpty(user.City))
                                    {
                                        <span class="badge bg-light text-secondary border mt-0.5" style="font-size: 0.68rem;">
                                            <i class="bi bi-geo-alt me-1"></i>@user.City
                                        </span>
                                    }
                                </div>
                            </div>
                        </td>

                        <!-- Role Column -->
                        <td class="py-3">
                            @if (user.Role == "Farmer")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill fw-bold">
                                    <i class="bi bi-tree-fill me-1"></i> Farmer
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1.5 rounded-pill fw-bold">
                                    <i class="bi bi-person-fill me-1"></i> Customer
                                </span>
                            }
                        </td>

                        <!-- Email Column -->
                        <td class="py-3">
                            <span class="text-dark fw-semibold small">@user.Email</span>
                            <small class="text-muted d-block" style="font-size: 0.72rem;">Joined: @user.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </td>

                        <!-- KYC & Bank Details Column -->
                        <td class="py-3">
                            @if (user.Role == "Farmer")
                            {
                                @if (!user.IsApprovedByAdmin)
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-bold mb-1 d-inline-block">
                                        <i class="bi bi-clock-history me-1"></i> Pending Review
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill fw-bold mb-1 d-inline-block">
                                        <i class="bi bi-patch-check-fill me-1"></i> KYC Verified
                                    </span>
                                }

                                @if (!string.IsNullOrEmpty(user.BankAccountNumber))
                                {
                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                        <i class="bi bi-bank text-secondary me-1"></i>@user.BankName: <span class="font-monospace text-dark fw-bold">@user.BankAccountNumber</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.KycDocumentPath))
                                {
                                    <a href="@user.KycDocumentPath" target="_blank" class="text-decoration-none small text-primary fw-semibold d-inline-block mt-0.5" style="font-size: 0.73rem;">
                                        <i class="bi bi-file-earmark-text me-1"></i>View @(user.KycDocumentType ?? "7/12 Document")
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">N/A (Retail Buyer)</span>
                            }
                        </td>

                        <!-- Account Status Column -->
                        <td class="py-3">
                            @if (user.IsBlocked)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold"><i class="bi bi-slash-circle me-1"></i> Blocked</span>
                            }
                            else if (user.Role == "Farmer" && !user.IsApprovedByAdmin)
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-bold"><i class="bi bi-hourglass-split me-1"></i> Under Review</span>
                            }
                            else
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold"><i class="bi bi-check-circle me-1"></i> Active</span>
                            }
                        </td>

                        <!-- Actions Column -->
                        <td class="text-end pe-4 py-3">
                            <div class="d-inline-flex gap-2 align-items-center">
                                @if (user.Role == "Farmer")
                                {
                                    <!-- Review KYC Inspector Modal Button -->
                                    <button type="button" class="btn btn-sm @(user.IsApprovedByAdmin ? "btn-outline-success" : "btn-success") rounded-pill px-3 py-1.5 fw-bold shadow-sm" 
                                            onclick="openKycReviewModal('@user.Id', '@user.FullName', '@user.Email', '@(user.City ?? "")', '@(user.Address ?? "")', '@(user.BankName ?? "")', '@(user.BankAccountNumber ?? "")', '@(user.BankIfscCode ?? "")', '@(user.UpiId ?? "")', '@(user.KycDocumentType ?? "7/12 (Satbara)")', '@(user.KycDocumentPath ?? "")', @(user.IsApprovedByAdmin ? "true" : "false"), '@(user.KycRejectionReason ?? "")', '@(user.ProfilePicturePath ?? "")')"
                                            title="Inspect Document &amp; Bank KYC">
                                        <i class="bi bi-shield-check me-1"></i>@(user.IsApprovedByAdmin ? "KYC Details" : "Review KYC")
                                    </button>
                                }

                                <!-- Block / Unblock Button -->
                                <form asp-action="ToggleBlockUser" method="post" class="d-inline m-0">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    @if (user.IsBlocked)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-circle shadow-sm" style="width: 34px; height: 34px; padding: 0;" title="Unblock User" onclick="return confirm('Are you sure you want to UNBLOCK this user?');">
                                            <i class="bi bi-unlock-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-circle shadow-sm" style="width: 34px; height: 34px; padding: 0;" title="Block User" onclick="return confirm('Are you sure you want to BLOCK this user?');">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>
                                    }
                                </form>

                                <!-- Delete Button -->
                                <form asp-action="DeleteUser" method="post" class="d-inline m-0">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle shadow-sm" style="width: 34px; height: 34px; padding: 0;" title="Delete User" onclick="return confirm('Are you sure you want to PERMANENTLY DELETE user @user.Email? This action cannot be undone.');">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<!-- Farmer KYC Review Inspector Modal -->
<div class="modal fade" id="kycReviewModal" tabindex="-1" aria-labelledby="kycReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3.5 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="kycReviewModalLabel">Farmer KYC &amp; Anti-Fraud Inspector</h5>
                        <small class="text-light opacity-75">Verify 7/12 (Satbara) &amp; Bank Payout Details</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Left: Document Preview -->
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 bg-light text-center h-100 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border fw-bold px-3 py-1.5 rounded-pill mb-2" id="kycDocTypeBadge">
                                    7/12 (Satbara)
                                </span>
                                <h6 class="fw-bold text-dark mb-2">Uploaded Document Proof</h6>
                            </div>
                            
                            <div class="my-3 d-flex align-items-center justify-content-center overflow-hidden rounded-3 border bg-white" style="min-height: 240px; max-height: 320px;">
                                <img id="kycDocImg" src="" class="img-fluid rounded" alt="KYC Document" style="max-height: 300px; object-fit: contain; display: none;" />
                                <iframe id="kycDocPdf" src="" class="w-100" style="height: 300px; border: none; display: none;"></iframe>
                                <div id="kycNoDoc" class="text-muted p-4">
                                    <i class="bi bi-file-earmark-x display-4 text-secondary opacity-50 d-block mb-2"></i>
                                    <p class="small mb-0">No document uploaded yet</p>
                                </div>
                            </div>

                            <a id="kycDocFullLink" href="#" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill w-100 fw-bold">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Open Original Document
                            </a>
                        </div>
                    </div>

                    <!-- Right: Farmer & Bank Verification Details -->
                    <div class="col-md-6">
                        <div class="h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
                                    <img id="kycFarmerAvatar" src="" class="rounded-circle border border-2 border-success shadow-sm" style="width: 54px; height: 54px; object-fit: cover;" alt="Farmer Face Photo" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-6" id="kycFarmerName"></h6>
                                        <small class="text-muted d-block" id="kycFarmerEmail"></small>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-0.5 rounded-pill" style="font-size: 0.70rem;">
                                            <i class="bi bi-person-check-fill me-1"></i> Registered Farmer
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted d-block">Farm Location</small>
                                    <span class="fw-semibold text-dark" id="kycFarmerLocation"></span>
                                </div>

                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Bank Account &amp; UPI Details</h6>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <small class="text-muted d-block">Bank Name</small>
                                        <span class="fw-bold text-dark" id="kycBankName"></span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Account Number</small>
                                        <span class="fw-bold text-success font-monospace" id="kycBankAcc"></span>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <small class="text-muted d-block">IFSC Code</small>
                                        <span class="fw-bold text-dark font-monospace" id="kycBankIfsc"></span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">UPI ID</small>
                                        <span class="fw-semibold text-dark font-monospace" id="kycUpiId"></span>
                                    </div>
                                </div>

                                <div id="kycRejectionAlert" class="alert alert-danger p-2.5 rounded-3 small mb-2 d-none">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Rejection Reason:</strong> <span id="kycRejectionMsg"></span>
                                </div>
                            </div>

                            <!-- Approval / Rejection Action Controls -->
                            <div class="border-top pt-3">
                                <div class="d-flex gap-2 mb-2">
                                    <form asp-action="ApproveFarmer" method="post" class="flex-grow-1">
                                        <input type="hidden" name="id" id="kycApproveUserId" value="" />
                                        <button type="submit" class="btn btn-success rounded-pill fw-bold w-100 py-2 shadow-sm" style="background-color: #006653; border-color: #006653;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approve &amp; Activate Farmer
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 fw-bold" onclick="toggleRejectBox()">
                                        <i class="bi bi-x-circle me-1"></i> Reject
                                    </button>
                                </div>

                                <!-- Collapsible Reject with Reason Form -->
                                <div id="rejectReasonBox" class="mt-2 p-3 bg-light rounded-3 border" style="display: none;">
                                    <form asp-action="RejectFarmer" method="post">
                                        <input type="hidden" name="id" id="kycRejectUserId" value="" />
                                        <label class="form-label small fw-bold text-danger mb-1">State Reason for Rejection:</label>
                                        <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. 7/12 document photo is blurred / Name does not match bank account..." required></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleRejectBox()">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Submit Rejection</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openKycReviewModal(id, name, email, city, address, bankName, bankAcc, bankIfsc, upi, docType, docPath, isApproved, rejectionReason, profilePic) {
            document.getElementById('kycApproveUserId').value = id;
            document.getElementById('kycRejectUserId').value = id;
            document.getElementById('kycFarmerName').textContent = name || 'N/A';
            document.getElementById('kycFarmerEmail').textContent = email || 'N/A';
            document.getElementById('kycFarmerLocation').textContent = (address ? address + ', ' : '') + (city || 'Gujarat');
            document.getElementById('kycBankName').textContent = bankName || 'Not Provided';
            document.getElementById('kycBankAcc').textContent = bankAcc || 'Not Provided';
            document.getElementById('kycBankIfsc').textContent = bankIfsc || 'Not Provided';
            document.getElementById('kycUpiId').textContent = upi || 'None';
            document.getElementById('kycDocTypeBadge').textContent = docType || '7/12 (Satbara)';

            const avatarImg = document.getElementById('kycFarmerAvatar');
            if (profilePic && profilePic.trim() !== '') {
                avatarImg.src = profilePic;
            } else {
                avatarImg.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name || 'Farmer') + '&background=15803d&color=fff&size=128';
            }

            const docImg = document.getElementById('kycDocImg');
            const docPdf = document.getElementById('kycDocPdf');
            const noDoc = document.getElementById('kycNoDoc');
            const fullLink = document.getElementById('kycDocFullLink');

            docImg.style.display = 'none';
            docPdf.style.display = 'none';
            noDoc.style.display = 'none';

            if (docPath && docPath.trim() !== '') {
                fullLink.href = docPath;
                fullLink.style.display = 'block';
                if (docPath.toLowerCase().endsWith('.pdf')) {
                    docPdf.src = docPath;
                    docPdf.style.display = 'block';
                } else {
                    docImg.src = docPath;
                    docImg.style.display = 'block';
                }
            } else {
                noDoc.style.display = 'block';
                fullLink.style.display = 'none';
            }

            const rejAlert = document.getElementById('kycRejectionAlert');
            const rejMsg = document.getElementById('kycRejectionMsg');
            if (rejectionReason && rejectionReason.trim() !== '') {
                rejMsg.textContent = rejectionReason;
                rejAlert.classList.remove('d-none');
            } else {
                rejAlert.classList.add('d-none');
            }

            document.getElementById('rejectReasonBox').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('kycReviewModal'));
            modal.show();
        }

        function toggleRejectBox() {
            const box = document.getElementById('rejectReasonBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        // Auto-dismiss alert banners smoothly after 3.5 seconds
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    alert.style.transition = 'opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease';
                    alert.style.opacity = '0';
                    alert.style.maxHeight = '0';
                    alert.style.margin = '0';
                    alert.style.padding = '0';
                    alert.style.overflow = 'hidden';
                    setTimeout(function () {
                        alert.remove();
                    }, 600);
                }, 3500);
            });
        });
    </script>
}
