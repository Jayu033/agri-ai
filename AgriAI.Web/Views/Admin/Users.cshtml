@model IEnumerable<AgriAI.Web.ViewModels.UserManagementViewModel>

@{
    ViewData["Title"] = "User & Farmer Directory";
    string currentFilter = ViewBag.CurrentFilter as string ?? "All";

    int totalUsers = Model.Count();
    int farmersCount = Model.Count(u => u.Role == "Farmer");
    int pendingKycCount = Model.Count(u => u.Role == "Farmer" && !u.IsApprovedByAdmin);
    int customersCount = Model.Count(u => u.Role == "Customer");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
}

<div class="container-fluid py-4 px-lg-4 px-md-3" style="max-width: 1440px; min-height: calc(100vh - 180px);">
    
    <!-- Top Header Banner -->
    <div class="admin-header-card d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px; background: linear-gradient(135deg, #15803d 0%, #22c55e 100%); color: #ffffff; font-size: 1.6rem;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark mb-0 fs-4">User &amp; Farmer Management</h2>
                <p class="text-muted small mb-0 mt-0.5">Verify 7/12 Satbara KYC, audit farmer payout accounts, and manage platform access.</p>
            </div>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-success bg-white rounded-pill px-4 py-2 fw-bold small shadow-sm d-inline-flex align-items-center gap-2" style="border-color: rgba(22, 101, 52, 0.3);">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Top Statistics Overview Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="admin-stat-card">
                <div class="admin-stat-icon" style="background: #f1f5f9; color: #475569;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="fs-4 fw-extrabold text-dark line-height-1">@totalUsers</div>
                    <span class="text-muted small" style="font-size: 0.78rem;">Total Accounts</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="admin-stat-card">
                <div class="admin-stat-icon" style="background: #dcfce7; color: #166534;">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <div>
                    <div class="fs-4 fw-extrabold text-success line-height-1">@farmersCount</div>
                    <span class="text-muted small" style="font-size: 0.78rem;">Registered Farmers</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="admin-stat-card">
                <div class="admin-stat-icon" style="background: #fef3c7; color: #d97706;">
                    <i class="bi bi-shield-exclamation"></i>
                </div>
                <div>
                    <div class="fs-4 fw-extrabold text-warning line-height-1">@pendingKycCount</div>
                    <span class="text-muted small" style="font-size: 0.78rem;">Pending 7/12 KYC</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="admin-stat-card">
                <div class="admin-stat-icon" style="background: #eff6ff; color: #1e40af;">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <div>
                    <div class="fs-4 fw-extrabold text-primary line-height-1">@customersCount</div>
                    <span class="text-muted small" style="font-size: 0.78rem;">Retail Buyers</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Pills & Live Search Toolbar -->
    <div class="bg-white p-3 rounded-4 shadow-sm border mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <!-- Role Filter Tabs -->
        <ul class="nav nav-pills gap-2 m-0">
            <li class="nav-item">
                <a asp-action="Users" asp-route-roleFilter="All" class="nav-link rounded-pill py-1.5 px-3.5 small fw-bold @(currentFilter == "All" ? "active bg-success text-white" : "text-muted bg-light")">
                    All Users (@totalUsers)
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Users" asp-route-roleFilter="Farmer" class="nav-link rounded-pill py-1.5 px-3.5 small fw-bold @(currentFilter == "Farmer" ? "active bg-success text-white" : "text-muted bg-light")">
                    <i class="bi bi-tree-fill me-1"></i> Farmers (@farmersCount)
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Users" asp-route-roleFilter="Customer" class="nav-link rounded-pill py-1.5 px-3.5 small fw-bold @(currentFilter == "Customer" ? "active bg-success text-white" : "text-muted bg-light")">
                    <i class="bi bi-bag-heart me-1"></i> Customers (@customersCount)
                </a>
            </li>
        </ul>

        <!-- Live Instant Search Box -->
        <div class="admin-search-input-box">
            <i class="bi bi-search admin-search-icon"></i>
            <input type="text" id="adminUserSearchInput" class="admin-search-input" placeholder="Search by name, email, village or username..." />
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="admin-table-container mb-5">
        <div class="table-responsive">
            <table class="table admin-users-table align-middle" id="adminUsersTable">
                <thead>
                    <tr>
                        <th class="ps-4">User Profile</th>
                        <th>Role</th>
                        <th>Email &amp; Joined</th>
                        <th>KYC &amp; Bank Details</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr id="emptyUsersRow">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-people display-4 d-block mb-2 text-secondary opacity-50"></i>
                                <p class="mb-0 fw-semibold">No registered users found under this category.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model)
                    {
                        <tr class="user-data-row" data-search="@user.FullName.ToLower() @user.Username.ToLower() @user.Email.ToLower() @(user.City ?? "").ToLower() @(user.Role.ToLower())">
                            <!-- User Column (Avatar + Name + Location) -->
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar-wrapper">
                                        @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                        {
                                            <img src="@user.ProfilePicturePath" class="user-avatar-img" alt="@user.FullName" />
                                        }
                                        else
                                        {
                                            <div class="user-avatar-fallback">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <div class="user-name-text">@user.FullName</div>
                                        <div class="user-username-tag">@@@user.Username</div>
                                        @if (!string.IsNullOrEmpty(user.City))
                                        {
                                            <div class="user-location-pill">
                                                <i class="bi bi-geo-alt-fill text-success" style="font-size: 0.65rem;"></i>
                                                <span>@user.City</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <!-- Role Column -->
                            <td>
                                @if (user.Role == "Farmer")
                                {
                                    <span class="admin-badge-role-farmer">
                                        <i class="bi bi-tree-fill"></i> Farmer
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge-role-customer">
                                        <i class="bi bi-bag-heart-fill"></i> Customer
                                    </span>
                                }
                            </td>

                            <!-- Email Column -->
                            <td>
                                <a href="mailto:@user.Email" class="text-dark fw-semibold small text-decoration-none d-block">
                                    @user.Email
                                </a>
                                <span class="text-muted d-block" style="font-size: 0.72rem;">
                                    <i class="bi bi-calendar3 me-1"></i>Joined @user.CreatedAt.ToString("MMM dd, yyyy")
                                </span>
                            </td>

                            <!-- KYC & Bank Details Column -->
                            <td>
                                @if (user.Role == "Farmer")
                                {
                                    <div class="mb-1">
                                        @if (!user.IsApprovedByAdmin)
                                        {
                                            <span class="admin-badge-kyc-pending">
                                                <i class="bi bi-clock-history"></i> Pending 7/12 Review
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge-kyc-verified">
                                                <i class="bi bi-patch-check-fill"></i> KYC Verified
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(user.BankAccountNumber))
                                    {
                                        <div class="small text-muted d-flex align-items-center gap-1.5" style="font-size: 0.74rem;">
                                            <i class="bi bi-bank text-success"></i>
                                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(user.BankName) ? "Bank" : user.BankName)</span>: 
                                            <span class="font-monospace fw-bold text-dark">@user.BankAccountNumber</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(user.KycDocumentPath))
                                    {
                                        <a href="@user.KycDocumentPath" target="_blank" class="text-decoration-none small text-success fw-bold d-inline-flex align-items-center gap-1 mt-1" style="font-size: 0.74rem;">
                                            <i class="bi bi-file-earmark-check-fill"></i> View @(user.KycDocumentType ?? "7/12 Satbara Proof")
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small" style="font-size: 0.75rem;">— Retail Buyer —</span>
                                }
                            </td>

                            <!-- Account Status Column -->
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="admin-status-dot-blocked">
                                        <i class="bi bi-slash-circle-fill"></i> Blocked
                                    </span>
                                }
                                else if (user.Role == "Farmer" && !user.IsApprovedByAdmin)
                                {
                                    <span class="admin-status-dot-review">
                                        <i class="bi bi-hourglass-split"></i> Under Review
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-status-dot-active">
                                        <i class="bi bi-check-circle-fill"></i> Active
                                    </span>
                                }
                            </td>

                            <!-- Actions Column -->
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2 align-items-center">
                                    @if (user.Role == "Farmer")
                                    {
                                        <!-- Review KYC Inspector Modal Button -->
                                        <button type="button" class="@(user.IsApprovedByAdmin ? "btn-action-kyc" : "btn-action-kyc-review")" 
                                                onclick="openKycReviewModal('@user.Id', '@user.FullName', '@user.Email', '@(user.City ?? "")', '@(user.Address ?? "")', '@(user.BankName ?? "")', '@(user.BankAccountNumber ?? "")', '@(user.BankIfscCode ?? "")', '@(user.UpiId ?? "")', '@(user.KycDocumentType ?? "7/12 (Satbara)")', '@(user.KycDocumentPath ?? "")', @(user.IsApprovedByAdmin ? "true" : "false"), '@(user.KycRejectionReason ?? "")', '@(user.ProfilePicturePath ?? "")')"
                                                title="Inspect Document &amp; Bank KYC">
                                            <i class="bi bi-shield-check"></i>
                                            <span>@(user.IsApprovedByAdmin ? "KYC Details" : "Review KYC")</span>
                                        </button>
                                    }

                                    <!-- Block / Unblock Button -->
                                    <form asp-action="ToggleBlockUser" method="post" class="d-inline m-0">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if (user.IsBlocked)
                                        {
                                            <button type="submit" class="btn-action-circle" title="Unblock User" onclick="return confirm('Are you sure you want to UNBLOCK this user account?');">
                                                <i class="bi bi-unlock-fill text-success"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn-action-circle btn-block-action" title="Block User" onclick="return confirm('Are you sure you want to BLOCK this user? They will not be able to log in.');">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }
                                    </form>

                                    <!-- Delete Button -->
                                    <form asp-action="DeleteUser" method="post" class="d-inline m-0">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn-action-circle btn-delete-action" title="Delete User" onclick="return confirm('Are you sure you want to PERMANENTLY DELETE user @user.Email? This action will remove all user records and cannot be undone.');">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Farmer KYC Review Inspector Modal -->
<div class="modal fade" id="kycReviewModal" tabindex="-1" aria-labelledby="kycReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3.5 px-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.2rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="kycReviewModalLabel">Farmer 7/12 KYC &amp; Bank Inspector</h5>
                        <small class="text-light opacity-75" style="font-size: 0.74rem;">Verify 7/12 Land Record &amp; Bank Payout Account</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Left: Document Preview -->
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3.5 bg-light text-center h-100 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-bold px-3 py-1.5 rounded-pill mb-2" id="kycDocTypeBadge">
                                    7/12 (Satbara)
                                </span>
                                <h6 class="fw-bold text-dark mb-2">Uploaded Document Proof</h6>
                            </div>
                            
                            <div class="my-3 d-flex align-items-center justify-content-center overflow-hidden rounded-3 border bg-white shadow-sm" style="min-height: 240px; max-height: 320px;">
                                <img id="kycDocImg" src="" class="img-fluid rounded" alt="KYC Document" style="max-height: 300px; object-fit: contain; display: none;" />
                                <iframe id="kycDocPdf" src="" class="w-100" style="height: 300px; border: none; display: none;"></iframe>
                                <div id="kycNoDoc" class="text-muted p-4">
                                    <i class="bi bi-file-earmark-x display-4 text-secondary opacity-50 d-block mb-2"></i>
                                    <p class="small mb-0">No document uploaded yet</p>
                                </div>
                            </div>

                            <a id="kycDocFullLink" href="#" target="_blank" class="btn btn-sm btn-outline-success bg-white rounded-pill w-100 fw-bold shadow-sm">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Open Original Document
                            </a>
                        </div>
                    </div>

                    <!-- Right: Farmer & Bank Verification Details -->
                    <div class="col-md-6">
                        <div class="h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-3">
                                    <img id="kycFarmerAvatar" src="" class="rounded-circle border border-2 border-success shadow-sm" style="width: 52px; height: 52px; object-fit: cover;" alt="Farmer Photo" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-6" id="kycFarmerName"></h6>
                                        <small class="text-muted d-block" id="kycFarmerEmail"></small>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-0.5 rounded-pill mt-0.5" style="font-size: 0.70rem;">
                                            <i class="bi bi-tree-fill me-1"></i> Registered Farmer
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3 p-2.5 rounded-3 bg-light border">
                                    <small class="text-muted d-block" style="font-size: 0.70rem; font-weight: 700; text-transform: uppercase;">Farm Location</small>
                                    <span class="fw-bold text-dark small" id="kycFarmerLocation"></span>
                                </div>

                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2.5 small text-uppercase" style="letter-spacing: 0.5px;">Bank Account &amp; UPI Details</h6>

                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3 border">
                                            <small class="text-muted d-block" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700;">Bank Name</small>
                                            <span class="fw-bold text-dark small" id="kycBankName"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3 border">
                                            <small class="text-muted d-block" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700;">Account Number</small>
                                            <span class="fw-bold text-success font-monospace small" id="kycBankAcc"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3 border">
                                            <small class="text-muted d-block" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700;">IFSC Code</small>
                                            <span class="fw-bold text-dark font-monospace small" id="kycBankIfsc"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3 border">
                                            <small class="text-muted d-block" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700;">UPI ID</small>
                                            <span class="fw-semibold text-dark font-monospace small" id="kycUpiId"></span>
                                        </div>
                                    </div>
                                </div>

                                <div id="kycRejectionAlert" class="alert alert-danger p-2.5 rounded-3 small mb-2 d-none">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Previous Reason:</strong> <span id="kycRejectionMsg"></span>
                                </div>
                            </div>

                            <!-- Approval / Rejection Action Controls -->
                            <div class="border-top pt-3">
                                <div class="d-flex gap-2 mb-2">
                                    <form asp-action="ApproveFarmer" method="post" class="flex-grow-1">
                                        <input type="hidden" name="id" id="kycApproveUserId" value="" />
                                        <button type="submit" class="btn btn-success rounded-pill fw-bold w-100 py-2.5 shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #16a34a 100%); border: none;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approve &amp; Activate Farmer
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger rounded-pill px-3.5 fw-bold" onclick="toggleRejectBox()">
                                        <i class="bi bi-x-circle me-1"></i> Reject
                                    </button>
                                </div>

                                <!-- Collapsible Reject with Reason Form -->
                                <div id="rejectReasonBox" class="mt-2 p-3 bg-light rounded-3 border" style="display: none;">
                                    <form asp-action="RejectFarmer" method="post">
                                        <input type="hidden" name="id" id="kycRejectUserId" value="" />
                                        <label class="form-label small fw-bold text-danger mb-1">State Reason for Rejection:</label>
                                        <textarea name="reason" class="form-control rounded-3 mb-2 small shadow-none" rows="2" placeholder="e.g. 7/12 document photo is blurred / Name does not match bank account..." required></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" onclick="toggleRejectBox()">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">Confirm &amp; Delete Data</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openKycReviewModal(id, name, email, city, address, bankName, bankAcc, bankIfsc, upi, docType, docPath, isApproved, rejectionReason, profilePic) {
            document.getElementById('kycApproveUserId').value = id;
            document.getElementById('kycRejectUserId').value = id;
            document.getElementById('kycFarmerName').textContent = name || 'N/A';
            document.getElementById('kycFarmerEmail').textContent = email || 'N/A';
            document.getElementById('kycFarmerLocation').textContent = (address ? address + ', ' : '') + (city || 'Gujarat');
            document.getElementById('kycBankName').textContent = bankName || 'Not Provided';
            document.getElementById('kycBankAcc').textContent = bankAcc || 'Not Provided';
            document.getElementById('kycBankIfsc').textContent = bankIfsc || 'Not Provided';
            document.getElementById('kycUpiId').textContent = upi || 'None';
            document.getElementById('kycDocTypeBadge').textContent = docType || '7/12 (Satbara)';

            const avatarImg = document.getElementById('kycFarmerAvatar');
            if (profilePic && profilePic.trim() !== '') {
                avatarImg.src = profilePic;
            } else {
                avatarImg.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name || 'Farmer') + '&background=15803d&color=fff&size=128';
            }

            const docImg = document.getElementById('kycDocImg');
            const docPdf = document.getElementById('kycDocPdf');
            const noDoc = document.getElementById('kycNoDoc');
            const fullLink = document.getElementById('kycDocFullLink');

            docImg.style.display = 'none';
            docPdf.style.display = 'none';
            noDoc.style.display = 'none';

            if (docPath && docPath.trim() !== '') {
                fullLink.href = docPath;
                fullLink.style.display = 'block';
                if (docPath.toLowerCase().endsWith('.pdf')) {
                    docPdf.src = docPath;
                    docPdf.style.display = 'block';
                } else {
                    docImg.src = docPath;
                    docImg.style.display = 'block';
                }
            } else {
                noDoc.style.display = 'block';
                fullLink.style.display = 'none';
            }

            const rejAlert = document.getElementById('kycRejectionAlert');
            const rejMsg = document.getElementById('kycRejectionMsg');
            if (rejectionReason && rejectionReason.trim() !== '') {
                rejMsg.textContent = rejectionReason;
                rejAlert.classList.remove('d-none');
            } else {
                rejAlert.classList.add('d-none');
            }

            document.getElementById('rejectReasonBox').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('kycReviewModal'));
            modal.show();
        }

        function toggleRejectBox() {
            const box = document.getElementById('rejectReasonBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        // Real-Time Live Search Filter
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('adminUserSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    const rows = document.querySelectorAll('.user-data-row');
                    let matchCount = 0;

                    rows.forEach(function (row) {
                        const searchContent = row.getAttribute('data-search') || '';
                        if (!query || searchContent.includes(query)) {
                            row.style.display = '';
                            matchCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    let emptyRow = document.getElementById('searchEmptyRow');
                    if (matchCount === 0 && rows.length > 0) {
                        if (!emptyRow) {
                            const tbody = document.querySelector('#adminUsersTable tbody');
                            emptyRow = document.createElement('tr');
                            emptyRow.id = 'searchEmptyRow';
                            emptyRow.innerHTML = '<td colspan="6" class="text-center text-muted py-5"><i class="bi bi-search display-5 d-block mb-2 text-secondary opacity-50"></i><p class="mb-0 fw-semibold">No users match "' + query + '"</p></td>';
                            tbody.appendChild(emptyRow);
                        }
                    } else if (emptyRow) {
                        emptyRow.remove();
                    }
                });
            }
        });
    </script>
}
