@model AgriAI.Domain.Entities.Product

@{
    ViewData["Title"] = "Edit Produce Listing - " + Model.Name + " - AgriAI";
    var currentImg = Model.Images?.FirstOrDefault()?.ImageUrl;
    bool isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <style>
        .produce-edit-container {
            max-width: 1680px;
            margin: 0 auto;
        }

        /* 1. Hero Header Banner */
        .produce-hero-header {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border-radius: 1.25rem;
            padding: 2.25rem 2rem;
            color: #ffffff;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            animation: produceFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .produce-hero-header::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 220px;
            height: 220px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            pointer-events: none;
        }

        .produce-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 30px;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            margin-bottom: 10px;
            backdrop-filter: blur(8px);
        }

        .produce-hero-title {
            font-size: 2.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .produce-hero-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.88);
            max-width: 760px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        /* 2. Unified Master Card */
        .produce-unified-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            padding: 2.25rem 2.5rem;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            animation: produceFadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .produce-unified-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #006653 0%, #10b981 50%, #cb9d46 100%);
        }

        .produce-card-header {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 1.25rem;
            margin-bottom: 2rem;
        }

        .crop-preview-box {
            border: 2px dashed #cbd5e1;
            border-radius: 16px;
            padding: 1.25rem;
            text-align: center;
            background: #f8fafc;
            transition: all 0.25s ease;
        }

        .crop-preview-box:hover {
            border-color: #006653;
            background: #f0fdf4;
        }

        .crop-current-img {
            max-height: 220px;
            width: 100%;
            object-fit: cover;
            border-radius: 12px;
        }

        /* Action Buttons */
        .btn-save-produce {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.72rem 2.25rem;
            border: none;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.25);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-save-produce:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 102, 83, 0.35);
        }

        .btn-cancel-produce {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.72rem 1.75rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-cancel-produce:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

        /* Animations */
        @@keyframes produceFadeInUp {
            from {
                opacity: 0;
                transform: translateY(22px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 991px) {
            .produce-unified-card {
                padding: 1.5rem 1.15rem;
                border-radius: 18px;
            }
            .produce-hero-header {
                padding: 1.75rem 1.25rem;
            }
            .produce-hero-title {
                font-size: 1.75rem;
            }
        }
    </style>
}

<div class="produce-edit-container py-3 px-2 px-md-3 px-xl-4" style="min-height: calc(100vh - 180px);">
    
    <!-- Top Header Navigation Banner -->
    <div class="produce-hero-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="produce-hero-badge">
                    <i class="bi bi-pencil-square"></i>
                    <span>Produce Editor #@Model.Id.ToString("D4") &bull; @(isAdmin ? "Super Administrator Command" : "Farmer Produce Manager")</span>
                </div>
                <h1 class="produce-hero-title">
                    ✏️ Edit Produce: @Model.Name
                </h1>
                <p class="produce-hero-subtitle">
                    Update crop specifications, stock quantity, APMC market price, and harvest imagery.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Dashboard" asp-route-tab="products" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-dark">
                        <i class="bi bi-arrow-left"></i> Back to Listed Crops
                    </a>
                }
                else
                {
                    <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-success">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-danger border-opacity-25 shadow-xs mb-4 p-3 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <span class="fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Unified Master Card -->
    <div class="produce-unified-card shadow-sm">
        
        <div class="produce-card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-basket-fill text-success"></i> Crop Details &amp; Taxonomy
                </h3>
                <p class="text-muted small mb-0">Modify listing specifications, pricing tiers, and agricultural inventory parameters.</p>
            </div>
            <div>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 fw-bold font-monospace" style="font-size: 0.82rem;">
                    Crop ID #@Model.Id.ToString("D4")
                </span>
            </div>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FarmerId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4"></div>

            <div class="row g-4 g-xl-5">
                
                <!-- Left Column: Produce Fields (8 Cols) -->
                <div class="col-lg-8">
                    <div class="row g-3 mb-3.5">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold text-dark small mb-1">Produce / Crop Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag-fill text-success"></i></span>
                                <input asp-for="Name" class="form-control ps-2 rounded-end-3 py-2.5" placeholder="e.g. Organic Saurashtra Groundnut" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold text-dark small mb-1">Produce Category <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-grid-fill text-success"></i></span>
                                <select asp-for="CategoryId" class="form-select ps-2 rounded-end-3 py-2.5" asp-items="ViewBag.CategoryId" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3.5">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold text-dark small mb-1">Direct Price (₹ / Kg) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 fw-bold text-success">₹</span>
                                <input asp-for="Price" class="form-control ps-2 py-2.5" type="number" step="0.01" min="1" required />
                                <span class="input-group-text bg-light border-start-0 text-muted small">/ Kg</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-bold text-dark small mb-1">Available Stock Quantity (Kg) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-box-seam text-success"></i></span>
                                <input asp-for="StockQuantity" class="form-control ps-2 py-2.5" type="number" min="0" required />
                                <span class="input-group-text bg-light border-start-0 text-muted small">Kg</span>
                            </div>
                            <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-dark small mb-1">Detailed Description &amp; Quality Specifications</label>
                        <textarea asp-for="Description" class="form-control rounded-3 p-3 shadow-none" rows="4" placeholder="Describe harvest quality, moisture percentage, organic certifications, packing type, etc." style="border: 1px solid #e2e8f0;"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Form Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        @if (isAdmin)
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" asp-route-tab="products" class="btn btn-cancel-produce">Cancel</a>
                        }
                        else
                        {
                            <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-cancel-produce">Cancel</a>
                        }
                        <button type="submit" class="btn btn-save-produce">
                            <i class="bi bi-check-circle-fill me-1.5"></i> Save &amp; Update Produce Listing
                        </button>
                    </div>
                </div>

                <!-- Right Column: Image Preview & Farmer Oversight (4 Cols) -->
                <div class="col-lg-4">
                    <!-- Produce Image Card -->
                    <div class="p-4 bg-light rounded-4 border mb-4">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-image text-success"></i> Produce Image
                        </h6>

                        <div class="crop-preview-box mb-3 bg-white">
                            @if (!string.IsNullOrEmpty(currentImg))
                            {
                                <img src="@currentImg" alt="@Model.Name" class="crop-current-img mb-2 shadow-xs" />
                                <small class="text-muted d-block fw-bold">Current Active Photo</small>
                            }
                            else
                            {
                                <div class="py-4 text-center text-muted">
                                    <i class="bi bi-image display-4 text-secondary opacity-50 mb-2 d-block"></i>
                                    <small>No image currently uploaded</small>
                                </div>
                            }
                        </div>

                        <div>
                            <label class="form-label fw-bold text-dark small mb-1">Replace / Upload New Image</label>
                            <input type="file" name="imageFile" class="form-control rounded-3 py-2 bg-white" accept="image/*" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Supports JPG, PNG, WEBP. Max size 5MB.</small>
                        </div>
                    </div>

                    <!-- Producer Info Badge -->
                    <div class="p-3.5 bg-light rounded-4 border">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-person-badge-fill text-success fs-5"></i>
                            <strong class="text-dark small">Listed By Producer Identity</strong>
                        </div>
                        <p class="font-monospace text-muted small mb-0 font-weight-bold" style="word-break: break-all;">
                            @(string.IsNullOrEmpty(Model.FarmerId) ? "General System Farmer" : Model.FarmerId)
                        </p>
                    </div>
                </div>

            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
