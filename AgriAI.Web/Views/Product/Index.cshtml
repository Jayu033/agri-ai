@model IEnumerable<AgriAI.Domain.Entities.Product>
@inject Microsoft.AspNetCore.Identity.UserManager<AgriAI.Infrastructure.Identity.ApplicationUser> UserManager

@functions {
    public static string GetChipIcon(string? name)
    {
        var lower = (name ?? "").ToLower();
        if (lower.Contains("veg")) return "🥬";
        if (lower.Contains("fruit")) return "🍎";
        if (lower.Contains("grain") || lower.Contains("cereal")) return "🌾";
        if (lower.Contains("pulse")) return "🌱";
        if (lower.Contains("oilseed")) return "🥜";
        if (lower.Contains("spice") || lower.Contains("jeera")) return "🌿";
        if (lower.Contains("dairy")) return "🥛";
        if (lower.Contains("seed") || lower.Contains("fertilizer")) return "🌻";
        return "📦";
    }
}

@{
    ViewData["Title"] = "Farm Fresh Produce Marketplace";
    var currentUserId = UserManager.GetUserId(User);
    var currentUserName = User.Identity?.Name;
}

<style>
    .marketplace-catalog-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 1.5rem 1.75rem 1.75rem 1.75rem;
        box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
        margin-bottom: 2rem;
    }
    .marketplace-catalog-header {
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }
    .marketplace-scroll-wrapper {
        min-height: 480px;
        max-height: calc(100vh - 270px);
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 6px;
        padding-bottom: 8px;
    }
    .marketplace-scroll-wrapper::-webkit-scrollbar {
        width: 7px;
    }
    .marketplace-scroll-wrapper::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 10px;
    }
    .marketplace-scroll-wrapper::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .marketplace-scroll-wrapper::-webkit-scrollbar-thumb:hover {
        background: #006653;
    }
    .marketplace-hero {
        background: linear-gradient(135deg, #006653 0%, #047857 100%);
        border-radius: 1.25rem;
        padding: 2.5rem 2rem;
        color: #ffffff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .marketplace-hero::after {
        content: "";
        position: absolute;
        right: -30px;
        bottom: -30px;
        width: 220px;
        height: 220px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 50%;
        pointer-events: none;
    }
    .product-card-modern {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
    }
    .product-card-modern:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px rgba(0, 102, 83, 0.12);
        border-color: #86efac;
    }
    .product-img-wrapper {
        position: relative;
        height: 220px;
        background: #f8fafc;
        overflow: hidden;
        border-bottom: 1px solid #f1f5f9;
    }
    .product-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .product-card-modern:hover .product-img-wrapper img {
        transform: scale(1.06);
    }
    .badge-organic-float {
        position: absolute;
        top: 14px;
        left: 14px;
        background: linear-gradient(135deg, #006653 0%, #16a34a 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 5px 12px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
    .badge-stock-float {
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(255, 255, 255, 0.95);
        color: #0f172a;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 5px 12px;
        border-radius: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        backdrop-filter: blur(4px);
    }
    .filter-chip-btn {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.5rem 1.2rem;
        border-radius: 9999px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .filter-chip-btn:hover,
    .filter-chip-btn.active {
        background: #006653;
        color: #ffffff;
        border-color: #006653;
        box-shadow: 0 4px 12px rgba(0, 102, 83, 0.2);
    }

    /* Modern Card Skeleton Loading (NO SPINNER - pure card shape shimmer) */
    .product-skeleton-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    }
    .skeleton-box {
        background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
        background-size: 200% 100%;
        animation: skeletonShimmerAnimation 1.3s infinite ease-in-out;
    }
    @@keyframes skeletonShimmerAnimation {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .skeleton-img {
        width: 100%;
        height: 220px;
    }
    .skeleton-badge {
        width: 85px;
        height: 20px;
        border-radius: 9999px;
    }
    .skeleton-pill-sm {
        width: 95px;
        height: 16px;
        border-radius: 9999px;
    }
    .skeleton-title {
        width: 70%;
        height: 20px;
        border-radius: 6px;
    }
    .skeleton-desc {
        width: 90%;
        height: 14px;
        border-radius: 4px;
    }
    .skeleton-price-box {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        padding: 1rem;
    }
    .skeleton-price-line {
        width: 55%;
        height: 22px;
        border-radius: 6px;
    }
    .skeleton-meta-line {
        width: 100%;
        height: 12px;
        border-radius: 4px;
    }
    .skeleton-btn {
        height: 38px;
        border-radius: 9999px;
        flex: 1;
    }

    /* Product Not Found State (Within Catalog Card Box) */
    .product-not-found-card {
        padding: 4.5rem 1.5rem;
        text-align: center;
        background: #fafbfc;
        border: 2px dashed #e2e8f0;
        border-radius: 1.25rem;
        margin: 0.5rem 0 1.5rem 0;
    }

    /* Product Card Action Buttons (Fixed spacing between icon & text) */
    .product-btn-cart,
    .product-btn-buy {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 8px !important;
        font-size: 0.82rem !important;
        font-weight: 700 !important;
        padding: 0.55rem 0.65rem !important;
        flex: 1 1 0 !important;
        white-space: nowrap !important;
        min-height: 40px !important;
        line-height: 1 !important;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        text-decoration: none !important;
    }
    .product-btn-cart i,
    .product-btn-buy i {
        font-size: 1.05rem !important;
        line-height: 1 !important;
        display: inline-block !important;
        flex-shrink: 0 !important;
        margin-right: 4px !important;
    }
    .product-btn-buy {
        background-color: #006653 !important;
        border-color: #006653 !important;
        color: #ffffff !important;
    }
    .product-btn-buy:hover {
        background-color: #047857 !important;
        border-color: #047857 !important;
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 102, 83, 0.25) !important;
    }
    .product-btn-cart {
        border-color: #006653 !important;
        color: #006653 !important;
        background-color: transparent !important;
    }
    .product-btn-cart:hover {
        background-color: #006653 !important;
        border-color: #006653 !important;
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 102, 83, 0.2) !important;
    }
    .product-btn-cart:hover i,
    .product-btn-cart:hover span {
        color: #ffffff !important;
    }
    .product-btn-cart span,
    .product-btn-buy span {
        display: inline-block !important;
        vertical-align: middle !important;
    }

    /* Mobile-responsive Crop Cards & Stock Statistics */
    .crop-stock-stats {
        font-size: 0.70rem;
    }
    @@media (max-width: 576px) {
        .marketplace-catalog-card {
            padding: 1rem 0.75rem !important;
            border-radius: 16px !important;
        }
        .product-card-modern .card-body-content {
            padding: 0.85rem !important;
        }
        .product-price-box {
            padding: 0.65rem 0.75rem !important;
        }
        .crop-stock-stats {
            font-size: 0.68rem !important;
            letter-spacing: -0.15px;
        }
    }
    @@media (max-width: 375px) {
        .crop-stock-stats {
            font-size: 0.63rem !important;
            letter-spacing: -0.2px;
        }
    }
</style>

<div class="container-fluid py-3 px-2 px-md-3 px-xl-4" style="max-width: 1680px;">
    
    <!-- Hero Banner -->
    <div class="marketplace-hero shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="agri-page-badge">
                    <i class="bi bi-shop"></i>
                    <span>Direct Farmer Marketplace</span>
                </div>
                <h1 class="agri-page-title">
                    Shop Fresh Farm Produce
                </h1>
                <p class="agri-page-subtitle">
                    Buy organic crops, grains, and spices directly from verified Gujarat farmers with 0% middleman commission.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    if (User.IsInRole("Farmer"))
                    {
                        <a asp-action="Create" class="btn btn-light text-success fw-bold px-4 py-2.5 rounded-pill shadow">
                            <i class="bi bi-plus-circle-fill me-1"></i> List New Harvest Produce
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light text-success fw-bold px-4 py-2.5 rounded-pill shadow">
                        <i class="bi bi-person-badge-fill me-1"></i> Register as Farmer
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-white shadow-sm rounded-4 border-success p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-white shadow-sm rounded-4 border-danger p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dedicated Distinct Marketplace Catalog Box (Framed with Custom Scrollbar) -->
    <div class="marketplace-catalog-card shadow-sm">
        
        <!-- Filter Header: Categories & Search Bar -->
        <div class="marketplace-catalog-header d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="filter-chip-btn active" onclick="filterMarketplace('all', this)">
                    All Harvests (@Model.Count())
                </button>
                @{
                    var dbCategories = ViewBag.Categories as List<AgriAI.Domain.Entities.Category>;
                }
                @if (dbCategories != null && dbCategories.Any())
                {
                    @foreach (var cat in dbCategories)
                    {
                        var filterKey = cat.Name.ToLower();
                        <button type="button" class="filter-chip-btn" onclick="filterMarketplace('@filterKey', this)">
                            @GetChipIcon(cat.Name) @cat.Name
                        </button>
                    }
                }
                else
                {
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('vegetables', this)">
                        🥬 Vegetables
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('fruits', this)">
                        🍎 Fruits
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('grains & cereals', this)">
                        🌾 Grains &amp; Cereals
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('pulses', this)">
                        🌱 Pulses
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('oilseeds', this)">
                        🥜 Oilseeds
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('spices & jeera', this)">
                        🌿 Spices &amp; Jeera
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('dairy produce', this)">
                        🥛 Dairy Produce
                    </button>
                    <button type="button" class="filter-chip-btn" onclick="filterMarketplace('seeds & fertilizers', this)">
                        🌻 Seeds &amp; Fertilizers
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 290px;">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="cropSearchInput" class="form-control bg-light border-start-0 border-end-0 shadow-none" placeholder="Search crops, spices..." oninput="searchMarketplace(this.value)" />
                    <button type="button" id="clearSearchBtn" class="btn bg-light border-start-0 rounded-end-pill text-muted pe-3 d-none" onclick="resetMarketplaceSearch()" title="Clear Search">
                        <i class="bi bi-x-circle-fill text-secondary"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Scrollable Produce Grid Area -->
        <div class="marketplace-scroll-wrapper">
            
            <!-- Skeleton Loading State (Card Shapes Shimmer - NO SPINNER) -->
            <div class="row g-4 mb-4" id="skeletonGrid" style="display: none;">
                @for (int s = 0; s < 4; s++)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="product-skeleton-card">
                            <div class="skeleton-box skeleton-img"></div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="skeleton-box skeleton-badge"></div>
                                    <div class="skeleton-box skeleton-pill-sm"></div>
                                </div>
                                <div class="skeleton-box skeleton-title mb-2"></div>
                                <div class="skeleton-box skeleton-desc mb-3"></div>
                                <div class="skeleton-price-box mb-3">
                                    <div class="skeleton-box skeleton-price-line mb-2"></div>
                                    <div class="skeleton-box skeleton-meta-line"></div>
                                </div>
                                <div class="d-flex gap-2 mt-auto">
                                    <div class="skeleton-box skeleton-btn"></div>
                                    <div class="skeleton-box skeleton-btn"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Product Not Found State (Dedicated Box Inside Catalog) -->
            <div id="productNotFoundState" class="product-not-found-card" style="display: none;">
                <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-xs mb-3" style="width: 76px; height: 76px; border: 1px solid #e2e8f0;">
                    <i class="bi bi-search text-muted" style="font-size: 2rem; color: #006653 !important;"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1.5" style="letter-spacing: -0.02em;">Product Not Found</h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 480px; font-size: 0.95rem; line-height: 1.55;">
                    We couldn't find any farm produce matching "<span id="searchKeywordEcho" class="text-success fw-bold"></span>". Try checking spelling, clearing search filter, or browsing all available harvests.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #006653; border-color: #006653;" onclick="resetMarketplaceSearch()">
                        <i class="bi bi-arrow-counterclockwise"></i> Clear Search &amp; Show All
                    </button>
                </div>
            </div>

            <div class="row g-4" id="marketplaceGrid">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="bg-white shadow-sm rounded-4 p-5 text-center text-muted border">
                    <i class="bi bi-basket display-3 mb-3 d-block text-success opacity-50"></i>
                    <h5 class="fw-bold text-dark mb-2">No farm produce listed currently.</h5>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Farmer"))
                    {
                        <p class="text-muted small mb-3">You are logged in as a Farmer. Click below to list your first harvest or crop produce.</p>
                        <a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #006653;">
                            <i class="bi bi-plus-circle me-1"></i> Add Your First Product
                        </a>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">Fresh harvests will be listed by local farmers soon. Check back shortly or view today's live market prices.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-graph-up-arrow me-1"></i> View Live Market Rates
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-muted border">
                                Back to Home
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
        
        @{
            var soldMap = ViewBag.SoldQuantities as Dictionary<int, int> ?? new Dictionary<int, int>();
        }
        @foreach (var item in Model) {
            var imgUrl = item.Images?.FirstOrDefault()?.ImageUrl;
            var catName = item.Category?.Name ?? "Farm Produce";
            var catNormalized = catName.ToLower();
            var stockQty = item.StockQuantity;
            var soldQty = soldMap.ContainsKey(item.Id) ? soldMap[item.Id] : 0;
            var totalPublished = stockQty + soldQty;
            var maundPrice = item.Price * 20;
            var isOwnCrop = !string.IsNullOrEmpty(currentUserId) && (item.FarmerId == currentUserId || item.FarmerId == currentUserName);

            <div class="col-md-6 col-lg-4 col-xl-3 crop-card-item" data-category="@catNormalized" data-name="@item.Name.ToLower()">
                <div class="product-card-modern">
                    <!-- Image Area -->
                    <div class="product-img-wrapper">
                        @if (!string.IsNullOrEmpty(imgUrl))
                        {
                            <img src="@imgUrl" alt="@item.Name">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-success">
                                <i class="bi bi-tree display-4 opacity-50"></i>
                            </div>
                        }
                        @if (isOwnCrop)
                        {
                            <span class="badge-organic-float" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
                                <i class="bi bi-person-check-fill me-1"></i>Your Listed Crop
                            </span>
                        }
                        else
                        {
                            <span class="badge-organic-float">
                                <i class="bi bi-patch-check-fill me-1"></i>100% Farm Fresh
                            </span>
                        }
                        <span class="badge-stock-float">
                            @if (stockQty > 0)
                            {
                                <span class="text-success fw-bold">● @stockQty Kg in Stock</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">● Sold Out</span>
                            }
                        </span>
                    </div>

                    <!-- Card Body with Generous Internal Padding -->
                    <div class="p-3 p-sm-4 card-body-content d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25 rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                                @GetChipIcon(catName) @catName
                            </span>
                            <span class="text-muted small fw-semibold" style="font-size: 0.72rem;">
                                <i class="bi bi-geo-alt-fill text-success"></i> Gujarat APMC
                            </span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1.5 text-truncate" title="@item.Name" style="font-size: 1.12rem;">@item.Name</h5>
                        
                        <p class="text-muted small mb-3 text-truncate" style="font-size: 0.82rem; min-height: 18px;">
                            @(string.IsNullOrEmpty(item.Description) ? "Fresh organic farm crop harvested directly by local Gujarat farmers." : item.Description)
                        </p>

                        <!-- Price Section with responsive padding & stock breakdown -->
                        <div class="product-price-box p-2.5 p-sm-3 bg-light rounded-3 border mb-3 overflow-hidden">
                            <div class="d-flex justify-content-between align-items-center mb-1.5 flex-nowrap gap-1">
                                <div class="text-nowrap">
                                    <span class="fs-5 fw-extrabold text-success">₹@item.Price.ToString("N2")</span>
                                    <small class="text-muted fw-bold">/ Kg</small>
                                </div>
                                <span class="badge bg-white text-dark border py-1.5 px-2 rounded-pill fw-bold text-nowrap" style="font-size: 0.70rem;">
                                    ₹@maundPrice.ToString("N0") / Maund
                                </span>
                            </div>
                            <div class="crop-stock-stats pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center text-muted flex-wrap gap-1">
                                    <span class="text-nowrap">Total: <strong class="text-dark">@totalPublished Kg</strong></span>
                                    <span class="text-muted opacity-40">&bull;</span>
                                    <span class="text-nowrap">Sold: <strong class="text-success">@soldQty Kg</strong></span>
                                    <span class="text-muted opacity-40">&bull;</span>
                                    <span class="text-nowrap">Left: <strong class="@(stockQty > 0 ? "text-primary" : "text-danger")">@stockQty Kg</strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Action Buttons with proper margins -->
                        <div class="mt-auto pt-1 d-flex gap-2 align-items-center">
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark rounded-pill fw-bold px-3 py-2 shadow-xs d-flex align-items-center justify-content-center gap-1.5 flex-grow-1" style="font-size: 0.84rem;">
                                    <i class="bi bi-shield-check text-primary fs-6"></i> Inspect Produce
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" title="Edit Crop" style="width: 38px; height: 38px;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delist @item.Name from public market?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" title="Delist Crop" style="width: 38px; height: 38px;">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            }
                            else if (isOwnCrop)
                            {
                                <a asp-controller="Farmer" asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center justify-content-center gap-1.5 flex-grow-1" style="font-size: 0.85rem;">
                                    <i class="bi bi-pencil-square fs-6"></i> Manage Listing
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light border rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center justify-content-center gap-1.5 flex-grow-1" style="font-size: 0.85rem;">
                                    <i class="bi bi-eye fs-6"></i> Preview
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-success product-btn-cart rounded-pill shadow-sm" onclick="addToCartAjax(@item.Id, 1, '@item.Name')">
                                    <i class="bi bi-cart-plus"></i>
                                    <span>Add to Cart</span>
                                </button>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success product-btn-buy rounded-pill shadow-sm">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span>Buy Now</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
            </div>
        </div>
    </div>
</div>


<!-- Login Required Prompt Modal (Clean, modern popup box) -->
<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden; background: #ffffff;">
            <!-- Header with close button -->
            <div class="modal-header border-0 pb-0 pt-4 px-4 position-relative">
                <button type="button" class="btn-close shadow-none position-absolute top-0 end-0 m-4" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 pt-0 text-center">
                <!-- Icon Emblem -->
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-xs" style="width: 76px; height: 76px; background: rgba(0, 102, 83, 0.08); border: 2px solid rgba(0, 102, 83, 0.18);">
                    <i class="bi bi-person-lock" style="font-size: 2.2rem; color: #006653;"></i>
                </div>
                
                <h4 class="fw-bold text-dark mb-2" id="loginRequiredModalLabel" style="letter-spacing: -0.02em;">
                    Login Required
                </h4>
                
                <p class="text-muted mb-3 px-2" style="font-size: 0.92rem; line-height: 1.55;">
                    Please sign in to your AgriAI account to add produce to your cart and proceed with order checkout.
                </p>

                <!-- Selected Crop Preview Card -->
                <div class="p-3 bg-light rounded-4 border d-flex align-items-center gap-3 mb-4 text-start">
                    <div class="d-flex align-items-center justify-content-center bg-white rounded-circle shadow-xs flex-shrink-0" style="width: 44px; height: 44px; border: 1px solid #e2e8f0;">
                        <i class="bi bi-basket2-fill text-success fs-5"></i>
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-bold text-dark text-truncate" id="modalCropNamePreview" style="font-size: 0.95rem;">Farm Produce</div>
                        <div class="text-muted small" style="font-size: 0.74rem;">Ready to be added to cart</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                        Verified APMC
                    </span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2 mb-2">
                    <a id="modalLoginRedirectBtn" href="/Account/Login" class="btn btn-success rounded-pill fw-bold py-2.5 px-4 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #006653; border-color: #006653;">
                        <i class="bi bi-box-arrow-in-right fs-5"></i> Sign In to Continue
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success rounded-pill fw-bold py-2.5 px-4 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-person-plus-fill fs-5"></i> Create Free Account
                    </a>
                </div>

                <div class="pt-2">
                    <button type="button" class="btn btn-link text-muted text-decoration-none small fw-semibold" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left me-1"></i> Continue Browsing
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let searchTimer = null;
    let currentSearchCategory = 'all';

    function filterMarketplace(category, btn) {
        currentSearchCategory = category;
        document.querySelectorAll('.filter-chip-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const searchInput = document.getElementById('cropSearchInput');
        const keyword = searchInput ? searchInput.value : '';
        triggerSkeletonAndFilter(keyword);
    }

    function searchMarketplace(keyword) {
        const clearBtn = document.getElementById('clearSearchBtn');
        if (clearBtn) {
            if (keyword && keyword.trim().length > 0) {
                clearBtn.classList.remove('d-none');
            } else {
                clearBtn.classList.add('d-none');
            }
        }
        triggerSkeletonAndFilter(keyword);
    }

    function triggerSkeletonAndFilter(keyword) {
        const skeletonGrid = document.getElementById('skeletonGrid');
        const marketplaceGrid = document.getElementById('marketplaceGrid');
        const notFoundState = document.getElementById('productNotFoundState');

        // Immediately show skeleton card shapes shimmer (Strictly NO SPINNER)
        if (skeletonGrid) skeletonGrid.style.display = 'flex';
        if (marketplaceGrid) marketplaceGrid.style.display = 'none';
        if (notFoundState) notFoundState.style.display = 'none';

        // 250ms smooth transition for realistic reactive card skeleton shape
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            applySearchAndFilter(keyword);
        }, 250);
    }

    function applySearchAndFilter(keyword) {
        const searchVal = (keyword || '').toLowerCase().trim();
        const skeletonGrid = document.getElementById('skeletonGrid');
        const marketplaceGrid = document.getElementById('marketplaceGrid');
        const notFoundState = document.getElementById('productNotFoundState');
        const searchEcho = document.getElementById('searchKeywordEcho');

        const cards = document.querySelectorAll('.crop-card-item');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = (card.getAttribute('data-name') || '').toLowerCase();
            const cat = (card.getAttribute('data-category') || '').toLowerCase();

            const matchesCat = (currentSearchCategory === 'all') || cat === currentSearchCategory || cat.includes(currentSearchCategory) || currentSearchCategory.includes(cat);
            const matchesQuery = !searchVal || name.includes(searchVal) || cat.includes(searchVal);

            if (matchesCat && matchesQuery) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Hide skeleton loading shape
        if (skeletonGrid) skeletonGrid.style.display = 'none';

        if (visibleCount === 0) {
            if (marketplaceGrid) marketplaceGrid.style.display = 'none';
            if (notFoundState) {
                notFoundState.style.display = 'block';
                if (searchEcho) {
                    searchEcho.textContent = searchVal || (currentSearchCategory !== 'all' ? currentSearchCategory : 'selected filter');
                }
            }
        } else {
            if (notFoundState) notFoundState.style.display = 'none';
            if (marketplaceGrid) marketplaceGrid.style.display = 'flex';
        }
    }

    function resetMarketplaceSearch() {
        const searchInput = document.getElementById('cropSearchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.classList.add('d-none');

        currentSearchCategory = 'all';
        document.querySelectorAll('.filter-chip-btn').forEach((b, idx) => {
            if (idx === 0) b.classList.add('active');
            else b.classList.remove('active');
        });

        triggerSkeletonAndFilter('');
    }

    const isUserLoggedIn = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

    function openLoginRequiredModal(productName, redirectUrl) {
        const modalNameEl = document.getElementById('modalCropNamePreview');
        const modalLoginBtn = document.getElementById('modalLoginRedirectBtn');
        
        if (modalNameEl) {
            modalNameEl.textContent = productName || 'Farm Produce';
        }
        
        const returnPath = window.location.pathname + window.location.search;
        const targetUrl = redirectUrl || (`/Account/Login?returnUrl=${encodeURIComponent(returnPath)}`);
        if (modalLoginBtn) {
            modalLoginBtn.href = targetUrl;
        }

        const modalEl = document.getElementById('loginRequiredModal');
        if (modalEl && window.bootstrap) {
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }
    }

    function addToCartAjax(productId, qty, name) {
        if (!isUserLoggedIn) {
            openLoginRequiredModal(name, `/Account/Login?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`);
            return;
        }

        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `productId=${productId}&quantity=${qty || 1}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showFloatingToast(data.message || `🌾 ${name} added to cart!`);
            } else {
                if (data.requireLogin) {
                    openLoginRequiredModal(name, data.redirectUrl);
                } else {
                    showFloatingToast(data.message || 'Could not add to cart', false);
                }
            }
        })
        .catch(err => {
            console.error(err);
            showFloatingToast('Error adding to cart', false);
        });
    }
</script>
