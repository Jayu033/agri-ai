@model AgriAI.Domain.Entities.Product

@{
    ViewData["Title"] = "List New Farm Produce";
}

<div class="py-4 my-2">
    <div class="container-fluid px-lg-4 px-md-3" style="max-width: 1240px;">
        
        <!-- Header & Breadcrumbs Navigation -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Farmer" asp-action="Dashboard" class="text-success text-decoration-none">Farmer Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">List New Crop Produce</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="fw-extrabold text-dark mb-0">List Farm Produce for Direct Sale</h2>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25 rounded-pill px-3 py-1.5 small">
                        <i class="bi bi-patch-check-fill me-1"></i>0% Commission
                    </span>
                </div>
            </div>
            <div>
                <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <div class="row g-4">
            
            <!-- Left Column: Main Produce Creation Form (8 Columns) -->
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 border p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
                        <h4 class="fw-bold text-dark mb-0">Crop &amp; Harvest Details</h4>
                        <span class="text-muted small">* Mandatory fields</span>
                    </div>

                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3"></div>
                        
                        <!-- Name & Category -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold text-dark small mb-1.5">Product / Crop Name *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-tag-fill"></i></span>
                                    <input asp-for="Name" class="form-control border-start-0 px-2.5 py-2 shadow-none" placeholder="e.g. Organic Saurashtra Groundnut" required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold text-dark small mb-1.5">Produce Category *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-grid-fill"></i></span>
                                    <select asp-for="CategoryId" class="form-select border-start-0 px-2.5 py-2 shadow-none" asp-items="ViewBag.CategoryId" required>
                                        <option value="">-- Select Category --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        
                        <!-- Price & Quantity -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold text-dark small mb-1.5">Direct Selling Price (₹) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0 fw-bold">₹</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control border-start-0 px-2.5 py-2 shadow-none" placeholder="e.g. 6200.00" required />
                                </div>
                                <small class="text-muted d-block mt-1">Suggested: Check APMC benchmark modal price on right panel.</small>
                                <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label fw-bold text-dark small mb-1.5">Available Stock Quantity (Kg / Quintal) *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-box-seam-fill"></i></span>
                                    <input asp-for="StockQuantity" type="number" class="form-control border-start-0 px-2.5 py-2 shadow-none" placeholder="e.g. 100" required />
                                </div>
                                <small class="text-muted d-block mt-1">1 Quintal = 100 Kg = 5 Maund (મણ)</small>
                                <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-dark small mb-1.5">Harvest Description &amp; Origin Details</label>
                            <textarea asp-for="Description" class="form-control px-3 py-2.5 shadow-none" rows="3" placeholder="Describe harvest date, organic certification, farm region (e.g. Gondal, Rajkot), and grain moisture quality..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Produce Photo Upload Area -->
                        <div class="mb-4 p-4 rounded-4 border bg-light bg-opacity-50">
                            <label class="form-label fw-bold text-success d-flex align-items-center gap-2 mb-1.5 fs-6">
                                <i class="bi bi-camera-fill"></i> Produce Photo / Image Upload
                            </label>
                            <p class="text-muted small mb-3">Upload clear photos of your crop produce for higher visibility and fast buyer inquiries.</p>
                            
                            <div class="p-3 bg-white rounded-3 border">
                                <input type="file" name="imageFile" id="imageFileInput" class="form-control shadow-none" accept="image/*" />
                                <small class="text-muted d-block mt-1.5">Supported file formats: JPG, JPEG, PNG, WEBP (Max 5MB)</small>
                                
                                <div id="imagePreviewContainer" class="mt-3 d-none text-center p-3 bg-light rounded-3 border">
                                    <span class="text-muted small d-block mb-2">Selected Photo Preview:</span>
                                    <img id="imagePreview" src="#" alt="Selected Image Preview" class="img-thumbnail rounded-3 shadow-sm" style="max-height: 200px; object-fit: cover;" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Hidden FarmerId -->
                        <input type="hidden" asp-for="FarmerId" value="farmer-123" />
                        
                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                            <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold text-muted border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                <i class="bi bi-cloud-arrow-up-fill me-1.5"></i> Publish Farm Produce
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Column: Market Guidance & Seller Advantages (4 Columns) -->
            <div class="col-lg-4">
                
                <!-- Live Gujarat APMC Rates Reference Card -->
                <div class="bg-white rounded-4 border shadow-sm p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-graph-up text-success me-1.5"></i> APMC Benchmark Rates
                        </h6>
                        <span class="badge bg-danger text-white fw-bold px-2 py-0.5 small">LIVE</span>
                    </div>
                    <p class="text-muted small mb-3">Today's modal reference prices across Gujarat markets:</p>

                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3">
                            <span class="small fw-bold text-dark">🌱 Cotton (કપાસ)</span>
                            <span class="text-success fw-bold small">₹ 7,120 / Qtl</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3">
                            <span class="small fw-bold text-dark">🥜 Groundnut (મગફળી)</span>
                            <span class="text-success fw-bold small">₹ 6,208 / Qtl</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3">
                            <span class="small fw-bold text-dark">🌿 Cumin / Jeera (જીરું)</span>
                            <span class="text-success fw-bold small">₹ 28,500 / Qtl</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3">
                            <span class="small fw-bold text-dark">🌾 Wheat (ઘઉં)</span>
                            <span class="text-success fw-bold small">₹ 2,565 / Qtl</span>
                        </div>
                    </div>
                    <a asp-controller="Home" asp-action="LiveMandi" class="btn btn-sm btn-outline-success rounded-pill fw-bold w-100">
                        View Full Mandi Price Board →
                    </a>
                </div>

                <!-- Seller Protection & Advantage Card -->
                <div class="p-4 rounded-4 border bg-success bg-opacity-10 mb-4 border-success border-opacity-25">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <h6 class="fw-bold text-success mb-0">Farmer Direct Advantage</h6>
                    </div>
                    <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                        <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> <strong>0% Brokerage:</strong> Keep 100% of your selling price.</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> <strong>Direct Buyer Connection:</strong> Connect with retail buyers across Gujarat.</li>
                        <li><i class="bi bi-check-circle-fill text-success me-1.5"></i> <strong>Transparent Payment:</strong> Secure bank &amp; UPI settlements.</li>
                    </ul>
                </div>

                <!-- Photo Tips Card -->
                <div class="p-3.5 bg-white rounded-4 border shadow-sm">
                    <h6 class="fw-bold text-dark mb-1.5 small">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i> Photo Tips for Fast Selling
                    </h6>
                    <p class="text-muted small mb-0" style="font-size: 0.80rem;">
                        Capture produce in natural daylight. Clean background and closeup grain texture increases buyer trust by 3x.
                    </p>
                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageFileInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = e.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
