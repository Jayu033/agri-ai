@model AgriAI.Domain.Entities.Product
@using AgriAI.Infrastructure.Identity
@inject Microsoft.AspNetCore.Identity.UserManager<AgriAI.Infrastructure.Identity.ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Name + " - Fresh Harvest Details";
    var imgUrl = Model.Images?.FirstOrDefault()?.ImageUrl;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var isAdmin = User.IsInRole("Admin");
    var isFarmer = User.IsInRole("Farmer");

    var currentUserId = UserManager.GetUserId(User);
    var currentUserName = User.Identity?.Name;
    var isOwnProduct = !string.IsNullOrEmpty(currentUserId) && (Model.FarmerId == currentUserId || Model.FarmerId == currentUserName);

    var farmerUser = ViewBag.FarmerUser as ApplicationUser;
    var farmerName = farmerUser != null 
        ? (!string.IsNullOrEmpty(farmerUser.FirstName) || !string.IsNullOrEmpty(farmerUser.LastName) 
            ? $"{farmerUser.FirstName} {farmerUser.LastName}".Trim() 
            : farmerUser.UserName) 
        : "Verified Gujarat Producer";
    var farmerLocation = !string.IsNullOrEmpty(farmerUser?.City) 
        ? $"{farmerUser.City}, {farmerUser.State ?? "Gujarat"} {(string.IsNullOrEmpty(farmerUser?.ZipCode) ? "" : "- " + farmerUser.ZipCode)}" 
        : (!string.IsNullOrEmpty(farmerUser?.Address) ? farmerUser.Address : "Gujarat Agricultural Farm Location");
    var maundPrice = Model.Price * 20;

    if (string.IsNullOrEmpty(returnUrl))
    {
        if (isAdmin)
        {
            returnUrl = "/Admin/Dashboard?tab=adminProductsTab";
        }
        else if (isFarmer)
        {
            returnUrl = "/Farmer/Dashboard?tab=farmerProductsTab";
        }
        else if (User.IsInRole("Customer"))
        {
            returnUrl = "/Customer/Dashboard?tab=shopTab";
        }
        else
        {
            returnUrl = Url.Action("Index", "Product") ?? "/Product";
        }
    }
}

<style>
    .product-details-hero-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 2.5rem !important;
        overflow: hidden;
    }
    .product-details-img-box {
        position: relative;
        background: #f8fafc;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        min-height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-details-img-box img {
        width: 100%;
        height: 100%;
        max-height: 440px;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .product-details-img-box:hover img {
        transform: scale(1.03);
    }
    .trust-badge-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1.25rem 0.75rem !important;
        transition: all 0.2s ease;
    }
    .trust-badge-card:hover {
        background: #f0fdf4;
        border-color: #86efac;
    }
    .qty-control-btn {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        font-size: 1.1rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #334155;
        transition: all 0.2s ease;
    }
    .qty-control-btn:hover {
        background: #006653;
        color: #ffffff;
        border-color: #006653;
    }
    .qty-display-input {
        width: 80px;
        height: 44px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        text-align: center;
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
    }
    .details-box {
        padding: 1.5rem !important;
        border-radius: 1.25rem;
        border: 1px solid #e2e8f0;
        margin-bottom: 1.5rem;
    }
</style>

<div class="container-fluid py-4 px-3 px-lg-5" style="max-width: 1360px;">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-success p-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-danger p-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Navigation Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <a href="@returnUrl" class="btn btn-outline-success rounded-pill fw-bold px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1.5 fw-bold">
                <i class="bi bi-patch-check-fill me-1"></i> Verified Direct Farm Produce
            </span>
            <span class="badge bg-light text-muted border rounded-pill px-3 py-1.5 fw-bold">
                <i class="bi bi-geo-alt-fill text-success me-1"></i> Gujarat Origin
            </span>
        </div>
    </div>

    <!-- Main Product Details Card -->
    <div class="product-details-hero-card mb-4">
        <div class="row g-4 g-lg-5">
            
            <!-- Left Column: Hero Crop Photo & Trust Seals -->
            <div class="col-lg-6">
                <div class="product-details-img-box mb-4 shadow-sm">
                    @if (!string.IsNullOrEmpty(imgUrl))
                    {
                        <img src="@imgUrl" class="img-fluid" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-tree display-1 text-success opacity-50"></i>
                            <p class="mt-2 fw-semibold">No Harvest Photo Available</p>
                        </div>
                    }
                    <span class="position-absolute top-0 start-0 m-3 badge bg-success text-white fw-bold px-3 py-1.5 rounded-pill shadow">
                        <i class="bi bi-stars me-1"></i> 100% Organic Farm Direct
                    </span>
                    <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark fw-bold px-3 py-1.5 rounded-pill shadow border">
                        <i class="bi bi-check2-circle text-success me-1"></i> Grade A Quality
                    </span>
                </div>

                <!-- 3 Buyer Protection Trust Cards -->
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="trust-badge-card text-center h-100">
                            <i class="bi bi-shield-lock-fill text-success fs-4 d-block mb-1"></i>
                            <strong class="text-dark d-block small">100% Escrow</strong>
                            <small class="text-muted" style="font-size: 0.72rem;">Funds held safe until delivery</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="trust-badge-card text-center h-100">
                            <i class="bi bi-clipboard-check-fill text-success fs-4 d-block mb-1"></i>
                            <strong class="text-dark d-block small">Pre-Delivery OTP</strong>
                            <small class="text-muted" style="font-size: 0.72rem;">Inspect before releasing OTP</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="trust-badge-card text-center h-100">
                            <i class="bi bi-truck text-success fs-4 d-block mb-1"></i>
                            <strong class="text-dark d-block small">Farm Logistics</strong>
                            <small class="text-muted" style="font-size: 0.72rem;">ST bus parcel &amp; self pickup</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Pricing, Farmer Profile & Purchase Actions -->
            <div class="col-lg-6 d-flex flex-column justify-content-between">
                <div>
                    <!-- Category & Stock Status -->
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
                        <span class="badge rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #f0fdf4; color: #006653; border: 1px solid #bbf7d0; font-size: 0.78rem;">
                            🌾 @(Model.Category?.Name ?? "Farm Produce")
                        </span>
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="badge rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #ecfdf5; color: #047857; border: 1px solid #86efac; font-size: 0.82rem;">
                                <i class="bi bi-check-circle-fill me-1 text-success"></i> @Model.StockQuantity Kg Available in Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; font-size: 0.82rem;">
                                <i class="bi bi-x-circle-fill me-1 text-danger"></i> Out of Stock
                            </span>
                        }
                    </div>

                    <!-- Title -->
                    <h1 class="fw-extrabold text-dark mb-3 display-6" style="line-height: 1.2;">@Model.Name</h1>

                    <!-- Price Box with Guaranteed 1.5rem Padding -->
                    <div class="details-box bg-light shadow-sm">
                        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-3 mb-2">
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="fs-1 fw-extrabold text-success" id="unitPriceDisplay">₹@Model.Price.ToString("N2")</span>
                                <span class="text-muted fw-bold fs-5">/ Kg</span>
                            </div>
                            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill fw-bold shadow-sm" style="font-size: 0.85rem;">
                                Equivalent: ₹@maundPrice.ToString("N0") / Maund (20 Kg)
                            </span>
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-graph-up-arrow text-success me-1"></i> Direct producer rate — Zero intermediary commissions.
                        </div>
                    </div>

                    <!-- Description Box with Guaranteed 1.5rem Padding -->
                    <div class="details-box bg-white shadow-sm">
                        <h6 class="fw-bold text-dark mb-2">Produce Description &amp; Quality Notes:</h6>
                        <p class="text-muted leading-relaxed mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                            @(string.IsNullOrEmpty(Model.Description) ? "Fresh organic farm produce harvested directly by verified Gujarat farmers. Cleaned, sorted, and ready for dispatch." : Model.Description)
                        </p>
                    </div>

                    <!-- Verified Farmer Profile Box with Guaranteed 1.5rem Padding -->
                    <div class="details-box bg-light shadow-sm">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 50px; height: 50px; min-width: 50px; background: linear-gradient(135deg, #006653 0%, #16a34a 100%);">
                                    @(!string.IsNullOrEmpty(farmerName) ? farmerName.Substring(0, 1).ToUpper() : "F")
                                </div>
                                <div>
                                    <strong class="text-dark d-block fs-6 mb-0.5">@farmerName</strong>
                                    <span class="text-muted small d-flex align-items-center gap-1">
                                        <i class="bi bi-geo-alt-fill text-success"></i> @farmerLocation
                                    </span>
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5" style="font-size: 0.78rem;">
                                    <i class="bi bi-patch-check-fill"></i> Verified Farmer &bull; Contact Unlocked on Order
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Purchase / Checkout Form Card with Guaranteed 1.5rem Padding -->
                <div class="mt-2">
                    @if (isOwnProduct)
                    {
                        <div class="details-box bg-white border shadow-sm mb-0 p-4 rounded-4">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                                    <i class="bi bi-person-check-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">🌱 Your Listed Harvest Crop</h5>
                                    <p class="text-muted small mb-0">
                                        You are the registered producer of this crop. You cannot purchase your own produce, but you can purchase from other farmers or manage your listing from the Farmer Dashboard.
                                    </p>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                <a asp-controller="Farmer" asp-action="EditProduct" asp-route-id="@Model.Id" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Crop Listing
                                </a>
                                <a asp-controller="Farmer" asp-action="Dashboard" class="btn btn-outline-dark rounded-pill px-4 py-2.5 fw-bold">
                                    <i class="bi bi-speedometer2 me-1"></i> Farmer Dashboard
                                </a>
                            </div>
                        </div>
                    }
                    else if (User.Identity == null || !User.Identity.IsAuthenticated)
                    {
                        <div class="details-box bg-white border border-success border-opacity-25 shadow-sm mb-0 p-4 rounded-4 text-center">
                            <div class="d-inline-flex p-3 bg-success bg-opacity-10 text-success rounded-circle fs-2 mb-2">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Login Required to Purchase Harvest</h5>
                            <p class="text-muted small mb-3">
                                Please log in with your Customer or Farmer account to place an order, unlock direct producer contact, and enjoy 100% Escrow Protection.
                            </p>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm" style="background-color: #006653; border-color: #006653;">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login to Buy
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success rounded-pill px-4 py-2.5 fw-bold">
                                    <i class="bi bi-person-plus me-1"></i> Register New Account
                                </a>
                            </div>
                        </div>
                    }
                    else if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Checkout" asp-action="Index" method="get" class="details-box bg-white shadow-sm mb-0">
                            <input type="hidden" name="productId" value="@Model.Id" />

                            <div class="row align-items-center g-3 mb-4 pb-3 border-bottom">
                                <div class="col-sm-6">
                                    <label class="fw-bold text-dark small mb-2 d-block">
                                        <i class="bi bi-bag-plus text-success me-1"></i> Select Quantity to Buy:
                                    </label>
                                    <div class="d-flex align-items-center gap-2">
                                        <button class="qty-control-btn" type="button" id="btnQtyMinus">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number" name="quantity" id="qtyInput" class="qty-display-input shadow-none" value="1" min="1" max="@Model.StockQuantity" required />
                                        <button class="qty-control-btn" type="button" id="btnQtyPlus">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                        <span class="fw-bold text-muted ms-1 fs-6">Kg</span>
                                    </div>
                                </div>

                                <div class="col-sm-6 text-sm-end">
                                    <span class="text-muted small fw-semibold d-block mb-1">Estimated Total Bill:</span>
                                    <span class="fs-3 fw-extrabold text-success" id="totalPricePreview">₹@Model.Price.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success btn-lg py-3 fw-bold rounded-pill shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" onclick="addToCartFromDetails()">
                                    <i class="bi bi-cart-plus fs-5"></i> Add to Cart
                                </button>
                                <button type="submit" class="btn btn-success btn-lg py-3 fw-bold rounded-pill shadow flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background-color: #006653; border-color: #006653;">
                                    <i class="bi bi-lightning-charge-fill fs-5"></i> Buy Now (<span id="btnAmountPreview">₹@Model.Price.ToString("N2")</span>)
                                </button>
                            </div>
                            <div class="text-center mt-2.5">
                                <small class="text-muted" style="font-size: 0.75rem;">
                                    <i class="bi bi-shield-check text-success me-1"></i> 100% Escrow Protected Trade &bull; Quality Checked at Farm
                                </small>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="p-4 bg-light rounded-4 border text-center">
                            <i class="bi bi-exclamation-circle text-warning fs-2 d-block mb-2"></i>
                            <h6 class="fw-bold text-dark mb-1">Harvest Currently Out of Stock</h6>
                            <p class="text-muted small mb-0">The farmer is preparing the next fresh harvest lot. Please check back soon or explore other verified crops.</p>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const unitPrice = @Model.Price;
            const maxStock = @Model.StockQuantity;
            const qtyInput = document.getElementById("qtyInput");
            const btnMinus = document.getElementById("btnQtyMinus");
            const btnPlus = document.getElementById("btnQtyPlus");
            const totalPricePreview = document.getElementById("totalPricePreview");
            const btnAmountPreview = document.getElementById("btnAmountPreview");

            if (qtyInput && btnMinus && btnPlus) {
                function updatePrice() {
                    let qty = parseInt(qtyInput.value) || 1;
                    if (qty < 1) qty = 1;
                    if (qty > maxStock && maxStock > 0) qty = maxStock;
                    qtyInput.value = qty;

                    const total = (qty * unitPrice).toFixed(2);
                    const formatted = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(total);
                    
                    if (totalPricePreview) totalPricePreview.textContent = formatted;
                    if (btnAmountPreview) btnAmountPreview.textContent = formatted;
                }

                btnMinus.addEventListener("click", function () {
                    let current = parseInt(qtyInput.value) || 1;
                    if (current > 1) {
                        qtyInput.value = current - 1;
                        updatePrice();
                    }
                });

                btnPlus.addEventListener("click", function () {
                    let current = parseInt(qtyInput.value) || 1;
                    if (current < maxStock) {
                        qtyInput.value = current + 1;
                        updatePrice();
                    }
                });

                qtyInput.addEventListener("input", updatePrice);
            }
        });

        function showFloatingToast(message, isSuccess = true) {
            let toast = document.getElementById('agriai-floating-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'agriai-floating-toast';
                toast.style.position = 'fixed';
                toast.style.bottom = '28px';
                toast.style.right = '28px';
                toast.style.zIndex = '999999';
                toast.style.transition = 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
                document.body.appendChild(toast);
            }
            toast.innerHTML = `
                <div class="alert ${isSuccess ? 'alert-success border-success' : 'alert-danger border-danger'} shadow-lg rounded-4 p-3 d-flex align-items-center gap-2 mb-0" style="min-width: 290px; background-color: #ffffff;">
                    <i class="bi ${isSuccess ? 'bi-check-circle-fill text-success' : 'bi-exclamation-circle-fill text-danger'} fs-5"></i>
                    <div class="flex-grow-1 small fw-bold text-dark">${message}</div>
                    <a href="/Customer/Dashboard?tab=cartTab" class="btn btn-xs btn-outline-success rounded-pill px-2.5 py-1 fw-bold text-nowrap">View Cart</a>
                    <button type="button" class="btn-close btn-sm shadow-none" onclick="this.closest('#agriai-floating-toast').style.display='none'"></button>
                </div>
            `;
            toast.style.display = 'block';
            setTimeout(() => {
                if (toast) toast.style.display = 'none';
            }, 4500);
        }

        function addToCartFromDetails() {
            const qty = parseInt(document.getElementById("qtyInput")?.value) || 1;
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=@Model.Id&quantity=${qty}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showFloatingToast(data.message || `🌾 ${qty} Kg of @Model.Name added to cart!`);
                } else {
                    if (data.requireLogin) {
                        showFloatingToast(data.message || 'Please log in to purchase produce.', false);
                        setTimeout(() => {
                            window.location.href = data.redirectUrl || '/Account/Login';
                        }, 1400);
                    } else {
                        showFloatingToast(data.message || 'Could not add to cart', false);
                    }
                }
            })
            .catch(err => {
                console.error(err);
                showFloatingToast('Error adding to cart', false);
            });
        }
    </script>
}
