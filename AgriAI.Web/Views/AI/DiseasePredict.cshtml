@model AgriAI.Web.ViewModels.DiseasePredictionResult
@using AgriAI.Web.ViewModels

@{
    ViewData["Title"] = "AgriAI Leaf Disease Detection - Computer Vision Pathology";
    var result = Model ?? (ViewBag.PredictionResult as DiseasePredictionResult);
    var selectedPreset = ViewBag.SelectedPreset as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/CropPredictor.css" asp-append-version="true" />
    <style>
        .disease-hero {
            background: linear-gradient(135deg, #1e3a2f 0%, #065f46 50%, #047857 100%);
            color: #ffffff;
            border-radius: 24px;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 12px 32px rgba(6, 95, 70, 0.2);
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }

        .disease-hero::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -20%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .disease-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 28px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            margin-bottom: 24px;
        }

        .upload-dropzone {
            border: 2px dashed #10b981;
            background: #f0fdf4;
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .upload-dropzone:hover, .upload-dropzone.dragover {
            background: #dcfce7;
            border-color: #059669;
            transform: translateY(-2px);
        }

        .preset-pill-btn {
            background: #ffffff;
            border: 1.5px solid #d1d5db;
            color: #374151;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 7px 14px;
            border-radius: 50px;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .preset-pill-btn:hover, .preset-pill-btn.active {
            background: #047857;
            border-color: #047857;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);
            transform: translateY(-1px);
        }

        .remedy-card {
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 12px;
            border-left: 5px solid;
            background: #f8fafc;
        }

        .remedy-chemical {
            border-left-color: #ef4444;
            background: #fef2f2;
        }

        .remedy-organic {
            border-left-color: #10b981;
            background: #f0fdf4;
        }

        .remedy-tip {
            border-left-color: #3b82f6;
            background: #eff6ff;
        }

        .preview-img-container {
            max-height: 260px;
            overflow: hidden;
            border-radius: 14px;
            border: 2px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
        }

        .preview-img-container img {
            max-width: 100%;
            max-height: 250px;
            object-fit: cover;
            border-radius: 12px;
        }
    </style>
}

<div class="crop-predictor-container">

    <!-- Top Hero Banner -->
    <div class="disease-hero">
        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
            <i class="bi bi-shield-virus me-1"></i> Computer Vision CNN Pathology Engine
        </span>
        <h1 class="crop-hero-title text-white">
            🍃 AgriAI Leaf Disease Pathology Detection
        </h1>
        <p class="crop-hero-subtitle text-white opacity-90">
            Upload leaf photo or choose Gujarat crop symptoms for instant AI disease identification, accurate chemical dosage &amp; organic remedies.
        </p>
    </div>

    <!-- Quick Presets & Switcher Row -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 px-1">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="text-muted small fw-bold"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>1-Click Test Presets:</span>
            <a asp-action="DiseasePredict" asp-route-sample="cotton_bollworm" class="preset-pill-btn @(selectedPreset == "cotton_bollworm" ? "active" : "")">
                ☁️ કપાસ ગુલાબી ઈયળ (Cotton)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="groundnut_tikka" class="preset-pill-btn @(selectedPreset == "groundnut_tikka" ? "active" : "")">
                🥜 મગફળી ટીક્કા રોગ (Groundnut)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="tomato_blight" class="preset-pill-btn @(selectedPreset == "tomato_blight" ? "active" : "")">
                🍅 ટામેટા કૂકડવા (Tomato)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="potato_late_blight" class="preset-pill-btn @(selectedPreset == "potato_late_blight" ? "active" : "")">
                🥔 બટાકા સુકારો (Potato)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="wheat_rust" class="preset-pill-btn @(selectedPreset == "wheat_rust" ? "active" : "")">
                🌾 ઘઉં ગેરુ (Wheat Rust)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="cumin_blight" class="preset-pill-btn @(selectedPreset == "cumin_blight" ? "active" : "")">
                🌿 જીરું કાળી જીરી (Cumin)
            </a>
            <a asp-action="DiseasePredict" asp-route-sample="healthy" class="preset-pill-btn @(selectedPreset == "healthy" ? "active" : "")">
                🌱 સ્વસ્થ પાન (Healthy)
            </a>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AI" asp-action="CropPredictor" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3 py-1">
                <i class="bi bi-cpu me-1"></i> Crop AI
            </a>
            <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3 py-1">
                <i class="bi bi-graph-up-arrow me-1"></i> Price AI
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Left Column: Upload / Test Form -->
        <div class="col-lg-5">
            <div class="disease-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-camera-fill text-success me-2"></i>Leaf Image Analysis
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">Live AI Model</span>
                </div>

                <form asp-action="DiseasePredict" method="post" enctype="multipart/form-data" id="diseaseForm">
                    @Html.AntiForgeryToken()

                    <!-- Dropzone -->
                    <div class="upload-dropzone mb-3" id="dropzoneBox" onclick="document.getElementById('leafImageInput').click();">
                        <i class="bi bi-cloud-arrow-up display-5 text-success mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">Click to browse or drop leaf image here</h6>
                        <p class="text-muted small mb-0">Supports JPG, PNG, WEBP (Max 10MB)</p>
                        <input type="file" id="leafImageInput" name="leafImage" accept="image/*" class="d-none" onchange="handleFileSelected(this);" />
                    </div>

                    <!-- Image Preview Area -->
                    <div id="imagePreviewContainer" class="preview-img-container mb-3 @(string.IsNullOrEmpty(result?.ImagePreviewUrl) ? "d-none" : "")">
                        <img id="imagePreview" src="@(result?.ImagePreviewUrl ?? "")" alt="Uploaded Leaf Preview" />
                    </div>

                    <!-- Quick Symptom Selector Dropdown -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Or select specific crop condition:</label>
                        <select name="sampleDisease" id="sampleDiseaseSelect" class="form-select rounded-3 py-2">
                            <option value="">-- Choose Symptoms / Crop --</option>
                            <option value="cotton_bollworm" selected="@(selectedPreset == "cotton_bollworm")">કપાસ - ગુલાબી ઈયળ &amp; સફેદ માખી (Cotton Pink Bollworm)</option>
                            <option value="groundnut_tikka" selected="@(selectedPreset == "groundnut_tikka")">મગફળી - ટીક્કા &amp; ગેરુ રોગ (Groundnut Tikka Leaf Spot)</option>
                            <option value="tomato_blight" selected="@(selectedPreset == "tomato_blight")">ટામેટા - કૂકડવા &amp; સુકારો (Tomato Leaf Curl &amp; Blight)</option>
                            <option value="potato_late_blight" selected="@(selectedPreset == "potato_late_blight")">બટાકા - પાછોતરો સુકારો (Potato Late Blight)</option>
                            <option value="wheat_rust" selected="@(selectedPreset == "wheat_rust")">ઘઉં - પીળો &amp; કથ્થાઈ ગેરુ (Wheat Rust)</option>
                            <option value="cumin_blight" selected="@(selectedPreset == "cumin_blight")">જીરું - કાળી જીરી &amp; છારો (Cumin Blight &amp; Mildew)</option>
                            <option value="healthy" selected="@(selectedPreset == "healthy")">તંદુરસ્ત પાન - કોઈ રોગ નથી (Healthy Crop Leaf)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: #047857; border-color: #047857;">
                        <i class="bi bi-search me-2"></i>Run AI Disease Diagnosis
                    </button>
                </form>

                <div class="mt-4 p-3 bg-light rounded-3 text-muted small">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>How to take the best photo:</div>
                    <ul class="mb-0 ps-3">
                        <li>Capture single leaf in clear daylight without flash glare.</li>
                        <li>Focus closely on spotted, yellowed, or damaged areas.</li>
                        <li>Turn leaf over to inspect sucking pests like whitefly/aphids.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Column: Diagnosis Result -->
        <div class="col-lg-7">
            @if (result != null)
            {
                <div class="disease-card">
                    <!-- Status Header Banner -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-size: 2.2rem;">@result.Emoji</span>
                            <div>
                                <span class="badge @result.SeverityBadgeClass rounded-pill px-2.5 py-1 mb-1 fw-bold">
                                    @result.Severity Severity &bull; @result.Confidence% AI Confidence
                                </span>
                                <h4 class="fw-bold text-dark mb-0">@result.DiseaseName</h4>
                                <h6 class="text-success fw-bold mb-0">@result.GujaratiDiseaseName</h6>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Host Crop:</span>
                            <strong class="text-dark">@result.CropName</strong>
                            <div class="text-muted small">(@result.GujaratiCropName)</div>
                        </div>
                    </div>

                    <!-- Symptoms Section -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-binoculars-fill text-warning me-1.5"></i>Diagnosed Symptoms (રોગના લક્ષણો)
                        </h6>
                        <p class="text-dark bg-light p-3 rounded-3 mb-1">
                            @result.Symptoms
                        </p>
                        @if (!string.IsNullOrEmpty(result.SymptomsGu))
                        {
                            <div class="p-2.5 rounded-3 bg-warning bg-opacity-10 text-dark small fw-semibold border border-warning border-opacity-25">
                                🌾 <strong>ગુજરાતી વિગત:</strong> @result.SymptomsGu
                            </div>
                        }
                    </div>

                    <!-- Cause & Scientific Pathology -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-bug-fill text-danger me-1.5"></i>Pathogen &amp; Environmental Cause (કારણ અને ફૂગ/જીવાત)
                        </h6>
                        <div class="p-3 bg-light rounded-3 small text-muted mb-1">
                            @result.Cause
                        </div>
                        @if (!string.IsNullOrEmpty(result.CauseGu))
                        {
                            <div class="p-2.5 rounded-3 bg-light text-dark small border">
                                💡 <strong>વાતાવરણ અને ફેલાવો:</strong> @result.CauseGu
                            </div>
                        }
                    </div>

                    <!-- Remedies Tabs -->
                    <div class="mt-4">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-capsule text-success me-1.5"></i>Recommended Treatment &amp; Dosages (સારવાર અને દવાનું પ્રમાણ)
                        </h6>

                        <!-- Chemical Treatment -->
                        @if (result.ChemicalRemedies.Any())
                        {
                            <div class="remedy-card remedy-chemical">
                                <div class="fw-bold text-danger mb-2">
                                    <i class="bi bi-shield-exclamation me-1"></i>Chemical Prescription (રાસાયણિક જંતુનાશક દવાઓ):
                                </div>
                                <ul class="mb-0 ps-3 small text-dark">
                                    @for (int i = 0; i < result.ChemicalRemedies.Count; i++)
                                    {
                                        <li class="mb-1">
                                            <strong>@result.ChemicalRemedies[i]</strong>
                                            @if (i < result.ChemicalRemediesGu.Count)
                                            {
                                                <div class="text-danger-emphasis small">(@result.ChemicalRemediesGu[i])</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Organic Treatment -->
                        @if (result.OrganicRemedies.Any())
                        {
                            <div class="remedy-card remedy-organic">
                                <div class="fw-bold text-success mb-2">
                                    <i class="bi bi-tree me-1"></i>Organic &amp; Bio-Control (ઓર્ગેનિક અને દેશી ઉપચાર):
                                </div>
                                <ul class="mb-0 ps-3 small text-dark">
                                    @for (int i = 0; i < result.OrganicRemedies.Count; i++)
                                    {
                                        <li class="mb-1">
                                            <strong>@result.OrganicRemedies[i]</strong>
                                            @if (i < result.OrganicRemediesGu.Count)
                                            {
                                                <div class="text-success-emphasis small">(@result.OrganicRemediesGu[i])</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Preventive Cultural Practices -->
                        @if (result.PreventiveTips.Any())
                        {
                            <div class="remedy-card remedy-tip">
                                <div class="fw-bold text-primary mb-2">
                                    <i class="bi bi-lightbulb me-1"></i>Agronomic Prevention (અગમચેતી અને સાવચેતી):
                                </div>
                                <ul class="mb-0 ps-3 small text-dark">
                                    @for (int i = 0; i < result.PreventiveTips.Count; i++)
                                    {
                                        <li class="mb-1">
                                            <strong>@result.PreventiveTips[i]</strong>
                                            @if (i < result.PreventiveTipsGu.Count)
                                            {
                                                <div class="text-primary-emphasis small">(@result.PreventiveTipsGu[i])</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <!-- Ask AgriAI Chatbot Assistant -->
                    <div class="mt-4 p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <strong class="text-success d-block small">Need customized spray advice?</strong>
                            <span class="text-muted small">Ask our 24/7 AgriAI Advisory Chatbot at bottom right for immediate help in Gujarati!</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold shadow-sm" onclick="openChatWithQuery('કપાસ માં ગુલાબી ઈયળ માટે કઈ દવા છાંટવી?')">
                            <i class="bi bi-chat-dots-fill me-1"></i> Ask Advisory Bot
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Initial State Placeholder -->
                <div class="disease-card text-center py-5">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No Diagnosis Selected Yet</h5>
                    <p class="text-muted small max-w-md mx-auto mb-4" style="max-width: 420px;">
                        Upload a photo of an affected leaf or click any of the <strong>1-Click Test Presets</strong> above (e.g. Cotton, Groundnut, Tomato, Potato) to view instant AI pathology analysis.
                    </p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-action="DiseasePredict" asp-route-sample="cotton_bollworm" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3">
                            ☁️ Test Cotton Bollworm
                        </a>
                        <a asp-action="DiseasePredict" asp-route-sample="groundnut_tikka" class="btn btn-sm btn-outline-warning text-dark rounded-pill fw-bold px-3">
                            🥜 Test Groundnut Tikka
                        </a>
                        <a asp-action="DiseasePredict" asp-route-sample="potato_late_blight" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3">
                            🥔 Test Potato Blight
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleFileSelected(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('imagePreview');
                    const container = document.getElementById('imagePreviewContainer');
                    if (img && container) {
                        img.src = e.target.result;
                        container.classList.remove('d-none');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Drag and drop handlers
        const dropzone = document.getElementById('dropzoneBox');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    const fileInput = document.getElementById('leafImageInput');
                    fileInput.files = files;
                    handleFileSelected(fileInput);
                }
            }, false);
        }

        function openChatWithQuery(query) {
            const chatToggle = document.getElementById('chatbot-toggle-btn') || document.querySelector('.chatbot-float-btn');
            if (chatToggle) {
                chatToggle.click();
                setTimeout(() => {
                    const input = document.getElementById('chatbot-input');
                    if (input) {
                        input.value = query;
                        const sendBtn = document.getElementById('chatbot-send-btn');
                        if (sendBtn) sendBtn.click();
                    }
                }, 400);
            }
        }
    </script>
}
