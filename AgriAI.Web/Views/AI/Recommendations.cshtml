@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "AI Recommendations";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold"><i class="bi bi-stars text-warning me-2"></i>Smart Recommendations</h2>
                <p class="text-muted">Products specifically curated for you by our Machine Learning engine.</p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="glass-panel p-4 h-100 position-relative overflow-hidden">
                        <div class="position-absolute top-0 end-0 p-2 bg-success text-white small fw-bold rounded-bottom-start">
                            @item.MatchScore Match
                        </div>
                        <div class="text-center mb-3 mt-2">
                            <i class="bi bi-box-seam display-4 text-primary"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">@item.Name</h5>
                        <p class="text-muted small text-center mb-4"><i class="bi bi-info-circle me-1"></i>@item.Reason</p>
                        
                        <div class="d-grid mt-auto">
                            <button class="btn btn-outline-primary">View Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
