@model AgriAI.Web.ViewModels.CropPredictorInputModel
@using AgriAI.Web.ViewModels

@{
    ViewData["Title"] = "AgriAI Crop Predictor - Machine Learning Soil & Weather Analysis";
    var result = ViewBag.PredictionResult as CropPredictionResult;
}

@section Styles {
    <link rel="stylesheet" href="~/css/CropPredictor.css" asp-append-version="true" />
}

<div class="container-fluid py-3 px-2 px-md-3 px-xl-4 crop-predictor-container" style="max-width: 1680px;">

    <!-- Top Hero Banner (Matching Exact Layout, Height & Width of Shop Product) -->
    <div class="crop-predictor-hero shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="agri-page-badge">
                    <i class="bi bi-cpu"></i>
                    <span>AI Soil &amp; Crop Intelligence</span>
                </div>
                <h1 class="agri-page-title">
                    AgriAI Crop Predictor
                </h1>
                <p class="agri-page-subtitle">
                    Enter your soil metrics and climate data to get instant, accurate crop recommendations for maximum yield.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-light text-success fw-bold px-4 py-2.5 rounded-pill shadow">
                    <i class="bi bi-graph-up-arrow me-1"></i> AI Price Predictor
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Presets Bar (Auto-Fill Benchmarks) -->
    <div class="crop-presets-wrapper mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2.5">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.82rem;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Soil Presets
                </span>
                <span class="text-muted small">Select any soil profile to auto-fill laboratory parameters:</span>
            </div>
            <span class="badge bg-white text-dark border shadow-xs rounded-pill px-3 py-1.5 small fw-semibold">
                <i class="bi bi-cpu text-success me-1"></i> 28+ Crops Trained
            </span>
        </div>

        <div class="crop-presets-grid">
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(90, 42, 43, 20.8, 82.0, 6.5)">
                <span class="chip-icon">🌾</span>
                <span class="chip-info">
                    <span class="chip-title">Alluvial Loam</span>
                    <span class="chip-sub">Rice &bull; Wheat</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(120, 46, 20, 24.0, 79.8, 6.8)">
                <span class="chip-icon">☁️</span>
                <span class="chip-info">
                    <span class="chip-title">Black Regur</span>
                    <span class="chip-sub">Cotton (Kapas)</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(35, 40, 45, 26.0, 60.0, 6.5)">
                <span class="chip-icon">🥜</span>
                <span class="chip-info">
                    <span class="chip-title">Saurashtra Loam</span>
                    <span class="chip-sub">Groundnut</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(40, 30, 30, 21.0, 50.0, 7.2)">
                <span class="chip-icon">🌿</span>
                <span class="chip-info">
                    <span class="chip-title">North Gujarat Arid</span>
                    <span class="chip-sub">Cumin &bull; Jeera</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(40, 68, 80, 19.0, 17.0, 7.3)">
                <span class="chip-icon">🌱</span>
                <span class="chip-info">
                    <span class="chip-title">Winter Heavy Clay</span>
                    <span class="chip-sub">Chickpea &bull; Chana</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(50, 40, 35, 25.0, 60.0, 6.5)">
                <span class="chip-icon">🍃</span>
                <span class="chip-info">
                    <span class="chip-title">Semi-Arid Dryland</span>
                    <span class="chip-sub">Castor (Divela)</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(100, 50, 100, 18.0, 75.0, 5.8)">
                <span class="chip-icon">🥔</span>
                <span class="chip-info">
                    <span class="chip-title">Sandy Alluvial</span>
                    <span class="chip-sub">Potato &bull; Onion</span>
                </span>
            </button>
            <button type="button" class="soil-preset-chip" onclick="applySoilPreset(20, 20, 40, 22.0, 90.0, 6.4)">
                <span class="chip-icon">🍎</span>
                <span class="chip-info">
                    <span class="chip-title">Horticulture Drip</span>
                    <span class="chip-sub">Pomegranate</span>
                </span>
            </button>
        </div>
    </div>

    <!-- Main Soil & Weather Input Form Card -->
    <div class="crop-form-card mb-4 shadow-sm">
        <div class="crop-form-heading">
            <div>
                <h5 class="fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-sliders2-vertical text-success"></i>
                    Enter Soil &amp; Climate Parameters
                </h5>
                <p class="text-muted small mb-0">Input laboratory soil nutrient levels (N-P-K) and environmental conditions for optimal crop selection.</p>
            </div>
            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1.5 rounded-pill border border-success border-opacity-25 font-monospace" style="font-size: 0.78rem;">
                <i class="bi bi-cpu-fill me-1"></i> ML Random Forest V2.4
            </span>
        </div>

        <form asp-action="PredictCrop" method="post" id="cropPredictorForm">
            <!-- Parameter Section 1: Soil Nutrients -->
            <div class="param-section-box mb-3.5">
                <div class="param-section-header">
                    <i class="bi bi-flower1 text-success fs-5"></i>
                    <h6 class="param-section-title m-0">Soil Macro-Nutrients (N - P - K)</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputN">
                                Nitrogen (N)
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-leaf-fill crop-input-icon text-success"></i>
                                <input type="number" step="any" class="form-control crop-input-field" id="inputN" name="Nitrogen" value="@Model.Nitrogen" placeholder="e.g. 90" required />
                                <span class="crop-input-unit">Ratio / ppm</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputP">
                                Phosphorus (P)
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-sun-fill crop-input-icon text-warning"></i>
                                <input type="number" step="any" class="form-control crop-input-field" id="inputP" name="Phosphorus" value="@Model.Phosphorus" placeholder="e.g. 42" required />
                                <span class="crop-input-unit">Ratio / ppm</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputK">
                                Potassium (K)
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-gem crop-input-icon text-danger"></i>
                                <input type="number" step="any" class="form-control crop-input-field" id="inputK" name="Potassium" value="@Model.Potassium" placeholder="e.g. 43" required />
                                <span class="crop-input-unit">Ratio / ppm</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Parameter Section 2: Climate & Soil Chemistry -->
            <div class="param-section-box mb-4">
                <div class="param-section-header">
                    <i class="bi bi-cloud-sun-fill text-primary fs-5"></i>
                    <h6 class="param-section-title m-0">Climate &amp; Environmental Factors</h6>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputTemp">
                                Average Temperature
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-thermometer-half crop-input-icon text-danger"></i>
                                <input type="number" step="any" class="form-control crop-input-field" id="inputTemp" name="Temperature" value="@Model.Temperature" placeholder="e.g. 20.8" required />
                                <span class="crop-input-unit">°C</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputHumidity">
                                Relative Humidity
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-droplet-half crop-input-icon text-primary"></i>
                                <input type="number" step="any" class="form-control crop-input-field" id="inputHumidity" name="Humidity" value="@Model.Humidity" placeholder="e.g. 82.0" required />
                                <span class="crop-input-unit">%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="crop-input-group">
                            <label class="crop-input-label" for="inputPh">
                                Soil pH Value
                            </label>
                            <div class="crop-input-wrapper">
                                <i class="bi bi-speedometer2 crop-input-icon text-info"></i>
                                <input type="number" step="any" min="0" max="14" class="form-control crop-input-field" id="inputPh" name="PhValue" value="@Model.PhValue" placeholder="e.g. 6.5" required />
                                <span class="crop-input-unit">pH (0-14)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-predict-crop" id="btnPredictSubmit">
                <i class="bi bi-stars fs-5"></i>
                <span>Run AI Crop Recommendation</span>
            </button>
        </form>
    </div>

    <!-- Prediction Results Section (Displays on Result) -->
    @if (result != null)
    {
        <div class="crop-result-container" id="predictionResultCard">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="crop-result-badge">
                    <i class="bi bi-patch-check-fill text-success"></i> AI Recommendation Found
                </div>
                <div class="crop-match-pill">
                    <i class="bi bi-stars"></i> @result.MatchScore% Optimal Match
                </div>
            </div>

            <div class="row align-items-center g-4 mb-4">
                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-4 bg-success bg-opacity-10 d-flex align-items-center justify-content-center p-3 border border-success border-opacity-25" style="width: 80px; height: 80px; font-size: 2.8rem;">
                            @result.Emoji
                        </div>
                        <div>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold small mb-1">
                                @result.Category
                            </span>
                            <h2 class="crop-result-title m-0">@result.CropName</h2>
                            <strong class="text-success fs-5">@result.GujaratiName</strong>
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0 leading-relaxed">
                        @result.Description
                    </p>
                </div>

                <div class="col-md-5">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="crop-stat-box">
                                <div class="label">Sowing Season</div>
                                <div class="value text-success">@result.Season</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="crop-stat-box">
                                <div class="label">Expected Yield</div>
                                <div class="value">@result.ExpectedYield</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="crop-stat-box">
                                <div class="label">Growth Period</div>
                                <div class="value">@result.GrowthDuration</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="crop-stat-box">
                                <div class="label">Avg APMC Rate</div>
                                <div class="value text-success">₹@result.EstimatedPricePerQtl.ToString("N0") / Qtl</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Agronomy Soil & Care Advice -->
            <div class="p-3.5 bg-light rounded-4 border mb-4">
                <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-lightbulb-fill text-warning"></i> Soil Care &amp; Best Practices
                </h6>
                <p class="text-muted small mb-0">
                    @result.SoilAdvice
                </p>
            </div>

            <!-- Top 3 Alternative Crops -->
            @if (result.TopAlternatives.Any())
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2">Alternative Crop Recommendations:</h6>
                    <div class="row g-2">
                        @foreach (var alt in result.TopAlternatives)
                        {
                            <div class="col-md-4">
                                <div class="alternative-crop-item">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-4">@alt.Emoji</span>
                                        <div>
                                            <strong class="text-dark d-block small">@alt.CropName</strong>
                                            <span class="text-muted" style="font-size: 0.72rem;">@alt.Category</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold">@alt.MatchScore%</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Action CTAs -->
            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a asp-controller="AI" asp-action="PricePredictor" class="btn btn-sm btn-success rounded-pill fw-bold px-3.5 py-2 shadow-sm" style="background-color: #006653; border-color: #006653;">
                    <i class="bi bi-graph-up me-1"></i> Forecast Price for @result.CropName
                </a>
                <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3.5 py-2">
                    <i class="bi bi-basket2 me-1"></i> Shop Quality Seeds &amp; Fertilizers
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold px-3 py-2 ms-auto" onclick="document.getElementById('inputN').focus();">
                    <i class="bi bi-arrow-repeat me-1"></i> Test Another Sample
                </button>
            </div>
        </div>
    }

</div>

<!-- Auth Required Modal for Guests -->
<div class="modal fade" id="authRequiredModal" tabindex="-1" aria-labelledby="authRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3 p-md-4 text-center position-relative">
            <button type="button" class="btn-close position-absolute top-0 end-0 m-3 shadow-none" data-bs-dismiss="modal" aria-label="Close" style="z-index: 1065; cursor: pointer;"></button>
            <div class="modal-body p-2">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                    <i class="bi bi-stars"></i>
                </div>
                <h4 class="fw-extrabold text-dark mb-1" id="authRequiredModalLabel">Unlock AI Prediction</h4>
                <p class="text-muted small mb-4">
                    Please log in with your existing account or create a free account to generate AI crop recommendations based on your soil parameters.
                </p>
                <div class="d-grid gap-2 mb-3">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/AI/CropPredictor" class="btn btn-success btn-lg rounded-pill fw-bold py-2.5 shadow-sm" style="background-color: #006653; border-color: #006653;">
                        <i class="bi bi-box-arrow-in-right me-1.5"></i> Login to Predict
                    </a>
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="/AI/CropPredictor" class="btn btn-outline-success btn-lg rounded-pill fw-bold py-2.5">
                        <i class="bi bi-person-plus me-1.5"></i> Register New Account
                    </a>
                </div>
                <button type="button" class="btn btn-link text-muted small text-decoration-none shadow-none" data-bs-dismiss="modal" style="cursor: pointer;">
                    Continue Browsing Parameters
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");

        document.getElementById('cropPredictorForm')?.addEventListener('submit', function (e) {
            if (!isAuthenticated) {
                e.preventDefault();
                const modalEl = document.getElementById('authRequiredModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        });

        function applySoilPreset(n, p, k, temp, hum, ph) {
            document.getElementById('inputN').value = n;
            document.getElementById('inputP').value = p;
            document.getElementById('inputK').value = k;
            document.getElementById('inputTemp').value = temp;
            document.getElementById('inputHumidity').value = hum;
            document.getElementById('inputPh').value = ph;

            // Highlight button
            const btn = document.getElementById('btnPredictSubmit');
            btn.classList.add('pulse-glow');
            setTimeout(() => btn.classList.remove('pulse-glow'), 600);
        }

        // Auto-scroll to results if present
        document.addEventListener("DOMContentLoaded", function () {
            const resultCard = document.getElementById("predictionResultCard");
            if (resultCard) {
                resultCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        });
    </script>
}
