@model AgriAI.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Account Profile & Settings - AgriAI";
    var userInitial = (!string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : (!string.IsNullOrEmpty(Model.Username) ? Model.Username.Substring(0, 1).ToUpper() : "U"));
    var isFarmer = User.IsInRole("Farmer") || Model.Role == "Farmer";
    var userRole = User.IsInRole("Admin") ? "Admin" : (isFarmer ? "Farmer" : "Customer");
    var dashCtrl = User.IsInRole("Admin") ? "Admin" : (isFarmer ? "Farmer" : "Customer");
}

@section Styles {
    <style>
        .profile-container {
            max-width: 1480px;
            margin: 0 auto;
        }

        .profile-hero-header {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border-radius: 1.25rem;
            padding: 2.25rem 2rem;
            color: #ffffff;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.08);
            animation: profileFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .profile-hero-header::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 220px;
            height: 220px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            pointer-events: none;
        }

        .profile-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 30px;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            margin-bottom: 10px;
            backdrop-filter: blur(8px);
        }

        .profile-hero-title {
            font-size: 2.15rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .profile-hero-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.88);
            max-width: 760px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        .profile-unified-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05);
            padding: 2.25rem 2.5rem;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            animation: profileFadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .profile-unified-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #006653 0%, #10b981 50%, #cb9d46 100%);
        }

        .profile-card-header {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 1.25rem;
            margin-bottom: 2rem;
        }

        .profile-showcase-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 1.75rem 1.5rem;
        }

        .profile-avatar-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .profile-avatar-circle {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: linear-gradient(135deg, #006653 0%, #10b981 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.25rem;
            font-weight: 800;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.2);
            object-fit: cover;
        }

        .profile-avatar-img {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.2);
            object-fit: cover;
        }

        .profile-avatar-edit-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #006653;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #ffffff;
            font-size: 0.85rem;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            transition: all 0.2s ease;
        }

        .profile-avatar-edit-btn:hover {
            background: #047857;
            transform: scale(1.1);
        }

        .profile-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.65rem 0;
            border-bottom: 1px dashed #e2e8f0;
            font-size: 0.85rem;
        }

        .profile-section-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .profile-section-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        }

        .profile-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 0.85rem;
            margin-bottom: 1.25rem;
            border-bottom: 1.5px solid #f1f5f9;
        }

        .profile-input-group .input-group-text {
            border-color: #e2e8f0;
            color: #64748b;
        }

        .profile-input-group .form-control {
            border-color: #e2e8f0;
            font-size: 0.90rem;
            color: #1e293b;
        }

        .profile-input-group .form-control:focus {
            border-color: #006653;
            box-shadow: 0 0 0 3px rgba(0, 102, 83, 0.12);
        }

        .profile-security-box {
            background: #fff5f5;
            border: 1.5px solid #fed7d7;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .profile-password-box {
            background: #f0fdf4;
            border: 1.5px solid #bbf7d0;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .btn-save-profile {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.75rem 2.5rem;
            border: none;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.25);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-save-profile:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 102, 83, 0.35);
        }

        .btn-cancel-profile {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.75rem 1.75rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-cancel-profile:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

        .pwd-toggle-btn {
            cursor: pointer;
            border: 1px solid #e2e8f0;
            border-left: 0;
            background: #f8fafc;
            color: #64748b;
        }

        .pwd-toggle-btn:hover {
            color: #006653;
        }

        @@keyframes profileFadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 991px) {
            .profile-unified-card { padding: 1.5rem 1.25rem; }
            .profile-hero-header { padding: 1.75rem 1.25rem; }
            .profile-hero-title { font-size: 1.75rem; }
        }
    </style>
}

<div class="profile-container py-3 px-2 px-md-3 px-xl-4" style="min-height: calc(100vh - 180px);">
    
    <!-- Hero Header Banner -->
    <div class="profile-hero-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="profile-hero-badge">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>@userRole Profile &bull; Identity &amp; Banking Portal</span>
                </div>
                <h1 class="profile-hero-title">
                    My Account Profile &amp; Settings
                </h1>
                <p class="profile-hero-subtitle">
                    Manage your personal credentials, farm address, banking payout details, and security passwords in one place.
                </p>
            </div>
            <div>
                <a asp-controller="@dashCtrl" asp-action="Dashboard" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-success">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3.5 mb-4 shadow-sm border-0 d-flex align-items-center justify-content-between" style="background-color: #d1fae5; color: #065f46;" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Unified Master Card -->
    <div class="profile-unified-card shadow-sm">
        
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3 border-0 shadow-xs"></div>

            <div class="row g-4 g-xl-5 align-items-start">
                
                <!-- Left Sidebar: Profile Showcase Card -->
                <div class="col-lg-4 col-xl-3.5">
                    <div class="profile-showcase-card text-center mb-4">
                        <div class="profile-avatar-wrapper">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                            {
                                <img src="@Model.ProfilePicturePath" id="profileAvatarDisplay" class="profile-avatar-img" alt="Profile Picture" />
                            }
                            else
                            {
                                <div class="profile-avatar-circle" id="profileAvatarInitial">
                                    @userInitial
                                </div>
                            }
                            <label for="newProfilePicInput" class="profile-avatar-edit-btn" title="Change Photo">
                                <i class="bi bi-camera-fill"></i>
                            </label>
                            <input type="file" id="newProfilePicInput" name="NewProfilePictureFile" class="d-none" accept="image/*" onchange="previewNewPhoto(this)" />
                        </div>
                        
                        <h4 class="fw-bold text-dark mb-1">
                            @(string.IsNullOrEmpty(Model.FirstName) && string.IsNullOrEmpty(Model.LastName) ? Model.Username : $"{Model.FirstName} {Model.LastName}")
                        </h4>
                        <p class="text-muted small mb-2 d-flex align-items-center justify-content-center gap-1.5">
                            <i class="bi bi-envelope text-success"></i>
                            <span>@Model.Email</span>
                        </p>
                        
                        <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 bg-success bg-opacity-10 text-success rounded-pill fw-bold small border border-success border-opacity-25 mb-3">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>@userRole Account</span>
                        </div>

                        <!-- Sidebar Quick Details -->
                        <div class="profile-details-list text-start">
                            <div class="profile-detail-row">
                                <span class="text-muted d-flex align-items-center gap-1.5">
                                    <i class="bi bi-at text-muted"></i> Username:
                                </span>
                                <strong class="text-dark font-monospace">@@@Model.Username</strong>
                            </div>
                            <div class="profile-detail-row">
                                <span class="text-muted d-flex align-items-center gap-1.5">
                                    <i class="bi bi-telephone text-success"></i> WhatsApp:
                                </span>
                                <strong class="text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not added" : Model.PhoneNumber)</strong>
                            </div>
                            @if (isFarmer)
                            {
                                <div class="profile-detail-row">
                                    <span class="text-muted d-flex align-items-center gap-1.5">
                                        <i class="bi bi-shield-check text-success"></i> KYC Status:
                                    </span>
                                    @if (Model.IsApprovedByAdmin)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2.5 py-1 rounded-pill">Verified 🟢</span>
                                    }
                                    else if (!string.IsNullOrEmpty(Model.KycRejectionReason))
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2.5 py-1 rounded-pill">Rejected 🔴</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning fw-bold px-2.5 py-1 rounded-pill">Pending Review ⏳</span>
                                    }
                                </div>
                                <div class="profile-detail-row">
                                    <span class="text-muted d-flex align-items-center gap-1.5">
                                        <i class="bi bi-bank text-primary"></i> Payout Bank:
                                    </span>
                                    <strong class="text-dark text-truncate" style="max-width: 140px;">@(Model.BankName ?? "Not Set")</strong>
                                </div>
                            }
                            <div class="profile-detail-row border-0 pb-0">
                                <span class="text-muted d-flex align-items-center gap-1.5">
                                    <i class="bi bi-geo-alt-fill text-danger opacity-75"></i> Location:
                                </span>
                                <strong class="text-dark">@(string.IsNullOrEmpty(Model.City) ? "Gujarat, India" : Model.City)</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Trust Shield Box -->
                    <div class="p-3.5 rounded-4 bg-light border border-slate-200 text-start">
                        <div class="d-flex align-items-start gap-2.5">
                            <i class="bi bi-shield-lock-fill text-success fs-4"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">Escrow &amp; Bank Protected</h6>
                                <p class="text-muted small mb-0" style="font-size: 0.78rem; line-height: 1.4;">
                                    Your personal information and payout bank details are encrypted and securely verified on AgriAI.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Main Column: Full Profile Information & Editable Fields -->
                <div class="col-lg-8 col-xl-8.5">

                    <!-- SECTION 1: Personal Credentials -->
                    <div class="profile-section-card">
                        <div class="profile-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                                    <i class="bi bi-person-badge-fill fs-5"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">Personal Credentials</h5>
                                    <small class="text-muted">Basic name, contact details, and account identifier</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-muted border small">Step 1 Details</span>
                        </div>

                        <!-- Name Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold text-dark small mb-1">First Name</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FirstName" class="form-control border-start-0 py-2.5 shadow-none" placeholder="First Name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-dark small mb-1">Last Name</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="LastName" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Last Name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Username & Phone Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-bold text-dark small mb-1">Username (Login ID)</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted fw-bold font-monospace">@@</span>
                                    <input asp-for="Username" class="form-control border-start-0 py-2.5 shadow-none font-monospace" placeholder="Username" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-dark small mb-1">
                                    Phone Number (WhatsApp OTP)
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 ms-1 fw-normal" style="font-size: 0.68rem;">Verified</span>
                                </label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-whatsapp"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control border-start-0 py-2.5 shadow-none font-monospace" placeholder="+91 98765 43210" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Email Address (Readonly) -->
                        <div>
                            <label class="form-label fw-bold text-dark small mb-1">Email Address (Registered Primary)</label>
                            <div class="input-group profile-input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 py-2.5 bg-light text-muted shadow-none" value="@Model.Email" readonly />
                                <span class="input-group-text bg-light border-start-0 text-muted small"><i class="bi bi-lock-fill"></i></span>
                            </div>
                            <small class="text-muted d-block mt-1" style="font-size: 0.76rem;"><i class="bi bi-shield-check me-1 text-success"></i>Verified primary email. Used for transaction receipts and notifications.</small>
                        </div>
                    </div>

                    @if (isFarmer)
                    {
                        <!-- SECTION 2: Farm Location & Address -->
                        <div class="profile-section-card">
                            <div class="profile-section-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                                        <i class="bi bi-geo-alt-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Farm &amp; Field Location</h5>
                                        <small class="text-muted">Where your agricultural crops are cultivated or stored for pickup</small>
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border small">Logistics</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label asp-for="City" class="form-label fw-bold text-dark small mb-1">Village / Taluka / District</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-buildings"></i></span>
                                        <input asp-for="City" class="form-control border-start-0 py-2.5 shadow-none" placeholder="e.g. Gondal, Rajkot" />
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <label asp-for="Address" class="form-label fw-bold text-dark small mb-1">Farm / Street Location / Survey No.</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-pin-map"></i></span>
                                        <input asp-for="Address" class="form-control border-start-0 py-2.5 shadow-none" placeholder="e.g. Survey No. 42, Near APMC Market Road" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Banking & Payout Setup -->
                        <div class="profile-section-card">
                            <div class="profile-section-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                                        <i class="bi bi-bank fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Bank Payout Information</h5>
                                        <small class="text-muted">Direct Escrow payout account for crop sale proceeds</small>
                                    </div>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small fw-bold">100% Escrow Direct</span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="BankName" class="form-label fw-bold text-dark small mb-1">Bank Name</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-bank"></i></span>
                                        <input asp-for="BankName" class="form-control border-start-0 py-2.5 shadow-none" placeholder="e.g. State Bank of India (SBI)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="BankAccountNumber" class="form-label fw-bold text-dark small mb-1">Bank Account Number</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-credit-card"></i></span>
                                        <input asp-for="BankAccountNumber" class="form-control border-start-0 py-2.5 shadow-none font-monospace" placeholder="e.g. 123456789012" />
                                    </div>
                                    <span asp-validation-for="BankAccountNumber" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="BankIfscCode" class="form-label fw-bold text-dark small mb-1">IFSC Code</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-hash"></i></span>
                                        <input asp-for="BankIfscCode" class="form-control border-start-0 py-2.5 shadow-none font-monospace text-uppercase" placeholder="e.g. SBIN0001234" />
                                    </div>
                                    <span asp-validation-for="BankIfscCode" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="UpiId" class="form-label fw-bold text-dark small mb-1">UPI ID (Optional)</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-qr-code"></i></span>
                                        <input asp-for="UpiId" class="form-control border-start-0 py-2.5 shadow-none font-monospace" placeholder="e.g. 9724560047@upi" />
                                    </div>
                                    <span asp-validation-for="UpiId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 4: Land Ownership & KYC Verification -->
                        <div class="profile-section-card">
                            <div class="profile-section-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                                        <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">Land Record &amp; KYC Verification</h5>
                                        <small class="text-muted">Official 7/12 (Satbara) or Aadhaar Card documentation</small>
                                    </div>
                                </div>
                                @if (Model.IsApprovedByAdmin)
                                {
                                    <span class="badge bg-success text-white px-3 py-1.5 rounded-pill small fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Verified by Admin
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(Model.KycRejectionReason))
                                {
                                    <span class="badge bg-danger text-white px-3 py-1.5 rounded-pill small fw-bold">
                                        <i class="bi bi-x-circle-fill me-1"></i>Action Required
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill small fw-bold">
                                        <i class="bi bi-hourglass-split me-1"></i>Under Admin Review
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(Model.KycRejectionReason))
                            {
                                <div class="alert alert-danger p-3 rounded-3 small mb-3">
                                    <strong>Admin Rejection Note:</strong> @Model.KycRejectionReason
                                    <div class="mt-1">Please re-upload a clear document image or PDF below to resubmit.</div>
                                </div>
                            }

                            <div class="row g-3 align-items-center">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold text-dark small mb-1">Document Type</label>
                                    <div class="input-group profile-input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-checklist"></i></span>
                                        <select asp-for="KycDocumentType" class="form-select border-start-0 py-2.5 shadow-none">
                                            <option value="7/12 (Satbara Utaro)">7/12 (Satbara Utaro)</option>
                                            <option value="Aadhaar Card">Aadhaar Card</option>
                                            <option value="Kisan Credit Card (KCC)">Kisan Credit Card (KCC)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-7">
                                    <label class="form-label fw-bold text-dark small mb-1">
                                        Current Document &amp; Update
                                    </label>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(Model.KycDocumentPath))
                                        {
                                            <a href="@Model.KycDocumentPath" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs">
                                                <i class="bi bi-file-earmark-arrow-down-fill"></i> View Current 7/12 File
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No file uploaded</span>
                                        }
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-bold" onclick="document.getElementById('newKycInput').click()">
                                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload New File
                                        </button>
                                        <input type="file" id="newKycInput" name="NewKycDocumentFile" class="d-none" accept="image/*,.pdf" onchange="showKycFileSelected(this)" />
                                    </div>
                                    <small id="kycFileStatusText" class="text-muted d-block mt-1.5" style="font-size: 0.74rem;"></small>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- SECTION 5: Change Password & Security (NEW FEATURE!) -->
                    <div class="profile-password-box">
                        <div class="d-flex align-items-center justify-content-between pb-2.5 mb-3 border-bottom border-success border-opacity-25">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-success bg-opacity-20 text-success p-2">
                                    <i class="bi bi-shield-lock-fill fs-5"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">Change Password (પાસવર્ડ બદલો)</h5>
                                    <small class="text-muted">Leave new password blank if you do not want to change it</small>
                                </div>
                            </div>
                            <span class="badge bg-white text-dark border small fw-bold">Optional</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-bold text-dark small mb-1">New Password</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                    <input asp-for="NewPassword" type="password" id="inputNewPassword" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Min. 6 characters" />
                                    <button type="button" class="btn pwd-toggle-btn" onclick="togglePasswordVisibility('inputNewPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-bold text-dark small mb-1">Confirm New Password</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                    <input asp-for="ConfirmNewPassword" type="password" id="inputConfirmPassword" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Repeat new password" />
                                    <button type="button" class="btn pwd-toggle-btn" onclick="togglePasswordVisibility('inputConfirmPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 6: Current Password Authorization Box -->
                    <div class="profile-security-box">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 d-inline-flex">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-danger mb-0">Current Password Required for Authorization</h6>
                                <small class="text-muted">Enter your current password to confirm and authorize changes to your profile and banking information</small>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold text-dark small mb-1">
                                Current Account Password <span class="text-danger">*</span>
                            </label>
                            <div class="input-group profile-input-group" style="max-width: 420px;">
                                <span class="input-group-text bg-white border-end-0 text-danger"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="CurrentPassword" type="password" id="inputCurrentPassword" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Enter current password" required />
                                <button type="button" class="btn pwd-toggle-btn" onclick="togglePasswordVisibility('inputCurrentPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                        <a asp-controller="@dashCtrl" asp-action="Dashboard" class="btn btn-cancel-profile">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-save-profile">
                            <i class="bi bi-check2-circle fs-5 me-1"></i> Save Profile &amp; Settings
                        </button>
                    </div>

                </div>
            </div>
        </form>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewNewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const avatarImg = document.getElementById('profileAvatarDisplay');
                    const initialCircle = document.getElementById('profileAvatarInitial');
                    if (avatarImg) {
                        avatarImg.src = e.target.result;
                    } else if (initialCircle) {
                        initialCircle.outerHTML = '<img src="' + e.target.result + '" id="profileAvatarDisplay" class="profile-avatar-img" alt="Profile Picture" />';
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function showKycFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const statusEl = document.getElementById('kycFileStatusText');
                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Selected: ' + file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)</span>';
                }
            }
        }

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }
        }
    </script>
}
