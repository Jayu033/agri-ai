@model AgriAI.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Account Profile & Settings - AgriAI";
    var userInitial = (!string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : (!string.IsNullOrEmpty(Model.Username) ? Model.Username.Substring(0, 1).ToUpper() : "U"));
    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Farmer") ? "Farmer" : "Customer";
    var dashCtrl = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Farmer") ? "Farmer" : "Customer";
}

@section Styles {
    <style>
        .profile-container {
            max-width: 1680px;
            margin: 0 auto;
        }

        /* 1. Hero Header Banner (Matching Exact Layout of Shop Products, Price Predictor & Live Mandi) */
        .profile-hero-header {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            border-radius: 1.25rem;
            padding: 2.25rem 2rem;
            color: #ffffff;
            margin-bottom: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            animation: profileFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .profile-hero-header::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 220px;
            height: 220px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            pointer-events: none;
        }

        .profile-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 16px;
            border-radius: 30px;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            margin-bottom: 10px;
            backdrop-filter: blur(8px);
        }

        .profile-hero-title {
            font-size: 2.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .profile-hero-subtitle {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.88);
            max-width: 760px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        /* 2. Unified Master Card (Consolidates Everything in One Elegant Box) */
        .profile-unified-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0, 50, 35, 0.05), 0 1px 4px rgba(0, 0, 0, 0.02);
            padding: 2.25rem 2.5rem;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            animation: profileFadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .profile-unified-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #006653 0%, #10b981 50%, #cb9d46 100%);
        }

        .profile-card-header {
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 1.25rem;
            margin-bottom: 2rem;
        }

        /* 3. Left Column Showcase Card */
        .profile-showcase-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 2rem 1.75rem;
            transition: all 0.25s ease;
        }

        .profile-showcase-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }

        .profile-avatar-circle {
            width: 94px;
            height: 94px;
            font-size: 2.5rem;
            font-weight: 800;
            color: #ffffff;
            background: linear-gradient(135deg, #006653 0%, #10b981 100%);
            border: 4px solid #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0, 102, 83, 0.2);
            transition: all 0.3s ease;
        }

        .profile-avatar-circle:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 28px rgba(0, 102, 83, 0.28);
        }

        .profile-details-list {
            border-top: 1px solid #e2e8f0;
            padding-top: 1.25rem;
            margin-top: 1.25rem;
            font-size: 0.88rem;
        }

        .profile-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.65rem 0;
            border-bottom: 1px dashed #e2e8f0;
        }

        /* 4. Security Trust Card */
        .profile-trust-card {
            background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
            border: 1.5px solid #a7f3d0;
            border-radius: 18px;
            padding: 1.35rem 1.45rem;
            transition: all 0.25s ease;
        }

        .profile-trust-card:hover {
            border-color: #006653;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 102, 83, 0.08);
        }

        .profile-trust-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #ffffff;
            color: #006653;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            box-shadow: 0 2px 8px rgba(0, 102, 83, 0.12);
            flex-shrink: 0;
        }

        /* 5. Modern Input Groups */
        .profile-input-group .input-group-text {
            background: #f8fafc;
            border-color: #e2e8f0;
            color: #64748b;
            border-radius: 12px 0 0 12px !important;
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .profile-input-group .form-control {
            border-color: #e2e8f0;
            border-radius: 0 12px 12px 0 !important;
            font-size: 0.94rem;
            transition: all 0.25s ease;
        }

        .profile-input-group .form-control:focus {
            border-color: #006653;
            box-shadow: 0 0 0 3px rgba(0, 102, 83, 0.12);
            background: #ffffff;
        }

        /* 6. Security Password Box */
        .profile-security-box {
            background: #fff5f5;
            border: 1.5px solid #fed7d7;
            transition: all 0.25s ease;
        }

        .profile-security-box:hover {
            border-color: #feb2b2;
            box-shadow: 0 4px 14px rgba(229, 62, 62, 0.06);
        }

        /* 7. Action Buttons */
        .btn-save-profile {
            background: linear-gradient(135deg, #006653 0%, #047857 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.72rem 2.25rem;
            border: none;
            box-shadow: 0 4px 14px rgba(0, 102, 83, 0.25);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-save-profile:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 102, 83, 0.35);
        }

        .btn-cancel-profile {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 9999px;
            padding: 0.72rem 1.75rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .btn-cancel-profile:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

        /* Entrance Keyframe Animation */
        @@keyframes profileFadeInUp {
            from {
                opacity: 0;
                transform: translateY(22px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 991px) {
            .profile-unified-card {
                padding: 1.5rem 1.15rem;
                border-radius: 18px;
            }
            .profile-hero-header {
                padding: 1.75rem 1.25rem;
            }
            .profile-hero-title {
                font-size: 1.75rem;
            }
        }
    </style>
}

<div class="profile-container py-3 px-2 px-md-3 px-xl-4" style="min-height: calc(100vh - 180px);">
    
    <!-- Hero Header Banner (Matching exact layout of Shop Products, Price Predictor & Live Mandi) -->
    <div class="profile-hero-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="profile-hero-badge">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Account Profile &bull; @userRole Identity &amp; Security</span>
                </div>
                <h1 class="profile-hero-title">
                    My Account Profile &amp; Settings
                </h1>
                <p class="profile-hero-subtitle">
                    Manage your personal credentials, contact details, and account preferences across the AgriAI portal.
                </p>
            </div>
            <div>
                <a asp-controller="@dashCtrl" asp-action="Dashboard" class="btn btn-light rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-success">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3.5 mb-4 shadow-sm border-0 d-flex align-items-center justify-content-between" style="background-color: #d1fae5; color: #065f46;" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Unified Master Card Container -->
    <div class="profile-unified-card shadow-sm">
        
        <div class="profile-card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-person-gear text-success"></i>
                    Personal Credentials &amp; Account Settings
                </h3>
                <p class="text-muted small mb-0">Review identity information, manage access credentials, and update verified security details.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.82rem;">
                    <i class="bi bi-shield-fill-check me-1"></i> Active &amp; Verified 🟢
                </span>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.82rem;">
                    <i class="bi bi-lock-fill text-muted me-1"></i> AES-256 Protected
                </span>
            </div>
        </div>

        <div class="row g-4 g-xl-5 align-items-start">
            
            <!-- Left Column: User Profile Badge & Status (col-lg-4 col-xl-3.5) -->
            <div class="col-lg-4 col-xl-3.5">
                <div class="profile-showcase-card text-center mb-4">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="profile-avatar-circle shadow-sm">
                            @userInitial
                        </div>
                    </div>
                    
                    <h4 class="fw-bold text-dark mb-1">
                        @(string.IsNullOrEmpty(Model.FirstName) && string.IsNullOrEmpty(Model.LastName) ? Model.Username : $"{Model.FirstName} {Model.LastName}")
                    </h4>
                    <p class="text-muted small mb-2 d-flex align-items-center justify-content-center gap-1.5">
                        <i class="bi bi-envelope text-success"></i>
                        <span>@Model.Email</span>
                    </p>
                    
                    <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 bg-success bg-opacity-10 text-success rounded-pill fw-bold small border border-success border-opacity-25 mb-3">
                        <i class="bi bi-patch-check-fill"></i>
                        <span>@userRole Account</span>
                    </div>

                    <div class="profile-details-list text-start">
                        <div class="profile-detail-row">
                            <span class="text-muted d-flex align-items-center gap-1.5">
                                <i class="bi bi-at text-muted"></i> Username:
                            </span>
                            <strong class="text-dark font-monospace">@@@Model.Username</strong>
                        </div>
                        <div class="profile-detail-row">
                            <span class="text-muted d-flex align-items-center gap-1.5">
                                <i class="bi bi-shield-check text-success"></i> Account Status:
                            </span>
                            <span class="text-success fw-bold">Active &amp; Verified 🟢</span>
                        </div>
                        <div class="profile-detail-row">
                            <span class="text-muted d-flex align-items-center gap-1.5">
                                <i class="bi bi-geo-alt-fill text-danger opacity-75"></i> Region:
                            </span>
                            <strong class="text-dark">Gujarat, India</strong>
                        </div>
                        <div class="profile-detail-row border-0 pb-0">
                            <span class="text-muted d-flex align-items-center gap-1.5">
                                <i class="bi bi-fingerprint text-primary opacity-75"></i> Role Access:
                            </span>
                            <strong class="text-dark">@userRole Level</strong>
                        </div>
                    </div>
                </div>

                <!-- Security Verification Trust Badge -->
                <div class="profile-trust-card shadow-xs">
                    <div class="d-flex align-items-start gap-3">
                        <div class="profile-trust-icon">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Secure @userRole Portal</h6>
                            <p class="text-muted small mb-0" style="font-size: 0.82rem; line-height: 1.5;">
                                Your credentials, order bids, and agricultural transactions are protected under AES-256 digital escrow encryption standards.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Editable Profile Form (col-lg-8 col-xl-8.5) -->
            <div class="col-lg-8 col-xl-8.5">
                <div class="profile-form-section">
                    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
                        <div>
                            <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-person-vcard text-success"></i> Personal Information
                            </h4>
                            <p class="text-muted small mb-0 mt-0.5">Update your public name, profile identity, and login credentials.</p>
                        </div>
                        <span class="badge bg-light text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill small fw-bold">
                            <i class="bi bi-pencil-square me-1"></i> Edit Details
                        </span>
                    </div>

                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-3 mb-4 rounded-3 border-0 shadow-xs"></div>

                        <!-- Name Fields -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold text-dark small mb-1.5">First Name</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FirstName" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Enter first name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-dark small mb-1.5">Last Name</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="LastName" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Enter last name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Username -->
                        <div class="mb-4">
                            <label asp-for="Username" class="form-label fw-bold text-dark small mb-1.5">Username (Login ID)</label>
                            <div class="input-group profile-input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted fw-bold font-monospace">@@</span>
                                <input asp-for="Username" class="form-control border-start-0 py-2.5 shadow-none font-monospace" placeholder="Enter unique username" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                            <small class="text-muted d-block mt-1.5"><i class="bi bi-info-circle me-1"></i>You can use this unique username to sign in to AgriAI instead of your email address.</small>
                        </div>

                        <!-- Email (Readonly) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small mb-1.5">Email Address (Registered Primary)</label>
                            <div class="input-group profile-input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 py-2.5 bg-light text-muted shadow-none" value="@Model.Email" readonly />
                                <span class="input-group-text bg-light border-start-0 text-muted small"><i class="bi bi-lock-fill"></i></span>
                            </div>
                            <small class="text-muted d-block mt-1.5"><i class="bi bi-shield-check me-1 text-success"></i>Verified primary email. Contact Gujarat Helpdesk to modify email address.</small>
                        </div>

                        <!-- Security Password Verification Box -->
                        <div class="profile-security-box p-4 rounded-4 mb-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 d-inline-flex">
                                    <i class="bi bi-shield-lock-fill fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-danger mb-0">Security Password Verification</h6>
                                    <small class="text-muted">Enter your current password to authorize profile changes</small>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label asp-for="CurrentPassword" class="form-label fw-bold text-dark small mb-1.5">Current Password <span class="text-danger">*</span></label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key-fill text-danger"></i></span>
                                    <input asp-for="CurrentPassword" type="password" class="form-control border-start-0 py-2.5 shadow-none" placeholder="Enter current account password" required />
                                </div>
                                <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                            <a asp-controller="@dashCtrl" asp-action="Dashboard" class="btn btn-cancel-profile">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-save-profile">
                                <i class="bi bi-check2-circle me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
